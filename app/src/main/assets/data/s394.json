{"儺":[{"b":"ㄋㄨㄛˊ","p":"nuó","d":[{"f":"迎神賽會以樂舞驅逐疫鬼。","t":"動"},{"f":"柔美的樣子。參見「猗儺」條。","t":"形"}]}],"儺神":[{"b":"ㄋㄨㄛˊ ㄕㄣˊ","p":"nuó shén","d":[{"f":"舉行儺祭時，驅除瘟疫的神。"}]}],"儺舞":[{"b":"ㄋㄨㄛˊ ㄨˇ","p":"nuó wǔ","d":[{"f":"古時祭祀儺神時跳的舞。目的在於驅鬼逐疫。舞者頭戴面具，手執兵器，表現驅鬼捉鬼的內容。"}]}],"夊":[{"b":"ㄘㄨㄟ","p":"cuī","d":[{"f":"(一)之又音。"}]},{"b":"ㄙㄨㄟ","p":"suī","d":[{"f":"走路遲緩的樣子。","t":"形"},{"f":"二一四部首之一。","t":"名"}]}],"媚":[{"b":"ㄇㄟˋ","p":"mèi","d":[{"f":"奉承、取悅、討好。","t":"動","e":["如：「諂媚」。"]},{"f":"愛。","t":"動"},{"f":"嬌豔、美好、可愛。","t":"形","e":["如：「嬌媚」、「嫵媚」、「風光明媚」。"]}]}],"媚世":[{"b":"ㄇㄟˋ ㄕˋ","p":"mèi shì","d":[{"f":"求悅於世人。"}]}],"媚力":[{"b":"ㄇㄟˋ ㄌㄧˋ","p":"mèi lì","d":[{"f":"嬌媚的吸引力。","e":["如：「她的媚力教人無法抗拒。」"]}]}],"媚外":[{"b":"ㄇㄟˋ ㄨㄞˋ","p":"mèi wài","d":[{"f":"諂媚外國人。"}]}],"媚奧":[{"b":"ㄇㄟˋ ㄠˋ","p":"mèi ào","d":[{"f":"比喻阿附權貴。"}]}],"媚如秋月":[{"b":"ㄇㄟˋ ㄖㄨˊ ㄑㄧㄡ ㄩㄝˋ","p":"mèi rú qiū yuè","d":[{"f":"美好可愛有如秋天的月亮。"}]}],"媚姿姿":[{"b":"ㄇㄟˋ ㄗ ㄗ","p":"mèi zī zī","d":[{"f":"形容女子嬌柔嫵媚的樣子。"}]}],"媚嫵":[{"b":"ㄇㄟˋ ㄨˇ","p":"mèi wǔ","d":[{"f":"形容姿態嬌柔美麗。金．元好問〈梨花海棠詩〉二首之二：「妍花紅粉妝，意態工媚嫵。」也作「嫵媚」。"}]}],"媚子":[{"b":"ㄇㄟˋ ㄗˇ","p":"mèi zǐ","d":[{"f":"所親愛的人。也指賢臣。"},{"f":"一種髮飾。"}]}],"媚惑":[{"b":"ㄇㄟˋ ㄏㄨㄛˋ","p":"mèi huò","d":[{"f":"以嬌媚的姿態使人迷惑。","e":["如：「由於受到媚惑，使他做了錯誤的決定，導致事業的失敗。」"]}]}],"媚態":[{"b":"ㄇㄟˋ ㄊㄞˋ","p":"mèi tài","d":[{"f":"諂媚的姿態。","e":["如：「瞧他那副媚態，真噁心！」"]},{"f":"嫵媚的姿態。唐．羅虬〈比紅兒〉詩：「總似紅兒媚態新，莫論于度笑爭春。」也作「媚氣」。"}]}],"媚景":[{"b":"ㄇㄟˋ ㄐㄧㄥˇ","p":"mèi jǐng","d":[{"f":"春景。"},{"f":"美好的景色。"}]}],"媚灶":[{"b":"ㄇㄟˋ ㄗㄠˋ","p":"mèi zào","d":[{"f":"語本《論語．八佾》：「與其媚於奧，寧媚於灶。」比喻阿附權臣。"}]}],"媚眼":[{"b":"ㄇㄟˋ ㄧㄢˇ","p":"mèi yǎn","d":[{"f":"嬌媚動人的眼睛。"}]}],"媚笑雜樣":[{"b":"ㄇㄟˋ ㄒㄧㄠˋ ㄗㄚˊ ㄧㄤˋ","p":"mèi xiào zá yàng","d":[{"f":"形容極盡諂媚地笑著。","e":["如：「瞧他那副媚笑雜樣，真教人討厭！」"]}]}],"媚行":[{"b":"ㄇㄟˋ ㄒㄧㄥˊ","p":"mèi xíng","d":[{"f":"緩步徐行。"}]}],"媚諂":[{"b":"ㄇㄟˋ ㄔㄢˇ","p":"mèi chǎn","d":[{"f":"巴結奉承。","e":["如：「他是一個喜歡媚諂的人。」"],"s":"趨奉,獻媚"}]}],"媚諛":[{"b":"ㄇㄟˋ ㄩˊ","p":"mèi yú","d":[{"f":"諂媚阿諛。《周禮．春官．大師》「教六詩：曰風，曰賦，曰比，曰興，曰雅，曰頌」句下漢．鄭玄．注：「興見今之美，嫌於媚諛，取善事以喻勸之。」"}]}],"媚道":[{"b":"ㄇㄟˋ ㄉㄠˋ","p":"mèi dào","d":[{"f":"諂媚的行為。"},{"f":"以巫祝之術取悅於人。"}]}],"媚骨":[{"b":"ㄇㄟˋ ㄍㄨˇ","p":"mèi gǔ","d":[{"f":"比喻奉承阿諛的品格。","e":["如：「為人宜直道而行，豈可屈膝媚骨？」"]}]}],"尪":[{"b":"ㄨㄤ","p":"wāng","d":[{"f":"一種骨骼彎曲的疾病。","t":"名"},{"f":"瘦弱。","t":"形"}]}],"尪羸":[{"b":"ㄨㄤ ㄌㄟˊ","p":"wāng léi","d":[{"f":"瘦弱。"}]}],"嶺":[{"b":"ㄌㄧㄥˇ","p":"lǐng","d":[{"f":"有道路可通的山頂。","t":"名"},{"f":"連綿不斷的山。","t":"名","e":["如：「北嶺」、「大興安嶺」、「南嶺」、「秦嶺」。"]},{"f":"大陸地區五嶺的簡稱。","t":"名"}]}],"嶺南":[{"b":"ㄌㄧㄥˇ ㄋㄢˊ","p":"lǐng nán","d":[{"f":"泛指五嶺以南的地區。"},{"f":"廣東。因其在五嶺以南，故通稱為「嶺南」。"}]}],"嶺南畫派":[{"b":"ㄌㄧㄥˇ ㄋㄢˊ ㄏㄨㄚˋ ㄆㄞˋ","p":"lǐng nán huà pài","d":[{"f":"近代中國畫的一個流派。廣東番禺高劍父、高奇峰及陳樹人，初師花鳥畫家居廉，後曾赴日進修。其作品多寫中國南方風物，運用傳統技法，融合日本和西洋畫法，重寫生，色彩鮮麗，別創新格，人稱「嶺南畫派」。"}]}],"嶺表":[{"b":"ㄌㄧㄥˇ ㄅㄧㄠˇ","p":"lǐng biǎo","d":[{"f":"五嶺以外的地方。指嶺南。在今廣東省一帶。"}]}],"彊":[{"b":"","p":"","d":[{"f":"「強」的異體字。"}]},{"b":"ㄑㄧㄤˇ","p":"qiǎng","d":[{"f":"迫使、使用強力。","t":"動"},{"f":"盡力、竭力。","t":"副"}]},{"b":"ㄑㄧㄤˊ","p":"qiáng","d":[{"f":"硬弓。","t":"名"},{"f":"姓。如漢代有彊華。","t":"名"},{"f":"壯盛、健壯。","t":"形"},{"f":"加強。","t":"動"}]}],"彊幹弱枝":[{"b":"ㄑㄧㄤˊ ㄍㄢˋ ㄖㄨㄛˋ ㄓ","p":"qiáng gàn ruò zhī","d":[{"f":"語本《史記．卷十七．漢興以來諸侯王年表．序》：「而漢郡八九十，形錯諸侯閒，犬牙相臨，秉其阨塞地利，彊本幹，弱枝葉之勢，尊卑明而萬事各得其所矣。」比喻強化根本主權力量，削弱分歧的勢力。也作「強本弱枝」、「強幹弱枝」。"}]}],"彊弩之末":[{"b":"ㄑㄧㄤˊ ㄋㄨˇ ㄓ ㄇㄛˋ","p":"qiáng nǔ zhī mò","d":[{"f":"強弩發射的箭，至射程盡頭，力量削弱，連絹帛也穿不過。語本《史記．卷一〇八．韓長孺傳》：「彊弩之極，矢不能穿魯縞；衝風之末，力不能漂鴻毛，非初不勁，末力衰也。」比喻氣衰力竭。《三國志．卷三十五．蜀書．諸葛亮傳》：「曹操之眾，遠來疲弊，聞追豫州，輕騎一日一夜行百餘里，此所謂『彊弩之末，勢不能穿魯縞。』者也。」也作「強弩之末」。"}]}],"彊志":[{"b":"ㄑㄧㄤˊ ㄓˋ","p":"qiáng zhì","d":[{"f":"記憶力特強。《荀子．解蔽》：「博聞彊志，不合王制，君子賤之。」唐．韓愈〈與祠部陸員外書〉：「彊志而婉容，和平而有立。」也作「強記」、「彊識」。"}]}],"彊本":[{"b":"ㄑㄧㄤˊ ㄅㄣˇ","p":"qiáng běn","d":[{"f":"重農。"},{"f":"加強根本。"}]}],"彊本弱末":[{"b":"ㄑㄧㄤˊ ㄅㄣˇ ㄖㄨㄛˋ ㄇㄛˋ","p":"qiáng běn ruò mò","d":[{"f":"加強鞏固根本，削弱餘末勢力。"}]}],"彊本節用":[{"b":"ㄑㄧㄤˊ ㄅㄣˇ ㄐㄧㄝˊ ㄩㄥˋ","p":"qiáng běn jié yòng","d":[{"f":"語本《荀子．天論》：「彊本而節用，則天不能貧。」指加強重視農業生產，節省用度。《史記．卷一三〇．太史公自序》：「要曰彊本節用，則人給家足之道也。此墨子之所長，雖百家弗能廢也。」也作「強本節用」。"}]}],"彊梁":[{"b":"ㄑㄧㄤˊ ㄌㄧㄤˊ","p":"qiáng liáng","d":[{"f":"剛強橫暴。《晏子春秋．內篇．問上》：「其言彊梁而信，其進敏遜而順。」《三國志．卷十四．魏書．董昭傳》：「且羽為人彊梁，自恃二城守固，必不速退。」也作「強梁」。"}]}],"彊禦":[{"b":"ㄑㄧㄤˊ ㄩˋ","p":"qiáng yù","d":[{"f":"豪強多力。《詩經．大雅．烝民》：「不侮矜寡，不畏彊禦。」南朝梁．劉勰《文心雕龍．奏啟》：「不畏彊禦，氣流墨中。」也作「強圉」、「彊圉」。"}]}],"彊記博聞":[{"b":"ㄑㄧㄤˊ ㄐㄧˋ ㄅㄛˊ ㄨㄣˊ","p":"qiáng jì bó wén","d":[{"f":"見聞廣博，記憶力強。《周書．卷二十六．長孫紹遠傳》：「兕字若汗，性機辯，彊記博聞，雅重賓遊，尤善談論。」也作「博聞強識」。"}]}],"惚":[{"b":"ㄏㄨ","p":"hū","d":[{"f":"參見「恍惚」條。"}]}],"惚恍":[{"b":"ㄏㄨ ㄏㄨㄤˇ","p":"hū huǎng","d":[{"f":"混沌不清。"},{"f":"神志迷糊。"}]}],"惚惚":[{"b":"ㄏㄨ ㄏㄨ","p":"hū hū","d":[{"f":"迷迷糊糊。"}]}],"樺":[{"b":"ㄏㄨㄚˋ","p":"huà","d":[{"f":"植物名。樺木科樺木屬，「樺木」、「白樺」之古稱，參見「樺木」條。","t":"名"}]}],"樺木":[{"b":"ㄏㄨㄚˋ ㄇㄨˋ","p":"huà mù","d":[{"f":"植物名。樺木科樺木屬，落葉喬木。高約九至二十七公尺。葉互生，三角狀卵形或菱形，葉緣有大小不等的鋸齒。柔荑花序，花小密生，果序是由許多小堅果及苞片集合成圓筒形。樹皮外層色白如雪，內皮淡褐色，且密含油脂，可提煉作潤滑劑，木材與樹皮可製家具。產於山西、河南、東北地區和朝鮮、日本一帶。"}]}],"樺燭":[{"b":"ㄏㄨㄚˋ ㄓㄨˊ","p":"huà zhú","d":[{"f":"以樺樹皮捲蠟製成的燭。"}]}],"樺皮臉":[{"b":"ㄏㄨㄚˋ ㄆㄧˊ ㄌㄧㄢˇ","p":"huà pí liǎn","d":[{"f":"罵人臉皮厚而不知羞恥。"}]}],"浚":[{"b":"ㄐㄩㄣˋ","p":"jùn","d":[{"f":"舀取。","t":"動"},{"f":"疏通或挖深水道。","t":"動"},{"f":"剝削、榨取。","t":"動"},{"f":"深。","t":"形"}]}],"浚利":[{"b":"ㄐㄩㄣˋ ㄌㄧˋ","p":"jùn lì","d":[{"f":"水流暢通無阻。"}]}],"浚財":[{"b":"ㄐㄩㄣˋ ㄘㄞˊ","p":"jùn cái","d":[{"f":"斂取他人財物而飽私囊。"}]}],"灺":[{"b":"ㄉㄨㄛˋ","p":"duò","d":[{"f":"(一)之又音。"}]},{"b":"ㄒㄧㄝˋ","p":"xiè","d":[{"f":"燈燭燒剩的殘餘物。","t":"名"}]}],"爊":[{"b":"ㄠˊ","p":"áo","d":[{"f":"用小火將食物煨熟。","t":"動"}]}],"甪":[{"b":"ㄌㄨˋ","p":"lù","d":[{"f":"一種野獸。","t":"名"},{"f":"同「角」(三)。","t":"名"}]}],"甪里":[{"b":"ㄌㄨˋ ㄌㄧˇ","p":"lù lǐ","d":[{"f":"地名。在今江蘇省吳縣西南。也作「角里」。"},{"f":"複姓。也作「角里」。"}]}],"皺":[{"b":"ㄓㄡˋ","p":"zhòu","d":[{"f":"臉上或皮膚因鬆弛而有摺紋的。","t":"形","e":["如：「皺紋」。"]},{"f":"物體有摺痕的。","t":"形","e":["如：「皺摺」、「他的衣服皺了！」"]},{"f":"擠壓、收縮。","t":"動","e":["如：「皺眉頭」。"]}]}],"皺巴巴":[{"b":"ㄓㄡˋ ㄅㄚ ㄅㄚ","p":"zhòu bā bā","d":[{"f":"皺紋多，不平整。","e":["如：「他從口袋裡掏出一張皺巴巴的鈔票。」"]}]}],"皺彆":[{"b":"ㄓㄡˋ ㄅㄧㄝˋ","p":"zhòu biè","d":[{"f":"狹隘、緊促的樣子。","e":["如：「這房間太皺彆了。」"]},{"f":"固執、緊握。","e":["如：「你別再皺彆了。」"]}]}],"皺摺":[{"b":"ㄓㄡˋ ㄓㄜˊ","p":"zhòu zhé","d":[{"f":"摺疊的紋。","e":["如：「他仔細的將衣服的皺摺燙平。」"]}]}],"皺眉":[{"b":"ㄓㄡˋ ㄇㄟˊ","p":"zhòu méi","d":[{"f":"雙眉緊蹙，表示不滿、不悅或憂愁。"}]}],"皺眉蹙眼":[{"b":"ㄓㄡˋ ㄇㄟˊ ㄘㄨˋ ㄧㄢˇ","p":"zhòu méi cù yǎn","d":[{"f":"皺眉頭、瞪眼睛，表示不滿或不高興的神情。","e":["如：「他聽了傳聞大為不悅，皺眉蹙眼的表示不信。」"]}]}],"皺紋":[{"b":"ㄓㄡˋ ㄨㄣˊ","p":"zhòu wén","d":[{"f":"皮膚或物體的摺紋。"}]}],"皺胃":[{"b":"ㄓㄡˋ ㄨㄟˋ","p":"zhòu wèi","d":[{"f":"反芻類動物的第四個胃，因皺紋甚多而得名。前接重瓣胃，後連十二指腸。"}]}],"皺褶":[{"b":"ㄓㄡˋ ㄓㄜˊ","p":"zhòu zhé","d":[{"f":"指紙張、衣物上顯出的折疊皺紋。","e":["如：「這件褲子在腰部打了三道皺褶，穿起來寬鬆自在。」"]}]}],"皺襞":[{"b":"ㄓㄡˋ ㄅㄧˋ","p":"zhòu bì","d":[{"f":"衣服上的皺痕。"}]}],"纊":[{"b":"ㄎㄨㄤˋ","p":"kuàng","d":[{"f":"棉絮。","t":"名"}]}],"纊工":[{"b":"ㄎㄨㄤˋ ㄍㄨㄥ","p":"kuàng gōng","d":[{"f":"製絲的工人。"}]}],"膪":[{"b":"ㄔㄨㄞˋ","p":"chuài","d":[{"f":"囊膪：豬肉靠近兩乳的部分。","t":"名"}]}],"茺":[{"b":"ㄔㄨㄥ","p":"chōng","d":[{"f":"參見「茺蔚」條。"}]}],"茺蔚":[{"b":"ㄔㄨㄥ ㄨㄟˋ","p":"chōng wèi","d":[{"f":"植物名。脣形科茺蔚屬，二年生草本。根生葉略呈圓形，莖葉掌狀三裂或數裂，小裂片線形。輪繖花序具八至十五朵花，腋生，花冠白色至淡紫紅色，脣形。葉莖可入藥，為產婦常服之品。"}]}],"蓊":[{"b":"ㄨㄥˇ","p":"wěng","d":[{"f":"參見「蓊蓊」、「蓊勃」等條。","t":"形"}]}],"蓊勃":[{"b":"ㄨㄥˇ ㄅㄛˊ","p":"wěng bó","d":[{"f":"草木茂盛的樣子。唐．柳宗元〈閔生賦〉：「山水浩以蔽虧兮，路蓊勃以揚氛。」也作「蓊葧」。"}]}],"蓊茸":[{"b":"ㄨㄥˇ ㄖㄨㄥˇ","p":"wěng rǒng","d":[{"f":"茂盛的樣子。"},{"f":"既亂又密的樣子。"}]}],"蓊蓊":[{"b":"ㄨㄥˇ ㄨㄥˇ","p":"wěng wěng","d":[{"f":"草木茂盛的樣子。"}]}],"蓊薆":[{"b":"ㄨㄥˇ ㄞˋ","p":"wěng ài","d":[{"f":"蔭蔽的樣子。"}]}],"蓊郁":[{"b":"ㄨㄥˇ ㄩˋ","p":"wěng yù","d":[{"f":"草木茂盛的樣子。"}]}],"蓊鬱":[{"b":"ㄨㄥˇ ㄩˋ","p":"wěng yù","d":[{"f":"草木茂盛的樣子。《文選．左思．蜀都賦》：「楩柟幽藹於谷底，松柏蓊鬱於山峰。」也作「蓊蔚」、「鬱蓊」。"},{"f":"雲氣濃密的樣子。三國魏．曹丕〈感物賦〉：「瞻玄雲之蓊鬱，仰沉陰之杳冥。」也作「鬱蓊」。"}]}],"蟪":[{"b":"ㄏㄨㄟˋ","p":"huì","d":[{"f":"參見「蟪蛄」條。"}]}],"蟪蛄":[{"b":"ㄏㄨㄟˋ ㄍㄨ","p":"huì gū","d":[{"f":"動物名。蟬類。吻長，體短。色黃綠，有黑白條紋，翅膀有黑斑。雄體腹部有鳴器，聲音響亮。"}]}],"蟪蛄不知春秋":[{"b":"ㄏㄨㄟˋ ㄍㄨ ㄅㄨˋ ㄓ ㄔㄨㄣ ㄑㄧㄡ","p":"huì gū bù zhī chūn qiū","d":[{"f":"蟪蛄夏生秋死，所以不知春秋。比喻生命短促或見識短淺。"}]}],"謊":[{"b":"ㄏㄨㄤˇ","p":"huǎng","d":[{"f":"假話，不實在的話。","t":"名","e":["如：「說謊」、「撒謊」、「圓謊」、「漫天大謊」。"]},{"f":"虛假不實的。","t":"形","e":["如：「謊言」、「謊話」。"]},{"f":"欺騙、哄騙。","t":"動"}]}],"謊價":[{"b":"ㄏㄨㄤˇ ㄐㄧㄚˋ","p":"huǎng jià","d":[{"f":"不實的價格。","e":["如：「不肖商人為了利益而虛報謊價。」"]}]}],"謊喳呼":[{"b":"ㄏㄨㄤˇ ㄔㄚ ㄏㄨ","p":"huǎng chā hū","d":[{"f":"說謊、胡說亂道。"}]}],"謊報":[{"b":"ㄏㄨㄤˇ ㄅㄠˋ","p":"huǎng bào","d":[{"f":"向人作不實的報告。","e":["如：「警方接獲一通謊報火警的電話，白忙了半天。」"]}]}],"謊子":[{"b":"ㄏㄨㄤˇ ˙ㄗ","p":"huǎng zi","d":[{"f":"騙子、無賴。"}]}],"謊徹梢虛":[{"b":"ㄏㄨㄤˇ ㄔㄜˋ ㄕㄠ ㄒㄩ","p":"huǎng chè shāo xū","d":[{"f":"扯謊、敷衍。"}]}],"謊敲才":[{"b":"ㄏㄨㄤˇ ㄑㄧㄠ ㄘㄞˊ","p":"huǎng qiāo cái","d":[{"f":"對情人怨懟的話。"}]}],"謊花":[{"b":"ㄏㄨㄤˇ ㄏㄨㄚ","p":"huǎng huā","d":[{"f":"不結果實的花。如南瓜、西瓜等的雄花。"}]}],"謊言":[{"b":"ㄏㄨㄤˇ ㄧㄢˊ","p":"huǎng yán","d":[{"f":"與事實不同、虛假的言語。","e":["如：「謊言遲早會被拆穿，你何不實話實說？」"],"s":"謠言","a":"實話,真話"}]}],"謊詐":[{"b":"ㄏㄨㄤˇ ㄓㄚˋ","p":"huǎng zhà","d":[{"f":"欺騙、作偽。"}]}],"謊話":[{"b":"ㄏㄨㄤˇ ㄏㄨㄚˋ","p":"huǎng huà","d":[{"f":"假話，不實的話。","s":"大話,鬼話,誑言"}]}],"謊話連篇":[{"b":"ㄏㄨㄤˇ ㄏㄨㄚˋ ㄌㄧㄢˊ ㄆㄧㄢ","p":"huǎng huà lián piān","d":[{"f":"形容謊話極多。","e":["如：「他總是謊話連篇，如今已沒有人相信他。」"],"a":"直言無隱"}]}],"踪":[{"b":"","p":"","d":[{"f":"「蹤」的異體字。"}]}],"酊":[{"b":"ㄉㄧㄥˇ","p":"dǐng","d":[{"f":"參見「酩酊」條。"}]}],"鑪":[{"b":"ㄌㄨˊ","p":"lú","d":[{"f":"火爐，可供燃燒以盛火的器具。","t":"名","e":["如：「香鑪」。"]},{"f":"酒店前，四邊隆起以放置酒罈的臺子。","t":"名"}]}],"鑪冶":[{"b":"ㄌㄨˊ ㄧㄝˇ","p":"lú yě","d":[{"f":"冶煉金屬的場所。《宋史．卷二九二．丁度傳》：「凶魁嘯聚，鑪冶日滋，居則鑄錢，急則為盜。」也作「爐冶」。"}]}],"鑪捶":[{"b":"ㄌㄨˊ ㄔㄨㄟˊ","p":"lú chuí","d":[{"f":"陶鑄、鍛造。"}]}],"餚":[{"b":"ㄒㄧㄠˊ","p":"xiáo","d":[{"f":"(一)之又音。"}]},{"b":"ㄧㄠˊ","p":"yáo","d":[{"f":"煮熟的肉類食物。","t":"名"}]}],"餚羞":[{"b":"ㄧㄠˊ ㄒㄧㄡ","p":"yáo xiū","d":[{"f":"佳餚、美食。"}]}],"餚饌":[{"b":"ㄧㄠˊ ㄓㄨㄢˋ","p":"yáo zhuàn","d":[{"f":"泛指飯菜。《儒林外史》第三七回：「當下廚役開剝了一條牛、四副羊，和祭品的餚饌菜蔬都整治起來。」也作「肴饌」、「殽饌」。"}]}],"鷊":[{"b":"ㄧˋ","p":"yì","d":[{"f":"雞形目吐綬雞科兩種鳥類的統稱。俗稱為「火雞」。體高三尺餘。羽色隨品種而異，頭部有瘤疣。雄者喉下垂紅色肉瓣，會發出咕嘍的聲音。今臺灣及大陸地區閩、粵等省多飼以供肉食用。也稱為「吐綬雞」。","t":"名"}]}],"齚":[{"b":"","p":"","d":[{"f":"「齰」的異體字。"}]}]}