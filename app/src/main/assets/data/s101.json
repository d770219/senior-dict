ㄓㄥ ㄒㄩㄣˊ","p":"zhēng xún","d":[{"f":"徵求詢問。","e":["如：「這件事必先徵詢他的意見，然後再作決定。」"]}]}],"徵調":[{"b":"ㄓㄥ ㄉㄧㄠˋ","p":"zhēng diào","d":[{"f":"徵召調度。","e":["如：「徵調人馬」、「徵調軍隊」。"]}]}],"徵象":[{"b":"ㄓㄥ ㄒㄧㄤˋ","p":"zhēng xiàng","d":[{"f":"跡象、徵候。","e":["如：「國民奮發有為，充滿朝氣，這就是國力強大的徵象。」"]},{"f":"驗證。"}]}],"徵購":[{"b":"ㄓㄥ ㄍㄡˋ","p":"zhēng gòu","d":[{"f":"徵收購買。一般指國家依法向人民收購私有財產。","e":["如：「政府徵購土地，興建國宅。」"]}]}],"徵辟":[{"b":"ㄓㄥ ㄅㄧˋ","p":"zhēng bì","d":[{"f":"朝廷任用平民為官。"}]}],"徵逐":[{"b":"ㄓㄥ ㄓㄨˊ","p":"zhēng zhú","d":[{"f":"追隨、追求。"}]}],"徵選":[{"b":"ㄓㄥ ㄒㄩㄢˇ","p":"zhēng xuǎn","d":[{"f":"公開徵求挑選。","e":["如：「某機關將公開徵選三名工讀生來擔任詢問臺服務的工作。」"]}]}],"徵集":[{"b":"ㄓㄥ ㄐㄧˊ","p":"zhēng jí","d":[{"f":"召集。","a":"遣散"},{"f":"及齡男子經徵兵檢查合格中籤者，縣（市）政府填發徵集令，限其準時到達指定地點報到入營，稱為「徵集」。"}]}],"徵風召雨":[{"b":"ㄓㄥ ㄈㄥ ㄓㄠˋ ㄩˇ","p":"zhēng fēng zhào yǔ","d":[{"f":"召喚風雨。形容人神通廣大，法力無邊。"}]}],"慅":[{"b":"ㄘㄠˇ","p":"cǎo","d":[{"f":"憂愁。","t":"形"}]},{"b":"ㄙㄠ","p":"sāo","d":[{"f":"擾動。","t":"動"}]}],"慅慅":[{"b":"ㄙㄠ ㄙㄠ","p":"sāo sāo","d":[{"f":"擾動不安的樣子。"}]}],"檥":[{"b":"ㄧˇ","p":"yǐ","d":[{"f":"停船靠岸。","t":"動"}]}],"淅":[{"b":"ㄒㄧ","p":"xī","d":[{"f":"淘米。","t":"動"},{"f":"洗過的米。","t":"名"}]}],"淅淅":[{"b":"ㄒㄧ ㄒㄧ","p":"xī xī","d":[{"f":"形容風、雨的聲音。"},{"f":"物體移動的聲音。"}]}],"淅淅瀝瀝":[{"b":"ㄒㄧ ㄒㄧ ㄌㄧˋ ㄌㄧˋ","p":"xī xī lì lì","d":[{"f":"擬聲詞。形容下雨的聲音。"}]}],"淅淅颯颯":[{"b":"ㄒㄧ ㄒㄧ ㄙㄚˋ ㄙㄚˋ","p":"xī xī sà sà","d":[{"f":"形容風雨細微的聲音。"}]}],"淅瀝":[{"b":"ㄒㄧ ㄌㄧˋ","p":"xī lì","d":[{"f":"形容風雨、霜雪、落葉等聲音。"}]}],"淅留淅零":[{"b":"ㄒㄧ ㄌㄧㄡˊ ㄒㄧ ㄌㄧㄥˊ","p":"xī liú xī líng","d":[{"f":"形容風雨、霜雪飄打的聲音。元．鄭光祖〈蟾宮曲．飄飄泊泊船纜定沙汀〉曲：「冷冷清清瀟湘景，晚風生，淅留淅零暮雨初晴。」也作「淅零零」、「淅零淅留」。"}]}],"淅零淅留":[{"b":"ㄒㄧ ㄌㄧㄥˊ ㄒㄧ ㄌㄧㄡˊ","p":"xī líng xī liú","d":[{"f":"形容風雨、霜雪飄打的聲音。元．周文質〈叨叨令．叮叮噹噹鐵馬兒乞留玎琅鬧〉曲：「滴滴點點細雨兒淅零淅留哨，瀟瀟灑灑梧葉兒失流疏剌落。」也作「淅留淅零」、「淅零零」。"}]}],"淅零零":[{"b":"ㄒㄧ ㄌㄧㄥˊ ㄌㄧㄥˊ","p":"xī líng líng","d":[{"f":"形容風雨、霜雪飄打的聲音。元．周文質〈叨叨令．嗚呀呀寒雁空中叫〉曲：「淅零零疏雨窗間哨，吉丁當鐵馬簷前鬧。」元．楊訥〈二郎神．景蕭索套〉：「敗葉兒淅零零亂飄，無聊。」也作「淅留淅零」、「淅零淅留」。"}]}],"淅颯":[{"b":"ㄒㄧ ㄙㄚˋ","p":"xī sà","d":[{"f":"動作細微的聲音。"}]}],"琅":[{"b":"ㄌㄤˊ","p":"láng","d":[{"f":"參見「琅玕」條。","t":"名"},{"f":"姓。如春秋時齊國有琅過。","t":"名"},{"f":"潔白的。","t":"形"}]}],"琅函":[{"b":"ㄌㄤˊ ㄏㄢˊ","p":"láng hán","d":[{"f":"書箱。"},{"f":"尊稱他人的書信。也作「瑯函」。"},{"f":"道書。"}]}],"琅玕":[{"b":"ㄌㄤˊ ㄍㄢ","p":"láng gān","d":[{"f":"圓潤如珠的美玉。"},{"f":"比喻華美的詞藻或佳文。"},{"f":"比喻美竹。唐．元稹〈種竹〉詩：「可憐亭亭幹，一一青琅玕。」也作「瑯玕」。"}]}],"琅琅":[{"b":"ㄌㄤˊ ㄌㄤˊ","p":"láng láng","d":[{"f":"擬聲詞：(1)形容金石相擊的聲音。《晉書．卷九二．庾闡傳》：「質清浮磬，聲若孤桐，琅琅其璞，巖巖其峰。」(2)形容清朗的讀書聲。清．蔣士銓〈鳴機夜課圖記〉：「銓誦聲琅琅然，與藥鼎沸聲相亂。」清．嚴復〈甲辰出都呈同里諸公〉詩：「孤山處士音琅琅，皂袍演說常登堂。」(3)形容蛇皮鼓的聲音。元．湯式〈風入松．題貨郎擔兒〉曲：「數聲何處蛇皮鼓，琅琅過金水橋東。」也作「不琅琅」、「不朗朗」。"}]}],"琅琅上口":[{"b":"ㄌㄤˊ ㄌㄤˊ ㄕㄤˋ ㄎㄡˇ","p":"láng láng shàng kǒu","d":[{"f":"琅琅，玉石撞擊聲，比喻響亮的讀書聲。「琅琅上口」形容誦讀詩文的聲音響亮而順口。","e":["如：「不要擔心，只要背熟了，自然就能琅琅上口。」"]}]}],"琅璫":[{"b":"ㄌㄤˊ ㄉㄤ","p":"láng dāng","d":[{"f":"擬聲詞。形容金屬或玉石撞擊的聲音。唐．杜甫〈大雲寺贊公房〉詩四首之三：「夜深殿突兀，風動金琅璫。」明．凌濛初《紅拂記》第三齣：「琅璫交錯垂金鎖，錦繡崚嶒絢彩霞。」也作「鋃鐺」。"},{"f":"刑具。指縛繫人犯的鐵鎖、鐵鏈。或指用鎖鎖住。《文明小史》第九回：「帶領衙役，到監裡，把一班秀才，一齊鐵索琅璫提了上來，當堂跪下。」也作「郎當」、「鋃鐺」。"}]}],"琅簡蘂書":[{"b":"ㄌㄤˊ ㄐㄧㄢˇ ㄖㄨㄟˇ ㄕㄨ","p":"láng jiǎn ruǐ shū","d":[{"f":"道書。"}]}],"琅邪":[{"b":"ㄌㄤˊ ㄧㄝˊ","p":"láng yé","d":[{"f":"郡名：(1)秦置，在今山東省諸城縣。(2)南朝齊置，在今江蘇省東海縣。也作「琅琊」、「瑯琊」。"}]}],"琅邪山":[{"b":"ㄌㄤˊ ㄧㄝˊ ㄕㄢ","p":"láng yé shān","d":[{"f":"山名：(1)在今山東省諸城縣東南，秦始皇曾登此山，築琅邪臺，立石刻以紀功頌德。(2)在今安徽省滁縣西南。晉元帝為琅邪王時，曾避居此山，因以為名。也作「琅琊山」、「瑯琊山」。"}]}],"琅邪臺刻石":[{"b":"ㄌㄤˊ ㄧㄝˊ ㄊㄞˊ ㄎㄜˋ ㄕˊ","p":"láng yé tái kè shí","d":[{"f":"秦始皇二十八年南巡，登琅邪山，築琅邪臺，立石刻於其上，目的在頌秦德，明得意。此刻石文字傳為李斯所書小篆。後胡亥繼立，二世元年東行郡縣，於原石之旁加刻詔書，世稱二世詔文。今原石已毀，惟二世詔文，殘存十三行八十七字，字跡多剝蝕難辨。"}]}],"眥":[{"b":"ㄗˋ","p":"zì","d":[{"f":"眼眶。","t":"名"}]}],"眥目":[{"b":"ㄗˋ ㄇㄨˋ","p":"zì mù","d":[{"f":"瞪大眼睛。","e":["如：「他都已經眥目握拳了，你還不立刻住嘴。」"],"s":"怒目,瞋目"}]}],"眥睚":[{"b":"ㄗˋ ㄧㄞˊ","p":"zì yái","d":[{"f":"本指瞪眼生氣的樣子，後借指微小的怨忿。","e":["如：「眥睚必報」。"]}]}],"穅":[{"b":"","p":"","d":[{"f":"「糠」的異體字。"}]}],"肅":[{"b":"ㄙㄨˋ","p":"sù","d":[{"f":"恭敬的。","t":"形"},{"f":"莊嚴的。","t":"形","e":["如：「嚴肅」、「肅穆」。"]},{"f":"恭敬。","t":"動"},{"f":"敬畏。","t":"動"},{"f":"戒備、整飭。","t":"動"},{"f":"斂縮、萎縮。","t":"動"},{"f":"急迫、嚴峻。","t":"動"},{"f":"引導。參見「肅客」條。","t":"動"},{"f":"用於書信的敬詞。","t":"動","e":["如：「手肅」、「端肅」、「拜肅」。"]},{"f":"恭敬的。","t":"副","e":["如：「肅立」、「肅呈」、「肅謝」。"]}]}],"肅函":[{"b":"ㄙㄨˋ ㄏㄢˊ","p":"sù hán","d":[{"f":"敬謹致函。也作「肅柬」。"}]}],"肅反":[{"b":"ㄙㄨˋ ㄈㄢˇ","p":"sù fǎn","d":[{"f":"大陸地區指肅清反革命。"}]}],"肅呈":[{"b":"ㄙㄨˋ ㄔㄥˊ","p":"sù chéng","d":[{"f":"敬謹呈獻。為書信用語。"}]}],"肅坐":[{"b":"ㄙㄨˋ ㄗㄨㄛˋ","p":"sù zuò","d":[{"f":"端坐。"}]}],"肅客":[{"b":"ㄙㄨˋ ㄎㄜˋ","p":"sù kè","d":[{"f":"迎接客人進入。"}]}],"肅恭":[{"b":"ㄙㄨˋ ㄍㄨㄥ","p":"sù gōng","d":[{"f":"措辭極恭敬。"}]}],"肅慎":[{"b":"ㄙㄨˋ ㄕㄣˋ","p":"sù shèn","d":[{"f":"古代東北邊疆的民族。參見「女真」條。"}]}],"肅拜":[{"b":"ㄙㄨˋ ㄅㄞˋ","p":"sù bài","d":[{"f":"一種古代的禮儀。兩膝齊跪而舉手下手，為九拜之一。見《周禮．春官．大祝》。"},{"f":"恭敬的拜揖。為書信常用語。"}]}],"肅殺":[{"b":"ㄙㄨˋ ㄕㄚ","p":"sù shā","d":[{"f":"嚴厲而有摧殘的力量。多用來形容秋冬草木枯落的蕭條氣象。"}]}],"肅清":[{"b":"ㄙㄨˋ ㄑㄧㄥ","p":"sù qīng","d":[{"f":"削平亂事，整飭綱紀。","s":"清除,消滅"},{"f":"冷靜寂寞。"}]}],"肅然":[{"b":"ㄙㄨˋ ㄖㄢˊ","p":"sù rán","d":[{"f":"嚴謹恭敬的樣子。"},{"f":"山名。位於山東萊蕪縣東北，當泰山東麓，漢武帝封泰山，禪肅然，即此。"}]}],"肅然起敬":[{"b":"ㄙㄨˋ ㄖㄢˊ ㄑㄧˇ ㄐㄧㄥˋ","p":"sù rán qǐ jìng","d":[{"f":"因受感動而欽佩恭敬。"}]}],"肅爽":[{"b":"ㄙㄨˋ ㄕㄨㄤˇ","p":"sù shuǎng","d":[{"f":"古代的一種駿馬。《左傳．定公三年》：「唐成公如楚，有兩肅爽馬。」也作「驌驦」。"}]}],"肅穆":[{"b":"ㄙㄨˋ ㄇㄨˋ","p":"sù mù","d":[{"f":"嚴肅莊重。如：「祖母的告別式極其肅穆哀榮。」也作「肅睦」。","s":"嚴肅"},{"f":"肅靜和緩。《文選．應璩．與滿公琰書》：「沙場夷敞，清風肅穆，是京臺之樂也。」也作「肅睦」。"}]}],"肅立":[{"b":"ㄙㄨˋ ㄌㄧˋ","p":"sù lì","d":[{"f":"恭敬的站立。","e":["如：「唱國歌時，大家應肅立。」"]}]}],"肅肅":[{"b":"ㄙㄨˋ ㄙㄨˋ","p":"sù sù","d":[{"f":"恭謹的樣子。"},{"f":"迅速、匆忙的樣子。"},{"f":"嚴正的樣子。"},{"f":"擬聲詞。形容風聲。"}]}],"肅貪":[{"b":"ㄙㄨˋ ㄊㄢ","p":"sù tān","d":[{"f":"整肅貪瀆。","e":["如：「司法單位將嚴辦各種收受賄賂的案件，以澈底展現肅貪的決心。」"]}]}],"肅雝":[{"b":"ㄙㄨˋ ㄩㄥ","p":"sù yōng","d":[{"f":"恭敬而溫和。《詩經．召南．何彼襛矣》：「曷不肅雝，王姬之車。」也作「肅雍」。"}]}],"肅靜":[{"b":"ㄙㄨˋ ㄐㄧㄥˋ","p":"sù jìng","d":[{"f":"嚴肅寂靜。","e":["如：「當國家元首進入禮堂時，頓時全場肅靜。」"],"a":"喧囂,喧譁,嘈雜,嚷鬧,鼓噪"},{"f":"平定。","e":["如：「肅靜叛亂」。"]}]}],"肅順":[{"b":"ㄙㄨˋ ㄕㄨㄣˋ","p":"sù shùn","d":[{"f":"人名。（西元1818～1861）清宗室，鄭王端華之弟。咸豐間，官至御前大臣、戶部尚書、協辦大學士，為文宗所信任。文宗崩，穆宗立，肅順與端華及怡王載垣等顧命主政務，因阻撓太后垂簾聽政失敗，而與端華、載垣均被殺害。"}]}],"舕":[{"b":"ㄊㄢˋ","p":"tàn","d":[{"f":"參見「舚舕」條。"}]}],"衕":[{"b":"ㄊㄨㄥˋ","p":"tòng","d":[{"f":"參見「衚衕」條。","t":"名"}]}],"觥":[{"b":"ㄍㄨㄥ","p":"gōng","d":[{"f":"用兕牛角製成的飲酒器物。","t":"名","e":["如：「杯觥交錯」。"]},{"f":"豐盛。","t":"形"}]}],"觥令":[{"b":"ㄍㄨㄥ ㄌㄧㄥˋ","p":"gōng lìng","d":[{"f":"酒令。","e":["如：「主持觥令」。"]}]}],"觥籌交舉":[{"b":"ㄍㄨㄥ ㄔㄡˊ ㄐㄧㄠ ㄐㄩˇ","p":"gōng chóu jiāo jǔ","d":[{"f":"酒器和酒籌錯雜相交。比喻飲酒暢歡。《初刻拍案驚奇》卷一八：「日日雇了天字一號的大湖船，擺了盛酒，吹彈歌唱俱備，攜了此妾下湖，淺斟低唱，觥籌交舉，滿桌擺設酒器，多是些金銀異巧式樣，層見迭出。」也作「觥籌交錯」、「交錯觥籌」。"}]}],"觥籌交錯":[{"b":"ㄍㄨㄥ ㄔㄡˊ ㄐㄧㄠ ㄘㄨㄛˋ","p":"gōng chóu jiāo cuò","d":[{"f":"酒器和酒籌錯雜相交。比喻暢飲。也作「觥籌交舉」、「交錯觥籌」。"}]}],"觥籌獄":[{"b":"ㄍㄨㄥ ㄔㄡˊ ㄩˋ","p":"gōng chóu yù","d":[{"f":"觥籌，酒器和酒籌。「觥籌獄」即酒獄。用於戲稱勉強別人飲酒。"}]}],"觥船":[{"b":"ㄍㄨㄥ ㄔㄨㄢˊ","p":"gōng chuán","d":[{"f":"載酒之舟。"}]}],"觥觥":[{"b":"ㄍㄨㄥ ㄍㄨㄥ","p":"gōng gōng","d":[{"f":"剛直的樣子。"}]}],"觥飯不及壺飧":[{"b":"ㄍㄨㄥ ㄈㄢˋ ㄅㄨˋ ㄐㄧˊ ㄏㄨˊ ㄙㄨㄣ","p":"gōng fàn bù jí hú sūn","d":[{"f":"豐盛的飯食還比不上壺中普通的飯食能救飢。比喻遠水難解近渴。"}]}],"贅":[{"b":"ㄓㄨㄟˋ","p":"zhuì","d":[{"f":"抵押。","t":"動"},{"f":"一種婚姻關係，指男子到女家成婚，並且成為女方家庭成員。","t":"名","e":["如：「招贅」、「入贅」。"]},{"f":"皮膚上的肉疙瘩。","t":"名"},{"f":"多餘、沒有用處。","t":"形","e":["如：「贅言」、「贅疣」、「贅肉」。"]}]}],"贅婿":[{"b":"ㄓㄨㄟˋ ㄒㄩˋ","p":"zhuì xù","d":[{"f":"男子就婚於女家，從女家的姓，所生子女亦從母姓，稱為「贅婿」。"}]}],"贅子":[{"b":"ㄓㄨㄟˋ ㄗˇ","p":"zhuì zǐ","d":[{"f":"淮南習俗窮苦人家賣子與人為奴婢，稱為「贅子」。若三年不能贖，即永為奴婢。一說贅子，即贅婿。"}]}],"贅文":[{"b":"ㄓㄨㄟˋ ㄨㄣˊ","p":"zhuì wén","d":[{"f":"多餘無用的文字。"}]}],"贅旒":[{"b":"ㄓㄨㄟˋ ㄌㄧㄡˊ","p":"zhuì liú","d":[{"f":"國君為臣下所挾持，大權旁落。《公羊傳．襄公十六年》：「曷為遍刺天下之大夫，君若贅旒然。」也作「綴旒」。"}]}],"贅疣":[{"b":"ㄓㄨㄟˋ ㄧㄡˊ","p":"zhuì yóu","d":[{"f":"指皮膚或黏膜的角質增殖、變厚的腫瘤。"},{"f":"比喻多餘無用的事物。"}]}],"贅瘤":[{"b":"ㄓㄨㄟˋ ㄌㄧㄡˊ","p":"zhuì liú","d":[{"f":"由細胞自主性增生所形成的腫塊，有良性和惡性之分。良性者通常界線清楚，生長速度慢，沒有侵襲性，不會轉移；惡性者又稱為「癌」或「惡性肉瘤」，通常界線不清楚，生長快，易侵襲附近組織或器官，會發生轉移。"},{"f":"比喻多餘無用的事物。三國魏．嵇康〈答向子期難養生論〉：「君子之用心若此，蓋將以名位為贅瘤，資財為塵垢也。」宋．王禹偁〈月波樓詠懷〉詩：「身世喻泡幻，衣冠如贅瘤。」也作「贅疣」。"}]}],"贅聚":[{"b":"ㄓㄨㄟˋ ㄐㄩˋ","p":"zhuì jù","d":[{"f":"會聚。","a":"星散"}]}],"贅肉":[{"b":"ㄓㄨㄟˋ ㄖㄡˋ","p":"zhuì ròu","d":[{"f":"多餘的肥肉、脂肪。","e":["如：「我打算每天做五十個仰臥起坐，來消除腹部的贅肉。」"]}]}],"贅言":[{"b":"ㄓㄨㄟˋ ㄧㄢˊ","p":"zhuì yán","d":[{"f":"多餘的言詞。"}]}],"贅述":[{"b":"ㄓㄨㄟˋ ㄕㄨˋ","p":"zhuì shù","d":[{"f":"多事敘述。"}]}],"躕":[{"b":"ㄔㄨˊ","p":"chú","d":[{"f":"參見「踟躕」條。"}]}],"躕躇":[{"b":"ㄔㄨˊ ㄔㄨˊ","p":"chú chú","d":[{"f":"徘徊。"}]}],"醵":[{"b":"ㄐㄩˋ","p":"jù","d":[{"f":"眾人集錢一起飲酒。","t":"動"},{"f":"聚集。","t":"動","e":["如：「醵資」、「醵金為壽」。"]}]}],"醵資":[{"b":"ㄐㄩˋ ㄗ","p":"jù zī","d":[{"f":"湊集眾人的錢財。如：「大家醵資為他祝壽。」也作「醵金」。","a":"獨資"}]}],"醵金":[{"b":"ㄐㄩˋ ㄐㄧㄣ","p":"jù jīn","d":[{"f":"湊集眾人的錢財。元．陶宗儀《南村輟耕錄．卷一一．暖屋》：「今之入宅與遷居者，鄰里醵金治具，過主人飲，謂曰暖屋，或曰暖房。」也作「醵資」。"}]}],"鍅":[{"b":"ㄈㄚˇ","p":"fǎ","d":[{"f":"（francium，Fr）化學元素。原子序87。為放射性鹼金屬元素之一。由法國科學家培雷（Marguerite Perey）所發現。培雷以致癌老鼠作實驗，發現鍅較易集中於腫瘤中，認為鍅可用於治療學上。大陸地區譯為鈁。","t":"名"}]}],"韵":[{"b":"","p":"","d":[{"f":"「韻」的異體字。"}]}]}