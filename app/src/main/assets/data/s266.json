{"㱪":[{"b":"","p":"","d":[{"f":"「殙」的異體字。"}]}],"䗊":[{"b":"","p":"","d":[{"f":"「舕」的異體字。"}]}],"傺":[{"b":"ㄔˋ","p":"chì","d":[{"f":"留住、停留。","t":"動"}]}],"削":[{"b":"ㄒㄧㄠ","p":"xiāo","d":[{"f":"(一)之語音。"}]},{"b":"ㄒㄩㄝˋ","p":"xuè","d":[{"f":"用刀斜刮除去物體表層。","t":"動","e":["如：「削皮」、「削鉛筆」。"]},{"f":"分割。","t":"動"},{"f":"減弱。","t":"動","e":["如：「削滅」、「削弱」、「國勢日削」。"]},{"f":"刪除。","t":"動","e":["如：「削職」。"]},{"f":"搜括。","t":"動","e":["如：「剝削」。"]},{"f":"責怪。","t":"動","e":["如：「他剛剛被老師削了一頓。」"]}]}],"削價":[{"b":"ㄒㄧㄠ ㄐㄧㄚˋ","p":"xiāo jià","d":[{"f":"削減價錢。如：「因倉庫存貨過多，又苦無現金周轉，廠商只好削價求現。」「主管單位力求物價穩定，以避免削價競爭之情況。」","s":"跌價,減價,抑價"}]}],"削地":[{"b":"ㄒㄩㄝˋ ㄉㄧˋ","p":"xuè dì","d":[{"f":"分地。"},{"f":"奪除封地。"}]}],"削壁":[{"b":"ㄒㄩㄝˋ ㄅㄧˋ","p":"xuè bì","d":[{"f":"峻峭陡直的山壁。","e":["如：「這山南面盡是懸崖削壁，地勢險峻。」"]}]}],"削奪":[{"b":"ㄒㄩㄝˋ ㄉㄨㄛˊ","p":"xuè duó","d":[{"f":"剝削奪取。"}]}],"削平":[{"b":"ㄒㄧㄠ ㄆㄧㄥˊ","p":"xiāo píng","d":[{"f":"切削物體使平滑。","e":["如：「這木材要先削平了才能用。」"]}]},{"b":"ㄒㄩㄝˋ ㄆㄧㄥˊ","p":"xuè píng","d":[{"f":"平定。"}]}],"削弱":[{"b":"ㄒㄩㄝˋ ㄖㄨㄛˋ","p":"xuè ruò","d":[{"f":"把力量或勢力減弱。","s":"減弱","a":"增強,鞏固,加強"}]}],"削成":[{"b":"ㄒㄩㄝˋ ㄔㄥˊ","p":"xuè chéng","d":[{"f":"陡峻。"}]}],"削方為圓":[{"b":"ㄒㄩㄝˋ ㄈㄤ ㄨㄟˊ ㄩㄢˊ","p":"xuè fāng wéi yuán","d":[{"f":"比喻將正直的性格轉為圓滑。參見「刓方為圓」條。"}]}],"削木為吏":[{"b":"ㄒㄩㄝˋ ㄇㄨˋ ㄨㄟˊ ㄌㄧˋ","p":"xuè mù wéi lì","d":[{"f":"相傳上古人民性情質樸，法令簡易，雖畫地為牢，用木頭雕成獄吏，亦可以為治。《幼學瓊林．卷四．訟獄類》：「上古時削木為吏，今日之淳風安在？」後比喻獄吏殘酷苛刻，令人生懼。《文選．司馬遷．報任少卿書》：「故有畫地為牢，勢不可入，削木為吏，議不可對。」也作「刻木為吏」。"}]}],"削正":[{"b":"ㄒㄩㄝˋ ㄓㄥˋ","p":"xuè zhèng","d":[{"f":"請人指正詩文的敬詞。","e":["如：「拙著請您削正！」"]}]}],"削減":[{"b":"ㄒㄩㄝˋ ㄐㄧㄢˇ","p":"xuè jiǎn","d":[{"f":"裁減。","e":["如：「為求財務收支平衡，只得削減人事費用。」"],"s":"減少,裁減","a":"增加,增添"}]}],"削牘":[{"b":"ㄒㄩㄝˋ ㄉㄨˊ","p":"xuè dú","d":[{"f":"古代書字於木簡上，有誤則以刀削去，故稱為「削牘」。"}]}],"削球":[{"b":"ㄒㄩㄝˋ ㄑㄧㄡˊ","p":"xuè qiú","d":[{"f":"球類運動用語。一種擊球技術。桌球或網球球拍擊球時帶有由上而下的逆旋轉動作，使球向後旋轉的技巧均屬之。"}]}],"削瘦":[{"b":"ㄒㄧㄠ ㄕㄡˋ","p":"xiāo shòu","d":[{"f":"形容人纖細瘦弱。","e":["如：「她削瘦的身子怎禁得起這番折磨雨淋！」"]}]}],"削職":[{"b":"ㄒㄩㄝˋ ㄓˊ","p":"xuè zhí","d":[{"f":"開除、革職。"}]}],"削肩":[{"b":"ㄒㄩㄝˋ ㄐㄧㄢ","p":"xuè jiān","d":[{"f":"纖瘦柔婉的肩部。多用於女性。"}]}],"削色":[{"b":"ㄒㄩㄝˋ ㄙㄜˋ","p":"xuè sè","d":[{"f":"丟臉、遜色。"}]}],"削草":[{"b":"ㄒㄩㄝˋ ㄘㄠˇ","p":"xuè cǎo","d":[{"f":"除草。比喻消除災禍。","e":["如：「這項措施從根源防治著手，可說是削草除根，永絕後患。」"]},{"f":"為求謹慎嚴密而將底稿銷毀。"}]}],"削蔥":[{"b":"ㄒㄩㄝˋ ㄘㄨㄥ","p":"xuè cōng","d":[{"f":"比喻人纖細白嫩的手指。多用於女性。"}]}],"削觚為圓":[{"b":"ㄒㄩㄝˋ ㄍㄨ ㄨㄟˊ ㄩㄢˊ","p":"xuè gū wéi yuán","d":[{"f":"觚，有稜角。削觚為圓比喻將正直的性格轉為圓滑。參見「刓方為圓」條。"}]}],"削足就履":[{"b":"ㄒㄩㄝˋ ㄗㄨˊ ㄐㄧㄡˋ ㄌㄩˇ","p":"xuè zú jiù lǚ","d":[{"f":"比喻勉強遷就，拘泥成例而不知變通。參見「削足適履」條。","e":["如：「吸取他人的經驗，應加以斟酌，切忌削足就履。」"],"s":"截趾適履"}]}],"削足適履":[{"b":"ㄒㄩㄝˋ ㄗㄨˊ ㄕˋ ㄌㄩˇ","p":"xuè zú shì lǚ","d":[{"f":"履，鞋。削足適履意指鞋小腳大，故將腳削小以適應鞋的尺寸。語本《淮南子．說林》：「夫所以養而害所養，譬猶削足而適履，殺頭而便冠。」比喻勉強遷就，拘泥舊例而不知變通。如：「擷取他人經驗時，應視自己的需求靈活運用，不可削足適履。」也作「刻足適屨」、「截趾適屨」、「削趾適屨」、「削足就履」、「刖趾適屨」、「刖足適屨」。","s":"因噎廢食"}]}],"削趾適屨":[{"b":"ㄒㄩㄝˋ ㄓˇ ㄕˋ ㄐㄩˋ","p":"xuè zhǐ shì jù","d":[{"f":"比喻勉強遷就，拘泥舊例而不知變通。參見「削足適履」條。","e":["如：「學習他人的經驗時，應靈活運用，不可削趾適屨。」"]}]}],"削跡":[{"b":"ㄒㄩㄝˋ ㄐㄧ","p":"xuè jī","d":[{"f":"隱藏起來，消聲匿跡。"}]}],"削鐵如泥":[{"b":"ㄒㄩㄝˋ ㄊㄧㄝˇ ㄖㄨˊ ㄋㄧˊ","p":"xuè tiě rú ní","d":[{"f":"形容兵器非常鋒利。明．無名氏《尋親記》第七齣：「純鐵打就，久鍊成之，斬人無血，削鐵如泥。」也作「砍鐵如泥」。"}]}],"削除":[{"b":"ㄒㄩㄝˋ ㄔㄨˊ","p":"xuè chú","d":[{"f":"刪除。","a":"添加"}]}],"削髮":[{"b":"ㄒㄩㄝˋ ㄈㄚˇ","p":"xuè fǎ","d":[{"f":"剃去頭髮出家。"}]}],"削髮披緇":[{"b":"ㄒㄩㄝˋ ㄈㄚˇ ㄆㄧ ㄗ","p":"xuè fǎ pī zī","d":[{"f":"剃去頭髮，披上緇衣出家為僧或為尼。","s":"落髮"}]}],"削髮為僧":[{"b":"ㄒㄩㄝˋ ㄈㄚˇ ㄨㄟˊ ㄙㄥ","p":"xuè fǎ wéi sēng","d":[{"f":"剃除鬚髮，出家為僧。"}]}],"削麵":[{"b":"ㄒㄧㄠ ㄇㄧㄢˋ","p":"xiāo miàn","d":[{"f":"將和好的麵團以鋒刀削成薄片，直接入鍋煮食，為坊間常見的一種小吃。"}]}],"叚":[{"b":"","p":"","d":[{"f":"「假」的異體字。"}]}],"啪":[{"b":"ㄆㄚ","p":"pā","d":[{"f":"模擬拍擊或爆裂的聲音。如：「他盛怒之下，『啪』的一聲，用力地拍了桌子。」「爆竹劈里啪啦響了起來。」也作「㕷」、「拍」。","t":"擬"}]},{"b":"ㄆㄧㄚ","p":"piā","d":[{"f":"(一)之又音。"}]}],"啪啦":[{"b":"ㄆㄚ ˙ㄌㄚ","p":"pā la","d":[{"f":"擬聲詞。形容器物落地破碎的聲音或聲音不清脆。如：「啪啦一聲，花瓶落地破碎了。」「這花瓶有了裂痕，拍起來啪啦啪啦的，不清脆。」也作「㕷啦」。"}]}],"啪嗒":[{"b":"ㄆㄚ ㄉㄚ","p":"pā dā","d":[{"f":"擬聲詞。摹擬東西落地或敲擊的聲音。如：「雨水打在鐵皮屋頂上，發出啪嗒啪嗒的聲響。」「筷子沒拿穩，啪嗒一聲掉到地上。」"}]}],"啪嚓":[{"b":"ㄆㄚ ㄘㄚ","p":"pā cā","d":[{"f":"擬聲詞。形容東西落地破碎的聲音。","e":["如：「只聽到啪嚓一聲，茶杯掉到地上破碎了。」"]}]}],"固":[{"b":"ㄍㄨˋ","p":"gù","d":[{"f":"結實、堅硬。","t":"形","e":["如：「牢固」、「穩固」、「堅固」。"]},{"f":"堅定、確定。","t":"形"},{"f":"安定。","t":"動","e":["如：「鞏固國防」。"]},{"f":"禁閉。","t":"動"},{"f":"堅決、堅持、極力。","t":"副","e":["如：「固守」。"]},{"f":"原來、一向。","t":"副","e":["如：「固有道德」。"]},{"f":"當然、誠然。","t":"副"},{"f":"姑且、暫且。","t":"副"},{"f":"姓。如春秋時晉國有固來。","t":"名"}]}],"固執":[{"b":"ㄍㄨˋ ㄓˊ","p":"gù zhí","d":[{"f":"堅守不違背。","s":"拘泥,執拗,頑固,頑強","a":"變通,遷就,靈活,順從"},{"f":"堅持己見，不肯變通。"}]}],"固執己見":[{"b":"ㄍㄨˋ ㄓˊ ㄐㄧˇ ㄐㄧㄢˋ","p":"gù zhí jǐ jiàn","d":[{"f":"堅持己見，不肯變通。","s":"獨斷專行,剛愎自用,自以為是,一意孤行","a":"從諫如流,虛懷若谷"}]}],"固壽":[{"b":"ㄍㄨˋ ㄕㄡˋ","p":"gù shòu","d":[{"f":"壽終正寢。"}]}],"固姑":[{"b":"ㄍㄨˋ ㄍㄨ","p":"gù gū","d":[{"f":"蒙古貴族婦女特有的禮冠。以鐵絲結成，約長三尺，頭冠高聳，並飾以紅青錦繡或珠玉，華麗繁複，能增添雍容華貴的氣勢。也作「罟罟」、「故故」。"}]}],"固守":[{"b":"ㄍㄨˋ ㄕㄡˇ","p":"gù shǒu","d":[{"f":"堅守不改變。","s":"堅守","a":"失守,失陷,撤退"}]}],"固定":[{"b":"ㄍㄨˋ ㄉㄧㄥˋ","p":"gù dìng","d":[{"f":"穩定、不移動。","e":["如：「找個固定的職業是每個人最大的願望。」"],"s":"不變,穩定,穩固","a":"移動,變動,動搖,流動,臨時,搖擺"}]}],"固定作用":[{"b":"ㄍㄨˋ ㄉㄧㄥˋ ㄗㄨㄛˋ ㄩㄥˋ","p":"gù dìng zuò yòng","d":[{"f":"穩定、平衡的作用。","e":["如：「墊上一塊石頭有固定作用。」"]}]}],"固定匯率":[{"b":"ㄍㄨˋ ㄉㄧㄥˋ ㄏㄨㄟˋ ㄌㄩˋ","p":"gù dìng huì lǜ","d":[{"f":"不同貨幣間之兌換乃根據比例協定，或允許在一定上下限幅度內波動的匯率。"}]}],"固定成本":[{"b":"ㄍㄨˋ ㄉㄧㄥˋ ㄔㄥˊ ㄅㄣˇ","p":"gù dìng chéng běn","d":[{"f":"不隨著產品的產量或某一作業活動的數量而變動的成本。相對於變動成本而言。如房租費用、借款利息、財產稅等。"}]}],"固定格式":[{"b":"ㄍㄨˋ ㄉㄧㄥˋ ㄍㄜˊ ㄕˋ","p":"gù dìng gé shì","d":[{"f":"有一定的規格或式樣。","e":["如：「公文有固定格式，不可隨興書寫。」"]}]}],"固定液":[{"b":"ㄍㄨˋ ㄉㄧㄥˋ ㄧㄝˋ","p":"gù dìng yè","d":[{"f":"固定活細胞和組織的化學溶液。可將組織的蛋白質變性、沉澱或連結而達到固定的目的，是保存標本或製作切片標本時所必須使用的液體。"}]}],"固定詞組":[{"b":"ㄍㄨˋ ㄉㄧㄥˋ ㄘˊ ㄗㄨˇ","p":"gù dìng cí zǔ","d":[{"f":"兩個或兩個以上的詞緊密結合，而句法功能相當於一個詞的詞組。常見的有專有名詞和成語，如中華民國、千鈞一髮。"}]}],"固定資本":[{"b":"ㄍㄨˋ ㄉㄧㄥˋ ㄗ ㄅㄣˇ","p":"gù dìng zī běn","d":[{"f":"可用於連續生產並多次使用的實體資本，如廠房、機器、工具等，而與債券、股票、存款、現金、金塊等「流動資本」對稱。參見「流動資本」條。","a":"流動資本"}]}],"固定資產":[{"b":"ㄍㄨˋ ㄉㄧㄥˋ ㄗ ㄔㄢˇ","p":"gù dìng zī chǎn","d":[{"f":"企業為製造、銷售、運輸、管理上所需而購置的一切必要不動產、廠房及設備。主要以長期使用為目的，不在短期內變賣。"}]}],"固定重音":[{"b":"ㄍㄨˋ ㄉㄧㄥˋ ㄓㄨㄥˋ ㄧㄣ","p":"gù dìng zhòng yīn","d":[{"f":"一種詞中的重音。指將重音固定在詞的某一個音節上。如捷克語、拉脫維亞語的重音在詞的第一個音節上，而法語和維吾爾語的重音則在詞的末一個音節上。"}]}],"固宜":[{"b":"ㄍㄨˋ ㄧˊ","p":"gù yí","d":[{"f":"