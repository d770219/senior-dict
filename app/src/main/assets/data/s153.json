{"亹":[{"b":"ㄇㄣˊ","p":"mén","d":[{"f":"地名用字。如大陸地區青海省的亹源縣。","t":"名"}]},{"b":"ㄨㄟˇ","p":"wěi","d":[{"f":"參見「亹亹」條。"}]}],"亹亹":[{"b":"ㄨㄟˇ ㄨㄟˇ","p":"wěi wěi","d":[{"f":"連續而不倦怠。"},{"f":"往前進的樣子。"}]}],"亹亹不倦":[{"b":"ㄨㄟˇ ㄨㄟˇ ㄅㄨˋ ㄐㄩㄢˋ","p":"wěi wěi bù juàn","d":[{"f":"連續而不倦怠。宋．周煇《清波雜志》卷三：「譚熙豐間舊事，亹亹不倦。」也作「亹亹不卷」。"}]}],"亹亹不卷":[{"b":"ㄨㄟˇ ㄨㄟˇ ㄅㄨˋ ㄐㄩㄢˋ","p":"wěi wěi bù juàn","d":[{"f":"連續而不倦怠。南朝梁．鍾嶸《詩品．卷上．晉黃門郎張協》：「調彩蔥蒨，音韻鏗鏘，使人味之，亹亹不卷。」也作「亹亹不倦」。"}]}],"偉":[{"b":"ㄨㄟˇ","p":"wěi","d":[{"f":"奇異的。","t":"形"},{"f":"盛壯、卓越。","t":"形","e":["如：「偉績」、「豐功偉業」。"]},{"f":"高大。","t":"形"},{"f":"姓。如漢代有偉璋。","t":"名"}]}],"偉丈夫":[{"b":"ㄨㄟˇ ㄓㄤˋ ㄈㄨ","p":"wěi zhàng fū","d":[{"f":"軀幹高大的人。","e":["如：「他心胸磊落，氣宇不凡，真是人中偉丈夫。」"],"a":"矮小子"},{"f":"志行超群特出的男子漢。"}]}],"偉人":[{"b":"ㄨㄟˇ ㄖㄣˊ","p":"wěi rén","d":[{"f":"偉大的人物。","a":"常人,庸人,凡人"}]}],"偉器":[{"b":"ㄨㄟˇ ㄑㄧˋ","p":"wěi qì","d":[{"f":"特異卓越的才器。"}]}],"偉大":[{"b":"ㄨㄟˇ ㄉㄚˋ","p":"wěi dà","d":[{"f":"高超、盛大。","e":["如：「偉大的貢獻」。"],"s":"宏大,宏壯,壯偉","a":"眇小,渺小,平凡,平庸,藐小"},{"f":"巨大、魁梧。"}]}],"偉岸":[{"b":"ㄨㄟˇ ㄢˋ","p":"wěi àn","d":[{"f":"壯大奇偉的樣子。","s":"魁梧,魁偉"}]}],"偉懋":[{"b":"ㄨㄟˇ ㄇㄠˋ","p":"wěi mào","d":[{"f":"盛大。"}]}],"偉晶岩":[{"b":"ㄨㄟˇ ㄐㄧㄥ ㄧㄢˊ","p":"wěi jīng yán","d":[{"f":"粗大礦物結晶的火成岩，一般由石英、雲母及正長石等礦物晶體組成，也稱為「偉晶花崗岩」。"}]}],"偉服":[{"b":"ㄨㄟˇ ㄈㄨˊ","p":"wěi fú","d":[{"f":"盛服。"}]}],"偉業":[{"b":"ㄨㄟˇ ㄧㄝˋ","p":"wěi yè","d":[{"f":"卓著的功績。如：「豐功偉業」。也作「偉績」。"}]}],"偉績":[{"b":"ㄨㄟˇ ㄐㄧ","p":"wěi jī","d":[{"f":"卓著的功績。如：「豐功偉績」。也作「偉業」。"}]}],"偉麗":[{"b":"ㄨㄟˇ ㄌㄧˋ","p":"wěi lì","d":[{"f":"壯美、英俊。"}]}],"卩":[{"b":"ㄐㄧㄝˊ","p":"jié","d":[{"f":"古代一種代表身分與權力的信物。","t":"名"},{"f":"二一四部首之一。","t":"名"}]}],"堙":[{"b":"ㄧㄣ","p":"yīn","d":[{"f":"填塞。","t":"動"},{"f":"埋沒、泯滅。","t":"動"},{"f":"土山。","t":"名"}]}],"堙曖":[{"b":"ㄧㄣ ㄞˋ","p":"yīn ài","d":[{"f":"埋藏隱晦。"}]}],"堙滅":[{"b":"ㄧㄣ ㄇㄧㄝˋ","p":"yīn miè","d":[{"f":"埋沒。"}]}],"堙窒":[{"b":"ㄧㄣ ㄓˋ","p":"yīn zhì","d":[{"f":"堵塞不通。"}]}],"峉":[{"b":"ㄜ","p":"ē","d":[{"f":"山勢高大的樣子。","t":"形"}]}],"忩":[{"b":"","p":"","d":[{"f":"「匆」的異體字。"}]}],"按":[{"b":"ㄢˋ","p":"àn","d":[{"f":"用手向下壓。","t":"動","e":["如：「按電鈴」。"]},{"f":"抑止、擱置。","t":"動","e":["如：「按兵不動」。"]},{"f":"依照。","t":"動","e":["如：「按照」、「按圖索驥」。"]},{"f":"撫、扶。","t":"動"},{"f":"巡行。","t":"動"},{"f":"考察。","t":"動"},{"f":"彈奏。","t":"動"},{"f":"文章中編者經研究考查後，所作的說明或判斷。如：「按語」。也作「案」。","t":"名"},{"f":"姓。如元代有按攤。","t":"名"}]}],"按下":[{"b":"ㄢˋ ㄒㄧㄚˋ","p":"àn xià","d":[{"f":"壓下。","e":["如：「按下鍵鈕」。"]}]}],"按例":[{"b":"ㄢˋ ㄌㄧˋ","p":"àn lì","d":[{"f":"按照往例、舊例。","s":"照例"}]}],"按兵":[{"b":"ㄢˋ ㄅㄧㄥ","p":"àn bīng","d":[{"f":"止兵不動。《商君書．農戰》：「興兵而伐，必取；按兵不伐，必富。」漢．阮瑀〈為曹公作書與孫權〉：「是故按兵守次，遣書致意。」也作「案兵」。"}]}],"按兵不動":[{"b":"ㄢˋ ㄅㄧㄥ ㄅㄨˋ ㄉㄨㄥˋ","p":"àn bīng bù dòng","d":[{"f":"暫時停住軍事行動，有觀望形勢的意思。今也指有任務卻不採取行動。《三國演義》第一一回：「於是傳檄三寨，且按兵不動，遣人齎書以達曹操。」《文明小史》第五九回：「幕府裡面子上雖含糊答應，暗地裡卻給他個按兵不動。」也作「按兵不舉」、「案兵不動」。","a":"聞風而動,揮軍進擊,傾巢出動"}]}],"按兵不舉":[{"b":"ㄢˋ ㄅㄧㄥ ㄅㄨˋ ㄐㄩˇ","p":"àn bīng bù jǔ","d":[{"f":"暫時止住軍事行動，有觀望形勢之意。今也指有任務卻不採取行動。《孤本元明雜劇．開詔救忠．第三折》：「你將那忠臣良將故贓謀，想著你按兵不舉心更毒。」《封神演義》第四回：「西伯侯姬昌好生可惡！今按兵不舉，坐觀成敗。」也作「按兵不動」、「案兵不動」。"}]}],"按分比例":[{"b":"ㄢˋ ㄈㄣ ㄅㄧˇ ㄌㄧˋ","p":"àn fēn bǐ lì","d":[{"f":"將已知數按一定的比例而分配之。"}]}],"按劍":[{"b":"ㄢˋ ㄐㄧㄢˋ","p":"àn jiàn","d":[{"f":"以手撫劍。"}]}],"按名責實":[{"b":"ㄢˋ ㄇㄧㄥˊ ㄗㄜˊ ㄕˊ","p":"àn míng zé shí","d":[{"f":"依照名稱以要求其與實際一致。"}]}],"按問":[{"b":"ㄢˋ ㄨㄣˋ","p":"àn wèn","d":[{"f":"考查審問。《漢書．卷八二．王商傳》：「商部屬按問，鳳以曉商曰：『災異天事，非人力所為。』」《宋史．卷二八三．王欽若傳》：「謂言欽若擅去官守，命御史中丞薛映就第按問。」也作「按治」。"}]}],"按圖索驥":[{"b":"ㄢˋ ㄊㄨˊ ㄙㄨㄛˇ ㄐㄧˋ","p":"àn tú suǒ jì","d":[{"f":"按照圖象尋求好馬。語本《漢書．卷六七．梅福傳》：「今不循伯者之道，乃欲以三代選舉之法取當時之士，猶察伯樂之圖，求騏驥於市，而不可得，亦已明矣。」後比喻做事拘泥成法，呆板不知變通。元．袁桷〈示從子瑛〉詩：「隔竹引龜心有想，按圖索驥術難靈。」","a":"無跡可尋"},{"f":"按照線索尋找、探求。比喻掌握線索，易於辦事。"}]}],"按堵如故":[{"b":"ㄢˋ ㄉㄨˇ ㄖㄨˊ ㄍㄨˋ","p":"àn dǔ rú gù","d":[{"f":"依序排列像牆堵一樣。形容百姓安居樂業，一如往昔。"}]}],"按壓":[{"b":"ㄢˋ ㄧㄚ","p":"àn yā","d":[{"f":"壓制。"},{"f":"公文案牘遭擱置。","e":["如：「這件公文被按壓了一個月。」"]}]}],"按家伏業":[{"b":"ㄢˋ ㄐㄧㄚ ㄈㄨˊ ㄧㄝˋ","p":"àn jiā fú yè","d":[{"f":"專心處理家務。","e":["如：「她姐妹倆一個按家伏業，一個叱吒商場，都很令人稱讚。」"]}]}],"按察":[{"b":"ㄢˋ ㄔㄚˊ","p":"àn chá","d":[{"f":"巡察、稽查。"}]}],"按察使":[{"b":"ㄢˋ ㄔㄚˊ ㄕˇ","p":"àn chá shǐ","d":[{"f":"職官名。唐置，明清以按察使為一省司法長官，掌刑名按劾之事。"}]}],"按彊助弱":[{"b":"ㄢˋ ㄑㄧㄤˊ ㄓㄨˋ ㄖㄨㄛˋ","p":"àn qiáng zhù ruò","d":[{"f":"抑制豪強，扶助弱小。","e":["如：「他平生最好打抱不平，按彊助弱維護正義。」"]}]}],"按手":[{"b":"ㄢˋ ㄕㄡˇ","p":"àn shǒu","d":[{"f":"一種宗教儀式。基督教中受職或受賜時，尊貴者按手於人頭頂上的儀式。"}]}],"按捺":[{"b":"ㄢˋ ㄋㄚˋ","p":"àn nà","d":[{"f":"抑止、忍耐。《清平山堂話本．刎頸鴛鴦會》：「氣得按捺不下，打一磚去。」《老殘遊記》第一七回：「翠環此時按捺不住，料想一定凶多吉少，不覺含淚跪到人瑞面前。」也作「按納」。","s":"抑制"}]}],"按捺不住":[{"b":"ㄢˋ ㄋㄚˋ ㄅㄨˋ ㄓㄨˋ","p":"àn nà bù zhù","d":[{"f":"無法抑制、忍耐。","e":["如：「他終於按捺不住胸中的怒氣而大發雷霆。」"]}]}],"按摩":[{"b":"ㄢˋ ㄇㄛˊ","p":"àn mó","d":[{"f":"對身體作敲、打、揉、搓等動作，以放鬆肌肉，促進循環，消除疲勞或鬆弛組織黏連，稱為「按摩」。","s":"推拿"}]}],"按摩器":[{"b":"ㄢˋ ㄇㄛˊ ㄑㄧˋ","p":"àn mó qì","d":[{"f":"能對人體施予按摩，促進血液循環、鬆弛肌肉筋骨，以達到消除疲勞等功能的器具。一般分為手動式、電磁式與電動式等。"}]}],"按摩師":[{"b":"ㄢˋ ㄇㄛˊ ㄕ","p":"àn mó shī","d":[{"f":"以按摩為職業的人。"}]}],"按摩椅":[{"b":"ㄢˋ ㄇㄛˊ ㄧˇ","p":"àn mó yǐ","d":[{"f":"一種座椅式的按摩器具。"}]}],"按摩襪":[{"b":"ㄢˋ ㄇㄛˊ ㄨㄚˋ","p":"àn mó wà","d":[{"f":"一種具按摩效用，能促進足部血液循環的醫療用襪子。"}]}],"按日":[{"b":"ㄢˋ ㄖˋ","p":"àn rì","d":[{"f":"每日。","e":["如：「按日計酬」。"]}]}],"按時":[{"b":"ㄢˋ ㄕˊ","p":"àn shí","d":[{"f":"準時、依時。","s":"定時,準時,守時","a":"誤期"}]}],"按月":[{"b":"ㄢˋ ㄩㄝˋ","p":"àn yuè","d":[{"f":"每月，按照月分。","e":["如：「他按月繳納電話費。」"]}]}],"按期":[{"b":"ㄢˋ ㄑㄧˊ","p":"àn qí","d":[{"f":"如期、按照規定的期限。","e":["如：「按期歸還」、「按期完工」。"],"s":"定期"}]}],"按檔兒":[{"b":"ㄢˋ ㄉㄤˇㄦ","p":"àn dǎngr ","d":[{"f":"按照次序。"}]}],"按次":[{"b":"ㄢˋ ㄘˋ","p":"àn cì","d":[{"f":"依照次序。","e":["如：「按次就坐」。"],"s":"依次"}]}],"按殺":[{"b":"ㄢˋ ㄕㄚ","p":"àn shā","d":[{"f":"壓置。《三國志平話．卷下》：「軍師大驚，怎敢奏帝，把此事按殺。」也作「案殺」。"}]}],"按照":[{"b":"ㄢˋ ㄓㄠˋ","p":"àn zhào","d":[{"f":"依照、遵照。","e":["如：「工程師按照說明書的指示操作機器。」"],"s":"根據,遵循,遵照,依照","a":"違背"}]}],"按牛頭吃不得草":[{"b":"ㄢˋ ㄋㄧㄡˊ ㄊㄡˊ ㄔ ㄅㄨˋ ㄉㄜˊ ㄘㄠˇ","p":"àn niú tóu chī bù dé cǎo","d":[{"f":"用強硬脅迫的手段是達不到目的的。"}]}],"按理":[{"b":"ㄢˋ ㄌㄧˇ","p":"àn lǐ","d":[{"f":"審訊處理。"},{"f":"按照道理、常理。"}]}],"按甲休兵":[{"b":"ㄢˋ ㄐㄧㄚˇ ㄒㄧㄡ ㄅㄧㄥ","p":"àn jiǎ xiū bīng","d":[{"f":"放下鎧甲和兵器，停止作戰。《漢書．卷三四．韓信傳》：「當今之計，不如按甲休兵。」明．崔時佩、李景雲《西廂記》第一三齣：「將軍可按甲休兵，退一箭之地。」也作「按甲寢兵」。"}]}],"按甲寢兵":[{"b":"ㄢˋ ㄐㄧㄚˇ ㄑㄧㄣˇ ㄅㄧㄥ","p":"àn jiǎ qǐn bīng","d":[{"f":"放下鎧甲和兵器，停止作戰。漢．傅幹〈諫曹公南征〉：「愚以為可且按甲寢兵，息軍養士。」也作「按甲休兵」。"}]}],"按納":[{"b":"ㄢˋ ㄋㄚˋ","p":"àn nà","d":[{"f":"抑止、忍耐。《董西廂》卷三：「君瑞心頭怒發，忿得來七上八下。煩惱身心怎按納？誦篤篤地酩子裡罵。」《警世通言．卷二五．桂員外途窮懺悔》：「施還此時怒氣填胸，一點無明火按納不住。」也作「按捺」。"},{"f":"捉摸。"}]}],"按脈":[{"b":"ㄢˋ ㄇㄞˋ","p":"àn mài","d":[{"f":"診察脈象的方法。以食、中、無名三指指端按在被檢查者的橈動脈上，探查脈象的變化。也作「把脈」。"}]}],"按著三板一眼":[{"b":"ㄢˋ ˙ㄓㄜ ㄙㄢ ㄅㄢˇ ㄧ ㄧㄢˇ","p":"àn zhe sān bǎn yī yǎn","d":[{"f":"比喻說話或行事有板有眼，井然有序。"}]}],"按著葫蘆摳子":[{"b":"ㄢˋ ˙ㄓㄜ ㄏㄨˊ ˙ㄌㄨ ㄎㄡ ˙ㄗ","p":"àn zhe hú lu kōu zi","d":[{"f":"比喻絲毫不放鬆。"}]}],"按討":[{"b":"ㄢˋ ㄊㄠˇ","p":"àn tǎo","d":[{"f":"依罪加以討伐。"}]}],"按語":[{"b":"ㄢˋ ㄩˇ","p":"àn yǔ","d":[{"f":"作者對作品的相關內容所做的說明、評論或考證等。《清史稿．卷一六．仁宗本紀》：「館臣呈進敕修明鑑，於萬曆、天啟載入先朝開創之事，又加按語頌揚，於體例均為未合。」也作「案語」。"}]}],"按說":[{"b":"ㄢˋ ㄕㄨㄛ","p":"àn shuō","d":[{"f":"按照情理來說。","e":["如：「這次考試的題目並不難，按說大家應該會考得不錯才對。」"]}]}],"按調":[{"b":"ㄢˋ ㄉㄧㄠˋ","p":"àn diào","d":[{"f":"按照曲調、調式。"}]}],"按資排輩":[{"b":"ㄢˋ ㄗ ㄆㄞˊ ㄅㄟˋ","p":"àn zī pái bèi","d":[{"f":"按照資歷、年齡等條件排定職務的方式。"}]}],"按轡":[{"b":"ㄢˋ ㄆㄟˋ","p":"àn pèi","d":[{"f":"勒住馬韁。《漢書．卷四〇．周勃傳》：「亞夫乃傳言開壁門，壁門士請車騎曰：『將軍約，軍中不得驅馳。』於是天子乃按轡徐行。」《初刻拍案驚奇》卷三：「只見後頭有一人奔馬趕來，遇著東山的騾，便按轡少駐。」也作「案轡」。"}]}],"按部就班":[{"b":"ㄢˋ ㄅㄨˋ ㄐㄧㄡˋ ㄅㄢ","p":"àn bù jiù bān","d":[{"f":"原指巡查所轄的部屬，歸入所屬的班列。語本《文選．陸機．文賦》：「然後選義按部，考辭就班。」後引申指作文章時，依照文義、安排章節，並將確切的詞句放在適當位置；亦可指做事依照一定的層次、條理。《歧路燈》第九九回：「我一發勞動小相公大筆，寫個書名簽兒，按部就班，以便觀書者指名以求，售書者認簽而給。」《兒女英雄傳》第四〇回：「他那個兒子，只按部就班的，也就作到公卿，正用不著到那等地方去名外圖利。」","s":"循序漸進","a":"躐等躁進"}]}],"按酒":[{"b":"ㄢˋ ㄐㄧㄡˇ","p":"àn jiǔ","d":[{"f":"下酒的菜餚。元．劉唐卿《降桑椹》第一折：「我早間分付下興兒，著他買些新鮮的按酒稀奇果品。」《西遊記》第四一回：「那唐僧與你做得師父，也與我做得按酒，你還思量要他哩。」也作「案酒」。"}]}],"按鈕":[{"b":"ㄢˋ ㄋㄧㄡˇ","p":"àn niǔ","d":[{"f":"啟閉開關的按鍵。"}]}],"按鈴申告":[{"b":"ㄢˋ ㄌㄧㄥˊ ㄕㄣ ㄍㄠˋ","p":"àn líng shēn gào","d":[{"f":"向法院按鈴提出告訴。類似中國古代的擊鼓鳴冤。今各地方法院檢察處門口都設有申告鈴，被害人及其他有告訴權人均可向法院按鈴申告，由值日檢察官開庭並作筆錄，只要是合法告訴，法院一定受理。"}]}],"按鍵":[{"b":"ㄢˋ ㄐㄧㄢˋ","p":"àn jiàn","d":[{"f":"琴、打字機或其他機器上設定功能、可以按動的鍵鈕。","e":["如：「熱水瓶上的按鍵，太小的小孩子不能讓她隨便按壓，否則熱水流出，會被燙傷。」"]},{"f":"按壓按鍵。","e":["如：「熱水瓶可以按鍵取水，非常方便。」"]}]}],"按音":[{"b":"ㄢˋ ㄧㄣ","p":"àn yīn","d":[{"f":"弦樂器按弦或管樂器按孔所生的音樂，均稱為「按音」。"}]}],"按驗":[{"b":"ㄢˋ ㄧㄢˋ","p":"àn yàn","d":[{"f":"驗覈其事，而治其罪。《漢書．卷九〇．酷吏傳．嚴延年傳》：「事下御史丞按驗，有此數事，以結延年，坐怨望非謗政治不道棄市。」也作「案驗」。"}]}],"按鷹":[{"b":"ㄢˋ ㄧㄥ","p":"àn yīng","d":[{"f":"試鷹、馴鷹。"}]}],"撙":[{"b":"ㄗㄨㄣˇ","p":"zǔn","d":[{"f":"節省、縮減。","t":"動","e":["如：「撙節開支」。"]},{"f":"抑制、壓制。","t":"動"}]}],"撙撙":[{"b":"ㄗㄨㄣˇ ㄗㄨㄣˇ","p":"zǔn zǔn","d":[{"f":"相聚合的樣子。"}]}],"撙省":[{"b":"ㄗㄨㄣˇ ˙ㄕㄥ","p":"zǔn sheng","d":[{"f":"節省。","e":["如：「這筆錢是省吃儉用撙省出來的。」"]}]}],"撙節":[{"b":"ㄗㄨㄣˇ ㄐㄧㄝˊ","p":"zǔn jié","d":[{"f":"約束、抑制。","a":"浪費,濫用"},{"f":"節省、節約。"}]}],"撙詘":[{"b":"ㄗㄨㄣˇ ㄑㄩ","p":"zǔn qū","d":[{"f":"卑屈、謙抑。"}]}],"撙銜":[{"b":"ㄗㄨㄣˇ ㄒㄧㄢˊ","p":"zǔn xián","d":[{"f":"勒住馬韁，使馬就範。"}]}],"枹":[{"b":"ㄅㄠ","p":"bāo","d":[{"f":"參見「枹木」條。"}]},{"b":"ㄈㄨ","p":"fū","d":[{"f":"(一)之又音。"}]},{"b":"ㄈㄨˊ","p":"fú","d":[{"f":"鼓槌。","t":"名"}]}],"枹木":[{"b":"ㄅㄠ ㄇㄨˋ","p":"bāo mù","d":[{"f":"植物名。殼斗科麻櫟屬，落葉喬木。葉互生，橢圓狀卵形至倒卵形，長七至十七公分，粗鋸齒緣。花單性，雌雄同株。雄花黃白色，排列成細長下垂柔荑花序，雌花生於杯狀的總苞內。堅果橢圓形，長八至二十公厘。種子可製澱粉，樹皮可作染料。"}]}],"枹鼓":[{"b":"ㄈㄨˊ ㄍㄨˇ","p":"fú gǔ","d":[{"f":"古代戰陣所用的戰鼓，後代指戰爭或軍旅。"},{"f":"鼓槌和鼓。"},{"f":"盜案發生時，用來示警之鼓。"}]}],"枹鼓相應":[{"b":"ㄈㄨˊ ㄍㄨˇ ㄒㄧㄤ ㄧㄥˋ","p":"fú gǔ xiāng yìng","d":[{"f":"用鼓槌擊鼓，鼓就發出聲音。比喻極力響應，緊密配合。"}]}],"汩":[{"b":"ㄍㄨˇ","p":"gǔ","d":[{"f":"亂。","t":"動"},{"f":"埋沒、消滅。","t":"動"},{"f":"水急流的樣子。","t":"副"}]},{"b":"ㄩˋ","p":"yù","d":[{"f":"急速。","t":"形"},{"f":"潔淨。","t":"形"}]}],"汩亂":[{"b":"ㄍㄨˇ ㄌㄨㄢˋ","p":"gǔ luàn","d":[{"f":"濁亂。"}]}],"汩徂":[{"b":"ㄩˋ ㄘㄨˊ","p":"yù cú","d":[{"f":"急行。"}]}],"汩汩":[{"b":"ㄍㄨˇ ㄍㄨˇ","p":"gǔ gǔ","d":[{"f":"擬聲詞。形容波浪聲。"},{"f":"比喻文思勃發。"},{"f":"水急流的樣子。比喻事情演進不已。"}]}],"汩沒":[{"b":"ㄍㄨˇ ㄇㄛˋ","p":"gǔ mò","d":[{"f":"沉淪。"},{"f":"浮沉。"},{"f":"埋沒。"},{"f":"形容水波的聲音。"},{"f":"淹沒。"}]}],"汩流":[{"b":"ㄩˋ ㄌㄧㄡˊ","p":"yù liú","d":[{"f":"急流。"}]}],"汩起":[{"b":"ㄍㄨˇ ㄑㄧˇ","p":"gǔ qǐ","d":[{"f":"湧起。"}]}],"汩越":[{"b":"ㄩˋ ㄩㄝˋ","p":"yù yuè","d":[{"f":"光彩亮麗的樣子。"},{"f":"水流湍急的樣子。"}]}],"淹":[{"b":"ㄧㄢ","p":"yān","d":[{"f":"浸漬。","t":"動"},{"f":"滯留、停留。","t":"動"},{"f":"水分長時間附著在皮膚上，而令人感覺不舒服。","t":"動","e":["如：「胳肢窩被汗淹得難受。」"]},{"f":"深入、精通。","t":"副"}]},{"b":"ㄧㄢˋ","p":"yàn","d":[{"f":"浸沒。","t":"動","e":["如：「醃菜時要讓水淹過菜來。」"]}]}],"淹博":[{"b":"ㄧㄢ ㄅㄛˊ","p":"yān bó","d":[{"f":"淵博。"}]}],"淹宿":[{"b":"ㄧㄢ ㄙㄨˋ","p":"yān sù","d":[{"f":"留待隔天。"}]}],"淹恤":[{"b":"ㄧㄢ ㄒㄩˋ","p":"yān xù","d":[{"f":"長年落難，流亡異地。"}]}],"淹旬曠月":[{"b":"ㄧㄢ ㄒㄩㄣˊ ㄎㄨㄤˋ ㄩㄝˋ","p":"yān xún kuàng yuè","d":[{"f":"淹，滯留。曠，荒廢。淹旬曠月指荒廢拖延時日。"}]}],"淹晷":[{"b":"ㄧㄢ ㄍㄨㄟˇ","p":"yān guǐ","d":[{"f":"長久、長時間。"}]}],"淹月":[{"b":"ㄧㄢ ㄩㄝˋ","p":"yān yuè","d":[{"f":"經月，整個月。"}]}],"淹死":[{"b":"ㄧㄢ ㄙˇ","p":"yān sǐ","d":[{"f":"溺死。","s":"滅頂,溺死"}]}],"淹殺":[{"b":"ㄧㄢ ㄕㄚ","p":"yān shā","d":[{"f":"沉入水中溺死。"}]}],"淹水":[{"b":"ㄧㄢ ㄕㄨㄟˇ","p":"yān shuǐ","d":[{"f":"被水覆蓋。","e":["如：「都市的排水系統若不健全，下雨時便容易淹水。」"]}]}],"淹沉":[{"b":"ㄧㄢ ㄔㄣˊ","p":"yān chén","d":[{"f":"沉溺。"}]}],"淹沒":[{"b":"ㄧㄢ ㄇㄛˋ","p":"yān mò","d":[{"f":"被水遮蓋。","e":["如：「大水淹沒稻田。」"],"s":"泯沒","a":"留存"},{"f":"蹧踐埋沒。","e":["如：「淹沒人才」。"]},{"f":"消失。"}]}],"淹淹一息":[{"b":"ㄧㄢ ㄧㄢ ㄧ ㄒㄧˊ","p":"yān yān yī xí","d":[{"f":"僅存微弱的一口氣。形容生命或事物已到了最後時刻。《儒林外史》第一回：「他母親淹淹一息，歸天去了。」也作「一息奄奄」、「奄奄一息」。"}]}],"淹滅":[{"b":"ㄧㄢ ㄇㄧㄝˋ","p":"yān miè","d":[{"f":"消失、磨滅。","e":["如：「赤壁古戰場的遺跡，早已在人們的記憶中逐漸淹滅。」"]}]}],"淹滯":[{"b":"ㄧㄢ ㄓˋ","p":"yān zhì","d":[{"f":"人才埋沒未顯，陸沉下僚。"},{"f":"長年流離漂泊。"}]}],"淹潤":[{"b":"ㄧㄢ ㄖㄨㄣˋ","p":"yān rùn","d":[{"f":"柔和、溫順。"}]}],"淹灌":[{"b":"ㄧㄢ ㄍㄨㄢˋ","p":"yān guàn","d":[{"f":"一種灌溉田地的方法。在田地蓄水以供農作物根部吸收。例如水稻耕種。"}]}],"淹煎":[{"b":"ㄧㄢ ㄐㄧㄢ","p":"yān jiān","d":[{"f":"久病纏身而飽受折磨、煎熬。明．賈仲名《蕭淑蘭》第三折：「病淹煎苦被東風禁，淚連綿惟把春衫滲。」明．湯顯祖《牡丹亭》第一〇齣：「淹煎，潑殘生，除問天。」也作「懨煎」。"}]}],"淹留":[{"b":"ㄧㄢ ㄌㄧㄡˊ","p":"yān liú","d":[{"f":"久留、逗留。《楚辭．屈原．離騷》：「時繽紛其變易兮，又何可以淹留。」《西遊記》第二七回：「他取經心重，那裡肯淹留，無已，遂行。」也作「逗留」、「逗遛」、「奄留」。","s":"滯留"},{"f":"挽留。"},{"f":"緩慢。"}]}],"淹纏":[{"b":"ㄧㄢ ˙ㄔㄢ","p":"yān chan","d":[{"f":"久病不癒，病情延宕。"}]}],"淹識":[{"b":"ㄧㄢ ㄕˋ","p":"yān shì","d":[{"f":"博識、精通。"}]}],"淹貫":[{"b":"ㄧㄢ ㄍㄨㄢˋ","p":"yān guàn","d":[{"f":"博通、深通。"}]}],"淹踐":[{"b":"ㄧㄢ ˙ㄐㄧㄢ","p":"yān jian","d":[{"f":"北平方言。蹧蹋、埋沒。","e":["如：「好好的東西讓你給淹踐了。」"]}]}],"淹通":[{"b":"ㄧㄢ ㄊㄨㄥ","p":"yān tōng","d":[{"f":"深通、精通。"},{"f":"弘大通達。"}]}],"淹雅":[{"b":"ㄧㄢ ㄧㄚˇ","p":"yān yǎ","d":[{"f":"學識淵博，人品寬宏儒雅。"}]}],"澉":[{"b":"ㄍㄢˇ","p":"gǎn","d":[{"f":"參見「澉浦」條。","t":"名"},{"f":"姓。如明代有澉仁亮。","t":"名"}]}],"澉浦":[{"b":"ㄍㄢˇ ㄆㄨˇ","p":"gǎn pǔ","d":[{"f":"鄉鎮名。在浙江省海鹽縣東南。南臨杭州灣，明朝時為對外貿易港。"}]}],"焙":[{"b":"ㄅㄟˋ","p":"bèi","d":[{"f":"用微火加熱使東西乾燥。","t":"動","e":["如：「烘焙」、「焙茶」。"]}]}],"焙乾":[{"b":"ㄅㄟˋ ㄍㄢ","p":"bèi gān","d":[{"f":"以傳熱較慢的載體慢速加熱的烘乾方式，可分天然晒乾和文火烤乾。","e":["如：「在醫學裡，利用容器以小火使藥材去除潮氣而不失去藥效的一種烘乾方法，就稱為焙乾。」"]}]}],"焙粉":[{"b":"ㄅㄟˋ ㄈㄣˇ","p":"bèi fěn","d":[{"f":"由碳酸氫鈉（小蘇打）混合酒石酸和澱粉而成，可用來製麵包等麵食。"}]}],"焙茶":[{"b":"ㄅㄟˋ ㄔㄚˊ","p":"bèi chá","d":[{"f":"用火烘製茶葉。"}]}],"琹":[{"b":"","p":"","d":[{"f":"「琴」的異體字。"}]}],"穹":[{"b":"ㄑㄩㄥ","p":"qiōng","d":[{"f":"窮盡。","t":"動"},{"f":"高大。","t":"形","e":["如：「穹石」。"]},{"f":"深。","t":"形"},{"f":"中間隆起四邊下垂的樣子。","t":"形"},{"f":"天空。","t":"名","e":["如：「蒼穹」、「清穹」。"]}]},{"b":"ㄑㄩㄥˊ","p":"qióng","d":[{"f":"(一)之又音。"}]}],"穹壤":[{"b":"ㄑㄩㄥ ㄖㄤˇ","p":"qiōng rǎng","d":[{"f":"天地。"}]}],"穹天":[{"b":"ㄑㄩㄥ ㄊㄧㄢ","p":"qiōng tiān","d":[{"f":"蒼天。"}]}],"穹廬":[{"b":"ㄑㄩㄥ ㄌㄨˊ","p":"qiōng lú","d":[{"f":"蒙古人所住的氈帳，中央隆起，四周下垂，形狀似天，因而稱為「穹廬」。"},{"f":"因匈奴多住穹廬，故以穹廬為匈奴的代稱。"}]}],"穹石":[{"b":"ㄑㄩㄥ ㄕˊ","p":"qiōng shí","d":[{"f":"大石頭。"}]}],"穹窒":[{"b":"ㄑㄩㄥ ㄓˋ","p":"qiōng zhì","d":[{"f":"堵塞洞穴。"},{"f":"鼠穴。"}]}],"穹窿":[{"b":"ㄑㄩㄥ ㄌㄨㄥˊ","p":"qiōng lóng","d":[{"f":"指天。"},{"f":"形容像天四周低垂而中間隆起的樣子。","e":["如：「遼闊的蒙古草原上，牛羊低頭吃草，綴點著一個個白色穹窿的帳篷，景色十分美麗。」"]}]}],"穹蒼":[{"b":"ㄑㄩㄥ ㄘㄤ","p":"qiōng cāng","d":[{"f":"蒼天。《詩經．大雅．桑柔》：「靡有旅力，以念穹蒼。」《三國演義》第一〇三回：「漢書尺素，上告穹蒼：伏望天慈，府垂鑒聽。」也作「穹冥」。"}]}],"穹谷":[{"b":"ㄑㄩㄥ ㄍㄨˇ","p":"qiōng gǔ","d":[{"f":"幽深的山谷。"}]}],"穹隆":[{"b":"ㄑㄩㄥ ㄌㄨㄥˊ","p":"qiōng lóng","d":[{"f":"像天中央高而四周下垂的形狀。《文選．陸機．挽歌詩三首之二》：「旁薄立四極，穹隆放蒼天。」也作「穹窿」。"},{"f":"長而曲折的樣子。"}]}],"穹靈":[{"b":"ㄑㄩㄥ ㄌㄧㄥˊ","p":"qiōng líng","d":[{"f":"天神。"}]}],"簉":[{"b":"ㄔㄡˋ","p":"chòu","d":[{"f":"(一)之又音。"}]},{"b":"ㄗㄠˋ","p":"zào","d":[{"f":"副的、附屬的。","t":"形","e":["如：「簉室」。"]}]}],"簉室":[{"b":"ㄗㄠˋ ㄕˋ","p":"zào shì","d":[{"f":"側室。","a":"髮妻,元配,正室"}]}],"簉弄":[{"b":"ㄗㄠˋ ㄋㄨㄥˋ","p":"zào nòng","d":[{"f":"小曲。"}]}],"継":[{"b":"","p":"","d":[{"f":"「繼」的異體字。"}]}],"肹":[{"b":"","p":"","d":[{"f":"「肸」的異體字。"}]}],"艉":[{"b":"ㄨㄟˇ","p":"wěi","d":[{"f":"造船工程上指船體的尾部。","t":"名"}]}],"艉垂標":[{"b":"ㄨㄟˇ ㄔㄨㄟˊ ㄅㄧㄠ","p":"wěi chuí biāo","d":[{"f":"通過船舶設計載重水線與艉柱後緣的交點而垂直於基線的直線。"}]}],"菙":[{"b":"ㄔㄨㄟˊ","p":"chuí","d":[{"f":"古代用來灼龜占卜的荊條。","t":"名"}]}],"蕩":[{"b":"ㄉㄤˋ","p":"dàng","d":[{"f":"搖動、擺動。","t":"動"},{"f":"動亂、擾亂。","t":"動"},{"f":"碰觸、衝撞。","t":"動"},{"f":"清空、去除。","t":"動"},{"f":"毀壞、敗壞。","t":"動"},{"f":"閒逛。","t":"動"},{"f":"放縱不受拘束。","t":"形","e":["如：「放蕩」、「浪蕩子」。"]},{"f":"平坦。","t":"形","e":["如：「坦蕩」。"]},{"f":"廣大無邊際。","t":"形"},{"f":"積水長草的淺水湖。","t":"名","e":["如：「魚蕩」、「蘆花蕩」。"]},{"f":"《詩經．大雅》的篇名。共八章。根據〈詩序〉：「蕩，召穆公傷周室大壞也。厲王無道，蕩蕩無綱紀文章，故作是詩也。」指假文王語氣，以彰殷人之惡，而明周人得國之正也。首章二句為：「蕩蕩上帝，下民之辟。」","t":"名"}]}],"蕩垢滌汙":[{"b":"ㄉㄤˋ ㄍㄡˋ ㄉㄧˊ ㄨ","p":"dàng gòu dí wū","d":[{"f":"清洗汙垢。"}]}],"蕩子":[{"b":"ㄉㄤˋ ㄗˇ","p":"dàng zǐ","d":[{"f":"遊子。指遠行不歸，流蕩忘返的人。《文選．古詩十九首．青青河畔草》：「昔為倡家女，今為蕩子婦。」唐．杜甫〈冬晚送長孫漸舍人歸州〉詩：「參卿休坐幄，蕩子不還鄉。」也作「宕子」。","s":"浪子"}]}],"蕩平":[{"b":"ㄉㄤˋ ㄆㄧㄥˊ","p":"dàng píng","d":[{"f":"平定寇亂。"}]}],"蕩心":[{"b":"ㄉㄤˋ ㄒㄧㄣ","p":"dàng xīn","d":[{"f":"迷亂心志。"},{"f":"放蕩恣縱之心。"}]}],"蕩志":[{"b":"ㄉㄤˋ ㄓˋ","p":"dàng zhì","d":[{"f":"排遣心志。"}]}],"蕩悠悠":[{"b":"ㄉㄤˋ ㄧㄡ ㄧㄡ","p":"dàng yōu yōu","d":[{"f":"神魂飄蕩。"}]}],"蕩散":[{"b":"ㄉㄤˋ ㄙㄢˋ","p":"dàng sàn","d":[{"f":"散盡。"}]}],"蕩析":[{"b":"ㄉㄤˋ ㄒㄧ","p":"dàng xī","d":[{"f":"離散。"}]}],"蕩析離居":[{"b":"ㄉㄤˋ ㄒㄧ ㄌㄧˊ ㄐㄩ","p":"dàng xī lí jū","d":[{"f":"人因災難而流離失所。泛指事物的離散，不歸其位。"}]}],"蕩檢踰閑":[{"b":"ㄉㄤˋ ㄐㄧㄢˇ ㄩˊ ㄒㄧㄢˊ","p":"dàng jiǎn yú xián","d":[{"f":"行為放蕩，不受禮法的約束。《兒女英雄傳》第二七回：「把他逼得房幃以內，生趣毫無，荊棘滿眼，就不免在外眠花宿柳，蕩檢踰閑。」也作「踰閑蕩檢」。"}]}],"蕩氣回腸":[{"b":"ㄉㄤˋ ㄑㄧˋ ㄏㄨㄟˊ ㄔㄤˊ","p":"dàng qì huí cháng","d":[{"f":"形容音樂或文辭感人之深。三國魏．曹丕〈大牆上蒿行〉：「女娥長歌，聲協宮商，感心動耳，蕩氣回腸。」也作「迴腸蕩氣」。","s":"勾魂攝魄"}]}],"蕩氣迴腸":[{"b":"ㄉㄤˋ ㄑㄧˋ ㄏㄨㄟˊ ㄔㄤˊ","p":"dàng qì huí cháng","d":[{"f":"形容音樂或文辭感人至深。","e":["如：「她的歌聲繞梁三日，令人蕩氣迴腸。」"]}]}],"蕩滌":[{"b":"ㄉㄤˋ ㄉㄧˊ","p":"dàng dí","d":[{"f":"洗滌。《史記．卷二四．樂書》：「天子躬於明堂臨觀，而萬民咸蕩滌邪穢，斟酌飽滿，以飾厥性。」也作「盪滌」。"}]}],"蕩漾":[{"b":"ㄉㄤˋ ㄧㄤˋ","p":"dàng yàng","d":[{"f":"振動起伏，多用於指水波、聲音。唐．李白〈惜餘春賦〉：「水蕩漾兮碧色，蘭葳蕤兮紅芳。」也作「盪漾」。","s":"飄蕩,泛動,漣漪","a":"平靜"}]}],"蕩潏":[{"b":"ㄉㄤˋ ㄐㄩㄝˊ","p":"dàng jué","d":[{"f":"搖蕩湧出。"}]}],"蕩然":[{"b":"ㄉㄤˋ ㄖㄢˊ","p":"dàng rán","d":[{"f":"全部毀壞。"}]}],"蕩然無存":[{"b":"ㄉㄤˋ ㄖㄢˊ ㄨˊ ㄘㄨㄣˊ","p":"dàng rán wú cún","d":[{"f":"原有的事物完全毀損。如：「當今社會尚功利，重物質，昔日淳樸之風已蕩然無存。」清．顧炎武《日知錄．卷八六．娶妻不娶同姓》﹕「唐人最重譜牒而五代以後則蕩然無存。」"}]}],"蕩瑕滌穢":[{"b":"ㄉㄤˋ ㄒㄧㄚˊ ㄉㄧˊ ㄏㄨㄟˋ","p":"dàng xiá dí huì","d":[{"f":"洗淨清除汙垢。","s":"除汙去垢","a":"藏垢納汙"}]}],"蕩產":[{"b":"ㄉㄤˋ ㄔㄢˇ","p":"dàng chǎn","d":[{"f":"破產、耗盡財產。","e":["如：「他沉迷於賭博，以至於傾家蕩產。」"]}]}],"蕩產傾家":[{"b":"ㄉㄤˋ ㄔㄢˇ ㄑㄧㄥ ㄐㄧㄚ","p":"dàng chǎn qīng jiā","d":[{"f":"用盡全部的家產。明．楊珽《龍膏記》第一八齣：「儘他萬千掗杷，亂國家使些奸詐，少不得蕩產傾家，能幾日妝孤做大。」也作「傾家蕩產」。"}]}],"蕩田":[{"b":"ㄉㄤˋ ㄊㄧㄢˊ","p":"dàng tián","d":[{"f":"利用圍堵方式，在湖邊據地為田，種植作物。"}]}],"蕩盡":[{"b":"ㄉㄤˋ ㄐㄧㄣˋ","p":"dàng jìn","d":[{"f":"耗盡、用光。"}]}],"蕩舟":[{"b":"ㄉㄤˋ ㄓㄡ","p":"dàng zhōu","d":[{"f":"划船。如：「昨天我和同學在碧潭蕩舟，玩得很愉快。」也作「盪舟」。","s":"划船"}]}],"蕩船":[{"b":"ㄉㄤˋ ㄔㄨㄢˊ","p":"dàng chuán","d":[{"f":"划船。","e":["如：「月夜蕩船，清風徐來，水波不興，是一大樂事！」"]}]}],"蕩蕩":[{"b":"ㄉㄤˋ ㄉㄤˋ","p":"dàng dàng","d":[{"f":"廣大。"},{"f":"平坦、平易。"},{"f":"法度廢壞的樣子。"}]}],"蕩蕩悠悠":[{"b":"ㄉㄤˋ ˙ㄉㄤ ㄧㄡ ㄧㄡ","p":"dàng dang yōu yōu","d":[{"f":"搖晃、飄流的樣子。"}]}],"蕩覆":[{"b":"ㄉㄤˋ ㄈㄨˋ","p":"dàng fù","d":[{"f":"傾覆、覆亡。"}]}],"蛹":[{"b":"ㄩㄥˇ","p":"yǒng","d":[{"f":"昆蟲類的幼蟲，長成至一定階段，即不動不食，其狀如死，形體發生變化，多為棗核形狀，於適合的環境條件下變為成蟲。","t":"名"}]}],"蛹臥":[{"b":"ㄩㄥˇ ㄨㄛˋ","p":"yǒng wò","d":[{"f":"比喻隱者蜷伏不出。"}]}],"遙":[{"b":"ㄧㄠˊ","p":"yáo","d":[{"f":"遠。","t":"形","e":["如：「遙遠」、「遙不可及」。"]},{"f":"長。","t":"形"}]}],"遙不可及":[{"b":"ㄧㄠˊ ㄅㄨˋ ㄎㄜˇ ㄐㄧˊ","p":"yáo bù kě jí","d":[{"f":"距離遙遠無法到達，不可希冀。","e":["如：「科技的發達，月球已不再是個遙不可及的地方了。」"]}]}],"遙不可期":[{"b":"ㄧㄠˊ ㄅㄨˋ ㄎㄜˇ ㄑㄧˊ","p":"yáo bù kě qí","d":[{"f":"歷時久遠，無法期待。","e":["如：「十年的時間好像遙不可期，其實一眨眼就過了。」"]}]}],"遙地裡":[{"b":"ㄧㄠˊ ㄉㄧˋ ㄌㄧˇ","p":"yáo dì lǐ","d":[{"f":"四處。"}]}],"遙夜":[{"b":"ㄧㄠˊ ㄧㄝˋ","p":"yáo yè","d":[{"f":"漫長的夜晚。唐．方干〈陽亭言事獻漳州于使君〉詩：「平明疏磬白雲寺，遙夜孤砧紅葉村。」宋．宇文虛中〈在金日作〉詩三首之二：「遙夜沉沉滿幕霜，有時歸夢到家鄉。」也作「遙夕」。"}]}],"遙念":[{"b":"ㄧㄠˊ ㄋㄧㄢˋ","p":"yáo niàn","d":[{"f":"遐想，漫無思緒的思考。晉．陶淵明〈戊申歲六月中遇火〉詩：「中宵佇遙念，一盼周九天。」也作「遙懷」、「遙想」、「遙思」。"}]}],"遙悲":[{"b":"ㄧㄠˊ ㄅㄟ","p":"yáo bēi","d":[{"f":"綿延不絕的悲思。"}]}],"遙感":[{"b":"ㄧㄠˊ ㄍㄢˇ","p":"yáo gǎn","d":[{"f":"近年新開發的探測技術，對遠距離的事物進行偵測或產生感應。參見「遙感探測」條。"}]}],"遙感探測":[{"b":"ㄧㄠˊ ㄍㄢˇ ㄊㄢˋ ㄘㄜˋ","p":"yáo gǎn tàn cè","d":[{"f":"一種從遠距離觀測物體的技術。由飛機或衛星，攜帶照相機、多譜掃描器或雷達等感測器，在空中向地面照相，以研究地面的情況，亦可觀測雲層或外太空星體等。"}]}],"遙憶":[{"b":"ㄧㄠˊ ㄧˋ","p":"yáo yì","d":[{"f":"回想遙遠的人、事、物。","e":["如：「而今人事全非，我只能在此流連徘徊，遙憶當年。」"]}]}],"遙拜":[{"b":"ㄧㄠˊ ㄅㄞˋ","p":"yáo bài","d":[{"f":"長距離的向某地、或某人行拜禮。"}]}],"遙控":[{"b":"ㄧㄠˊ ㄎㄨㄥˋ","p":"yáo kòng","d":[{"f":"在操作器和欲控制的遠端系統間不受距離限制進行操控的機制。","e":["如：「紅外線遙控電視機」。"]},{"f":"比喻主事者不在現場，而透過電訊或代理人操控。","e":["如：「董事長雖不在國內，但每天透過電話遙控公司業務。」"]}]}],"遙控器":[{"b":"ㄧㄠˊ ㄎㄨㄥˋ ㄑㄧˋ","p":"yáo kòng qì","d":[{"f":"發送訊號進行遠端控制的裝置。"}]}],"遙控飛機":[{"b":"ㄧㄠˊ ㄎㄨㄥˋ ㄈㄟ ㄐㄧ","p":"yáo kòng fēi jī","d":[{"f":"利用磁力、音波、電波、電力等，並透過無線電路的遙控器，作遠端控制飛行的模型飛機。","e":["如：「每逢星期假日，小陳都會帶兒子去公園玩遙控飛機。」"]}]}],"遙望":[{"b":"ㄧㄠˊ ㄨㄤˋ","p":"yáo wàng","d":[{"f":"遠眺。《文選．宋玉．高唐賦》：「中阪遙望，玄木冬榮。」《初刻拍案驚奇》卷二七：「遙望林木之中，有屋宇露出來。」也作「遙矚」。"}]}],"遙測":[{"b":"ㄧㄠˊ ㄘㄜˋ","p":"yáo cè","d":[{"f":"一種從遠距離觀測物體的技術。參見「遙感探測」條。"}]}],"遙測影像":[{"b":"ㄧㄠˊ ㄘㄜˋ ㄧㄥˇ ㄒㄧㄤˋ","p":"yáo cè yǐng xiàng","d":[{"f":"遙測載具所攝製的影像。"}]}],"遙測技術":[{"b":"ㄧㄠˊ ㄘㄜˋ ㄐㄧˋ ㄕㄨˋ","p":"yáo cè jì shù","d":[{"f":"一種探測技術。參見「遙感探測」條。"}]}],"遙相應和":[{"b":"ㄧㄠˊ ㄒㄧㄤ ㄧㄥˋ ㄏㄜˋ","p":"yáo xiāng yìng hè","d":[{"f":"相隔遙遠，卻仍互相照應、配合。"}]}],"遙祭":[{"b":"ㄧㄠˊ ㄐㄧˋ","p":"yáo jì","d":[{"f":"遙遙向著遠方祭祀。","e":["如：「遙祭黃陵」。"]}]}],"遙裔":[{"b":"ㄧㄠˊ ㄧˋ","p":"yáo yì","d":[{"f":"世代間隔久遠的後代子孫。"}]}],"遙見":[{"b":"ㄧㄠˊ ㄐㄧㄢˋ","p":"yáo jiàn","d":[{"f":"遠遠看見。"}]}],"遙遙":[{"b":"ㄧㄠˊ ㄧㄠˊ","p":"yáo yáo","d":[{"f":"悠久的時間。"},{"f":"長遠的距離。"}]}],"遙遙無期":[{"b":"ㄧㄠˊ ㄧㄠˊ ㄨˊ ㄑㄧˊ","p":"yáo yáo wú qí","d":[{"f":"沒有確定的日期，表示希望渺茫。","a":"指日可待,為期不遠"}]}],"遙遙相對":[{"b":"ㄧㄠˊ ㄧㄠˊ ㄒㄧㄤ ㄉㄨㄟˋ","p":"yáo yáo xiāng duì","d":[{"f":"遠遠相望。"}]}],"遙遙華胄":[{"b":"ㄧㄠˊ ㄧㄠˊ ㄏㄨㄚˊ ㄓㄡˋ","p":"yáo yáo huá zhòu","d":[{"f":"距今時代久遠的名人的後代。"}]}],"遙遙領先":[{"b":"ㄧㄠˊ ㄧㄠˊ ㄌㄧㄥˇ ㄒㄧㄢ","p":"yáo yáo lǐng xiān","d":[{"f":"絕對的領先優勢。","e":["如：「跑在最前面的二號選手，一馬當先，已遙遙領先其他選手。」"]}]}],"遙遠":[{"b":"ㄧㄠˊ ㄩㄢˇ","p":"yáo yuǎn","d":[{"f":"形容時、空的差距很大。","s":"迢遙,遼遠","a":"鄰近,眼前,附近"}]}],"遙郡":[{"b":"ㄧㄠˊ ㄐㄩㄣˋ","p":"yáo jùn","d":[{"f":"宋代稱非正階的副官為「遙郡」。"}]}],"遙隔":[{"b":"ㄧㄠˊ ㄍㄜˊ","p":"yáo gé","d":[{"f":"遠遠的相隔著。"}]}],"遙領":[{"b":"ㄧㄠˊ ㄌㄧㄥˇ","p":"yáo lǐng","d":[{"f":"自遠處遙遙監督、控制。"}]}],"釩":[{"b":"ㄈㄢˊ","p":"fán","d":[{"f":"（vanadium，V)化學元素。原子序23。為銀白色的金屬，具延展性。主要以化合物形式存在礦石中。用於釩鋼的製造，可提高硬度及強度。","t":"名"}]}],"隙":[{"b":"ㄒㄧˋ","p":"