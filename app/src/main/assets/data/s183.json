":[{"b":"ㄨㄟˊ","p":"wéi","d":[{"f":"植物名：(1)紫萁科紫萁屬，多年生草本，高五十至八十公分。葉叢生，有孢子葉與營養葉之分，營養葉三角狀卵形，二回羽狀複葉，小羽片全緣，游離脈；孢子葉全部或部分羽片著生孢子囊。幼嫩時可供食用，多生於山野向陽草地。也稱為「紫萁」。(2)豆科蠶豆屬，「苕子」、「大巢菜」之古稱，參見「苕子」條。","t":"名"}]}],"薇蕨":[{"b":"ㄨㄟˊ ㄐㄩㄝˊ","p":"wéi jué","d":[{"f":"薇與蕨，貧人所常採食的野菜。"}]}],"袧":[{"b":"ㄍㄡ","p":"gōu","d":[{"f":"古代一種兩側有縐摺的喪服。","t":"名"}]}],"遷":[{"b":"ㄑㄧㄢ","p":"qiān","d":[{"f":"變換地方。","t":"動","e":["如：「遷居」、「遷移」。"]},{"f":"改變、轉移。","t":"動","e":["如：「見異思遷」、「事過境遷」。"]},{"f":"晉升。","t":"動"},{"f":"貶謫、降職。","t":"動"},{"f":"被貶的。","t":"形","e":["如：「遷客騷人」。"]}]}],"遷人":[{"b":"ㄑㄧㄢ ㄖㄣˊ","p":"qiān rén","d":[{"f":"被迫遷移搬家的人。"}]}],"遷化":[{"b":"ㄑㄧㄢ ㄏㄨㄚˋ","p":"qiān huà","d":[{"f":"更改變化。"},{"f":"死亡。"}]}],"遷善":[{"b":"ㄑㄧㄢ ㄕㄢˋ","p":"qiān shàn","d":[{"f":"改過向善。"}]}],"遷善改過":[{"b":"ㄑㄧㄢ ㄕㄢˋ ㄍㄞˇ ㄍㄨㄛˋ","p":"qiān shàn gǎi guò","d":[{"f":"改正過失，走上正途。"}]}],"遷善遠罪":[{"b":"ㄑㄧㄢ ㄕㄢˋ ㄩㄢˇ ㄗㄨㄟˋ","p":"qiān shàn yuǎn zuì","d":[{"f":"改過向善而遠離罪愆。"}]}],"遷喬":[{"b":"ㄑㄧㄢ ㄑㄧㄠˊ","p":"qiān qiáo","d":[{"f":"賀人升遷或搬家。參見「喬遷」條。"}]}],"遷喬之望":[{"b":"ㄑㄧㄢ ㄑㄧㄠˊ ㄓ ㄨㄤˋ","p":"qiān qiáo zhī wàng","d":[{"f":"有高升的希望。"}]}],"遷客":[{"b":"ㄑㄧㄢ ㄎㄜˋ","p":"qiān kè","d":[{"f":"因罪而流徙他鄉的人。"}]}],"遷客騷人":[{"b":"ㄑㄧㄢ ㄎㄜˋ ㄙㄠ ㄖㄣˊ","p":"qiān kè sāo rén","d":[{"f":"遷客，因罪而流徙他鄉的人。騷人，詩人。遷客騷人泛指失意的文人。"}]}],"遷就":[{"b":"ㄑㄧㄢ ㄐㄧㄡˋ","p":"qiān jiù","d":[{"f":"不顧己意或事理之宜而委曲求全。","s":"將就","a":"固執"}]}],"遷居":[{"b":"ㄑㄧㄢ ㄐㄩ","p":"qiān jū","d":[{"f":"遷移住所。","s":"搬家,搬遷,搬場,喬遷,徙遷"}]}],"遷延":[{"b":"ㄑㄧㄢ ㄧㄢˊ","p":"qiān yán","d":[{"f":"形容徘徊不前。","s":"拖延"},{"f":"拖延。"},{"f":"恣意徜徉。"}]}],"遷徙":[{"b":"ㄑㄧㄢ ㄒㄧˇ","p":"qiān xǐ","d":[{"f":"搬移、遷移。","s":"遷移"},{"f":"更改、改變。"}]}],"遷徙自由":[{"b":"ㄑㄧㄢ ㄒㄧˇ ㄗˋ ㄧㄡˊ","p":"qiān xǐ zì yóu","d":[{"f":"人民在本國領域內，有往來旅行及變更住所的自由權。遷徙自由為人民的基本權利，受憲法保障。"}]}],"遷怒":[{"b":"ㄑㄧㄢ ㄋㄨˋ","p":"qiān nù","d":[{"f":"把怒氣發洩在不相干的人、事、物上。"}]}],"遷思迴慮":[{"b":"ㄑㄧㄢ ㄙ ㄏㄨㄟˊ ㄌㄩˋ","p":"qiān sī huí lǜ","d":[{"f":"反覆的思考。"}]}],"遷斥":[{"b":"ㄑㄧㄢ ㄔˋ","p":"qiān chì","d":[{"f":"貶謫。"}]}],"遷染":[{"b":"ㄑㄧㄢ ㄖㄢˇ","p":"qiān rǎn","d":[{"f":"性情被習俗所潛移默化。"}]}],"遷次":[{"b":"ㄑㄧㄢ ㄘˋ","p":"qiān cì","d":[{"f":"簡陋、狼狽的樣子。"},{"f":"倉卒、造次。"}]}],"遷正":[{"b"