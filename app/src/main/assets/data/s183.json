{"f":"鎗枝。","e":["如：「拿著鎗桿上戰場。」"]}]}],"鎗榴彈":[{"b":"ㄑㄧㄤ ㄌㄧㄡˊ ㄉㄢˋ","p":"qiāng liú dàn","d":[{"f":"裝於步鎗上施放的榴彈。"}]}],"鎗機":[{"b":"ㄑㄧㄤ ㄐㄧ","p":"qiāng jī","d":[{"f":"裝在機槽內，為擊發鎗彈、訂書針等的各種機械總稱。"}]}],"鎗眼":[{"b":"ㄑㄧㄤ ㄧㄢˇ","p":"qiāng yǎn","d":[{"f":"在牆壁上開的小洞，用來向外射擊。也作「槍眼」。"},{"f":"彈孔。也作「槍眼」。"}]}],"鎗筒":[{"b":"ㄑㄧㄤ ㄊㄨㄥˇ","p":"qiāng tǒng","d":[{"f":"除了鎗托以外的鎗身。","e":["如：「這桿鎗的鎗筒早已生鏽了。」"]}]}],"鎗膛":[{"b":"ㄑㄧㄤ ㄊㄤˊ","p":"qiāng táng","d":[{"f":"鎗管內面的空腔。也作「槍膛」。"}]}],"鎗鍠":[{"b":"ㄑㄧㄤ ㄏㄨㄤˊ","p":"qiāng huáng","d":[{"f":"擬聲詞。形容金屬相互撞擊聲。"}]}],"鎗靶":[{"b":"ㄑㄧㄤ ㄅㄚˇ","p":"qiāng bǎ","d":[{"f":"射擊的目標。","e":["如：「射中鎗靶」。"]}]}],"隷":[{"b":"","p":"","d":[{"f":"「隸」的異體字。"}]}],"顇":[{"b":"","p":"","d":[{"f":"「悴」的異體字。"}]}],"鳷":[{"b":"ㄓ","p":"zhī","d":[{"f":"參見「鳷鵲」條。"}]}],"鳷鵲":[{"b":"ㄓ ㄑㄩㄝˋ","p":"zhī què","d":[{"f":"動物名。鳥綱雀形目鳴禽類。額至眼前眼下，色純黑，從頭上至後頸及喉胸間呈暗濃的琉璃色，翼長五六寸，大部呈黑色，尾與翼同長，嘴長寸許。"},{"f":"漢朝的宮觀。在甘泉宮，武帝時所建。"}]}],"麇":[{"b":"ㄐㄩㄣ","p":"jūn","d":[{"f":"動物名。即獐。哺乳綱偶蹄目。似鹿而小，無角。性機警，善跳躍。","t":"名"}]},{"b":"ㄑㄩㄣˊ","p":"qún","d":[{"f":"成群。","t":"副","e":["如：「麇集」。"]}]}],"麇聚":[{"b":"ㄑㄩㄣˊ ㄐㄩˋ","p":"qún jù","d":[{"f":"群集。","e":["如：「湖邊時有牛羊麇聚喝水。」"]}]}],"麇至":[{"b":"ㄑㄩㄣˊ ㄓˋ","p":"qún zhì","d":[{"f":"成群而來。"}]}],"麇至沓來":[{"b":"ㄑㄩㄣˊ ㄓˋ ㄊㄚˋ ㄌㄞˊ","p":"qún zhì tà lái","d":[{"f":"形容接連不斷的到來。《花月痕》第一回：「自登甲科，入仕版，蛇神牛鬼，麇至沓來。」也作「紛沓而來」、「紛至沓來」。"}]}],"麇集":[{"b":"ㄑㄩㄣˊ ㄐㄧˊ","p":"qún jí","d":[{"f":"群集、聚集。","e":["如：「飼料一撒下去，魚兒麇集爭食。」"],"s":"密集,聚集"}]}],"麇集蜂萃":[{"b":"ㄑㄩㄣˊ ㄐㄧˊ ㄈㄥ ㄘㄨㄟˋ","p":"qún jí fēng cuì","d":[{"f":"麇集，群集。蜂萃，如蜂之聚集。麇集蜂萃謂成群聚集。","e":["如：「高雄港口終年有各式輪船麇集蜂萃。」"]}]}]}