n shuò","d":[{"f":"健壯魁武。","e":["如：「體格健碩」。"],"a":"羸弱"}]}],"健筆":[{"b":"ㄐㄧㄢˋ ㄅㄧˇ","p":"jiàn bǐ","d":[{"f":"雄健的文筆。比喻人善於為文或借指文章氣勢雄健。"}]}],"健美":[{"b":"ㄐㄧㄢˋ ㄇㄟˇ","p":"jiàn měi","d":[{"f":"人的體格和體態健康而美麗。","e":["如：「他平日注重營養，又勤於運動，因此保持了健美的身材。」"]}]}],"健羨":[{"b":"ㄐㄧㄢˋ ㄒㄧㄢˋ","p":"jiàn xiàn","d":[{"f":"本指剛強與貪欲。《史記．卷一三〇．太史公自序》：「至於大道之要，去健羨，絀聰明，釋此而任術。」裴駰集解引如淳曰：「知雄守雌，是『去健』也；不見可欲，使心不亂，是『去羨』也。」後泛指過度索求之貪念。唐．白居易〈偶作〉詩二首之二：「名無高與卑，未得多健羨；事無小與大，已得多厭賤。」"},{"f":"非常羨慕、十分仰慕。"}]}],"健胃":[{"b":"ㄐㄧㄢˋ ㄨㄟˋ","p":"jiàn wèi","d":[{"f":"使胃中消化力增強，而能多進飲食。"}]}],"健胃劑":[{"b":"ㄐㄧㄢˋ ㄨㄟˋ ㄐㄧˋ","p":"jiàn wèi jì","d":[{"f":"能增加胃部機能，預防胃病的藥。可分為刺激性、芳香性、苦味性三種。"}]}],"健舞":[{"b":"ㄐㄧㄢˋ ㄨˇ","p":"jiàn wǔ","d":[{"f":"一種唐代教坊的樂舞。舞姿剛勁，音樂多用繁弦急管。相對於軟舞而言。"}]}],"健行":[{"b":"ㄐㄧㄢˋ ㄒㄧㄥˊ","p":"jiàn xíng","d":[{"f":"以徒步方式，到郊外旅遊的活動。此種活動起源於西元一九〇一年德國費施爾中學，後流行於世界各地。"}]}],"健訟":[{"b":"ㄐㄧㄢˋ ㄙㄨㄥˋ","p":"jiàn sòng","d":[{"f":"喜好爭訟、愛打官司。"}]}],"健談":[{"b":"ㄐㄧㄢˋ ㄊㄢˊ","p":"jiàn tán","d":[{"f":"善於談論，歷久不疲。"}]}],"健起":[{"b":"ㄐㄧㄢˋ ㄑㄧˇ","p":"jiàn qǐ","d":[{"f":"精神振奮。"}]}],"健身":[{"b":"ㄐㄧㄢˋ ㄕㄣ","p":"jiàn shēn","d":[{"f":"強健身體。","e":["如：「爺爺每天清晨都會去公園打太極拳以健身。」"]}]}],"健身房":[{"b":"ㄐㄧㄢˋ ㄕㄣ ㄈㄤˊ","p":"jiàn shēn fáng","d":[{"f":"供人鍛鍊身體的房舍，內部設有各種健身器材。"}]}],"健身院":[{"b":"ㄐㄧㄢˋ ㄕㄣ ㄩㄢˋ","p":"jiàn shēn yuàn","d":[{"f":"設有各種運動器材，供人鍛鍊身體的地方。"}]}],"凵":[{"b":"ㄎㄢˇ","p":"kǎn","d":[{"f":"同「坎」。","t":"名"},{"f":"二一四部首之一。","t":"名"}]}],"唕":[{"b":"ㄗㄠˋ","p":"zào","d":[{"f":"參見「囉唕」條。"}]}],"嚥":[{"b":"ㄧㄢˋ","p":"yàn","d":[{"f":"吞食。","t":"動","e":["如：「狼吞虎嚥」、「細嚼慢嚥」。"]}]}],"嚥下":[{"b":"ㄧㄢˋ ㄒㄧㄚˋ","p":"yàn xià","d":[{"f":"吞下。","e":["如：「他個性剛烈，要嚥下這口氣，實在比登天還難。」"]}]}],"嚥住":[{"b":"ㄧㄢˋ ㄓㄨˋ","p":"yàn zhù","d":[{"f":"屏息不出聲。"}]}],"嚥唾":[{"b":"ㄧㄢˋ ㄊㄨㄛˋ","p":"yàn tuò","d":[{"f":"吞嚥口水。即垂涎之意。"}]}],"嚥氣":[{"b":"ㄧㄢˋ ㄑㄧˋ","p":"yàn qì","d":[{"f":"人死氣絕。","e":["如：「他從水裡救起來時，已經嚥氣了。」"]},{"f":"吞氣。道家的一種養生法。"}]}],"嚥氣症":[{"b":"ㄧㄢˋ ㄑㄧˋ ㄓㄥˋ","p":"yàn qì zhèng","d":[{"f":"病人無意識中吞嚥空氣的症狀。常發生於神經疾病或歇斯底里的患者，易引起胃腸擴張和障礙。"}]}],"嚥苦吞甘":[{"b":"ㄧㄢˋ ㄎㄨˇ ㄊㄨㄣ ㄍㄢ","p":"yàn kǔ tūn gān","d":[{"f":"形容吃盡了各種甘苦，極為艱辛。"}]}],"堵":[{"b":"ㄉㄨˇ","p":"dǔ","d":[{"f":"牆壁。","t":"名"},{"f":"量詞。計算牆壁的單位。","t":"名","e":["如：「一堵牆」。"]},{"f":"姓。如春秋時鄭國有堵叔。","t":"名"},{"f":"阻塞。","t":"動","e":["如：「堵塞」、「堵住破洞」。"]},{"f":"以言語頂撞或遏阻別人。","t":"動"}]}],"堵人":[{"b":"ㄉㄨˇ ㄖㄣˊ","p":"dǔ rén","d":[{"f":"逼人、氣人。","e":["如：「剛才如果不是你拿話堵人，我也不會把所有的事情講出來。」"]}]}],"堵喪":[{"b":"ㄉㄨˇ ˙ㄙㄤ","p":"dǔ sang","d":[{"f":"以言語頂撞人。也作「堵噎」。"}]}],"堵嘴":[{"b":"ㄉㄨˇ ㄗㄨㄟˇ","p":"dǔ zuǐ","d":[{"f":"比喻不讓人說話或使人沒法開口。","e":["如：「檢察官提出確切的證據，讓他堵嘴，無法再狡辯。」"]}]}],"堵塞":[{"b":"ㄉㄨˇ ㄙㄜˋ","p":"dǔ sè","d":[{"f":"阻塞不通。","e":["如：「每到上、下班時間，城裡的交通都會嚴重堵塞，車子幾乎動彈不得。」"],"a":"疏通,暢通"}]}],"堵得慌":[{"b":"ㄉㄨˇ ˙ㄉㄜ ㄏㄨㄤ","p":"dǔ de huāng","d":[{"f":"悶得慌。","e":["如：「他放假一週在家裡閒著堵得慌，所以約了幾位好友出外旅遊。」"]}]}],"堵心":[{"b":"ㄉㄨˇ ㄒㄧㄣ","p":"dǔ xīn","d":[{"f":"心中懊惱。","e":["如：「對於自己的一時大意，越想越堵心。」"]}]}],"堵牆":[{"b":"ㄉㄨˇ ㄑㄧㄤˊ","p":"dǔ qiáng","d":[{"f":"牆垣。"}]}],"堵門兒":[{"b":"ㄉㄨˇ ㄇㄣˊㄦ ","p":"dǔ ménr ","d":[{"f":"正當門口。"},{"f":"把門塞住了。"}]}],"堵頭":[{"b":"ㄉㄨˇ ㄊㄡˊ","p":"dǔ tóu","d":[{"f":"棺材兩頭的板。"}]}],"孕":[{"b":"ㄩㄣˋ","p":"yùn","d":[{"f":"懷胎。","t":"動"},{"f":"培養。","t":"動"},{"f":"包含。","t":"動","e":["如：「包孕」、「孕含」。"]}]}],"孕吐":[{"b":"ㄩㄣˋ ㄊㄨˋ","p":"yùn tù","d":[{"f":"懷孕初期所發生的食慾異常、嘔吐現象。"}]}],"孕婦":[{"b":"ㄩㄣˋ ㄈㄨˋ","p":"yùn fù","d":[{"f":"懷有身孕的女子。","s":"妊婦"}]}],"孕婦走獨木橋":[{"b":"ㄩㄣˋ ㄈㄨˋ ㄗㄡˇ ㄉㄨˊ ㄇㄨˋ ㄑㄧㄠˊ","p":"yùn fù zǒu dú mù qiáo","d":[{"f":"（歇後語）挺而走險。","e":["如：「如今被情勢逼得只好像孕婦走獨木橋──挺而走險了。」"]}]}],"孕期":[{"b":"ㄩㄣˋ ㄑㄧˊ","p":"yùn qí","d":[{"f":"婦女從受孕到產出胎兒的時間。通常指自末次月經的第一日算起共二百八十日。"}]}],"孕珠":[{"b":"ㄩㄣˋ ㄓㄨ","p":"yùn zhū","d":[{"f":"比喻女子懷胎。","s":"懷胎,妊娠"}]}],"孕穗":[{"b":"ㄩㄣˋ ㄙㄨㄟˋ","p":"yùn suì","d":[{"f":"穀類作物在葉鞘內形成而尚未抽出來的花穗。"}]}],"孕育":[{"b":"ㄩㄣˋ ㄩˋ","p":"yùn yù","d":[{"f":"懷胎而生育。《後漢書．卷一〇．皇后紀下．桓帝懿獻梁皇后紀》：「后即無子，潛懷怨忌，每宮人孕育，鮮得全者。」也作「孕毓」、「孕鬻」。"},{"f":"自既存事物中，醞釀出新事物。","e":["如：「孕育革命的種子。」"]}]}],"幵":[{"b":"ㄐㄧㄢ","p":"jiān","d":[{"f":"平。","t":"形"},{"f":"漢代羌族的別支，舊居地約在今大陸地區甘肅省天水縣南。","t":"名"},{"f":"姓。如宋代有幵度。","t":"名"}]}],"晅":[{"b":"ㄒㄩㄢ","p":"xuān","d":[{"f":"日氣。","t":"名"},{"f":"晒乾。","t":"動"}]}],"楥":[{"b":"ㄒㄩㄢˋ","p":"xuàn","d":[{"f":"製鞋的木質模型。","t":"名"}]}],"楥頭":[{"b":"ㄒㄩㄢˋ ˙ㄊㄡ","p":"xuàn tou","d":[{"f":"製鞋用的木質模型。"}]}],"沅":[{"b":"ㄩㄢˊ","p":"yuán","d":[{"f":"參見「沅江」條。"}]}],"沅江":[{"b":"ㄩㄢˊ ㄐㄧㄤ","p":"yuán jiāng","d":[{"f":"河川名。湖南省巨川，有南北二源，北源出自貴州省甕安縣，即潕水，也稱為「鎮陽江」。南源為平越的豬梁江、都勻的馬尾河；合流為清水江。二水東流入湖南境，合於黔陽縣西，總稱為「沅江」，分數道入洞庭湖。兩岸多金，自常德以下可通船。"}]}],"澥":[{"b":"ㄒㄧㄝˋ","p":"xiè","d":[{"f":"伸入陸地的海。古稱渤海為「勃澥」。","t":"名"},{"f":"北平方言。指加水使糊狀物或膠狀物由稠變稀。","t":"動","e":["如：「漿糊澥了。」"]}]}],"澥谷":[{"b":"ㄒㄧㄝˋ ㄍㄨˇ","p":"xiè gǔ","d":[{"f":"崑崙山的北谷。也作「解谷」、「嶰谷」。"}]}],"瑕":[{"b":"ㄒㄧㄚˊ","p":"xiá","d":[{"f":"玉上的斑點。","t":"名","e":["如：「白璧無瑕」、「瑕不掩瑜」。"]},{"f":"過失、缺點。","t":"名"},{"f":"間隙、空隙。","t":"名"}]}],"瑕不掩瑜":[{"b":"ㄒㄧㄚˊ ㄅㄨˋ ㄧㄢˇ ㄩˊ","p":"xiá bù yǎn yú","d":[{"f":"瑕，玉的斑點。瑜，玉的光澤。瑕不掩瑜比喻事物雖有缺點，卻無損其整體的完美。"}]}],"瑕玷":[{"b":"ㄒㄧㄚˊ ㄉㄧㄢˋ","p":"xiá diàn","d":[{"f":"玉的斑點及毛病。"},{"f":"比喻缺點、過失。"}]}],"瑕瑜":[{"b":"ㄒㄧㄚˊ ㄩˊ","p":"xiá yú","d":[{"f":"瑕，玉之斑痕；瑜，玉之光彩。「瑕瑜」比喻美德與過失、優點與缺點。","e":["如：「瑕瑜互見」。"],"s":"好壞"}]}],"瑕瑜互見":[{"b":"ㄒㄧㄚˊ ㄩˊ ㄏㄨˋ ㄒㄧㄢˋ","p":"xiá yú hù xiàn","d":[{"f":"語本《禮記．聘義》：「瑕不掩瑜，瑜不掩瑕，忠也。」比喻缺點與優點自然並存。"}]}],"瑕疵":[{"b":"ㄒㄧㄚˊ ㄘ","p":"xiá cī","d":[{"f":"比喻缺點、毛病。北齊．顏之推《顏氏家訓．省事》：「或有劫持宰相瑕疵，而獲酬謝。」唐．韓愈〈進學解〉：「忘己量之所稱，指前人之瑕疵。」也作「瑕纇」。","s":"缺點"}]}],"瑕謫":[{"b":"ㄒㄧㄚˊ ㄓㄜˊ","p":"xiá zhé","d":[{"f":"比喻過失。《老子》第二七章：「善行無轍跡，善言無瑕謫。」宋．蘇軾〈追餞正輔表兄至博羅賦詩為別〉：「何時曠蕩洗瑕謫？與君歸駕相追攀。」也作「瑕讁」。"}]}],"瑕釁":[{"b":"ㄒㄧㄚˊ ㄒㄧㄣˋ","p":"xiá xìn","d":[{"f":"罅隙，可乘之機。"},{"f":"比喻過失。"}]}],"窕":[{"b":"ㄊㄧㄠˇ","p":"tiǎo","d":[{"f":"深邃。","t":"形"},{"f":"間隙、不充滿。","t":"形"},{"f":"微細、輕小。","t":"形"},{"f":"虛假、不實在。","t":"形"},{"f":"輕薄、不莊重。","t":"形"},{"f":"挑逗、誘惑。","t":"動"}]}],"窕言":[{"b":"ㄊㄧㄠˇ ㄧㄢˊ","p":"tiǎo yán","d":[{"f":"謊言，欺詐不實的話。"}]}],"綵":[{"b":"ㄘㄞˇ","p":"cǎi","d":[{"f":"五彩的絲織品。","t":"名"}]}],"綵勝":[{"b":"ㄘㄞˇ ㄕㄥˋ","p":"cǎi shèng","d":[{"f":"插於髮飾上的飾物。"}]}],"綵女":[{"b":"ㄘㄞˇ ㄋㄩˇ","p":"cǎi nǚ","d":[{"f":"宮女。"}]}],"綵棚":[{"b":"ㄘㄞˇ ㄆㄥˊ","p":"cǎi péng","d":[{"f":"慶典活動中用彩綢、樹枝等裝飾的棚子。《宋史．卷一一三．禮志十六》：「宗室親王、近列牧伯洎舊臣、宗室官，為設綵棚於左右廊廡。」宋．孟元老《東京夢華錄．卷六．正月》：「正月一日年節……州北封丘門外，及州南一帶，皆結綵棚。」也作「彩棚」。"}]}],"綵樓":[{"b":"ㄘㄞˇ ㄌㄡˊ","p":"cǎi lóu","d":[{"f":"結綵的樓臺。"}]}],"綵牌樓":[{"b":"ㄘㄞˇ ㄆㄞˊ ˙ㄌㄡ","p":"cǎi pái lou","d":[{"f":"舉行盛大慶典時以綵綢結飾的牌樓，現在多用三夾板之類的木料繪製圖案直接懸掛於牌樓上。"}]}],"綵球":[{"b":"ㄘㄞˇ ㄑㄧㄡˊ","p":"cǎi qiú","d":[{"f":"用紅色綵綢結成的球。","e":["如：「那部新娘禮車結了幾個綵球，顯得喜氣洋洋。」"]}]}],"綵筆生花":[{"b":"ㄘㄞˇ ㄅㄧˇ ㄕㄥ ㄏㄨㄚ","p":"cǎi bǐ shēng huā","d":[{"f":"比喻人才思敏捷，文章佳妙。參見「夢筆生花」條。"}]}],"綵緞":[{"b":"ㄘㄞˇ ㄉㄨㄢˋ","p":"cǎi duàn","d":[{"f":"著有五色文彩的綢緞。"}]}],"綵繒":[{"b":"ㄘㄞˇ ㄗㄥ","p":"cǎi zēng","d":[{"f":"有五色文彩的絲織品，古人有時用以寫書信。"}]}],"綵衣娛親":[{"b":"ㄘㄞˇ ㄧ ㄩˊ ㄑㄧㄣ","p":"cǎi yī yú qīn","d":[{"f":"老萊子性至孝，年七十，常著五色彩衣，作嬰兒嬉戲的樣子逗父母高興。後用以比喻孝養父母。參見「戲綵娛親」條。"}]}],"綵頭":[{"b":"ㄘㄞˇ ㄊㄡˊ","p":"cǎi tóu","d":[{"f":"吉利的徵兆。《肉蒲團》第四回：「他正在吉慶頭上，我若去偷他，使他沒有好綵頭，將來做事，就蹭蹬了。」也作「彩頭」。"}]}],"綵鳳":[{"b":"ㄘㄞˇ ㄈㄥˋ","p":"cǎi fèng","d":[{"f":"羽毛顏色五彩繽紛的鳳凰。"}]}],"綵鸞":[{"b":"ㄘㄞˇ ㄌㄨㄢˊ","p":"cǎi luán","d":[{"f":"相傳為西王母的傳書使者。"}]}],"罅":[{"b":"ㄒㄧㄚˋ","p":"xià","d":[{"f":"分開、裂開。","t":"動"},{"f":"空隙、隙縫。","t":"名","e":["如：「石罅」、「巖罅」。"]},{"f":"事情的漏洞、缺陷。","t":"名"}]}],"罅剌兒":[{"b":"ㄒㄧㄚˋ ㄌㄚˊㄦ","p":"xià lár ","d":[{"f":"裂縫、空隙。"}]}],"罅漏":[{"b":"ㄒㄧㄚˋ ㄌㄡˋ","p":"xià lòu","d":[{"f":"裂縫、漏洞。"}]}],"罅隙":[{"b":"ㄒㄧㄚˋ ㄒㄧˋ","p":"xià xì","d":[{"f":"裂縫、縫隙。","s":"漏洞,裂縫"},{"f":"缺點或劣跡。"}]}],"胕":[{"b":"ㄈㄨ","p":"fū","d":[{"f":"足。","t":"名"},{"f":"指皮膚。","t":"名"}]},{"b":"ㄈㄨˊ","p":"fú","d":[{"f":"浮腫。","t":"形"}]}],"薅":[{"b":"ㄏㄠ","p":"hāo","d":[{"f":"拔除雜草。","t":"動"},{"f":"泛指拔掉。","t":"動","e":["如：「薅鬍鬚」、「薅下幾根頭髮。」"]}]}],"薅惱":[{"b":"ㄏㄠ ㄋㄠˇ","p":"hāo nǎo","d":[{"f":"打攪、麻煩。《水滸傳》第二回：「史進歸到廳前，尋思：『這廝們大弄，必要來薅惱村坊。』」也作「蒿惱」、「蓐惱」。"},{"f":"煩惱、不悅。"}]}],"薅鋤":[{"b":"ㄏㄠ ㄔㄨˊ","p":"hāo chú","d":[{"f":"用以除草的短柄鋤頭。"}]}],"軥":[{"b":"ㄑㄩˊ","p":"qú","d":[{"f":"車軛兩邊下卷以利於繫革帶的部分。","t":"名"}]}],"軥車":[{"b":"ㄑㄩˊ ㄔㄜ","p":"qú chē","d":[{"f":"車軛向下卷曲的車。據傳為夏后氏之輅車。也作「鉤車」。"}]}],"遵":[{"b":"ㄗㄨㄣ","p":"zūn","d":[{"f":"順著、循著。","t":"動"},{"f":"依照。","t":"動","e":["如：「遵命」。"]}]}],"遵命":[{"b":"ㄗㄨㄣ ㄇㄧㄥˋ","p":"zūn mìng","d":[{"f":"遵循所指示的命令。","s":"遵從","a":"抗命,抗議"}]}],"遵大路":[{"b":"ㄗㄨㄣ ㄉㄚˋ ㄌㄨˋ","p":"zūn dà lù","d":[{"f":"《詩經．鄭風》的篇名。共二章。根據〈詩序〉：「遵大路，思君子也。」或亦指男女相愛者，其一因失和而去，其一悔而留之之詩。首章二句為：「遵大路兮，摻執子之袪兮。」"}]}],"遵奉":[{"b":"ㄗㄨㄣ ㄈㄥˋ","p":"zūn fèng","d":[{"f":"遵守奉行。","s":"稟承"}]}],"遵守":[{"b":"ㄗㄨㄣ ㄕㄡˇ","p":"zūn shǒu","d":[{"f":"謹守、服從。","s":"服從,恪守,堅守,遵照","a":"違反,違背,違犯"}]}],"遵從":[{"b":"ㄗㄨㄣ ㄘㄨㄥˊ","p":"zūn cóng","d":[{"f":"遵守依從。","e":["如：「遵從上級的指示。」"],"s":"聽命,遵命,從命","a":"違反,違背,反抗,背離,違拗"}]}],"遵循":[{"b":"ㄗㄨㄣ ㄒㄩㄣˊ","p":"zūn xún","d":[{"f":"遵守依從。","e":["如：「現代國民皆應遵循禮法，以維持社會秩序。」"],"s":"服從,遵照,按照","a":"違反,違背,背離"}]}],"遵時養晦":[{"b":"ㄗㄨㄣ ㄕˊ ㄧㄤˇ ㄏㄨㄟˋ","p":"zūn shí yǎng huì","d":[{"f":"暫時退隱，以等待時機。明．湯顯祖〈答王宇泰太史〉：「門下且宜遵時養晦，以存其真。」也作「遵養時晦」。"}]}],"遵照":[{"b":"ㄗㄨㄣ ㄓㄠˋ","p":"zūn zhào","d":[{"f":"遵奉依照。《儒林外史》第四三回：「看上臺如何批下來，我們遵照辦理就是了。」也作「遵依」。","s":"遵循,遵守,按照,依照","a":"違背,背離"}]}],"遵紬":[{"b":"ㄗㄨㄣ ㄔㄡˊ","p":"zūn chóu","d":[{"f":"貴州省遵義縣所出產的綢布。遵義地方因產槲樹，清乾隆初，知府陳玉璧乃教民育蠶繅絲織紬，其後出紬甚豐，世稱為「遵紬」。"}]}],"遵而不失":[{"b":"ㄗㄨㄣ ㄦˊ ㄅㄨˋ ㄕ","p":"zūn ér bù shī","d":[{"f":"遵守禮儀規範而不違反。"}]}],"遵行":[{"b":"ㄗㄨㄣ ㄒㄧㄥˊ","p":"zūn xíng","d":[{"f":"依從實行。","e":["如：「他決定遵行亡父的遺囑，拿到博士學位。」"]}]}],"遵辦":[{"b":"ㄗㄨㄣ ㄅㄢˋ","p":"zūn bàn","d":[{"f":"遵照辦理。","e":["如：「王先生對太太的吩咐，半開玩笑的說：『是！一切遵辦！』」"]}]}],"遵養時晦":[{"b":"ㄗㄨㄣ ㄧㄤˇ ㄕˊ ㄏㄨㄟˋ","p":"zūn yǎng shí huì","d":[{"f":"暫時退隱，以等待時機。《詩經．周頌．酌》：「於鑠王師，遵養時晦。」《舊五代史．卷二七．唐書．莊宗本紀一》：「大人當遵養時晦，以待其衰，何事輕為沮喪！」也作「遵時養晦」。"}]}],"駕":[{"b":"ㄐㄧㄚˋ","p":"jià","d":[{"f":"用牲畜拉車。","t":"動"},{"f":"乘、騎。","t":"動","e":["如：「駕鶴西歸」、「騰雲駕霧」。"]},{"f":"開動、馭駛。","t":"動","e":["如：「駕汽車」、「駕飛機」。"]},{"f":"管理、控制。","t":"動"},{"f":"超越。","t":"動","e":["如：「凌駕」。"]},{"f":"車輛的總稱。","t":"名","e":["如：「鸞駕」、「車駕」、「整駕出遊」。"]},{"f":"古時對皇帝的尊稱。","t":"名","e":["如：「護駕」、「駕崩」。"]},{"f":"對他人的敬稱。","t":"名","e":["如：「尊駕」、「擋駕」、「勞駕」、「大駕光臨」、「在此候駕」。"]}]}],"駕上人":[{"b":"ㄐㄧㄚˋ ㄕㄤˋ ㄖㄣˊ","p":"jià shàng rén","d":[{"f":"禁衛軍士。皇帝的儀衛之一。"}]}],"駕凌":[{"b":"ㄐㄧㄚˋ ㄌㄧㄥˊ","p":"jià líng","d":[{"f":"凌駕、超越。","e":["如：「只要能奮發自勵，假以時日，必能駕凌你友人的成就。」"]}]}],"駕娘":[{"b":"ㄐㄧㄚˋ ㄋㄧㄤˊ","p":"jià niáng","d":[{"f":"女撐船手。"}]}],"駕崩":[{"b":"ㄐㄧㄚˋ ㄅㄥ","p":"jià bēng","d":[{"f":"尊稱天子死亡。"}]}],"駕帖":[{"b":"ㄐㄧㄚˋ ㄊㄧㄝˋ","p":"jià tiè","d":[{"f":"明代廠衛逮捕人犯的憑據，由刑部簽發。"}]}],"駕御":[{"b":"ㄐㄧㄚˋ ㄩˋ","p":"jià yù","d":[{"f":"控制車馬的前進。","s":"控制,操縱"},{"f":"指揮、驅使。"}]}],"駕照":[{"b":"ㄐㄧㄚˋ ㄓㄠˋ","p":"jià zhào","d":[{"f":"駕駛汽機車的許可憑證。由駕駛人向公路監理機關申請登記，經考試合格後發給。","e":["如：「他終於通過考試，拿到駕照了。」"]}]}],"駕臨":[{"b":"ㄐㄧㄚˋ ㄌㄧㄣˊ","p":"jià lín","d":[{"f":"敬稱他人的光臨。","e":["如：「歡迎駕臨指導。」"],"s":"光駕,惠臨,移玉"}]}],"駕說":[{"b":"ㄐㄧㄚˋ ㄕㄨㄛ","p":"jià shuō","d":[{"f":"傳揚學說。"}]}],"駕車":[{"b":"ㄐㄧㄚˋ ㄔㄜ","p":"jià chē","d":[{"f":"用牲口拉車。現泛指開車。","e":["如：「閒來無事，他喜歡駕車到處兜風。」"]}]}],"駕輕就熟":[{"b":"ㄐㄧㄚˋ ㄑㄧㄥ ㄐㄧㄡˋ ㄕㄨˊ","p":"jià qīng jiù shú","d":[{"f":"駕著輕車走熟路。比喻對事情很熟悉，做起來很容易。","s":"輕車熟路"}]}],"駕返瑤池":[{"b":"ㄐㄧㄚˋ ㄈㄢˇ ㄧㄠˊ ㄔˊ","p":"jià fǎn yáo chí","d":[{"f":"瑤池，相傳為西王母的居所。駕返瑤池用作哀輓老年女喪的題辭。","s":"跨鶴西歸"}]}],"駕長":[{"b":"ㄐㄧㄚˋ ㄓㄤˇ","p":"jià zhǎng","d":[{"f":"尊稱操舟的人。"}]}],"駕霧騰雲":[{"b":"ㄐㄧㄚˋ ㄨˋ ㄊㄥˊ ㄩㄣˊ","p":"jià wù téng yún","d":[{"f":"乘雲霧飛行。比喻法術高強。《水滸傳》第一五回：「為因學得一家道術，亦能呼風喚雨，駕霧騰雲。」也作「騰雲駕霧」。"}]}],"駕靈":[{"b":"ㄐㄧㄚˋ ㄌㄧㄥˊ","p":"jià líng","d":[{"f":"舊時父母之喪，孝子在棺木前引導出殯的行列，稱為「駕靈」。"}]}],"駕頭":[{"b":"ㄐㄧㄚˋ ㄊㄡˊ","p":"jià tóu","d":[{"f":"帝王出行時儀仗隊中的寶座。"},{"f":"元代演帝王的雜劇稱為「駕頭」雜劇。"}]}],"駕馭":[{"b":"ㄐㄧㄚˋ ㄩˋ","p":"jià yù","d":[{"f":"操縱車馬前進。","e":["如：「新手上路，很難駕馭車子。」"],"s":"操縱"},{"f":"指揮、控制。"}]}],"駕駛":[{"b":"ㄐㄧㄚˋ ㄕˇ","p":"jià shǐ","d":[{"f":"操縱車船、飛機等交通工具。","e":["如：「駕駛汽車」。"]},{"f":"操縱車船或飛機的人。","e":["如：「正駕駛」、「副駕駛」。"]}]}],"駕駛執照":[{"b":"ㄐㄧㄚˋ ㄕˇ ㄓˊ ㄓㄠˋ","p":"jià shǐ zhí zhào","d":[{"f":"駕駛車、船、飛機等交通工具的許可憑證。一般須經考試合格後發給，分為普通、職業、國際等數種駕駛執照。"}]}],"駕駛盤":[{"b":"ㄐㄧㄚˋ ㄕˇ ㄆㄢˊ","p":"jià shǐ pán","d":[{"f":"駕駛員所把持操作的方向盤。"}]}],"駕鶴西歸":[{"b":"ㄐㄧㄚˋ ㄏㄜˋ ㄒㄧ ㄍㄨㄟ","p":"jià hè xī guī","d":[{"f":"神仙駕鶴回到西天，比喻人死。多用於輓辭。","e":["如：「靈堂裡掛著一幅駕鶴西歸的輓聯。」"]}]}],"麅":[{"b":"","p":"","d":[{"f":"「麃」的異體字。"}]}],"󰘅":[{"b":"","p":"","d":[{"f":"「兼」的異體字。"}]}]}