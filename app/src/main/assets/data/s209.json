{"刑":[{"b":"ㄒㄧㄥˊ","p":"xíng","d":[{"f":"法律上處罰罪犯方法的總稱。","t":"名","e":["如：「刑罰」、「死刑」、「徒刑」。"]},{"f":"常法、典範。","t":"名"},{"f":"殺害。","t":"動"},{"f":"取法、效法。","t":"動"},{"f":"正。","t":"動"}]}],"刑不上大夫":[{"b":"ㄒㄧㄥˊ ㄅㄨˋ ㄕㄤˋ ㄉㄚˋ ㄈㄨ","p":"xíng bù shàng dà fū","d":[{"f":"古代社會的一種執禮觀念。指刑罰不加諸大夫的身上，大夫有罪則論其輕重的法則在八議，而非刑書。"}]}],"刑事":[{"b":"ㄒㄧㄥˊ ㄕˋ","p":"xíng shì","d":[{"f":"指稱行為觸犯《刑法》或依其他法律應處以刑罰的法律事件，相對於民事的法律事件而言。"}]}],"刑事主權":[{"b":"ㄒㄧㄥˊ ㄕˋ ㄓㄨˇ ㄑㄩㄢˊ","p":"xíng shì zhǔ quán","d":[{"f":"國家在其領域範圍內，對於犯罪者予以處罰的權力，為國家主權的具體表現。"}]}],"刑事學":[{"b":"ㄒㄧㄥˊ ㄕˋ ㄒㄩㄝˊ","p":"xíng shì xué","d":[{"f":"專門研究犯罪原因及其防止方法的學科。分為犯罪原因學與刑事政策學等。"}]}],"刑事局":[{"b":"ㄒㄧㄥˊ ㄕˋ ㄐㄩˊ","p":"xíng shì jú","d":[{"f":"刑事警察局的簡稱。參見「刑事警察局」條。"}]}],"刑事案":[{"b":"ㄒㄧㄥˊ ㄕˋ ㄢˋ","p":"xíng shì àn","d":[{"f":"對於觸犯刑法或其相關法規，所進行調查或審理的案件。"}]}],"刑事犯":[{"b":"ㄒㄧㄥˊ ㄕˋ ㄈㄢˋ","p":"xíng shì fàn","d":[{"f":"為「行政犯」之相對概念，指具有特定法益侵害性的行為，依《刑法》或其他刑罰規定科予刑事責任的犯罪者。"}]}],"刑事訴訟":[{"b":"ㄒㄧㄥˊ ㄕˋ ㄙㄨˋ ㄙㄨㄥˋ","p":"xíng shì sù sòng","d":[{"f":"關於刑事案件的訴訟，為確定犯罪嫌疑人是否犯罪，以及應如何處罰所進行的一切行為。"}]}],"刑事調查":[{"b":"ㄒㄧㄥˊ ㄕˋ ㄉㄧㄠˋ ㄔㄚˊ","p":"xíng shì diào chá","d":[{"f":"對於刑事案件，根據法定程序並運用各種技術，予以偵查，以求了解犯罪事實。"}]}],"刑事警察":[{"b":"ㄒㄧㄥˊ ㄕˋ ㄐㄧㄥˇ ㄔㄚˊ","p":"xíng shì jǐng chá","d":[{"f":"以辦理犯罪預防、偵辨重大或複雜之刑事犯罪、蒐集運用重要治安情資為主要業務的警察人員。"}]}],"刑事警察局":[{"b":"ㄒㄧㄥˊ ㄕˋ ㄐㄧㄥˇ ㄔㄚˊ ㄐㄩˊ","p":"xíng shì jǐng chá jú","d":[{"f":"專辦刑事案件的最高警察機關，直屬警政署，負責處理較重大或複雜的刑事案件。"}]}],"刑事責任":[{"b":"ㄒㄧㄥˊ ㄕˋ ㄗㄜˊ ㄖㄣˋ","p":"xíng shì zé rèn","d":[{"f":"一種法律責任。因觸犯《刑法》及相關刑罰法律所定的罪名，而應接受的法律制裁及其後果。刑罰有死刑、無期徒刑、有期徒刑、拘役、罰金、褫奪公權、沒收、追徵、追繳或抵償等種類，與民事、行政或政治責任不同。"}]}],"刑于":[{"b":"ㄒㄧㄥˊ ㄩˊ","p":"xíng yú","d":[{"f":"以禮法相待。"}]}],"刑人":[{"b":"ㄒㄧㄥˊ ㄖㄣˊ","p":"xíng rén","d":[{"f":"受刑的人。"},{"f":"對人處以殺戮之刑。"},{"f":"古代的賤役大多由受過刑的人充當，故稱為「刑人」。"}]}],"刑具":[{"b":"ㄒㄧㄥˊ ㄐㄩˋ","p":"xíng jù","d":[{"f":"用來拘束犯人、逼問口供或執行刑罰的器具。如手銬、腳鐐、笞杖、夾棍、絞架等。"}]}],"刑剋":[{"b":"ㄒㄧㄥˊ ㄎㄜˋ","p":"xíng kè","d":[{"f":"術數用語。指命運中不吉、不宜而相害、相剋之處。"}]}],"刑名":[{"b":"ㄒㄧㄥˊ ㄇㄧㄥˊ","p":"xíng míng","d":[{"f":"戰國時的學派之一。主張循名責實，慎賞明罰。"},{"f":"法律。"},{"f":"職官名。古時官署中管刑事判牘的人。"},{"f":"刑罰的名稱。如主刑、從刑、拘役、罰金等。"}]}],"刑問":[{"b":"ㄒㄧㄥˊ ㄨㄣˋ","p":"xíng wèn","d":[{"f":"用刑具審問。如：「古代有以炮烙刑問犯人的酷刑。」也作「刑訊」。"}]}],"刑器":[{"b":"ㄒㄧㄥˊ ㄑㄧˋ","p":"xíng qì","d":[{"f":"古時將刑書鑄於鼎上，故稱鼎為「刑器」。"},{"f":"用刑的器具。如刀、鋸、笞、杖、械、桎等類。"}]}],"刑場":[{"b":"ㄒㄧㄥˊ ㄔㄤˊ","p":"xíng cháng","d":[{"f":"處決犯人、執行死刑的地方。"}]}],"刑官":[{"b":"ㄒㄧㄥˊ ㄍㄨㄢ","p":"xíng guān","d":[{"f":"職官名。掌理刑法的官吏。"}]}],"刑席":[{"b":"ㄒㄧㄥˊ ㄒㄧˊ","p":"xíng xí","d":[{"f":"舊時衙署中掌刑事判牘的人。"}]}],"刑庭":[{"b":"ㄒㄧㄥˊ ㄊㄧㄥˊ","p":"xíng tíng","d":[{"f":"審理刑事案件的法庭。"}]}],"刑律":[{"b":"ㄒㄧㄥˊ ㄌㄩˋ","p":"xíng lǜ","d":[{"f":"法律、刑法。"}]}],"刑憲":[{"b":"ㄒㄧㄥˊ ㄒㄧㄢˋ","p":"xíng xiàn","d":[{"f":"刑法。"},{"f":"刑罰。"}]}],"刑戮":[{"b":"ㄒㄧㄥˊ ㄌㄨˋ","p":"xíng lù","d":[{"f":"刑罰或誅戮。"}]}],"刑房":[{"b":"ㄒㄧㄥˊ ㄈㄤˊ","p":"xíng fáng","d":[{"f":"舊時掌理刑事案件的官署，為衙署中六房之一。"},{"f":"掌管刑事的官吏。"},{"f":"用刑的房子。","e":["如：「黑道幫派私設刑房是犯法的。」"]}]}],"刑政":[{"b":"ㄒㄧㄥˊ ㄓㄥˋ","p":"xíng zhèng","d":[{"f":"刑法政令。"}]}],"刑書":[{"b":"ㄒㄧㄥˊ ㄕㄨ","p":"xíng shū","d":[{"f":"泛指刑法。"},{"f":"刑部的官吏。"}]}],"刑期":[{"b":"ㄒㄧㄥˊ ㄑㄧˊ","p":"xíng qí","d":[{"f":"根據判決應服徒刑的期限。"}]}],"刑期無刑":[{"b":"ㄒㄧㄥˊ ㄑㄧˊ ㄨˊ ㄒㄧㄥˊ","p":"xíng qí wú xíng","d":[{"f":"語本《書經．大禹謨》：「汝作士，明于五刑，以刑五教，期于予治。刑期于無刑，民協于中時，乃功懋哉。」指刑罰的目的，在於教育人遵守法律，從而達到不用刑的境地。"}]}],"刑杖":[{"b":"ㄒㄧㄥˊ ㄓㄤˋ","p":"xíng zhàng","d":[{"f":"責打犯人的棍棒。"}]}],"刑案":[{"b":"ㄒㄧㄥˊ ㄢˋ","p":"xíng àn","d":[{"f":"現代法之刑事案件。"},{"f":"在傳統法之笞杖輕重罪案件。"}]}],"刑法":[{"b":"ㄒㄧㄥˊ ㄈㄚˇ","p":"xíng fǎ","d":[{"f":"關於犯罪與刑罰的法律，即規定何種行為為犯罪及其應處以如何刑罰的法律。"},{"f":"行刑、體罰。"}]}],"刑法學":[{"b":"ㄒㄧㄥˊ ㄈㄚˇ ㄒㄩㄝˊ","p":"xíng fǎ xué","d":[{"f":"以科學方法研究犯罪及刑罰的原理、原則及適用的學科。依研究方法的切入角度有比較刑法學、沿革刑法學（歷史刑法學）、注釋刑法學等。"}]}],"刑清":[{"b":"ㄒㄧㄥˊ ㄑㄧㄥ","p":"xíng qīng","d":[{"f":"斷案清明而能省卻刑罰。"}]}],"刑網":[{"b":"ㄒㄧㄥˊ ㄨㄤˇ","p":"xíng wǎng","d":[{"f":"比喻刑法。"}]}],"刑罰":[{"b":"ㄒㄧㄥˊ ㄈㄚˊ","p":"xíng fá","d":[{"f":"國家依照法律對犯罪者所實行的法律制裁。"},{"f":"比喻受苦。","e":["如：「這城市的交通已擁塞到寸步難行，出門簡直是受刑罰哪！」"]}]}],"刑臣":[{"b":"ㄒㄧㄥˊ ㄔㄣˊ","p":"xíng chén","d":[{"f":"宦官、太監。因太監須割除生殖器官，如同受刑一般，故稱為「刑臣」。"}]}],"刑警":[{"b":"ㄒㄧㄥˊ ㄐㄧㄥˇ","p":"xíng jǐng","d":[{"f":"刑事警察的簡稱。參見「刑事警察」條。"}]}],"刑警隊":[{"b":"ㄒㄧㄥˊ ㄐㄧㄥˇ ㄉㄨㄟˋ","p":"xíng jǐng duì","d":[{"f":"負責犯罪偵防工作的警察編制單位。在直轄市設有刑事警察大隊，在縣（市）設有刑事警察隊，簡稱為「刑警隊」。","s":"偵緝隊"}]}],"刑責":[{"b":"ㄒㄧㄥˊ ㄗㄜˊ","p":"xíng zé","d":[{"f":"刑罰、責罰。"}]}],"刑賞":[{"b":"ㄒㄧㄥˊ ㄕㄤˇ","p":"xíng shǎng","d":[{"f":"刑罰與功賞。"}]}],"刑辟":[{"b":"ㄒㄧㄥˊ ㄆㄧˋ","p":"xíng pì","d":[{"f":"刑法。"}]}],"刑部":[{"b":"ㄒㄧㄥˊ ㄅㄨˋ","p":"xíng bù","d":[{"f":"中國古代掌管刑法及獄訟事務的機關，屬六部之一。由隋朝開始設置，歷代因之，至清光緒時更名為法部。"}]}],"刑部尚書":[{"b":"ㄒㄧㄥˊ ㄅㄨˋ ㄕㄤˋ ㄕㄨ","p":"xíng bù shàng shū","d":[{"f":"職官名。刑部的長官，掌全國律令、刑法、徒隸等政。唐代時稱為「大秋」。"}]}],"刑錯":[{"b":"ㄒㄧㄥˊ ㄘㄨㄛˋ","p":"xíng cuò","d":[{"f":"刑罰置放不用。"}]}],"刑餘":[{"b":"ㄒㄧㄥˊ ㄩˊ","p":"xíng yú","d":[{"f":"宦官。"},{"f":"被赦的犯人。"},{"f":"受過刑罰而致身體不全的人。"}]}],"刑馬作誓":[{"b":"ㄒㄧㄥˊ ㄇㄚˇ ㄗㄨㄛˋ ㄕˋ","p":"xíng mǎ zuò shì","d":[{"f":"宰馬盟誓。古代結盟，殺馬見血，以表示守信不悔。"}]}],"刑鼎":[{"b":"ㄒㄧㄥˊ ㄉㄧㄥˇ","p":"xíng dǐng","d":[{"f":"鑄有刑典的鼎。"}]}],"唱":[{"b":"ㄔㄤˋ","p":"chàng","d":[{"f":"發出歌聲。","t":"動","e":["如：「唱歌」、「合唱」。"]},{"f":"高聲呼叫。","t":"動","e":["如：「唱名」、「唱票」。"]},{"f":"倡導。","t":"動"},{"f":"泛稱詩詞歌曲。","t":"名","e":["如：「絕唱」、「小唱」。"]}]}],"唱作":[{"b":"ㄔㄤˋ ㄗㄨㄛˋ","p":"chàng zuò","d":[{"f":"本指戲曲的唱工與做工。後泛指表演。"}]}],"唱作俱佳":[{"b":"ㄔㄤˋ ㄗㄨㄛˋ ㄐㄩˋ ㄐㄧㄚ","p":"chàng zuò jù jiā","d":[{"f":"表演生動、精采。","e":["如：「跨年晚會表演的藝人，個個唱作俱佳。」"]}]}],"唱作念打":[{"b":"ㄔㄤˋ ㄗㄨㄛˋ ㄋㄧㄢˋ ㄉㄚˇ","p":"chàng zuò niàn dǎ","d":[{"f":"戲曲上指演員的四種基本功夫：唱工、做工、念白、武打。"}]}],"唱反調":[{"b":"ㄔㄤˋ ㄈㄢˇ ㄉㄧㄠˋ","p":"chàng fǎn diào","d":[{"f":"比喻提出相反的意見或採取相反的行動。","e":["如：「你老是跟老闆唱反調，不怕被炒魷魚嗎？」"]}]}],"唱叫":[{"b":"ㄔㄤˋ ㄐㄧㄠˋ","p":"chàng jiào","d":[{"f":"高聲叫喊，吵鬧。"},{"f":"一種歌唱的形式。"}]}],"唱叫揚疾":[{"b":"ㄔㄤˋ ㄐㄧㄠˋ ㄧㄤˊ ㄐㄧˊ","p":"chàng jiào yáng jí","d":[{"f":"大聲喊叫，吵鬧。"}]}],"唱名":[{"b":"ㄔㄤˋ ㄇㄧㄥˊ","p":"chàng míng","d":[{"f":"按名冊高聲點名。"},{"f":"舊時殿試後，皇帝呼名召見登第的進士。"}]}],"唱和":[{"b":"ㄔㄤˋ ㄏㄜˋ","p":"chàng hè","d":[{"f":"唱歌時，互相應和。"},{"f":"以詩詞互相酬答。"},{"f":"互相呼應、配合。"}]}],"唱哩嗹":[{"b":"ㄔㄤˋ ㄌㄧ ㄌㄧㄢˊ","p":"chàng lī lián","d":[{"f":"唱蓮花落。"}]}],"唱喏":[{"b":"ㄔㄤˋ ㄖㄜˇ","p":"chàng rě","d":[{"f":"一面作揖，一面出聲致敬。"},{"f":"古代貴人駕車出行時，由差役前導，高聲喏喝，使人規避。"}]}],"唱好":[{"b":"ㄔㄤˋ ㄏㄠˇ","p":"chàng hǎo","d":[{"f":"喝采叫好。"},{"f":"真是、正是。宋．丘崈〈太常引．憎人虎豹守天關〉詞：「忘形尊俎，能言桃李，日日在東山，不醉有餘歡，唱好個風流謝安。」也作「暢好」。"}]}],"唱對臺戲":[{"b":"ㄔㄤˋ ㄉㄨㄟˋ ㄊㄞˊ ㄒㄧˋ","p":"chàng duì tái xì","d":[{"f":"比喻採取與對方相對的行動來相抗衡。","e":["如：「在我們舉行座談會的同時，他們也舉行性質類似的座談會，和我們大唱對臺戲。」"]}]}],"唱工":[{"b":"ㄔㄤˋ ㄍㄨㄥ","p":"chàng gōng","d":[{"f":"戲曲中指伶人的歌唱技藝。","e":["如：「這齣戲對演員的唱工是一項嚴苛的考驗。」"]}]}],"唱念":[{"b":"ㄔㄤˋ ㄋㄧㄢˋ","p":"chàng niàn","d":[{"f":"如唱歌似的高聲複誦。","e":["如：「跑堂的唱念我們點的菜色給廚房聽。」"]}]}],"唱戲":[{"b":"ㄔㄤˋ ㄒㄧˋ","p":"chàng xì","d":[{"f":"演唱戲曲。"}]}],"唱揚":[{"b":"ㄔㄤˋ ㄧㄤˊ","p":"chàng yáng","d":[{"f":"張揚。"}]}],"唱曲":[{"b":"ㄔㄤˋ ㄑㄩˇ","p":"chàng qǔ","d":[{"f":"吟唱歌曲。"}]}],"唱書":[{"b":"ㄔㄤˋ ㄕㄨ","p":"chàng shū","d":[{"f":"以弦、琴為伴奏，說唱演義小說中的故事。"}]}],"唱本":[{"b":"ㄔㄤˋ ㄅㄣˇ","p":"chàng běn","d":[{"f":"戲本、曲本的小冊子。","s":"曲稿"}]}],"唱機":[{"b":"ㄔㄤˋ ㄐㄧ","p":"chàng jī","d":[{"f":"電唱機的簡稱。參見「電唱機」條。"}]}],"唱歌":[{"b":"ㄔㄤˋ ㄍㄜ","p":"chàng gē","d":[{"f":"吟唱歌曲。"}]}],"唱段":[{"b":"ㄔㄤˋ ㄉㄨㄢˋ","p":"chàng duàn","d":[{"f":"戲曲中一段完整的唱腔。"}]}],"唱洋梆子":[{"b":"ㄔㄤˋ ㄧㄤˊ ㄅㄤ ˙ㄗ","p":"chàng yáng bāng zi","d":[{"f":"北平方言：(1)比喻大哭大鬧。如：「她一聽爸媽不肯答應她的要求，當場就唱洋梆子了。」(2)比喻大肆埋怨或訓斥。如：「把老爺子惹毛了，他又要對你大唱洋梆子了。」"}]}],"唱片":[{"b":"ㄔㄤˋ ㄆㄧㄢˋ","p":"chàng piàn","d":[{"f":"一種利用機械錄音方法記錄聲音的膠製圓片。上有細溝，放在留聲機或電唱機上旋轉時，沿著槽紋滑動的唱針尖端發生機械振動，通過唱頭還原為聲音或轉換為電信號。可分為單聲道唱片和立體聲唱片兩種。"}]}],"唱獨角戲":[{"b":"ㄔㄤˋ ㄉㄨˊ ㄐㄧㄠˇ ㄒㄧˋ","p":"chàng dú jiǎo xì","d":[{"f":"比喻一個人獨自做某一件事。","e":["如：「這件企劃案不能單靠組長一人唱獨角戲，需要大家凝聚共識，合作無間，才可順利完成。」"]}]}],"唱的":[{"b":"ㄔㄤˋ ˙ㄉㄜ","p":"chàng de","d":[{"f":"指歌女。"}]}],"唱盤":[{"b":"ㄔㄤˋ ㄆㄢˊ","p":"chàng pán","d":[{"f":"唱機上安放唱片的轉盤。一般分為四種速度，可任意調整。放聲效果的好壞，取決於轉速的穩定與否。"}]}],"唱票":[{"b":"ㄔㄤˋ ㄆㄧㄠˋ","p":"chàng piào","d":[{"f":"選舉開票時，由指定人員大聲唱出選票內所圈選的人名。"}]}],"唱空城計":[{"b":"ㄔㄤˋ ㄎㄨㄥ ㄔㄥˊ ㄐㄧˋ","p":"chàng kōng chéng jì","d":[{"f":"比喻人力空虛。","e":["如：「公司的服務臺不可唱空城計，趕緊找人來接班吧！」"]},{"f":"比喻肚子餓。","e":["如：「剛才來不及吃午餐，現在我的肚子正在唱空城計呢！」"]}]}],"唱籌量沙":[{"b":"ㄔㄤˋ ㄔㄡˊ ㄌㄧㄤˊ ㄕㄚ","p":"chàng chóu liáng shā","d":[{"f":"南朝劉宋名將檀道濟伐魏，因糧食不繼而還，加上後有追兵，故軍心渙散。道濟乃利用夜晚，叫人以沙充糧，高聲報數，假裝存糧尚足。如此一來，軍心穩定，魏兵也不敢再追。見《南史．卷一五．檀道濟傳》。後比喻製造假象，欺矇敵人。"}]}],"唱籍":[{"b":"ㄔㄤˋ ㄐㄧˊ","p":"chàng jí","d":[{"f":"按名冊點名。"}]}],"唱紅白臉":[{"b":"ㄔㄤˋ ㄏㄨㄥˊ ㄅㄞˊ ㄌㄧㄢˇ","p":"chàng hóng bái liǎn","d":[{"f":"中國古代戲曲中，紅臉代表忠貞的人物，白臉代表奸佞的人物。唱紅白臉比喻同時採取正、反兩種方法。","e":["如：「他們合唱紅白臉，終於勸動他向警察自首認罪。」"]}]}],"唱腔":[{"b":"ㄔㄤˋ ㄑㄧㄤ","p":"chàng qiāng","d":[{"f":"戲曲演員歌唱時的曲調。各地方戲曲因所使用的方言不同，其唱腔曲調亦各異其趣。每個劇種或曲種都有一定的唱腔，同一唱腔又因演員行腔的不同而形成各種流派，如京劇中有譚派、汪派及孫派等。"}]}],"唱詞":[{"b":"ㄔㄤˋ ㄘˊ","p":"chàng cí","d":[{"f":"歌曲或戲曲裡供歌唱的文字部分。"}]}],"唱詩班":[{"b":"ㄔㄤˋ ㄕ ㄅㄢ","p":"chàng shī bān","d":[{"f":"教堂裡演唱詩歌的團體。由聖職人員及一般信徒組成。"}]}],"唱論":[{"b":"ㄔㄤˋ ㄌㄨㄣˋ","p":"chàng lùn","d":[{"f":"書名。元朝燕南芝庵著，三十一節。為中國最早論述聲樂的著作。內容主要列舉宋、金、元樂曲的名目、節奏、曲式結構、流傳地區、歌唱方法和其他相關的音樂理論等。"}]}],"唱賺":[{"b":"ㄔㄤˋ ㄓㄨㄢˋ","p":"chàng zhuàn","d":[{"f":"宋代的一種說唱藝術。以兼慢曲、曲破、大曲、小唱、耍令、蕃曲、叫聲諸家的腔譜，故難度極高。"}]}],"唱遊":[{"b":"ㄔㄤˋ ㄧㄡˊ","p":"chàng yóu","d":[{"f":"唱歌和遊戲。幼稚園和國民小學常排有此項課程。"}]}],"唱針":[{"b":"ㄔㄤˋ ㄓㄣ","p":"chàng zhēn","d":[{"f":"電唱機唱頭上裝的針。藉著唱針的運轉，唱頭將音溝的振動，轉換成電的信號。可分為圓形、橢圓形及夏巴塔形(Shabata）三種。"}]}],"唱陽關":[{"b":"ㄔㄤˋ ㄧㄤˊ ㄍㄨㄢ","p":"chàng yáng guān","d":[{"f":"陽關三疊，為古人的送別曲。唱陽關比喻離別。"}]}],"唱雙簧":[{"b":"ㄔㄤˋ ㄕㄨㄤ ㄏㄨㄤˊ","p":"chàng shuāng huáng","d":[{"f":"比喻一搭一唱，彼此配合。","e":["如：「他倆唱雙簧，就想說服我一起去旅行。」"]}]}],"唱頭":[{"b":"ㄔㄤˋ ㄊㄡˊ","p":"chàng tóu","d":[{"f":"電唱機的組成器件之一。與唱臂組合成拾音器，專司檢出唱片音溝的振動，並將其轉變為電壓或電流的信號，完全左右了電唱機再生聲音的品質。就其構造與特徵可分為電磁型、壓電型、光電型、電容器型、半導體和帶型六種唱頭。"}]}],"唱題目":[{"b":"ㄔㄤˋ ㄊㄧˊ ㄇㄨˋ","p":"chàng tí mù","d":[{"f":"宋代的一種說唱伎藝，藝人在表演當場指物賦詩，稱為「唱題目」。"}]}],"唱高調":[{"b":"ㄔㄤˋ ㄍㄠ ㄉㄧㄠˋ","p":"chàng gāo diào","d":[{"f":"比喻高談不切實際的理想或言論。","e":["如：「別光只會唱高調，要功成名就還是得腳踏實地，一步一步來。」"]}]}],"囁":[{"b":"ㄋㄧㄝˋ","p":"niè","d":[{"f":"參見「呫囁」、「囁嚅」等條。"}]},{"b":"ㄓㄜˊ","p":"zhé","d":[{"f":"(一)之又音。"}]}],"囁嚅":[{"b":"ㄋㄧㄝˋ ㄖㄨˊ","p":"niè rú","d":[{"f":"有話想說又不敢說，吞吞吐吐的樣子。唐．韓愈〈送李愿歸盤谷序〉：「足將進而趦趄，口將言而囁嚅。」《初刻拍案驚奇》卷三〇：「太守幾番要問他，囁嚅數次，不敢輕易開口。」也作「囁囁嚅嚅」。"}]}],"囁囁嚅嚅":[{"b":"ㄋㄧㄝˋ ㄋㄧㄝˋ ㄖㄨˊ ㄖㄨˊ","p":"niè niè rú rú","d":[{"f":"有話想說又不敢說，吞吞吐吐的樣子。如：「他幾次想把真相告訴她，但總是囁囁嚅嚅的，不知該如何開口才好。」也作「囁嚅」。"}]}],"塑":[{"b":"ㄙㄨˋ","p":"sù","d":[{"f":"用泥土等做成人、物的形狀。","t":"動","e":["如：「泥塑」、「雕塑」。"]},{"f":"陶冶、培養。","t":"動","e":["如：「塑造形象」。"]}]}],"塑像":[{"b":"ㄙㄨˋ ㄒㄧㄤˋ","p":"sù xiàng","d":[{"f":"以黏土、油土或蠟等材料塑造而成的作品，稱為「塑像」。","s":"泥像"},{"f":"利用土、蠟、石膏等材料塑造雕像。"}]}],"塑性":[{"b":"ㄙㄨˋ ㄒㄧㄥˋ","p":"sù xìng","d":[{"f":"物體受超過其彈性限度的力作用，而造成永久形變且改變原有的彈性參數，這樣的變形叫做塑性變形。","a":"彈性"}]}],"塑性加工":[{"b":"ㄙㄨˋ ㄒㄧㄥˋ ㄐㄧㄚ ㄍㄨㄥ","p":"sù xìng jiā gōng","d":[{"f":"利用物體的塑形變性製出各種形狀的成品。相對於切削加工而言。如輥軋、擠製、抽拉、鍛造、板金工作等。"}]}],"塑料":[{"b":"ㄙㄨˋ ㄌㄧㄠˋ","p":"sù liào","d":[{"f":"樹脂等高分子化合物與配料混合，再經加熱加壓而形成的一種材料。種類很多，如聚氯乙烯、賽璐珞等。具有質輕、絕緣、耐磨、耐腐蝕等特點。多用於飛機、船舶、機械等工業，並可製造日用品。"}]}],"塑膠":[{"b":"ㄙㄨˋ ㄐㄧㄠ","p":"sù jiāo","d":[{"f":"一種以高分子聚合物為主，再加入適當添加劑的可塑性材料。此種材料可經加熱或加壓而成形。"}]}],"塑膠工業":[{"b":"ㄙㄨˋ ㄐㄧㄠ ㄍㄨㄥ ㄧㄝˋ","p":"sù jiāo gōng yè","d":[{"f":"製造塑膠產品的工業。"}]}],"塑膠布":[{"b":"ㄙㄨˋ ㄐㄧㄠ ㄅㄨˋ","p":"sù jiāo bù","d":[{"f":"以塑膠材料製成的布。生產容易，比重輕、防雨、耐腐蝕，常製成雨衣、桌巾等。"}]}],"塑膠炸彈":[{"b":"ㄙㄨˋ ㄐㄧㄠ ㄓㄚˋ ㄉㄢˋ","p":"sù jiāo zhà dàn","d":[{"f":"一種具有可塑性的高分子有機化合物炸藥。其組合成分依製造法各有不同，形態上有如黏土，可耐強壓、揉擠，甚至防水，並可依需要捏成各種形狀。除依一定程序引爆外，不會自動爆炸。引爆方式很多，一般在炸藥上插定時信管，或用遙控、電擊等，均可引炸，威力則不亞於TNT黃色炸藥。"}]}],"塑膠玻璃":[{"b":"ㄙㄨˋ ㄐㄧㄠ ㄅㄛ ˙ㄌㄧ","p":"sù jiāo bō li","d":[{"f":"以塑膠製成透明如玻璃的物體。可用來製配鏡片，代替玻璃。"}]}],"塑膠花":[{"b":"ㄙㄨˋ ㄐㄧㄠ ㄏㄨㄚ","p":"sù jiāo huā","d":[{"f":"利用塑膠材料製成的人造花。"}]}],"塑膠袋":[{"b":"ㄙㄨˋ ㄐㄧㄠ ㄉㄞˋ","p":"sù jiāo dài","d":[{"f":"以塑膠材料製成的袋子。","e":["如：「為了保護環境，請大家少用塑膠袋。」"]}]}],"塑膠貨幣":[{"b":"ㄙㄨˋ ㄐㄧㄠ ㄏㄨㄛˋ ㄅㄧˋ","p":"sù jiāo huò bì","d":[{"f":"可以代替貨幣使用的卡片。如信用卡、預付卡、轉帳卡、電話卡等。"}]}],"塑身":[{"b":"ㄙㄨˋ ㄕㄣ","p":"sù shēn","d":[{"f":"雕塑身體的曲線。"}]}],"塑造":[{"b":"ㄙㄨˋ ㄗㄠˋ","p":"sù zào","d":[{"f":"利用黏土或人造油土等材料，以按捏、加減、剷削等手法塑成人物或物體的形象。"}]}],"塑鋼":[{"b":"ㄙㄨˋ ㄍㄤ","p":"sù gāng","d":[{"f":"玻璃纖維補強塑膠。在塑膠製品中，加入玻璃纖維補強材料，由於具有鋼鐵材料的韌性，且具耐化學作用與耐熱等特性，故被稱為「塑鋼」。俗稱為FRP。重量輕於鋼板，又不會生鏽，廣泛用於遊艇外殼、汽車車體、浴缸、洗衣機外殼、水塔等。"}]}],"孱":[{"b":"ㄔㄢˊ","p":"chán","d":[{"f":"狹窄。","t":"形"},{"f":"虛弱、衰弱。","t":"形","e":["如：「孱弱」。"]},{"f":"低劣、淺陋。","t":"形"},{"f":"謹慎。","t":"副"}]},{"b":"ㄘㄢˋ","p":"càn","d":[{"f":"參見「孱頭」條。"}]}],"孱困":[{"b":"ㄔㄢˊ ㄎㄨㄣˋ","p":"chán kùn","d":[{"f":"卑劣。"},{"f":"瘦弱、虛弱。"}]}],"孱夫":[{"b":"ㄔㄢˊ ㄈㄨ","p":"chán fū","d":[{"f":"懦弱的人。"}]}],"孱弱":[{"b":"ㄔㄢˊ ㄖㄨㄛˋ","p":"chán ruò","d":[{"f":"瘦弱、虛弱。宋．文天祥〈正氣歌．序〉：「而予以孱弱，俯仰其間，於茲二年矣，幸而無恙。」《三國演義》第八五回：「嗣子孱弱，不得不以大事相託。」也作「孱羸」。","s":"羸弱,孱羸,瘦弱","a":"強健"}]}],"孱王":[{"b":"ㄔㄢˊ ㄨㄤˊ","p":"chán wáng","d":[{"f":"懦弱無能的君王。"}]}],"孱瑣":[{"b":"ㄔㄢˊ ㄙㄨㄛˇ","p":"chán suǒ","d":[{"f":"猥賤無能。宋．歐陽修〈謝進士及第啟〉：「致茲孱瑣，及此抽揚。」也作「孱微」。"}]}],"孱羸":[{"b":"ㄔㄢˊ ㄌㄟˊ","p":"chán léi","d":[{"f":"瘦弱。明．方孝孺〈栽柏〉詩：「我生素多病，中歲早孱羸。」也作「孱弱」。","s":"羸弱,孱弱,瘦弱"}]}],"孱軀":[{"b":"ㄔㄢˊ ㄑㄩ","p":"chán qū","d":[{"f":"瘦弱的身體。"}]}],"孱頭":[{"b":"ㄘㄢˋ ˙ㄊㄡ","p":"càn tou","d":[{"f":"卑怯無能的人。"}]}],"孱頭貨":[{"b":"ㄘㄢˋ ˙ㄊㄡ ㄏㄨㄛˋ","p":"càn tou huò","d":[{"f":"怯弱無能的人。","e":["如：「他自從生意失敗後，便一蹶不振，成了個孱頭貨。」"]}]}],"崁":[{"b":"ㄎㄢˇ","p":"kǎn","d":[{"f":"山崖、山谷。如「崁腳」指斷崖之下；「崁頂」指山崖之上。常用在地名。","e":["如：「南崁」、「大嵙崁」。"]}]}],"怡":[{"b":"ㄧˊ","p":"yí","d":[{"f":"和悅的。","t":"形","e":["如：「心曠神怡」。"]},{"f":"快樂的。","t":"形"},{"f":"姓。如北周有怡峰。","t":"名"}]}],"怡堂燕雀":[{"b":"ㄧˊ ㄊㄤˊ ㄧㄢˋ ㄑㄩㄝˋ","p":"yí táng yàn què","d":[{"f":"燕雀爭處堂上，灶火延燒至棟梁，仍怡樂自安而不變。典出《呂氏春秋．有始覽．諭大》。比喻不知禍之將至。"}]}],"怡怡":[{"b":"ㄧˊ ㄧˊ","p":"yí yí","d":[{"f":"和悅、順從的樣子。《論語．子路》：「朋友切切偲偲，兄弟怡怡。」後亦用以指兄弟的情誼。《文選．曹植．求通親親表》：「以敘骨肉之歡恩，全怡怡之篤義。」"}]}],"怡悅":[{"b":"ㄧˊ ㄩㄝˋ","p":"yí yuè","d":[{"f":"愉快、喜悅。唐．孟浩然〈秋登蘭山寄張五〉詩：「北山白雲裡，隱者自怡悅。」《儒林外史》第一〇回：「魯編修見瓶花罏儿，位置得宜，不覺怡悅。」也作「夷悅」。","s":"高興,快樂,快活,夷悅"}]}],"怡情悅性":[{"b":"ㄧˊ ㄑㄧㄥˊ ㄩㄝˋ ㄒㄧㄥˋ","p":"yí qíng yuè xìng","d":[{"f":"怡悅、陶養性情。《紅樓夢》第一七、一八回：「如今上了年紀，且案牘勞煩，於這怡情悅性文章上更生疏了。」也作「怡情理性」、「怡情養性」。"}]}],"怡情理性":[{"b":"ㄧˊ ㄑㄧㄥˊ ㄌㄧˇ ㄒㄧㄥˋ","p":"yí qíng lǐ xìng","d":[{"f":"怡悅、陶養性情。漢．徐幹《中論．卷上．治學第一》：「學也者，所以疏神達思，怡情理性，聖人之上務也。」也作「怡情養性」、「怡情悅性」。"}]}],"怡情養性":[{"b":"ㄧˊ ㄑㄧㄥˊ ㄧㄤˇ ㄒㄧㄥˋ","p":"yí qíng yǎng xìng","d":[{"f":"怡悅、陶養性情。如：「閱覽文學作品，蒔花養鳥，在在都可以怡情養性。」也作「怡情理性」、「怡情悅性」。"}]}],"怡然":[{"b":"ㄧˊ ㄖㄢˊ","p":"yí rán","d":[{"f":"欣悅自得的樣子。"}]}],"怡然自娛":[{"b":"ㄧˊ ㄖㄢˊ ㄗˋ ㄩˊ","p":"yí rán zì yú","d":[{"f":"欣悅自得的樣子。元．湯式〈一枝花．攬將天上雲套．尾聲〉：「怡然自娛，恬然自足，再不從龍化甘雨。」也作「怡然自得」。"}]}],"怡然自得":[{"b":"ㄧˊ ㄖㄢˊ ㄗˋ ㄉㄜˊ","p":"yí rán zì dé","d":[{"f":"欣悅自得的樣子。《舊唐書．卷七二．李百藥傳》：「及懸車告老，怡然自得，穿池築山，文酒談賞，以舒平生之志。」《紅樓夢》第三四回：「冥冥之中，若不怡然自得，亦可謂糊塗鬼祟矣。」也作「怡然自樂」、「怡然自足」、「怡然自娛」、「怡然自悅」。","s":"悠然自得","a":"惘然若失,局促不安"}]}],"怡然自悅":[{"b":"ㄧˊ ㄖㄢˊ ㄗˋ ㄩㄝˋ","p":"yí rán zì yuè","d":[{"f":"欣悅自得的樣子。《紅樓夢》第二一回：「便權當他們死了，毫無牽掛，反能怡然自悅。」也作「怡然自得」。"}]}],"怡然自樂":[{"b":"ㄧˊ ㄖㄢˊ ㄗˋ ㄌㄜˋ","p":"yí rán zì lè","d":[{"f":"欣悅自得的樣子。晉．陶淵明〈桃花源記〉：「黃髮垂髫，並怡然自樂。」宋．洪邁《夷堅丙志．卷二．趙縮手》：「或終日不飲食，亦怡然自樂。」也作「怡然自得」。"}]}],"怡然自足":[{"b":"ㄧˊ ㄖㄢˊ ㄗˋ ㄗㄨˊ","p":"yí rán zì zú","d":[{"f":"欣悅自得的樣子。《西湖佳話．孤山隱跡》：「三十餘年，而從無一日不怡然自足，誠甘心於隱，而非假借也。」也作「怡然自得」。"}]}],"怡聲":[{"b":"ㄧˊ ㄕㄥ","p":"yí shēng","d":[{"f":"柔和的語聲。"}]}],"怡聲下氣":[{"b":"ㄧˊ ㄕㄥ ㄒㄧㄚˋ ㄑㄧˋ","p":"yí shēng xià qì","d":[{"f":"柔和其聲音，低抑其氣息，以取悅他人。"}]}],"怡色":[{"b":"ㄧˊ ㄙㄜˋ","p":"yí sè","d":[{"f":"和悅的容色。《禮記．內則》：「父母有過，下氣怡色，柔聲以諫。」也作「怡顏」。"}]}],"怡顏":[{"b":"ㄧˊ ㄧㄢˊ","p":"yí yán","d":[{"f":"和悅的容色。《文選．陶淵明．歸去來辭》：「引壺觴以自酌，眄庭柯以怡顏。」《西遊記》第二九回：「拙女幸托坤宮，感激劬勞萬種。不能竭力怡顏，盡心奉孝。」也作「怡色」。"}]}],"怡顏悅色":[{"b":"ㄧˊ ㄧㄢˊ ㄩㄝˋ ㄙㄜˋ","p":"yí yán yuè sè","d":[{"f":"容顏和悅，心情愉快。"}]}],"憱":[{"b":"ㄘㄨˋ","p":"cù","d":[{"f":"不高興的樣子。","t":"副"}]}],"晡":[{"b":"ㄅㄨ","p":"bū","d":[{"f":"申時。約當午後三時至五時。一般泛指下午或黃昏。","t":"名"}]}],"晡夕":[{"b":"ㄅㄨ ㄒㄧˋ","p":"bū xì","d":[{"f":"傍晚、黃昏。"}]}],"晡時":[{"b":"ㄅㄨ ㄕˊ","p":"bū shí","d":[{"f":"申時。下午三點到五點。《初刻拍案驚奇》卷六：「狄氏到了這日晡食，果然盛妝而來。」也作「餔時」。"}]}],"晡食":[{"b":"ㄅㄨ ㄕˊ","p":"bū shí","d":[{"f":"吃晚餐。"}]}],"柱":[{"b":"ㄓㄨˋ","p":"zhù","d":[{"f":"屋中直立以支持梁的粗木。","t":"名"},{"f":"泛稱細長像柱形的東西。","t":"名","e":["如：「水柱」、「花柱」。"]},{"f":"琴瑟上繫弦的木條。","t":"名"},{"f":"支持。","t":"動"},{"f":"譏刺。","t":"動"}]}],"柱下史":[{"b":"ㄓㄨˋ ㄒㄧㄚˋ ㄕˇ","p":"zhù xià shǐ","d":[{"f":"職官名。周、秦時掌理天下圖書、計籍的官吏。《史記．卷九六．張丞相傳》：「秦時為御史，主柱下方書」句下唐．司馬貞．索隱：「周、秦皆有柱下史，謂御史也。所掌及侍立恆在殿柱之下，故老子為周柱下史。」後用為御史的代稱。唐．李白〈贈宣城趙太守悅〉詩：「公為柱下史，脫繡歸田園。」"}]}],"柱國":[{"b":"ㄓㄨˋ ㄍㄨㄛˊ","p":"zhù guó","d":[{"f":"國都。"},{"f":"職官名。戰國時楚所設置，原指保衛國都之宮，地位非常崇高。後世則指最高級的武官或勛官。"}]}],"柱子":[{"b":"ㄓㄨˋ ˙ㄗ","p":"zhù zi","d":[{"f":"建築物中支撐橫梁、桁架、樓板等的直立長條形構件。可用鋼筋混凝土、鋼材、磚石或木材等製成。"},{"f":"瑟、箏等撥弦樂器上的繫弦木。木製，橋形，立於瑟、箏等面板上。"}]}],"柱廊":[{"b":"ㄓㄨˋ ㄌㄤˊ","p":"zhù láng","d":[{"f":"西洋建築中，由柱子排列成的迴廊。"}]}],"柱杖":[{"b":"ㄓㄨˋ ㄓㄤˋ","p":"zhù zhàng","d":[{"f":"手杖。"}]}],"柱石":[{"b":"ㄓㄨˋ ㄕˊ","p":"zhù shí","d":[{"f":"支撐屋梁的柱子和柱下的基石。"},{"f":"比喻擔負國家重任的大臣。"}]}],"柱石之寄":[{"b":"ㄓㄨˋ ㄕˊ ㄓ ㄐㄧˋ","p":"zhù shí zhī jì","d":[{"f":"委以國家重任。"}]}],"柱石之臣":[{"b":"ㄓㄨˋ ㄕˊ ㄓ ㄔㄣˊ","p":"zhù shí zhī chén","d":[{"f":"擔負國家重任的大臣。"}]}],"柱科":[{"b":"ㄓㄨˋ ㄎㄜ","p":"zhù kē","d":[{"f":"屋柱。"}]}],"柱臣":[{"b":"ㄓㄨˋ ㄔㄣˊ","p":"zhù chén","d":[{"f":"國家的重臣。"}]}],"柱頭":[{"b":"ㄓㄨˋ ㄊㄡˊ","p":"zhù tóu","d":[{"f":"柱子的頂部。"},{"f":"雌蕊的花柱先端或近先端側面稍擴大處，是雌蕊受花粉的部位。形狀常呈膨大頭狀、圓盤狀（如百合）、羽狀（如禾本科）、或總狀（如酸模）等。"}]}],"欑":[{"b":"ㄘㄨㄢˊ","p":"cuán","d":[{"f":"聚合、拼湊。","t":"動","e":["如：「欑集」。"]}]}],"欑宮":[{"b":"ㄘㄨㄢˊ ㄍㄨㄥ","p":"cuán gōng","d":[{"f":"古代稱帝、后靈柩暫殯的地方。宋南渡後，因陵寢皆在河南，此處不過暫厝，故有此稱。《宋史．卷三〇．高宗紀七》：「以孟忠厚為樞密使，充欑宮總護使。」也作「攢宮」。"}]}],"没":[{"b":"","p":"","d":[{"f":"「沒」的異體字。"}]}],"濁":[{"b":"ㄓㄨㄛˊ","p":"zhuó","d":[{"f":"骯髒、不清潔。","t":"形","e":["如：「汙濁」、「混濁不清」。"]},{"f":"昏亂、混亂。","t":"形"},{"f":"平凡、庸俗。","t":"形"},{"f":"低沉粗重。","t":"形","e":["如：「濁聲濁氣」、「聲音重濁」。"]},{"f":"畢星的別名。","t":"名"},{"f":"姓。如漢代有濁賢。","t":"名"}]}],"濁世":[{"b":"ㄓㄨㄛˊ ㄕˋ","p":"zhuó shì","d":[{"f":"亂世。","s":"亂世"},{"f":"塵世。"}]}],"濁母":[{"b":"ㄓㄨㄛˊ ㄇㄨˇ","p":"zhuó mǔ","d":[{"f":"國音字母中屬於濁聲的聲母。如ㄇ、ㄋ、ㄖ等。"}]}],"濁氣":[{"b":"ㄓㄨㄛˊ ㄑㄧˋ","p":"zhuó qì","d":[{"f":"混濁不清之氣。"}]}],"濁水":[{"b":"ㄓㄨㄛˊ ㄕㄨㄟˇ","p":"zhuó shuǐ","d":[{"f":"不清潔的水。","a":"清水"}]}],"濁水溪":[{"b":"ㄓㄨㄛˊ ㄕㄨㄟˇ ㄒㄧ","p":"zhuó shuǐ xī","d":[{"f":"河川名。臺灣最長的溪，全長一百八十六公里。主源霧社溪，發自中央山脈合歡山南麓。因含沙量高，溪水長年混濁，故稱為「濁水溪」。"}]}],"濁流":[{"b":"ㄓㄨㄛˊ ㄌㄧㄡˊ","p":"zhuó liú","d":[{"f":"混濁的水流。","s":"汙流","a":"清流"},{"f":"比喻品格低劣的人。"}]}],"濁涇清渭":[{"b":"ㄓㄨㄛˊ ㄐㄧㄥ ㄑㄧㄥ ㄨㄟˋ","p":"zhuó jīng qīng wèi","d":[{"f":"比喻明辨是非，判別善惡。參見「清渭濁涇」條。"}]}],"濁物":[{"b":"ㄓㄨㄛˊ ㄨˋ","p":"zhuó wù","d":[{"f":"世俗凡庸的人。"}]}],"濁聲":[{"b":"ㄓㄨㄛˊ ㄕㄥ","p":"zhuó shēng","d":[{"f":"語音學上凡氣息發出成聲時顫動聲帶的輔音，稱為「濁聲」。如國音聲符中ㄇ、ㄋ、ㄖ等。"}]}],"濁聲母":[{"b":"ㄓㄨㄛˊ ㄕㄥ ㄇㄨˇ","p":"zhuó shēng mǔ","d":[{"f":"國音字母中，發音時聲帶顫動的聲母。如ㄇ、ㄋ、ㄖ等。"}]}],"濁質凡姿":[{"b":"ㄓㄨㄛˊ ㄓˊ ㄈㄢˊ ㄗ","p":"zhuó zhí fán zī","d":[{"f":"資質低下、容貌平庸。多為自謙之辭。"}]}],"濁酒":[{"b":"ㄓㄨㄛˊ ㄐㄧㄡˇ","p":"zhuó jiǔ","d":[{"f":"釀製後較混濁的酒。"}]}],"濁酒粗食":[{"b":"ㄓㄨㄛˊ ㄐㄧㄡˇ ㄘㄨ ㄕˊ","p":"zhuó jiǔ cū shí","d":[{"f":"混濁的酒和粗糙的食物。指不精緻的飲食。"}]}],"濁醪":[{"b":"ㄓㄨㄛˊ ㄌㄠˊ","p":"zhuó láo","d":[{"f":"混濁的酒。"}]}],"濁音":[{"b":"ㄓㄨㄛˊ ㄧㄣ","p":"zhuó yīn","d":[{"f":"語音學上指氣息發出成聲時振動聲帶的輔音。如國音字母ㄇ、ㄋ、ㄖ等。"}]}],"濁骨凡胎":[{"b":"ㄓㄨㄛˊ ㄍㄨˇ ㄈㄢˊ ㄊㄞ","p":"zhuó gǔ fán tāi","d":[{"f":"凡夫俗子，塵世之人。"}]}],"煑":[{"b":"","p":"","d":[{"f":"「煮」的異體字。"}]}],"狡":[{"b":"ㄐㄧㄠˇ","p":"jiǎo","d":[{"f":"奸詐。","t":"形","e":["如：「狡獪」、「狡猾」。"]},{"f":"殘暴、凶猛。","t":"形"},{"f":"貌美而無實才實德。","t":"形","e":["如：「狡婦」。"]},{"f":"急速、急促。","t":"形"}]}],"狡兔三窟":[{"b":"ㄐㄧㄠˇ ㄊㄨˋ ㄙㄢ ㄎㄨ","p":"jiǎo tù sān kū","d":[{"f":"狡猾的兔子有三處藏身的洞穴。《戰國策．齊策四》：「狡兔有三窟，僅得免其死耳。」比喻有多處藏身的地方或多種避禍的準備。《聊齋志異．卷七．邵女》：「汝狡兔三窟，何歸為？」也作「三窟狡兔」。"}]}],"狡兔死，良狗烹":[{"b":"ㄐㄧㄠˇ ㄊㄨˋ ㄙˇ ， ㄌㄧㄤˊ ㄍㄡˇ ㄆㄥ","p":"jiǎo tù sǐ ， liáng gǒu pēng","d":[{"f":"狡兔一死，獵犬即無所用，將被烹食。比喻事成後殺害有功之人。《史記．卷九二．淮陰侯傳》：「狡兔死，良狗烹；高鳥盡，良弓藏；敵國破，謀臣亡。」也作「狡兔死良犬烹」。"}]}],"狡憤":[{"b":"ㄐㄧㄠˇ ㄈㄣˋ","p":"jiǎo fèn","d":[{"f":"狂戾憤懣。"}]}],"狡猾":[{"b":"ㄐㄧㄠˇ ㄏㄨㄚˊ","p":"jiǎo huá","d":[{"f":"詭變多詐。《西遊記》第二五回：「這潑猴，雖是狡猾奸頑，卻倒有些孝意。」《初刻拍案驚奇》卷一三：「卻是為他有錢財使用，又好結識那一班慘刻狡猾沒天理的衙門中人。多只是奉承過去，那個敢與他一般見識。」也作「狡獪」。","s":"狡黠,狡詐,奸滑,油滑,圓滑","a":"誠實,老實,忠厚,純厚,正直"}]}],"狡猾多詐":[{"b":"ㄐㄧㄠˇ ㄏㄨㄚˊ ㄉㄨㄛ ㄓㄚˋ","p":"jiǎo huá duō zhà","d":[{"f":"形容人陰險詭詐。","e":["如：「這個人素來狡猾多詐，聲名狼藉。」"]}]}],"狡獪":[{"b":"ㄐㄧㄠˇ ㄎㄨㄞˋ","p":"jiǎo kuài","d":[{"f":"詭變多詐。《文明小史》第五八回：「這其間有位侯補知府叫做黃世昌的，為人極其狡獪。」也作「狡猾」。"},{"f":"開玩笑、戲言。"},{"f":"遊戲。"}]}],"狡童":[{"b":"ㄐㄧㄠˇ ㄊㄨㄥˊ","p":"jiǎo tóng","d":[{"f":"貌美而無實才的人。語出《詩經．鄭風．山有扶蘇》：「山有喬松，隰有游龍，不見子充，乃見狡童。」今泛稱浮華少年。"},{"f":"《詩經．鄭風》的篇名。共二章。根據〈詩序〉：「狡童，刺忽也。」或亦指女子斥男子相愛不終之詩。首章二句為：「彼狡童兮，不與我言兮。」"}]}],"狡蠹":[{"b":"ㄐㄧㄠˇ ㄉㄨˋ","p":"jiǎo dù","d":[{"f":"姦詐為害。"}]}],"狡計":[{"b":"ㄐㄧㄠˇ ㄐㄧˋ","p":"jiǎo jì","d":[{"f":"狡詐的計謀。","e":["如：「這個人狡計很多，你要小心應付！」"],"s":"詭計"}]}],"狡詐":[{"b":"ㄐㄧㄠˇ ㄓㄚˋ","p":"jiǎo zhà","d":[{"f":"狡猾奸詐。","a":"憨厚,忠實,誠懇,老實"}]}],"狡賴":[{"b":"ㄐㄧㄠˇ ㄌㄞˋ","p":"jiǎo lài","d":[{"f":"狡辯抵賴。","e":["如：「這個卡車司機撞死了人還想狡賴，真是沒良心！」"],"s":"狡辯","a":"承認"}]}],"狡辯":[{"b":"ㄐㄧㄠˇ ㄅㄧㄢˋ","p":"jiǎo biàn","d":[{"f":"狡猾強辯。","e":["如：「做錯事應勇於承認，而不是一味不負責任地狡辯。」"],"s":"詭辯"}]}],"狡飾":[{"b":"ㄐㄧㄠˇ ㄕˋ","p":"jiǎo shì","d":[{"f":"狡辯掩飾。","a":"坦白"}]}],"狡黠":[{"b":"ㄐㄧㄠˇ ㄒㄧㄚˊ","p":"jiǎo xiá","d":[{"f":"狡詐。《三國志．卷二八．魏書．鄧艾傳》：「逆賊姜維連年狡黠，民夷騷動，西土不寧。」也作「狡偽」。","s":"狡猾"}]}],"瑱":[{"b":"ㄊㄧㄢˋ","p":"tiàn","d":[{"f":"古代繫於冠冕兩側，垂在耳旁，用以塞耳的玉飾。","t":"名"},{"f":"充填。","t":"動"}]}],"瑱圭":[{"b":"ㄊㄧㄢˋ ㄍㄨㄟ","p":"tiàn guī","d":[{"f":"六瑞之一，古代帝王所持的玉器，象徵安定天下四方。"}]}],"瘁":[{"b":"ㄘㄨㄟˋ","p":"cuì","d":[{"f":"疾病。","t":"名"},{"f":"勞苦、勞累。","t":"形"},{"f":