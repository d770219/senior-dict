：「剛毅」、「果毅」。"]},{"f":"嚴厲。","t":"形"}]}],"毅力":[{"b":"ㄧˋ ㄌㄧˋ","p":"yì lì","d":[{"f":"堅定持久的意志。","e":["如：「恆心與毅力是一個人邁向成功的必備條件。」"]}]}],"毅勇":[{"b":"ㄧˋ ㄩㄥˇ","p":"yì yǒng","d":[{"f":"堅決勇敢。"}]}],"毅然":[{"b":"ㄧˋ ㄖㄢˊ","p":"yì rán","d":[{"f":"堅決毫不猶疑的樣子。"}]}],"毅然決然":[{"b":"ㄧˋ ㄖㄢˊ ㄐㄩㄝˊ ㄖㄢˊ","p":"yì rán jué rán","d":[{"f":"形容態度堅決，毫不猶豫退縮。","e":["如：「他從小立志報國，長大後毅然決然地投筆從戎。」"]}]}],"玕":[{"b":"ㄍㄢ","p":"gān","d":[{"f":"似玉的美石。參見「琅玕」條。","t":"名"}]}],"玕琅":[{"b":"ㄍㄢ ㄌㄤˊ","p":"gān láng","d":[{"f":"美玉。"}]}],"甥":[{"b":"ㄕㄥ","p":"shēng","d":[{"f":"稱謂：(1)用以稱姊妹的孩子。《爾雅．釋親》：「謂我舅者，吾謂之甥也。」如：「外甥」。(2)男子對阿姨、舅舅的自稱。(3)用以稱外孫。《詩經．齊風．猗嗟》：「終日射侯，不出正兮，展我甥兮。」漢．毛亨．傳：「外孫曰甥。」","t":"名"},{"f":"女婿。","t":"名"}]}],"甥女":[{"b":"ㄕㄥ ㄋㄩˇ","p":"shēng nǚ","d":[{"f":"稱謂。稱姊妹的女兒，或女子對姨、舅的自稱。"}]}],"甥館":[{"b":"ㄕㄥ ㄍㄨㄢˇ","p":"shēng guǎn","d":[{"f":"女婿所住的房子。"}]}],"硅":[{"b":"ㄍㄨㄟ","p":"guī","d":[{"f":"化學元素。矽的舊譯。","t":"名"}]}],"硅肺":[{"b":"ㄍㄨㄟ ㄈㄟˋ","p":"guī fèi","d":[{"f":"病名。因長期吸入含二氧化硅的灰塵而引起。有呼吸短促、胸口疼痛、體力減弱、咳嗽等症狀，常併發肺結核。"}]}],"硅谷":[{"b":"ㄍㄨㄟ ㄍㄨˇ","p":"guī gǔ","d":[{"f":"大陸地區指美國的矽谷。"}]}],"秕":[{"b":"ㄅㄧˇ","p":"bǐ","d":[{"f":"穀類植物所結的果實，虛有外殼，裡面卻是中空的，稱為「秕」或「秕穀」。","t":"名"},{"f":"穀物中空不飽滿的。","t":"形","e":["如：「秕子」。"]},{"f":"不好的、有名無實的。","t":"形","e":["如：「秕政」。"]}]}],"秕政":[{"b":"ㄅㄧˇ ㄓㄥˋ","p":"bǐ zhèng","d":[{"f":"不良的政治。"}]}],"秕滓":[{"b":"ㄅㄧˇ ㄗˇ","p":"bǐ zǐ","d":[{"f":"比喻廢棄的東西。"}]}],"秕稗":[{"b":"ㄅㄧˇ ㄅㄞˋ","p":"bǐ bài","d":[{"f":"秕子和稗子。比喻粗穢、微薄的東西。"},{"f":"喻有害之物。"}]}],"秕糠":[{"b":"ㄅㄧˇ ㄎㄤ","p":"bǐ kāng","d":[{"f":"秕子和米糠。比喻煩瑣或無價值的事物。北齊．顏之推《顏氏家訓．省事》：「守門詣闕，獻書言計，率多空薄，高自矜夸，無經略之大體，咸秕糠之微事。」唐．杜佑〈杜城郊居王處士鑿山引泉記〉：「棲遲衡茅，秕糠爵祿。」也作「糠秕」。"}]}],"秕謬":[{"b":"ㄅㄧˇ ㄇㄧㄡˋ","p":"bǐ miù","d":[{"f":"比喻事理乖錯。"}]}],"筥":[{"b":"ㄐㄩˇ","p":"jǔ","d":[{"f":"盛米飯的圓形竹器。","t":"名"}]}],"糵":[{"b":"","p":"","d":[{"f":"「糱」的異體字。"}]}],"耕":[{"b":"ㄍㄥ","p":"gēng","d":[{"f":"犁田、種植。","t":"動","e":["如：「耕田」、「耕地」。"]},{"f":"比喻謀生。","t":"動","e":["如：「舌耕」、「筆耕」。"]},{"f":"從事耕種的。","t":"形","e":["如：「耕叟」。"]}]},{"b":"ㄐㄧㄥ","p":"jīng","d":[{"f":"(一)之語音。"}]}],"耕九餘三":[{"b":"ㄍㄥ ㄐㄧㄡˇ ㄩˊ ㄙㄢ","p":"gēng jiǔ yú sān","d":[{"f":"耕種九年必有三年的餘糧。語本《禮記．王制》：「三年耕必有一年之食，九年耕必有三年之食，以三十年之通，雖有凶旱水溢，民無菜色。」後比喻平時積蓄，方能備凶荒不時之需。如：「持家之道在於耕九餘三，不在於寅吃卯糧。」"}]}],"耕作":[{"b":"ㄍㄥ ㄗㄨㄛˋ","p":"gēng zuò","d":[{"f":"耕種田地。","s":"耕種,耕耘"}]}],"耕具":[{"b":"ㄍㄥ ㄐㄩˋ","p":"gēng jù","d":[{"f":"耕種的農具。如犁、耙等。"}]}],"耕前耡後":[{"b":"ㄍㄥ ㄑㄧㄢˊ ㄔㄨˊ ㄏㄡˋ","p":"gēng qián chú hòu","d":[{"f":"夫耕於前，妻耡於後。比喻夫妻同心協力，能共甘苦。","e":["如：「看他們夫妻倆耕前耡後的相互扶持，真是令人羨慕。」"]}]}],"耕地":[{"b":"ㄍㄥ ㄉㄧˋ","p":"gēng dì","d":[{"f":"可種植農作物的土地。","e":["如：「他家的耕地相當肥沃。」"]},{"f":"耕種田地。"}]}],"耕地放領":[{"b":"ㄍㄥ ㄉㄧˋ ㄈㄤˋ ㄌㄧㄥˇ","p":"gēng dì fàng lǐng","d":[{"f":"政府所實施的農地政策，將公有耕地或由徵收而來的私有耕地出售與農民的措施。"}]}],"耕墾":[{"b":"ㄍㄥ ㄎㄣˇ","p":"gēng kěn","d":[{"f":"耕種開墾。"}]}],"耕夫":[{"b":"ㄍㄥ ㄈㄨ","p":"gēng fū","d":[{"f":"農夫。"}]}],"耕寬":[{"b":"ㄍㄥ ㄎㄨㄢ","p":"gēng kuān","d":[{"f":"犁翻土條的寬度，稱為「耕寬」。"}]}],"耕御路":[{"b":"ㄍㄥ ㄩˋ ㄌㄨˋ","p":"gēng yù lù","d":[{"f":"御路，王者所行的路，指御路耕為田。比喻亡國的意思。"}]}],"耕戶":[{"b":"ㄍㄥ ㄏㄨˋ","p":"gēng hù","d":[{"f":"耕種的人家。","e":["如：「隨著鄉村人口外流，如今耕戶有日益漸少的趨勢。」"],"s":"佃戶,田戶"}]}],"耕牛":[{"b":"ㄍㄥ ㄋㄧㄡˊ","p":"gēng niú","d":[{"f":"耕田的牛。","e":["如：「農村現代化之後，耕耘機已取代耕牛的地位。」"]}]}],"耕牛為主遭鞭杖":[{"b":"ㄍㄥ ㄋㄧㄡˊ ㄨㄟˋ ㄓㄨˇ ㄗㄠ ㄅㄧㄢ ㄓㄤˋ","p":"gēng niú wèi zhǔ zāo biān zhàng","d":[{"f":"本指耕牛為救主人逃離虎口，用角將熟睡的牧童驚醒，牧童不察，反以杖鞭打其牛。後引申為恩遭仇報。"}]}],"耕牧":[{"b":"ㄍㄥ ㄇㄨˋ","p":"gēng mù","d":[{"f":"耕田與畜牧。"}]}],"耕犁":[{"b":"ㄍㄥ ㄌㄧˊ","p":"gēng lí","d":[{"f":"作物栽植前翻動土壤的工作。"}]}],"耕田":[{"b":"ㄍㄥ ㄊㄧㄢˊ","p":"gēng tián","d":[{"f":"泛指耕種田地的一切活動。","s":"種地,種田"}]}],"耕畜":[{"b":"ㄍㄥ ㄔㄨˋ","p":"gēng chù","d":[{"f":"專用來耕種的牲畜。","e":["如：「牛、馬、騾子等是主要的耕畜。」"]}]}],"耕當問奴":[{"b":"ㄍㄥ ㄉㄤ ㄨㄣˋ ㄋㄨˊ","p":"gēng dāng wèn nú","d":[{"f":"比喻事有專司，處理事務當問行家。"}]}],"耕種":[{"b":"ㄍㄥ ㄓㄨㄥˋ","p":"gēng zhòng","d":[{"f":"耕田與種植。","s":"耕作,耕耘,墾植"}]}],"耕稼":[{"b":"ㄍㄥ ㄐㄧㄚˋ","p":"gēng jià","d":[{"f":"耕田與種植。"}]}],"耕織":[{"b":"ㄍㄥ ㄓ","p":"gēng zhī","d":[{"f":"耕田與織布。"}]}],"耕者有其田":[{"b":"ㄍㄥ ㄓㄜˇ ㄧㄡˇ ㄑㄧˊ ㄊㄧㄢˊ","p":"gēng zhě yǒu qí tián","d":[{"f":"民生主義解決土地問題的政策。要點是減低田租，保障農民收入，切實扶植自耕農，使其有自己的田地可以耕種。自民國四十二年起實施。"}]}],"耕耘":[{"b":"ㄍㄥ ㄩㄣˊ","p":"gēng yún","d":[{"f":"耕田與除草。泛指農田耕作的事情。","s":"耕種,耕作","a":"收穫"},{"f":"比喻付出精神和勞力。","e":["如：「一分耕耘，一分收穫。」"]}]}],"耕耘機":[{"b":"ㄍㄥ ㄩㄣˊ ㄐㄧ","p":"gēng yún jī","d":[{"f":"自西洋園圃式牽引機演變而來，有兩輪式，耕作時人行其後操縱之。"}]}],"耕耨":[{"b":"ㄍㄥ ㄋㄡˋ","p":"gēng nòu","d":[{"f":"犁田除草。"}]}],"耕讀":[{"b":"ㄍㄥ ㄉㄨˊ","p":"gēng dú","d":[{"f":"利用農耕之餘，致力學問的生活方式。比喻勤苦恬淡。","e":["如：「這種耕讀的生活雖苦，他卻怡然自得。」"]}]}],"耕讀傳家":[{"b":"ㄍㄥ ㄉㄨˊ ㄔㄨㄢˊ ㄐㄧㄚ","p":"gēng dú chuán jiā","d":[{"f":"以勤苦恬淡、不慕名利的門風傳家。"}]}],"耕鋤":[{"b":"ㄍㄥ ㄔㄨˊ","p":"gēng chú","d":[{"f":"耕種除草。《三國演義》第三八回：「亮久樂耕鋤，懶於應世，不能奉命。」也作「耕耡」。"}]}],"茵":[{"b":"ㄧㄣ","p":"yīn","d":[{"f":"車上的坐墊。","t":"名"},{"f":"墊褥的通稱。","t":"名","e":["如：「綠草如茵」。"]}]}],"茵夢湖":[{"b":"ㄧㄣ ㄇㄥˋ ㄏㄨˊ","p":"yīn mèng hú","d":[{"f":"書名。德國作家施篤姆的中篇小說，完成於西元一八五二年。全書以倒敘法追憶一對青年男女的戀情，文筆清新淒美，情意真摯動人。"}]}],"茵席之臣":[{"b":"ㄧㄣ ㄒㄧˊ ㄓ ㄔㄣˊ","p":"yīn xí zhī chén","d":[{"f":"侍奉於君主身側的近臣。"}]}],"茵芋":[{"b":"ㄧㄣ ㄩˋ","p":"yīn yù","d":[{"f":"植物名。芸香科茵芋屬，常綠灌木。生山地，高約可達二公尺。葉互生，橢圓形，密被透明油點。圓錐花序頂生，夏開白花。果球形，熟則色紅。全體平滑有香氣，莖葉皆有毒。也作「茵蕷」。"}]}],"茵藉":[{"b":"ㄧㄣ ㄐㄧㄝˋ","p":"yīn jiè","d":[{"f":"墊褥、坐席。"}]}],"茵陳":[{"b":"ㄧㄣ ㄔㄣˊ","p":"yīn chén","d":[{"f":"植物名。菊科艾屬，多年生草本。蒿的一種，生水濱砂地，葉一至二回羽狀全裂，小裂片細線形，近無毛。夏秋著花，頭狀花序多數，排列成複總狀，總苞黃綠色。莖葉可入藥。"}]}],"茵陳蒿":[{"b":"ㄧㄣ ㄔㄣˊ ㄏㄠ","p":"yīn chén hāo","d":[{"f":"菊科「茵陳」的別名。參見「茵陳」條。"}]}],"茵飪":[{"b":"ㄧㄣ ㄖㄣˋ","p":"yīn rèn","d":[{"f":"茵褥與飪食。原指吃與睡，後比喻起居飲食。"}]}],"處":[{"b":"ㄔㄨˇ","p":"chǔ","d":[{"f":"居住、止息。","t":"動"},{"f":"存在、置身於。","t":"動","e":["如：「處於逆境」、「設身處地」、「處變不驚」。"]},{"f":"交往、對待、共同生活。","t":"動","e":["如：「相處」、「和平共處」。"]},{"f":"安頓、安排。","t":"動","e":["如：「何以自處」。"]},{"f":"裁制、懲罰。","t":"動","e":["如：「處分」、「處罰」、「懲處」。"]},{"f":"辦理。","t":"動","e":["如：「處理」。"]},{"f":"決斷。","t":"動","e":["如：「處斷」。"]},{"f":"退隱自居。","t":"動","e":["如：「出處進退」。"]},{"f":"在家未出仕或未出嫁的。","t":"形","e":["如：「處士」、「處子」、「處女」。"]},{"f":"姓。如漢代有處興。","t":"名"}]},{"b":"ㄔㄨˋ","p":"chù","d":[{"f":"地方、場所。","t":"名","e":["如：「住處」、「各處」。"]},{"f":"事物的某一部分。","t":"名","e":["如：「益處」、「長處」、「用處」。"]},{"f":"機關團體的組織單位。","t":"名","e":["如：「訓導處」、「人事處」、「新聞處」。"]},{"f":"時候、時刻。","t":"名"},{"f":"量詞。計算部位、地點的單位。","t":"名","e":["如：「一處勝景」、「兩處流沙」、「三處瘀傷」。"]}]}],"處世":[{"b":"ㄔㄨˇ ㄕˋ","p":"chǔ shì","d":[{"f":"待人接物，應付世情。"}]}],"處世待人":[{"b":"ㄔㄨˇ ㄕˋ ㄉㄞˋ ㄖㄣˊ","p":"chǔ shì dài rén","d":[{"f":"居於世上，與人相處。","e":["如：「老師不僅傳授知識，也教導我們處世待人之道。」"]}]}],"處之泰然":[{"b":"ㄔㄨˇ ㄓ ㄊㄞˋ ㄖㄢˊ","p":"chǔ zhī tài rán","d":[{"f":"遇到事情時態度鎮定，神色自若。《宋史．卷四五〇．尹穀傳》：「江陵大府，雄據上流，表裡襄、漢，西控巴蜀，南扼湖、廣，兵民雜處，庶務叢集，霆隨事裁決，處之泰然。」《元史．卷一五八．許衡傳》：「家貧躬耕，粟熟則食，粟不熟，則食糠覈菜茹，處之泰然。」也作「泰然居之」、「泰然處之」。","s":"坦然,心安,從容不迫","a":"提心吊膽,坐臥不安,驚惶失措"}]}],"處事":[{"b":"ㄔㄨˇ ㄕˋ","p":"chǔ shì","d":[{"f":"治理事務。","s":"辦事,做事"},{"f":"六書之一。描繪抽象事物的造字方法。參見「指事」條。"}]}],"處分":[{"b":"ㄔㄨˇ ㄈㄣˋ","p":"chǔ fèn","d":[{"f":"處置。"},{"f":"處罰、懲治。"},{"f":"吩咐。"}]}],"處刑":[{"b":"ㄔㄨˇ ㄒㄧㄥˊ","p":"chǔ xíng","d":[{"f":"依法對犯罪者施以相當的刑罰。"}]}],"處境":[{"b":"ㄔㄨˇ ㄐㄧㄥˋ","p":"chǔ jìng","d":[{"f":"所處的情境。","e":["如：「處境窘迫」。"],"s":"環境,情況"}]}],"處境尷尬":[{"b":"ㄔㄨˇ ㄐㄧㄥˋ ㄍㄢ ㄍㄚˋ","p":"chǔ jìng gān gà","d":[{"f":"所處的環境、狀況令人難為情或窘迫。","e":["如：「她處境尷尬，不知該如何收場。」"],"s":"不上不下"}]}],"處士":[{"b":"ㄔㄨˇ ㄕˋ","p":"chǔ shì","d":[{"f":"有才學而隱居不做官的人。"}]}],"處女":[{"b":"ㄔㄨˇ ㄋㄩˇ","p":"chǔ nǚ","d":[{"f":"待在家裡的婦女。"},{"f":"原指未出嫁的女子，今則專指未曾有過性行為的女子。"},{"f":"比喻初次、第一次。","e":["如：「處女航」、「處女作」。"]},{"f":"比喻未開墾、未開發的。","e":["如：「處女地」。"]}]}],"處女作":[{"b":"ㄔㄨˇ ㄋㄩˇ ㄗㄨㄛˋ","p":"chǔ nǚ zuò","d":[{"f":"﻿第一次發表的作品。﻿如：「這位作家﻿甫推出處女作就﻿大受歡迎﻿，後續發展令人期待。」﻿"}]}],"處女地":[{"b":"ㄔㄨˇ ㄋㄩˇ ㄉㄧˋ","p":"chǔ nǚ dì","d":[{"f":"﻿1.尚未﻿開墾的土地。﻿如：「這塊處女地﻿已﻿淪為財團炒﻿作﻿的對象。」﻿2.尚未發現探索的領域。如：「人工智能仍是一片處女地，有待大家努力探索。」"}]}],"處女膜":[{"b":"ㄔㄨˇ ㄋㄩˇ ㄇㄛˋ","p":"chǔ nǚ mò","d":[{"f":"位於陰道口的環狀軟組織。由於舊時認知錯誤，將此組織的完整性視為女性未有性行為經驗與潔身自愛的象徵。西元二〇二二年因應民間團體倡議與民情輿論之連署陳請，認為人體器官之命名不該帶有性別歧視的價值觀而要求更名。醫學上稱為「陰道前膜」，參見「陰道前膜」條。"}]}],"處女航":[{"b":"ㄔㄨˇ ㄋㄩˇ ㄏㄤˊ","p":"chǔ nǚ háng","d":[{"f":"輪船、軍艦或飛機的第一次航行。"}]}],"處女表演":[{"b":"ㄔㄨˇ ㄋㄩˇ ㄅㄧㄠˇ ㄧㄢˇ","p":"chǔ nǚ biǎo yǎn","d":[{"f":"第一次的表演。","e":["如：「因為是處女表演，所以舞團裡的每位成員都顯得格外緊張。」"]}]}],"處子":[{"b":"ㄔㄨˇ ㄗˇ","p":"chǔ zǐ","d":[{"f":"原指未出嫁的女子，今則專指未曾有過性行為的女子。"},{"f":"品學俱優而隱居不做官的人。"}]}],"處安思危":[{"b":"ㄔㄨˇ ㄢ ㄙ ㄨㄟˊ","p":"chǔ ān sī wéi","d":[{"f":"居於安樂之境，要想到可能出現的危險、困難。《樂府詩集．卷一五．燕射歌辭三．隋元會大饗歌．皇夏》：「居高念下，處安思危，照臨有度，紀律無虧。」也作「居安慮危」、「居安思危」。"}]}],"處宗談雞":[{"b":"ㄔㄨˇ ㄗㄨㄥ ㄊㄢˊ ㄐㄧ","p":"chǔ zōng tán jī","d":[{"f":"晉人宋處宗得一長鳴雞，能作人語，處宗終日與之談論，口才大進。見南朝宋．劉義慶《幽明錄》。故用以比喻善於玄談、清談。"}]}],"處室":[{"b":"ㄔㄨˇ ㄕˋ","p":"chǔ shì","d":[{"f":"居住一室。"}]}],"處心有道，行己有方":[{"b":"ㄔㄨˇ ㄒㄧㄣ ㄧㄡˇ ㄉㄠˋ ， ㄒㄧㄥˊ ㄐㄧˇ ㄧㄡˇ ㄈㄤ","p":"chǔ xīn yǒu dào ， xíng jǐ yǒu fāng","d":[{"f":"以道修心，行事必守原則。"}]}],"處心積慮":[{"b":"ㄔㄨˇ ㄒㄧㄣ ㄐㄧ ㄌㄩˋ","p":"chǔ xīn jī lǜ","d":[{"f":"千方百慮，蓄意已久。","s":"費盡心機,久有存心,千方百計,想方設法,挖空心思"}]}],"處所":[{"b":"ㄔㄨˋ ㄙㄨㄛˇ","p":"chù suǒ","d":[{"f":"地方、居留之地。","s":"地方"}]}],"處斬":[{"b":"ㄔㄨˇ ㄓㄢˇ","p":"chǔ zhǎn","d":[{"f":"處以死刑。"}]}],"處斷":[{"b":"ㄔㄨˇ ㄉㄨㄢˋ","p":"chǔ duàn","d":[{"f":"處置裁斷。"},{"f":"執行死刑。"}]}],"處方":[{"b":"ㄔㄨˇ ㄈㄤ","p":"chǔ fāng","d":[{"f":"醫師針對病人病症所開具之醫療處置，以門診處方為例，在醫師開具之後，由患者據以交付藥師調劑取得藥品。依法律規定交付之藥劑容器或包裝除應標示病人資料、藥名、劑量、數量、用法、作用、警語或副作用外，另應包含機構名稱地點、醫師姓名、調劑者姓名及調劑時間等內容。"},{"f":"對策。"}]}],"處方箋":[{"b":"ㄔㄨˇ ㄈㄤ ㄐㄧㄢ","p":"chǔ fāng jiān","d":[{"f":"醫生診斷完畢後，開給病患的藥單。參見「處方」條。"}]}],"處暑":[{"b":"ㄔㄨˇ ㄕㄨˇ","p":"chǔ shǔ","d":[{"f":"二十四節氣之一。陽曆八月二十三或二十四日，此日過後，夏天的暑氣漸將結束，天氣漸轉涼爽。"}]}],"處死":[{"b":"ㄔㄨˇ ㄙˇ","p":"chǔ sǐ","d":[{"f":"處以死刑。"}]}],"處決":[{"b":"ㄔㄨˇ ㄐㄩㄝˊ","p":"chǔ jué","d":[{"f":"處置裁決。"},{"f":"依法執行死刑。"}]}],"處治":[{"b":"ㄔㄨˇ ㄓˋ","p":"chǔ zhì","d":[{"f":"處理、解決。"},{"f":"懲治處分。"}]}],"處理":[{"b":"ㄔㄨˇ ㄌㄧˇ","p":"chǔ lǐ","d":[{"f":"治理、解決。","s":"辦理,管理,解決,治理"}]}],"處理品":[{"b":"ㄔㄨˇ ㄌㄧˇ ㄆㄧㄣˇ","p":"chǔ lǐ pǐn","d":[{"f":"降低價格出售的貨品。通常指有瑕疵或滯銷品。","e":["如：「災後處理品大拍賣」。"]}]}],"處窩子":[{"b":"ㄔㄨˇ ˙ㄨㄛ ˙ㄗ","p":"chǔ wo zi","d":[{"f":"歷練不夠，遇事羞怯的人。","e":["如：「他是個沒見過大世面的處窩子。」"]}]}],"處約":[{"b":"ㄔㄨˇ ㄩㄝ","p":"chǔ yuē","d":[{"f":"居於窮困的環境。"}]}],"處置":[{"b":"ㄔㄨˇ ㄓˋ","p":"chǔ zhì","d":[{"f":"處理、措置。","s":"措置"},{"f":"處罰、懲治。"}]}],"處罰":[{"b":"ㄔㄨˇ ㄈㄚˊ","p":"chǔ fá","d":[{"f":"懲罰。","s":"科罰,懲罰"}]}],"處處":[{"b":"ㄔㄨˋ ㄔㄨˋ","p":"chù chù","d":[{"f":"各處、到處。","s":"隨地,隨處"}]}],"處處碰壁":[{"b":"ㄔㄨˋ ㄔㄨˋ ㄆㄥˋ ㄅㄧˋ","p":"chù chù pèng bì","d":[{"f":"比喻辦事或求人隨處受阻，事事不順利。","e":["如：「這物品他推銷了一整天，仍是處處碰壁，銷路不佳。」"],"a":"面面俱圓,八面玲瓏"}]}],"處變不驚":[{"b":"ㄔㄨˇ ㄅㄧㄢˋ ㄅㄨˋ ㄐㄧㄥ","p":"chǔ biàn bù jīng","d":[{"f":"處於詭譎多變的情勢中，仍不驚惶失措。","e":["如：「儘管世局多變，吾人當莊敬自強，處變不驚。」"]}]}],"處身":[{"b":"ㄔㄨˇ ㄕㄣ","p":"chǔ shēn","d":[{"f":"立身。","e":["如：「處身於世，修己為要。」"]}]}],"處長":[{"b":"ㄔㄨˋ ㄓㄤˇ","p":"chù zhǎng","d":[{"f":"組織部門中稱處的最高長官。","e":["如：「他由於工作認真努力，不久就被升為處長了。」"]}]}],"處館":[{"b":"ㄔㄨˇ ㄍㄨㄢˇ","p":"chǔ guǎn","d":[{"f":"舊時到別人家裡當私塾老師。"}]}],"蟥":[{"b":"ㄏㄨㄤˊ","p":"huáng","d":[{"f":"參見「馬蟥」條。"}]}],"襵":[{"b":"ㄓㄜˊ","p":"zhé","d":[{"f":"衣物上的皺褶。","t":"名"},{"f":"折疊。","t":"動"}]}],"謅":[{"b":"ㄗㄡ","p":"zōu","d":[{"f":"胡說。","t":"動","e":["如：「瞎謅」、「滿口胡謅」。"]},{"f":"編造。","t":"動"}]}],"謅札":[{"b":"ㄗㄡ ㄓㄚˊ","p":"zōu zhá","d":[{"f":"凶惡、頑劣。元．鄭廷玉《後庭花》第三折：「覷了王慶呵慌張勢煞，這漢就裡決謅札。」也作「搊扎」、「搊殺」、「鄒鄒查查」、「謅吒」。"}]}],"貕":[{"b":"ㄒㄧ","p":"xī","d":[{"f":"小豬。","t":"名"}]}],"踥":[{"b":"ㄑㄧㄝˋ","p":"qiè","d":[{"f":"參見「踥蹀」、「踥踥」等條。"}]}],"踥踥":[{"b":"ㄑㄧㄝˋ ㄑㄧㄝˋ","p":"qiè qiè","d":[{"f":"往來的樣子。"}]}],"踥蹀":[{"b":"ㄑㄧㄝˋ ㄉㄧㄝˊ","p":"qiè dié","d":[{"f":"走路的樣子。《楚辭．屈原．九章．哀郢》：「眾踥蹀而日進兮，美超遠而逾邁。」也作「踕蹀」、「躞蹀」。"}]}],"辵":[{"b":"ㄔㄨㄛˋ","p":"chuò","d":[{"f":"忽走忽跳。","t":"動"},{"f":"二一四部首之一。","t":"名"}]}],"酅":[{"b":"ㄒㄧ","p":"xī","d":[{"f":"地名。春秋時齊邑。故址在今大陸地區山東省東阿縣西南。","t":"名"}]}],"鑥":[{"b":"ㄌㄨˇ","p":"lǔ","d":[{"f":"化學元素鎦（lutetium，Lu）的大陸地區用詞。","t":"名"}]}],"鞅":[{"b":"ㄧㄤ","p":"yāng","d":[{"f":"套在馬頸上，用以駕車的皮帶。","t":"名"},{"f":"泛指車馬。","t":"名"},{"f":"不滿意的樣子。參見「鞅鞅」條。","t":"副"}]},{"b":"ㄧㄤˇ","p":"yǎng","d":[{"f":"(一)之又音。"}]}],"鞅掌":[{"b":"ㄧㄤ ㄓㄤˇ","p":"yāng zhǎng","d":[{"f":"煩勞、忙碌。"},{"f":"無暇修飾儀容。"}]}],"鞅鞅":[{"b":"ㄧㄤ ㄧㄤ","p":"yāng yāng","d":[{"f":"不滿意、不快樂的樣子。《漢書．卷一．高帝紀》：「諸將故與帝為編戶民，北面為臣，心常鞅鞅。」也作「怏怏」。"}]}],"餕":[{"b":"ㄐㄩㄣˋ","p":"jùn","d":[{"f":"剩餘的食物。","t":"名"},{"f":"熟食。","t":"名"},{"f":"吃剩下的食物。","t":"動"}]}],"餕餘":[{"b":"ㄐㄩㄣˋ ㄩˊ","p":"jùn yú","d":[{"f":"吃剩或祭拜過的食物。","s":"冷炙,殘羹"}]}],"鰵":[{"b":"ㄇㄧㄣˇ","p":"mǐn","d":[{"f":"動物名：（1）鮨科。上下頜無犬齒，後鼻孔為一垂直裂紋。體紅色，有許多黑眼斑。鰓蓋骨有二棘，常居岩礁區海域。（2）鱈魚的別稱。參見「鱈魚」條。","t":"名"}]}],"鰵魚肝油":[{"b":"ㄇㄧㄣˇ ㄩˊ ㄍㄢ ㄧㄡˊ","p":"mǐn yú gān yóu","d":[{"f":"鱈魚肝臟所製的油，為滋補品。"}]}],"齕":[{"b":"ㄏㄜˊ","p":"hé","d":[{"f":"用牙齒咬。","t":"動"}]}],"栟":[{"b":"","p":"","d":[{"f":"「栟」的異體字。"}]}]}