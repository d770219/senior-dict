 ㄧㄤˇ","p":"xiū yǎng","d":[{"f":"修治涵養使學問道德臻於精美完善。","s":"素養"},{"f":"品德、風度。","e":["如：「他是一位很有修養的人。」"]}]}],"修齋":[{"b":"ㄒㄧㄡ ㄓㄞ","p":"xiū zhāi","d":[{"f":"會合僧眾，供以齋食，謂之齋會，執行齋會稱為「修齋」。"}]}],"修齡":[{"b":"ㄒㄧㄡ ㄌㄧㄥˊ","p":"xiū líng","d":[{"f":"長壽。"}]}],"兾":[{"b":"","p":"","d":[{"f":"「冀」的異體字。"}]}],"嘮":[{"b":"ㄌㄠˊ","p":"láo","d":[{"f":"參見「嘮叨」、「嘮嘮」等條。"}]}],"嘮三叨四":[{"b":"ㄌㄠˊ ㄙㄢ ㄉㄠ ㄙˋ","p":"láo sān dāo sì","d":[{"f":"囉嗦、叨叨絮絮的樣子。"}]}],"嘮叨":[{"b":"ㄌㄠˊ ˙ㄉㄠ","p":"láo dao","d":[{"f":"囉囉嗦嗦話說個不停。《紅樓夢》第八回：「請了安，又問好，嘮叨半日，方纔走開。」也作「叨嘮」。","s":"絮聒"}]}],"嘮嗑":[{"b":"ㄌㄠˊ ㄎㄜˋ","p":"láo kè","d":[{"f":"東北方言。指談天、閒聊。"}]}],"嘮嘮":[{"b":"ㄌㄠˊ ㄌㄠˊ","p":"láo láo","d":[{"f":"吵雜喧擾的樣子。"}]}],"嘮嘮叨叨":[{"b":"ㄌㄠˊ ˙ㄌㄠ ㄉㄠ ㄉㄠ","p":"láo lao dāo dāo","d":[{"f":"囉囉嗦嗦話說個不停。元．無名氏《謝金吾》第一折：「我儘讓你說幾句便罷。則管裡倚老賣老，口裡嘮嘮叨叨的說個不了。」《金瓶梅》第五七回：「正在嘮嘮叨叨，喃喃洞洞，一頭罵，一頭著腦的時節，只見那玳安走將進來。」也作「勞勞叨叨」。","s":"喋喋不休,咕噥不已,嘵嘵不停,刺刺不休"}]}],"嘮扯":[{"b":"ㄌㄠˊ ㄔㄜˇ","p":"láo chě","d":[{"f":"東北方言。指聊天、閒談。"}]}],"奎":[{"b":"ㄎㄨㄟˊ","p":"kuí","d":[{"f":"兩條大腿之間。","t":"名"},{"f":"星宿名。二十八星宿之一，為西方白虎七宿的第一宿。","t":"名"},{"f":"星官名，奎宿之首，有星十六顆，在西方分屬雙魚與仙女座。《晉書．卷一一．天文志上》：「奎十六星，天之武庫也。一曰天豕，亦曰封豕。主以兵禁暴，又主溝瀆。」古人以為奎宿主文章，即文曲星，專司人間的文運。","t":"名"},{"f":"關於文事的。","t":"形","e":["如：「奎運」、「奎星高照」。"]}]}],"奎寧":[{"b":"ㄎㄨㄟˊ ㄋㄧㄥˊ","p":"kuí níng","d":[{"f":"一種藥物。為英語quinine的音譯。由金雞納樹的皮中提製出來的白色結晶或無定形粉末，有強苦味，為治療瘧疾的特效藥。"}]}],"奎星高照":[{"b":"ㄎㄨㄟˊ ㄒㄧㄥ ㄍㄠ ㄓㄠˋ","p":"kuí xīng gāo zhào","d":[{"f":"奎星，神話傳說中掌文運的神。「奎星高照」比喻考運好。","e":["如：「他今年奎星高照，參加高考順利上榜。」"]}]}],"奎章":[{"b":"ㄎㄨㄟˊ ㄓㄤ","p":"kuí zhāng","d":[{"f":"皇帝所寫的字。"}]}],"奎蹄":[{"b":"ㄎㄨㄟˊ ㄊㄧˊ","p":"kuí tí","d":[{"f":"蹄彎曲處。"}]}],"屮":[{"b":"ㄔㄜˋ","p":"chè","d":[{"f":"初生的草木。","t":"名"},{"f":"二一四部首之一。","t":"名"}]}],"巾":[{"b":"ㄐㄧㄣ","p":"jīn","d":[{"f":"擦洗用的布。","t":"名","e":["如：「毛巾」、「手巾」、「浴巾」。"]},{"f":"覆蓋或纏繞用的布。","t":"名","e":["如：「頭巾」、「領巾」、「圍巾」。"]},{"f":"二一四部首之一。","t":"名"}]}],"巾冠":[{"b":"ㄐㄧㄣ ㄍㄨㄢ","p":"jīn guān","d":[{"f":"成人的服裝。"},{"f":"穿戴衣物。"}]}],"巾幗":[{"b":"ㄐㄧㄣ ㄍㄨㄛˊ","p":"jīn guó","d":[{"f":"古代婦女用以覆髮的頭巾和髮飾。《新唐書．卷二二〇．東夷傳．高麗傳》：「庶人衣褐，戴弁。女子首巾幗。」《三國演義》第一〇三回：「孔明乃取巾幗并婦人縞素之服，盛於大盒之內，修書一封，遣人送至魏寨。」後用巾幗代稱女子。《聊齋志異．卷二．巧娘》：「此丈夫而巾幗者，何畏之？」《儒林外史》第五四回：「你看！他不過是個巾幗，還曉得看詩。怎有個鶯脰湖大會大作詩的呢？」","a":"鬚眉"}]}],"巾幗英雄":[{"b":"ㄐㄧㄣ ㄍㄨㄛˊ ㄧㄥ ㄒㄩㄥˊ","p":"jīn guó yīng xióng","d":[{"f":"女性英雄。","e":["如：「花木蘭是古代的巾幗英雄。」"],"s":"女中丈夫"}]}],"巾幗鬚眉":[{"b":"ㄐㄧㄣ ㄍㄨㄛˊ ㄒㄩ ㄇㄟˊ","p":"jīn guó xū méi","d":[{"f":"巾幗，古代女子的頭巾和首飾，借指女子；鬚眉，鬍鬚、眉毛，借指男子。「巾幗鬚眉」，女中丈夫。指性格豪爽，有男子氣概的女子。《孽海花》第一四回：「如今且說筱亭的夫人，是揚州傅容狀元的女兒，容貌雖說不得美麗，卻氣概豐富，倜儻不群，有巾幗鬚眉之號。」也作「鬚眉巾幗」。","s":"女中豪傑,女中丈夫"}]}],"巾幘":[{"b":"ㄐㄧㄣ ㄗㄜˊ","p":"jīn zé","d":[{"f":"頭巾。"},{"f":"戴上頭巾。"}]}],"巾服":[{"b":"ㄐㄧㄣ ㄈㄨˊ","p":"jīn fú","d":[{"f":"頭巾和長衣。泛指官定的士人服飾。"},{"f":"穿戴巾服。"}]}],"巾櫛":[{"b":"ㄐㄧㄣ ㄐㄧㄝˊ","p":"jīn jié","d":[{"f":"毛巾和梳子。泛指盥洗用具。"},{"f":"婢妾執管之事。"}]}],"巾箱本":[{"b":"ㄐㄧㄣ ㄒㄧㄤ ㄅㄣˇ","p":"jīn xiāng běn","d":[{"f":"小版本的古書。因南齊衡陽王蕭鈞手寫五經，其外形體積不大，可放置巾箱中，便於攜帶，故稱為「巾箱本」。見《南史．卷四一．齊宗室傳．衡陽元王道度傳》。"}]}],"巾舞":[{"b":"ㄐㄧㄣ ㄨˇ","p":"jīn wǔ","d":[{"f":"一種中國古代的舞蹈。參見「公莫舞」條。"}]}],"巾袖無光":[{"b":"ㄐㄧㄣ ㄒㄧㄡˋ ㄨˊ ㄍㄨㄤ","p":"jīn xiù wú guāng","d":[{"f":"形容穿戴的服裝敝舊不華麗。"}]}],"巾車":[{"b":"ㄐㄧㄣ ㄐㄩ","p":"jīn jū","d":[{"f":"張設帷幔的車子。"},{"f":"以帷幕裝飾車子。指整車出行。"},{"f":"職官名。為車官之長。"}]}],"愞":[{"b":"","p":"","d":[{"f":"「懦」的異體字。"}]}],"搾":[{"b":"ㄓㄚˋ","p":"zhà","d":[{"f":"擠壓、壓迫、逼迫。","t":"動","e":["如：「搾汁」、「壓搾」。"]}]}],"旎":[{"b":"ㄋㄧˇ","p":"nǐ","d":[{"f":"參見「旎旎」、「旖旎」等條。"}]}],"旎旎":[{"b":"ㄋㄧˇ ㄋㄧˇ","p":"nǐ nǐ","d":[{"f":"濃郁柔和的樣子。"}]}],"杞":[{"b":"ㄑㄧˇ","p":"qǐ","d":[{"f":"參見「枸杞」、「杞柳」等條。","t":"名"},{"f":"國名。周朝所分封的諸侯國。姒姓。故城在今大陸地區河南省杞縣。","t":"名"},{"f":"姓。如春秋時齊國有杞梁。","t":"名"}]}],"杞人之憂":[{"b":"ㄑㄧˇ ㄖㄣˊ ㄓ ㄧㄡ","p":"qǐ rén zhī yōu","d":[{"f":"比喻無謂的憂慮。參見「杞人憂天」條。"}]}],"杞人憂天":[{"b":"ㄑㄧˇ ㄖㄣˊ ㄧㄡ ㄊㄧㄢ","p":"qǐ rén yōu tiān","d":[{"f":"古時杞國有個人，擔心天會塌下來，因而寢食難安。典出《列子．天瑞》。後比喻無謂的憂慮。《幼學瓊林．卷一．天文類》：「心多過慮，何異杞人憂天。」《孽海花》第六回：「正盼他們互建奇勛，為書生吐氣，一面又免不了杞人憂天，代為著急。」也作「杞國憂天」、「杞人之憂」。","s":"杞天之憂,鰓鰓過慮","a":"樂天安命"}]}],"杞國憂天":[{"b":"ㄑㄧˇ ㄍㄨㄛˊ ㄧㄡ ㄊㄧㄢ","p":"qǐ guó yōu tiān","d":[{"f":"比喻無謂的憂慮。參見「杞人憂天」條。"}]}],"杞天":[{"b":"ㄑㄧˇ ㄊㄧㄢ","p":"qǐ tiān","d":[{"f":"無謂的煩惱。參見「杞人憂天」條。"}]}],"杞宋無徵":[{"b":"ㄑㄧˇ ㄙㄨㄥˋ ㄨˊ ㄓㄥ","p":"qǐ sòng wú zhēng","d":[{"f":"比喻事情證據不足。"}]}],"杞憂":[{"b":"ㄑㄧˇ ㄧㄡ","p":"qǐ yōu","d":[{"f":"比喻無謂的憂慮。參見「杞人憂天」條。"}]}],"杞柳":[{"b":"ㄑㄧˇ ㄌㄧㄡˇ","p":"qǐ liǔ","d":[{"f":"植物名。楊柳科柳屬，叢生灌木。枝延長，光滑。葉對生或近對生，長橢圓形，全緣或上方具細齒。花雌雄異株，柔荑花序，雄花序卵圓形，雄蕊二枚，合生；雌花序長一至二公分。枝條可用來編織器物。產大陸地區江蘇及河南等省。"}]}],"杞梁":[{"b":"ㄑㄧˇ ㄌㄧㄤˊ","p":"qǐ liáng","d":[{"f":"人名。（？～西元前791？)春秋齊人，名植，字梁。事莊公，與華周俱為大夫，同於伐莒之役殉國。"}]}],"杞梁妻":[{"b":"ㄑㄧˇ ㄌㄧㄤˊ ㄑㄧ","p":"qǐ liáng qī","d":[{"f":"春秋時齊大夫杞梁戰死，其妻於城下大哭十日，城牆為之倒塌。待其夫下葬後，投水而死。見漢．劉向《列女傳．卷四．齊杞梁妻》。"},{"f":"樂曲名。杞梁妻之妹朝月所作。"}]}],"杞梓":[{"b":"ㄑㄧˇ ㄗˇ","p":"qǐ zǐ","d":[{"f":"杞、梓皆為良木，用以比喻有用的人材。"}]}],"森":[{"b":"ㄙㄣ","p":"sēn","d":[{"f":"樹木濃密的樣子。","t":"形"},{"f":"灰暗陰冷的樣子。","t":"形","e":["如：「陰森」。"]},{"f":"整肅、不可侵犯的。","t":"形","e":["如：「法度森嚴」。"]},{"f":"眾多的。","t":"副","e":["如：「森列」、「森羅萬象」。"]}]}],"森嚴":[{"b":"ㄙㄣ ㄧㄢˊ","p":"sēn yán","d":[{"f":"嚴肅、嚴密的樣子。","e":["如：「戒備森嚴」。"]}]}],"森岑":[{"b":"ㄙㄣ ㄘㄣˊ","p":"sēn cén","d":[{"f":"陰森寒冷的樣子。"}]}],"森巴":[{"b":"ㄙㄣ ㄅㄚ","p":"sēn bā","d":[{"f":"一種非洲舞蹈。為英語samba的音譯，然此語實源自非洲。後來南美洲巴西修改成為一種酒吧舞蹈，音樂節奏為四四拍，以每四拍為一段。其所配合的音樂，也稱為「森巴」。也譯作「桑巴」。"}]}],"森林":[{"b":"ㄙㄣ ㄌㄧㄣˊ","p":"sēn lín","d":[{"f":"樹木密生的寬廣地區。","e":["如：「森林兼具木材供應、水土保持、觀光休憩等功能，是重要的天然資源之一。」"],"s":"叢林"}]}],"森林副產物":[{"b":"ㄙㄣ ㄌㄧㄣˊ ㄈㄨˋ ㄔㄢˇ ㄨˋ","p":"sēn lín fù chǎn wù","d":[{"f":"森林中木材為主產物，木材以外的林產品即為森林副產物。如菌蕈類、藥材、愛玉子等。"}]}],"森林學":[{"b":"ㄙㄣ ㄌㄧㄣˊ ㄒㄩㄝˊ","p":"sēn lín xué","d":[{"f":"研究森林資源之組成、建造、撫育、經營、保護、效益及林產物利用的學科。"}]}],"森林法":[{"b":"ㄙㄣ ㄌㄧㄣˊ ㄈㄚˇ","p":"sēn lín fǎ","d":[{"f":"為保育森林資源，發揮森林公益及經濟效用而制定的法律。"}]}],"森林浴":[{"b":"ㄙㄣ ㄌㄧㄣˊ ㄩˋ","p":"sēn lín yù","d":[{"f":"在森林中漫步，吸收樹木所散發出的諸種精氣，具有調節精神，滌垢更新，健身的功能。","e":["如：「能赴溪頭作森林浴是人生的一大享受啊！」"]}]}],"森林生態系":[{"b":"ㄙㄣ ㄌㄧㄣˊ ㄕㄥ ㄊㄞˋ ㄒㄧˋ","p":"sēn lín shēng tài xì","d":[{"f":"以林木為主要組成的生態系統，其植群能與環境交互作用，並使物質交替循環，達到持續永久之功能者。可分為針葉林、落葉林及熱帶雨林等三帶。"}]}],"森林遊樂區":[{"b":"ㄙㄣ ㄌㄧㄣˊ ㄧㄡˊ ㄌㄜˋ ㄑㄩ","p":"sēn lín yóu lè qū","d":[{"f":"森林景觀經過規劃，而適合休閒遊樂的處所。","e":["如：「太平山森林遊樂區」。"]}]}],"森森":[{"b":"ㄙㄣ ㄙㄣ","p":"sēn sēn","d":[{"f":"樹木茂盛的樣子。"},{"f":"戰慄的樣子。"},{"f":"陰森寒冷的樣子。","e":["如：「寒風森森的吹，怪可怕的。」"]},{"f":"眾多的樣子。"}]}],"森然":[{"b":"ㄙㄣ ㄖㄢˊ","p":"sēn rán","d":[{"f":"林木茂盛的樣子。"},{"f":"陰森寒冷的樣子。"}]}],"森羅殿":[{"b":"ㄙㄣ ㄌㄨㄛˊ ㄉㄧㄢˋ","p":"sēn luó diàn","d":[{"f":"相傳為陰曹地府閻羅所居住的殿。"}]}],"森羅萬象":[{"b":"ㄙㄣ ㄌㄨㄛˊ ㄨㄢˋ ㄒㄧㄤˋ","p":"sēn luó wàn xiàng","d":[{"f":"宇宙間的各種現象繁多而整齊的排列在眼前。《五燈會元．卷一九．白雲守端禪師法嗣》：「乾坤大地，日月星辰，森羅萬象。」也作「萬象森羅」。"}]}],"森豎":[{"b":"ㄙㄣ ㄕㄨˋ","p":"sēn shù","d":[{"f":"因恐懼而毛髮聳立。"}]}],"牎":[{"b":"","p":"","d":[{"f":"「窗」的異體字。"}]}],"珞":[{"b":"ㄌㄨㄛˋ","p":"luò","d":[{"f":"參見「瓔珞」條。"}]}],"珞巴族":[{"b":"ㄌㄨㄛˋ ㄅㄚ ㄗㄨˊ","p":"luò bā zú","d":[{"f":"中國少數民族之一。分布在西藏東南部。珞巴在藏語的意思為南方人。社會基本按父系氏族血緣關係聚居。一般採一夫一妻制，但亦有富戶行多妻制產業。以農為主，狩獵為副。語言屬漢藏語系藏緬語族。部分地區通用藏語。信仰萬物有靈的原始宗教，日常生活中多所禁忌。參見「洛巴」條。"}]}],"珞珞":[{"b":"ㄌㄨㄛˋ ㄌㄨㄛˋ","p":"luò luò","d":[{"f":"石頭堅硬的樣子。"}]}],"畮":[{"b":"","p":"","d":[{"f":"「畝」的異體字。"}]}],"盾":[{"b":"ㄉㄨㄣˋ","p":"dùn","d":[{"f":"一種抵禦敵人矢刃等攻擊，保護己身安全的兵器。","t":"名","e":["如：「盾牌」、「籐盾」、「金劍神盾」。"]},{"f":"比喻支持或援助的力量。","t":"名","e":["如：「深厚的民意基礎是他強而有力的後盾。」"]},{"f":"盾形的物品。多用作獎牌或紀念品。","t":"名","e":["如：「銀盾」、「金盾」。"]},{"f":"荷蘭、越南、印尼等國貨幣單位的簡稱。","t":"名"}]},{"b":"ㄕㄨㄣˇ","p":"shǔn","d":[{"f":"(一)之又音。"}]}],"盾牌":[{"b":"ㄉㄨㄣˋ ㄆㄞˊ","p":"dùn pái","d":[{"f":"古代用來抵禦刀刃、矢石的防護武器。"},{"f":"推托的藉口。","e":["如：「一說到付錢，老王總是找盾牌來推托、拖延。」"]}]}],"碎":[{"b":"ㄙㄨㄟˋ","p":"suì","d":[{"f":"破裂。","t":"動","e":["如：「破碎」、「粉碎」。"]},{"f":"細小、不完整的。","t":"形","e":["如：「碎布」、「碎石」。"]},{"f":"瑣細、煩雜。","t":"形","e":["如：「瑣碎」。"]},{"f":"言語叨絮、囉嗦。","t":"形","e":["如：「閒言碎語」。"]}]}],"碎修兒":[{"b":"ㄙㄨㄟˋ ㄒㄧㄡㄦ","p":"suì xiūr ","d":[{"f":"東西已經陳舊，但不全面修理，只在腐朽不堪的地方隨壞隨修，稱為「碎修兒」。"}]}],"碎催":[{"b":"ㄙㄨㄟˋ ㄘㄨㄟ","p":"suì cuī","d":[{"f":"譏諷受人指使，為人奔走的人。"}]}],"碎務":[{"b":"ㄙㄨㄟˋ ㄨˋ","p":"suì wù","d":[{"f":"煩瑣的事務。","s":"雜務"}]}],"碎嘴碎舌":[{"b":"ㄙㄨㄟˋ ㄗㄨㄟˇ ㄙㄨㄟˋ ㄕㄜˊ","p":"suì zuǐ suì shé","d":[{"f":"嘮嘮叨叨。"}]}],"碎妝":[{"b":"ㄙㄨㄟˋ ㄓㄨㄤ","p":"suì zhuāng","d":[{"f":"一種古代的裝飾。"}]}],"碎密":[{"b":"ㄙㄨㄟˋ ㄇㄧˋ","p":"suì mì","d":[{"f":"繁瑣。"}]}],"碎小":[{"b":"ㄙㄨㄟˋ ㄒㄧㄠˇ","p":"suì xiǎo","d":[{"f":"家人、兒女等。"}]}],"碎屍萬段":[{"b":"ㄙㄨㄟˋ ㄕ ㄨㄢˋ ㄉㄨㄢˋ","p":"suì shī wàn duàn","d":[{"f":"在極忿怒的情況下，恐嚇要將他人打死。為刻毒罵人的話。"}]}],"碎屑":[{"b":"ㄙㄨㄟˋ ㄒㄧㄝˋ","p":"suì xiè","d":[{"f":"碎末。","e":["如：「他鋸一根木頭，就弄得碎屑滿地。」"]}]}],"碎步":[{"b":"ㄙㄨㄟˋ ㄅㄨˋ","p":"suì bù","d":[{"f":"小而快的步伐。","e":["如：「她碎步上前，接受校長的頒獎。」"]}]}],"碎步兒":[{"b":"ㄙㄨㄟˋ ㄅㄨˋㄦ","p":"suì bùr ","d":[{"f":"邁步小而行動較快的走法。"}]}],"碎玉":[{"b":"ㄙㄨㄟˋ ㄩˋ","p":"suì yù","d":[{"f":"比喻潔白的牙齒。"}]}],"碎瓊亂玉":[{"b":"ㄙㄨㄟˋ ㄑㄩㄥˊ ㄌㄨㄢˋ ㄩˋ","p":"suì qióng luàn yù","d":[{"f":"散落地上的潔白雪花。"}]}],"碎瓷":[{"b":"ㄙㄨㄟˋ ㄘˊ","p":"suì cí","d":[{"f":"因年代久、釉彩裂開，而呈現碎紋的瓷器。"}]}],"碎石":[{"b":"ㄙㄨㄟˋ ㄕˊ","p":"suì shí","d":[{"f":"細碎的石頭。","e":["如：「這條羊腸小徑遍滿了碎石，真是難走極了。」"]}]}],"碎紛紛":[{"b":"ㄙㄨㄟˋ ㄈㄣ ㄈㄣ","p":"suì fēn fēn","d":[{"f":"形容非常破碎的樣子。"}]}],"碎聒":[{"b":"ㄙㄨㄟˋ ㄍㄨㄚ","p":"suì guā","d":[{"f":"囉嗦、嘮叨。"}]}],"碎花":[{"b":"ㄙㄨㄟˋ ㄏㄨㄚ","p":"suì huā","d":[{"f":"細碎的花樣。","e":["如：「這類碎花圖樣的衣飾產品，領導今年秋冬流行趨向。」"]}]}],"碎裂":[{"b":"ㄙㄨㄟˋ ㄌㄧㄝˋ","p":"suì liè","d":[{"f":"破裂。","s":"破裂,破碎"},{"f":"打破、打碎。"}]}],"碎身粉骨":[{"b":"ㄙㄨㄟˋ ㄕㄣ ㄈㄣˇ ㄍㄨˇ","p":"suì shēn fěn gǔ","d":[{"f":"比喻犧牲生命。如：「你的大恩大德，我縱使碎身粉骨，亦難報萬一。」也作「粉身碎骨」。"}]}],"碎金":[{"b":"ㄙㄨㄟˋ ㄐㄧㄣ","p":"suì jīn","d":[{"f":"比喻簡短的佳作。"}]}],"碎首糜軀":[{"b":"ㄙㄨㄟˋ ㄕㄡˇ ㄇㄧˊ ㄑㄩ","p":"suì shǒu mí qū","d":[{"f":"粉碎頭顱，身軀糜爛。形容壯烈的犧牲生命。"}]}],"碎骨粉身":[{"b":"ㄙㄨㄟˋ ㄍㄨˇ ㄈㄣˇ ㄕㄣ","p":"suì gǔ fěn shēn","d":[{"f":"比喻犧牲生命。《文明小史》第五八回：「況且卑府受老帥的厚恩，就是碎骨粉身，也不能報答老帥的恩典。」也作「粉身碎骨」。"}]}],"稞":[{"b":"ㄎㄜ","p":"kē","d":[{"f":"參見「青稞」條。"}]}],"稞麥":[{"b":"ㄎㄜ ㄇㄞˋ","p":"kē mài","d":[{"f":"青稞的別名。參見「青稞」條。"}]}],"紾":[{"b":"ㄓㄣˇ","p":"zhěn","d":[{"f":"扭轉。","t":"動"},{"f":"糾纏、糾結。","t":"動"}]}],"紾臂":[{"b":"ㄓㄣˇ ㄅㄧˋ","p":"zhěn bì","d":[{"f":"語本《孟子．告子下》：「紾兄之臂而奪之食。」後指用力扭轉手臂。"}]}],"聞":[{"b":"ㄨㄣˊ","p":"wén","d":[{"f":"聽到。","t":"動","e":["如：「百聞不如一見」。"]},{"f":"傳達、傳布。","t":"動"},{"f":"著稱。","t":"動"},{"f":"用鼻子嗅。","t":"動","e":["如：「入芝蘭之室，久而不聞其香。」"]},{"f":"知識。","t":"名","e":["如：「見聞廣博」、「孤陋寡聞」。"]},{"f":"音訊、消息。","t":"名","e":["如：「新聞」、「趣聞」。"]},{"f":"姓。宋代有聞見。","t":"名"}]},{"b":"ㄨㄣˋ","p":"wèn","d":[{"f":"名譽、名望。","t":"名"},{"f":"著名的、有名望的。","t":"形","e":["如：「聞人」。"]}]}],"聞一多":[{"b":"ㄨㄣˊ ㄧ ㄉㄨㄛ","p":"wén yī duō","d":[{"f":"人名。（西元1899～1945）本名聞家驊，湖北浠水人。留美攻治美術，歸國後，任教大學。生活分三期：初為新月派詩人，有《死水》等新詩集，以格律見長；繼治文學史，對《詩經》、《楚辭》、唐詩等有獨到見解；最後參加民盟，領導學生運動，在昆明被狙死。著作結集為《聞一多全集》。"}]}],"聞一知十":[{"b":"ㄨㄣˊ ㄧ ㄓ ㄕˊ","p":"wén yī zhī shí","d":[{"f":"形容人稟賦聰敏，領悟力、類推力強。","s":"舉一反三"}]}],"聞人":[{"b":"ㄨㄣˊ ㄖㄣˊ","p":"wén rén","d":[{"f":"複姓。如宋朝聞人宏。"}]},{"b":"ㄨㄣˋ ㄖㄣˊ","p":"wèn rén","d":[{"f":"有名望的人。","s":"名流,名士,名人"}]}],"聞名":[{"b":"ㄨㄣˊ ㄇㄧㄥˊ","p":"wén míng","d":[{"f":"聽到名字。"},{"f":"著名。","e":["如：「西湖美景，聞名全國。」"]}]}],"聞名不如見面":[{"b":"ㄨㄣˊ ㄇㄧㄥˊ ㄅㄨˋ ㄖㄨˊ ㄐㄧㄢˋ ㄇㄧㄢˋ","p":"wén míng bù rú jiàn miàn","d":[{"f":"聽聞比不上親眼目睹的真切。"}]}],"聞名天下":[{"b":"ㄨㄣˊ ㄇㄧㄥˊ ㄊㄧㄢ ㄒㄧㄚˋ","p":"wén míng tiān xià","d":[{"f":"名聲響亮，天下皆知。","e":["如：「他是一位聞名天下的音樂家。」"],"s":"聞名遐邇"}]}],"聞名於世":[{"b":"ㄨㄣˊ ㄇㄧㄥˊ ㄩˊ ㄕˋ","p":"wén míng yú shì","d":[{"f":"名聲顯著於當今世上。","e":["如：「我國的全民健保制度聞名於世，不少國家派員前來考察學習。」"]}]}],"聞名遐邇":[{"b":"ㄨㄣˊ ㄇㄧㄥˊ ㄒㄧㄚˊ ㄦˇ","p":"wén míng xiá ěr","d":[{"f":"聲名遠播，遠近皆知。","e":["如：「他的醫術聞名遐邇。」"],"s":"聞名天下"}]}],"聞問":[{"b":"ㄨㄣˊ ㄨㄣˋ","p":"wén wèn","d":[{"f":"通音信。"}]},{"b":"ㄨㄣˋ ㄨㄣˋ","p":"wèn wèn","d":[{"f":"好名聲。"}]}],"聞喜宴":[{"b":"ㄨㄣˊ ㄒㄧˇ ㄧㄢˋ","p":"wén xǐ yàn","d":[{"f":"唐、宋時朝廷宴請新科進士及諸科及第者的宴席。宋時曾設宴於瓊林苑，故也稱為「瓊林宴」。後泛指在禮部宴請新科進士的宴會。"}]}],"聞所未聞":[{"b":"ㄨㄣˊ ㄙㄨㄛˇ ㄨㄟˋ ㄨㄣˊ","p":"wén suǒ wèi wén","d":[{"f":"聽到從未聽過的事。","a":"家常便飯,不足為奇,耳熟能詳,習以為常,司空見慣"}]}],"聞望":[{"b":"ㄨㄣˋ ㄨㄤˋ","p":"wèn wàng","d":[{"f":"名譽與聲望。"}]}],"聞見":[{"b":"ㄨㄣˊ ˙ㄐㄧㄢ","p":"wén jian","d":[{"f":"聞到氣味。","e":["如：「聞見一股焦味兒。」"]}]},{"b":"ㄨㄣˊ ㄐㄧㄢˋ","p":"wén jiàn","d":[{"f":"耳朵聽到和眼睛所看到的事。比喻知識。"}]}],"聞訊":[{"b":"ㄨㄣˊ ㄒㄩㄣˋ","p":"wén xùn","d":[{"f":"聽到消息。","e":["如：「車禍發生後，警方聞訊立刻趕到現場處理。」"]}]}],"聞診":[{"b":"ㄨㄣˊ ㄓㄣˇ","p":"wén zhěn","d":[{"f":"中醫用來診斷病情的方法。包括憑聽覺從病人說話、呼吸、咳嗽等聲音診斷和憑嗅覺分辨病人散發的氣味或排泄物的氣味。"}]}],"聞過則喜":[{"b":"ㄨㄣˊ ㄍㄨㄛˋ ㄗㄜˊ ㄒㄧˇ","p":"wén guò zé xǐ","d":[{"f":"聽到別人指出自己的缺失就感到高興。形容人虛心接受別人的批評。","a":"怙惡不悛"}]}],"聞過色喜":[{"b":"ㄨㄣˊ ㄍㄨㄛˋ ㄙㄜˋ ㄒㄧˇ","p":"wén guò sè xǐ","d":[{"f":"聽到他人告訴自己的過錯就十分歡喜。形容樂於接受規勸。"}]}],"聞道":[{"b":"ㄨㄣˊ ㄉㄠˋ","p":"wén dào","d":[{"f":"追求知識學問。"}]}],"聞道猶迷":[{"b":"ㄨㄣˊ ㄉㄠˋ ㄧㄡˊ ㄇㄧˊ","p":"wén dào yóu mí","d":[{"f":"聽到好的道理，卻仍然執迷不悟。"}]}],"聞達":[{"b":"ㄨㄣˋ ㄉㄚˊ","p":"wèn dá","d":[{"f":"被稱揚薦拔。"}]}],"聞雞起舞":[{"b":"ㄨㄣˊ ㄐㄧ ㄑㄧˇ ㄨˇ","p":"wén jī qǐ wǔ","d":[{"f":"晉代祖逖，半夜聞雞啼，立即起床操練武藝的故事。典出《晉書．卷六二．祖逖傳》。後用以比喻及時奮起行動。"}]}],"聞雷失箸":[{"b":"ㄨㄣˊ ㄌㄟˊ ㄕ ㄓㄨˋ","p":"wén léi shī zhù","d":[{"f":"本指三國蜀主劉備進食時，聽到曹操說：「今天下英雄，唯使君與操耳。」大吃一驚，筷子遂掉落地上，此時正逢雷雨，劉備乃託言是因打雷受到驚嚇。見《三國志．卷三二．蜀書．先主備傳》注引《華陽國志》。後比喻利用巧言掩飾真情。"}]}],"聞韶忘味":[{"b":"ㄨㄣˊ ㄕㄠˊ ㄨㄤˋ ㄨㄟˋ","p":"wén sháo wàng wèi","d":[{"f":"韶，舜時樂曲名。「聞韶忘味」即孔子在齊國聽到舜時的雅樂，心中念念不忘，以致有一段很長時間食肉而不知味。語本《論語．述而》：「子在齊聞韶，三月不知肉味，曰：『不圖為樂之至於斯也。』」後用以比喻對某種事物熱愛到入迷的境界。"}]}],"聞風":[{"b":"ㄨㄣˊ ㄈㄥ","p":"wén fēng","d":[{"f":"聽到風聲或消息。","e":["如：「百貨公司的贈獎活動才一展開，即有大批的會員聞風前來。」"]}]}],"聞風不動":[{"b":"ㄨㄣˊ ㄈㄥ ㄅㄨˋ ㄉㄨㄥˋ","p":"wén fēng bù dòng","d":[{"f":"不因外來事物的影響而做任何改變。","e":["如：「他聞風不動的在那兒站了兩個小時。」"],"a":"聞風而逃,聞風遠揚,聞風而起,聞風而動"}]}],"聞風喪膽":[{"b":"ㄨㄣˊ ㄈㄥ ㄙㄤˋ ㄉㄢˇ","p":"wén fēng sàng dǎn","d":[{"f":"聽到一點消息就嚇破膽。形容極度恐懼。","e":["如：「宋朝岳飛帶領的岳家軍，英勇善戰，使金人聞風喪膽。」"],"s":"心驚膽戰"}]}],"聞風而動":[{"b":"ㄨㄣˊ ㄈㄥ ㄦˊ ㄉㄨㄥˋ","p":"wén fēng ér dòng","d":[{"f":"聽到消息就馬上行動。","s":"聞風而逃,聞風而起","a":"聞風不動"}]}],"聞風而起":[{"b":"ㄨㄣˊ ㄈㄥ ㄦˊ ㄑㄧˇ","p":"wén fēng ér qǐ","d":[{"f":"一聽到消息就起來響應。","s":"聞風而動,聞風而逃","a":"聞風不動"}]}],"聞風而逃":[{"b":"ㄨㄣˊ ㄈㄥ ㄦˊ ㄊㄠˊ","p":"wén fēng ér táo","d":[{"f":"一聽到風聲，就馬上逃跑。","s":"聞風而動,聞風而起,聞風遠揚","a":"聞風不動"}]}],"聞風遠揚":[{"b":"ㄨㄣˊ ㄈㄥ ㄩㄢˇ ㄧㄤˊ","p":"wén fēng yuǎn yáng","d":[{"f":"聽到風聲就遠遠的逃開。","s":"聞風而逃","a":"聞風不動"}]}],"聞風響應":[{"b":"ㄨㄣˊ ㄈㄥ ㄒㄧㄤˇ ㄧㄥˋ","p":"wén fēng xiǎng yìng","d":[{"f":"聽到風聲，就開始附和、跟隨。","e":["如：「保護動物團體提倡認養流浪狗運動，社會各界聞風響應。」"]}]}],"蔎":[{"b":"ㄕㄜˋ","p":"shè","d":[{"f":"一種香草。","t":"名"}]}],"譎":[{"b":"ㄐㄩㄝˊ","p":"jué","d":[{"f":"欺詐的。","t":"形"},{"f":"奇異、怪異。","t":"形","e":["如：「詭譎」。"]},{"f":"欺騙。","t":"動"},{"f":"決斷。","t":"動"},{"f":"隱諱而不直言。","t":"副","e":["如：「譎諫」。"]}]}],"譎怪之談":[{"b":"ㄐㄩㄝˊ ㄍㄨㄞˋ ㄓ ㄊㄢˊ","p":"jué guài zhī tán","d":[{"f":"怪異而不近情理的談話。"}]}],"譎而不正":[{"b":"ㄐㄩㄝˊ ㄦˊ ㄅㄨˋ ㄓㄥˋ","p":"jué ér bù zhèng","d":[{"f":"通達權變而不守正道。"}]}],"譎詐":[{"b":"ㄐㄩㄝˊ ㄓㄚˋ","p":"jué zhà","d":[{"f":"詭詐、欺騙。"}]}],"譎詭":[{"b":"ㄐㄩㄝˊ ㄍㄨㄟˇ","p":"jué guǐ","d":[{"f":"變化不測。"}]}],"譎誑":[{"b":"ㄐㄩㄝˊ ㄎㄨㄤˊ","p":"jué kuáng","d":[{"f":"遊說時的權詐變化。"}]}],"譎諫":[{"b":"ㄐㄩㄝˊ ㄐㄧㄢˋ","p":"jué jiàn","d":[{"f":"託辭不直言，使聞者自悟。"}]}],"譎譬":[{"b":"ㄐㄩㄝˊ ㄆㄧˋ","p":"jué pì","d":[{"f":"繞彎子作譬喻。"}]}],"譎辭":[{"b":"ㄐㄩㄝˊ ㄘˊ","p":"jué cí","d":[{"f":"譎詐之詞，指諷喻。"}]}],"賞":[{"b":"