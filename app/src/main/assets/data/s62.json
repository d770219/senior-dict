{"㛮":[{"b":"","p":"","d":[{"f":"「嫂」的異體字。"}]}],"䠞":[{"b":"","p":"","d":[{"f":"「蹙」的異體字。"}]}],"乞":[{"b":"ㄑㄧˇ","p":"qǐ","d":[{"f":"求、討取。","t":"動","e":["如：「乞巧」、「乞討」、「搖尾乞憐」。"]},{"f":"引申為希冀、盼望的意思。","t":"動"},{"f":"乞丐，討飯的人。","t":"名"},{"f":"姓。如明代有乞賢。","t":"名"}]},{"b":"ㄑㄧˋ","p":"qì","d":[{"f":"給與。","t":"動"}]}],"乞丐":[{"b":"ㄑㄧˇ ㄍㄞˋ","p":"qǐ gài","d":[{"f":"請求給與。","s":"托缽人,叫花子"},{"f":"靠討飯、要錢過活的人。"}]}],"乞乞縮縮":[{"b":"ㄑㄧˇ ㄑㄧˇ ㄙㄨˋ ㄙㄨˋ","p":"qǐ qǐ sù sù","d":[{"f":"顫抖瑟縮的樣子。"}]}],"乞人":[{"b":"ㄑㄧˇ ㄖㄣˊ","p":"qǐ rén","d":[{"f":"討飯的人。"},{"f":"請求於人。"}]}],"乞伏":[{"b":"ㄑㄧˇ ㄈㄨˊ","p":"qǐ fú","d":[{"f":"懇請。","e":["如：「此乃無心之過，乞伏見諒！」"]}]}],"乞伏國仁":[{"b":"ㄑㄧˇ ㄈㄨˊ ㄍㄨㄛˊ ㄖㄣˊ","p":"qǐ fú guó rén","d":[{"f":"人名。（西元？～388)隴西鮮卑人。東晉時西秦建國之君，世為酋豪，受前秦封為南單于，鎮守勇士川（今甘肅省金縣東北）。旋趁秦亂，築所鎮城為都，國號西秦。"}]}],"乞休":[{"b":"ㄑㄧˇ ㄒㄧㄡ","p":"qǐ xiū","d":[{"f":"自請退職。如：「年老乞休」。也作「乞免」。"}]}],"乞假":[{"b":"ㄑㄧˇ ㄐㄧㄚˇ","p":"qǐ jiǎ","d":[{"f":"借貸。"}]},{"b":"ㄑㄧˇ ㄐㄧㄚˋ","p":"qǐ jià","d":[{"f":"請假休息。","s":"告假,請假"}]}],"乞免":[{"b":"ㄑㄧˇ ㄇㄧㄢˇ","p":"qǐ miǎn","d":[{"f":"向人求饒。"},{"f":"自請退職。如：「為了避人口舌，上週他已向經理乞免了。」也作「乞休」。"}]}],"乞兒乘小車":[{"b":"ㄑㄧˇ ㄦˊ ㄔㄥˊ ㄒㄧㄠˇ ㄔㄜ","p":"qǐ ér chéng xiǎo chē","d":[{"f":"譏刺人官職升得很快。"}]}],"乞化":[{"b":"ㄑㄧˇ ㄏㄨㄚˋ","p":"qǐ huà","d":[{"f":"討飯、要錢。"},{"f":"和尚、道士等化齋飯。"}]}],"乞命":[{"b":"ㄑㄧˇ ㄇㄧㄥˋ","p":"qǐ mìng","d":[{"f":"請求寬饒活命。"},{"f":"請示命令。"}]}],"乞哀告憐":[{"b":"ㄑㄧˇ ㄞ ㄍㄠˋ ㄌㄧㄢˊ","p":"qǐ āi gào lián","d":[{"f":"乞求別人憐憫同情。","e":["如：「她每次受到委屈，總要向我乞哀告憐一番。」"]}]}],"乞婆":[{"b":"ㄑㄧˇ ㄆㄛˊ","p":"qǐ pó","d":[{"f":"乞討的婦人。借為對婦人的蔑稱。"}]}],"乞巧":[{"b":"ㄑㄧˇ ㄑㄧㄠˇ","p":"qǐ qiǎo","d":[{"f":"相傳陰曆七月七日為牽牛、織女二星相會之期，舊俗婦女此夕必備陳瓜果、鮮花、胭脂於庭中向天祭拜，以期擁有姣美的面貌；並對月引線穿針，以期雙手靈巧，長於刺繡織布，稱為「乞巧」。南朝梁．宗懍《荊楚歲時記．七月》：「是夕，人家婦女結綵縷，穿七孔針，或以金銀鍮石為針，陳几筵酒脯瓜果於庭中以乞巧。」也作「祈巧」。"}]}],"乞師":[{"b":"ㄑㄧˇ ㄕ","p":"qǐ shī","d":[{"f":"求人出兵相助。"}]}],"乞憐":[{"b":"ㄑㄧˇ ㄌㄧㄢˊ","p":"qǐ lián","d":[{"f":"求人憐憫。"}]}],"乞憐搖尾":[{"b":"ㄑㄧˇ ㄌㄧㄢˊ ㄧㄠˊ ㄨㄟˇ","p":"qǐ lián yáo wěi","d":[{"f":"本指狗搖著尾巴，以討主人歡心。後形容人有所請求，卑躬屈膝向人討好之態。明．汪錂《春蕪記》第一一齣：「你無知小輩，胡言亂語，休在人前乞憐搖尾！」也作「搖尾乞憐」。"}]}],"乞懇":[{"b":"ㄑㄧˇ ㄎㄣˇ","p":"qǐ kěn","d":[{"f":"乞求懇請。","e":["如：「乞懇惠賜一票。」"]}]}],"乞拉朋吉":[{"b":"ㄑㄧˇ ㄌㄚ ㄆㄥˊ ㄐㄧˊ","p":"qǐ lā péng jí","d":[{"f":"鄉鎮名。印度東北部阿薩密省卡夕山脈南坡的村鎮。因位於雪朗高原南緣，面迎強烈西南季風，年降雨量極高，有「世界雨極」之稱。"}]}],"乞援":[{"b":"ㄑㄧˇ ㄩㄢˊ","p":"qǐ yuán","d":[{"f":"請求幫助。","s":"討救,請援"}]}],"乞期":[{"b":"ㄑㄧˇ ㄑㄧˊ","p":"qǐ qí","d":[{"f":"請假。"}]}],"乞求":[{"b":"ㄑㄧˇ ㄑㄧㄡˊ","p":"qǐ qiú","d":[{"f":"懇切的祈求。","s":"請求,仰求"}]}],"乞活":[{"b":"ㄑㄧˇ ㄏㄨㄛˊ","p":"qǐ huó","d":[{"f":"本指到有糧食的地方圖生存。後多指流徙逐糧的饑民。"}]}],"乞漿得酒":[{"b":"ㄑㄧˇ ㄐㄧㄤ ㄉㄜˊ ㄐㄧㄡˇ","p":"qǐ jiāng dé jiǔ","d":[{"f":"向人討一點漿湯喝，卻得到酒。語出晉．袁淮〈正書〉：「太歲在酉，乞漿得酒；太歲在巳，販妻鬻子。則知災祥有自然之理。」比喻所得到的遠超過所祈求的。唐．張文成《游仙窟》：「乞漿得酒，舊來伸口；打兔得獐，非意所望。」","a":"借貸無門"}]}],"乞火":[{"b":"ㄑㄧˇ ㄏㄨㄛˇ","p":"qǐ huǒ","d":[{"f":"借取火種。"},{"f":"漢代蒯通以里婦為洗刷鄰婦偷肉的冤屈，往鄰家借火驅逐為肉相爭的狗群的故事，向曹相國推薦梁石君、東郭先生。見《漢書．卷四五．蒯通傳》。後以喻向人說情或推薦。"}]}],"乞留乞良":[{"b":"ㄑㄧˇ ㄌㄧㄡˊ ㄑㄧˇ ㄌㄧㄤˊ","p":"qǐ liú qǐ liáng","d":[{"f":"憂愁、悲痛的樣子。"}]}],"乞留惡濫":[{"b":"ㄑㄧˇ ㄌㄧㄡˊ ㄜˋ ㄌㄢˋ","p":"qǐ liú è làn","d":[{"f":"隨心所欲，不受拘束。"}]}],"乞留曲律":[{"b":"ㄑㄧˇ ㄌㄧㄡˊ ㄑㄩ ㄌㄩˋ","p":"qǐ liú qū lǜ","d":[{"f":"彎曲不整的樣子。"}]}],"乞留玎琅":[{"b":"ㄑㄧˇ ㄌㄧㄡˊ ㄉㄧㄥ ㄌㄤˊ","p":"qǐ liú dīng láng","d":[{"f":"擬聲詞。形容清脆的響聲。"}]}],"乞盟":[{"b":"ㄑㄧˇ ㄇㄥˊ","p":"qǐ méng","d":[{"f":"乞求參加盟約。"},{"f":"向敵求和。"}]}],"乞窮儉相":[{"b":"ㄑㄧˇ ㄑㄩㄥˊ ㄐㄧㄢˇ ㄒㄧㄤˋ","p":"qǐ qióng jiǎn xiàng","d":[{"f":"像乞丐般的寒酸模樣。"}]}],"乞討":[{"b":"ㄑㄧˇ ㄊㄠˇ","p":"qǐ tǎo","d":[{"f":"向人乞求施捨。","e":["如：「沿街乞討」。"]}]}],"乞請":[{"b":"ㄑㄧˇ ㄑㄧㄥˇ","p":"qǐ qǐng","d":[{"f":"乞討、乞求給與。","s":"伏祈,伏乞,哀求"},{"f":"請求。"}]}],"乞貸":[{"b":"ㄑㄧˇ ㄉㄞˋ","p":"qǐ dài","d":[{"f":"向人借貸。","s":"借款"}]}],"乞身":[{"b":"ㄑㄧˇ ㄕㄣ","p":"qǐ shēn","d":[{"f":"舊時視任官為委身於國君，故稱官員自請離職為「乞身」。"}]}],"乞鄰":[{"b":"ㄑㄧˇ ㄌㄧㄣˊ","p":"qǐ lín","d":[{"f":"語本《論語．公冶長》：「孰謂微生高直？或乞醯焉，乞諸其鄰而與之。」指向鄰人求助。"}]}],"乞閒":[{"b":"ㄑㄧˇ ㄒㄧㄢˊ","p":"qǐ xián","d":[{"f":"請求離職閒居。"}]}],"乞降":[{"b":"ㄑㄧˇ ㄒㄧㄤˊ","p":"qǐ xiáng","d":[{"f":"請求敵方接受投降。","s":"求和"}]}],"乞靈":[{"b":"ㄑㄧˇ ㄌㄧㄥˊ","p":"qǐ líng","d":[{"f":"求助於神靈或某種權威，來幫助自己。"}]}],"乞鞠":[{"b":"ㄑㄧˇ ㄐㄩˊ","p":"qǐ jú","d":[{"f":"請求覆審。漢．王符《潛夫論．述赦》：「而彼冤之家，乃甫當乞鞠，告故以信直，亦無益於死亡矣。」也作「乞鞫」。"}]}],"乞頭":[{"b":"ㄑㄧˇ ㄊㄡˊ","p":"qǐ tóu","d":[{"f":"賭局的抽頭。"}]}],"乞食":[{"b":"ㄑㄧˇ ㄕˊ","p":"qǐ shí","d"