{"䃉":[{"b":"","p":"","d":[{"f":"「珉」的異體字。"}]}],"仙":[{"b":"ㄒㄧㄢ","p":"xiān","d":[{"f":"經修煉後長生不老、超脫塵俗的人。","t":"名","e":["如：「神仙」、「八仙過海」、「修道成仙」。"]},{"f":"性情或行為超凡不俗的人。","t":"名","e":["如：「詩仙」、「劍仙」。"]},{"f":"姓。如宋代有仙源明。","t":"名"},{"f":"神仙的、仙人的。","t":"形","e":["如：「仙宮」、「仙居」、「仙丹」。"]},{"f":"輕飄、輕盈。","t":"形"},{"f":"超俗不凡。","t":"形","e":["如：「仙容」、「仙品」、「仙才」。"]},{"f":"稱死的婉辭。","t":"副","e":["如：「仙化」、「仙去」、「仙逝」。"]}]}],"仙丹":[{"b":"ㄒㄧㄢ ㄉㄢ","p":"xiān dān","d":[{"f":"神仙所煉的靈藥，據說吃了可以長生不老，變成神仙。"},{"f":"比喻非常有效的藥。"}]}],"仙人":[{"b":"ㄒㄧㄢ ㄖㄣˊ","p":"xiān rén","d":[{"f":"神話傳說中長生不死，並且有各種神通的人。《史記．卷二八．封禪書》：「仙人可見，而上往常遽，以故不見。」宋．張君房《雲笈七籤．卷一七．洞玄靈寶定觀經》：「長生不死，延數萬歲，名編仙籙，故曰仙人。」也作「僊人」。","s":"神仙","a":"凡人"}]}],"仙人拳":[{"b":"ㄒㄧㄢ ㄖㄣˊ ㄑㄩㄢˊ","p":"xiān rén quán","d":[{"f":"植物名。仙人掌科仙人球屬，多年生肉質草本。原產阿根廷、巴西。植株叢生，莖綠色，球形或棍棒狀，有縱稜十三至十五條，稜上有刺。花大型，喇叭狀，白色或淡紅色，生於莖側。可供觀賞。"}]}],"仙人掌":[{"b":"ㄒㄧㄢ ㄖㄣˊ ㄓㄤˇ","p":"xiān rén zhǎng","d":[{"f":"植物名。仙人掌科仙人掌屬，常綠肉質灌木。高約二公尺。莖多節，橢圓形或倒卵狀長橢圓形，扁平而肥厚，深綠色。葉退化為小針形。花無梗，著生於頂端者，常開放成盤狀，黃紅色。原產於南美洲，現分布廣泛，不限於熱帶。"},{"f":"漢武帝為承接天上甘露所打造的銅器。形如仙人以手掌擎盤狀。"},{"f":"山名。陝西省華陰太華山的東峰。峰側留有形似手掌的痕跡，據說為黃河河神以手擘開山峰以利河水通過所留。"}]}],"仙人擔":[{"b":"ㄒㄧㄢ ㄖㄣˊ ㄉㄢˋ","p":"xiān rén dàn","d":[{"f":"一種鍛鍊體力的運動器具。以長棍兩端貫穿石輪，類似舉重。"}]}],"仙人放屁":[{"b":"ㄒㄧㄢ ㄖㄣˊ ㄈㄤˋ ㄆㄧˋ","p":"xiān rén fàng pì","d":[{"f":"（歇後語）不同凡響。","e":["如：「這事可真如仙人放屁──不同凡響。」"]}]}],"仙人跳":[{"b":"ㄒㄧㄢ ㄖㄣˊ ㄊㄧㄠˋ","p":"xiān rén tiào","d":[{"f":"以色誘為主要手段的詐財圈套。過去多由一男一女串通，當被害者受女方色誘，陷入圈套時，男方即出面指控二人通姦，藉機強行勒索錢財。《九尾龜》第二〇回：「當下秋谷暗恨王雲生、李雙林做得好事，竟頑起仙人跳的勾當來。」今泛指加害人色誘被害人入圈套，隨後加以強行勒索。也稱為「紮火囤」。"}]}],"仙仗":[{"b":"ㄒㄧㄢ ㄓㄤˋ","p":"xiān zhàng","d":[{"f":"仙人的儀仗。"},{"f":"天子的儀仗。"}]}],"仙公":[{"b":"ㄒㄧㄢ ㄍㄨㄥ","p":"xiān gōng","d":[{"f":"仙人、仙翁。"}]}],"仙公廟":[{"b":"ㄒㄧㄢ ㄍㄨㄥ ㄇㄧㄠˋ","p":"xiān gōng miào","d":[{"f":"道教奉祀純陽祖師呂洞賓的觀宇。有位於臺北木柵指南山上的仙公廟。參見「指南宮」條。"}]}],"仙后座":[{"b":"ㄒㄧㄢ ㄏㄡˋ ㄗㄨㄛˋ","p":"xiān hòu zuò","d":[{"f":"星座名。位於北天，在仙王座與英仙座之間。其中五顆亮星約略排列成W形。"}]}],"仙域":[{"b":"ㄒㄧㄢ ㄩˋ","p":"xiān yù","d":[{"f":"仙人居住的地方。亦用來比喻風景優美的地方。","e":["如：「這裡處處青山綠水、鳥語花香，宛如仙域一般。」"]}]}],"仙境":[{"b":"ㄒㄧㄢ ㄐㄧㄥˋ","p":"xiān jìng","d":[{"f":"神仙居住的地方。"},{"f":"形容景致優美的地方。"}]}],"仙壇":[{"b":"ㄒㄧㄢ ㄊㄢˊ","p":"xiān tán","d":[{"f":"仙人所在的地方。"},{"f":"占卜求神的壇場。"}]}],"仙女":[{"b":"ㄒㄧㄢ ㄋㄩˇ","p":"xiān nǚ","d":[{"f":"女性的仙人。"},{"f":"形容極美麗的女子。","e":["如：「她美得像仙女下凡。」"]},{"f":"星座名。參見「仙女座」條。"}]}],"仙女座":[{"b":"ㄒㄧㄢ ㄋㄩˇ ㄗㄨㄛˋ","p":"xiān nǚ zuò","d":[{"f":"星座名。位於北天，在雙魚座與仙后座之間。"}]}],"仙女廟":[{"b":"ㄒㄧㄢ ㄋㄩˇ ㄇㄧㄠˋ","p":"xiān nǚ miào","d":[{"f":"鄉鎮名。位於江蘇省江都縣東北。相傳古時女道士康紫霞於夢中得仙，後人立廟祀之，故稱為「仙女廟」。南瀕運河，西臨人字河，商業繁盛，米市尤為興盛。"}]}],"仙姑":[{"b":"ㄒㄧㄢ ㄍㄨ","p":"xiān gū","d":[{"f":"女性的仙人。","e":["如：「何仙姑」。"]},{"f":"敬稱女性道士。"},{"f":"女乩童。"},{"f":"螻蛄的別名。參見「螻蛄」條。也作「仙蛄」。"}]}],"仙姿":[{"b":"ㄒㄧㄢ ㄗ","p":"xiān zī","d":[{"f":"形容秀逸的面貌、形態。","e":["如：「仙姿玉質」。"],"s":"美貌"}]}],"仙姿玉色":[{"b":"ㄒㄧㄢ ㄗ ㄩˋ ㄙㄜˋ","p":"xiān zī yù sè","d":[{"f":"形容女子容貌美麗，光潤如玉，有如神仙。"}]}],"仙子":[{"b":"ㄒㄧㄢ ㄗˇ","p":"xiān zǐ","d":[{"f":"仙人。亦用以尊稱修道或隱居的人。"},{"f":"美女。"}]}],"仙官":[{"b":"ㄒㄧㄢ ㄍㄨㄢ","p":"xiān guān","d":[{"f":"稱有職位、爵祿的神仙。"}]}],"仙客":[{"b":"ㄒㄧㄢ ㄎㄜˋ","p":"xiān kè","d":[{"f":"仙人，敬稱修道或隱居的人。"}]}],"仙居":[{"b":"ㄒㄧㄢ ㄐㄩ","p":"xiān jū","d":[{"f":"仙人居住的地方。"},{"f":"尊稱他人的住處。","e":["如：「仙居何方？」"]}]}],"仙山瓊閣":[{"b":"ㄒㄧㄢ ㄕㄢ ㄑㄩㄥˊ ㄍㄜˊ","p":"xiān shān qióng gé","d":[{"f":"仙山，神仙居住的高山；瓊閣，美玉雕築的樓閣。「仙山瓊閣」指神仙居住的仙境。也用以指美妙空幻的地方或景象。","e":["如：「出外的人只要有個溫暖的被窩，一個遮風擋雨的屋頂，也就勝似仙山瓊閣了。」"]}]}],"仙府":[{"b":"ㄒㄧㄢ ㄈㄨˇ","p":"xiān fǔ","d":[{"f":"仙人居住的地方。"}]}],"仙才":[{"b":"ㄒㄧㄢ ㄘㄞˊ","p":"xiān cái","d":[{"f":"成為神仙的資質。"},{"f":"比喻清逸的才思。"}]}],"仙方":[{"b":"ㄒㄧㄢ ㄈㄤ","p":"xiān fāng","d":[{"f":"舊時迷信服用後可以飛昇成仙的藥方。"},{"f":"仙人所賜的藥。比喻具有神效的藥。"}]}],"仙曹":[{"b":"ㄒㄧㄢ ㄘㄠˊ","p":"xiān cáo","d":[{"f":"仙輩，仙人的行列。"},{"f":"唐時尚書省各官署稱為「仙曹」。尚書省郎中也稱為「仙曹」。"}]}],"仙木":[{"b":"ㄒㄧㄢ ㄇㄨˋ","p":"xiān mù","d":[{"f":"古時年初一掛在門邊以驅鬼辟邪的桃木板。"}]}],"仙果":[{"b":"ㄒㄧㄢ ㄍㄨㄛˇ","p":"xiān guǒ","d":[{"f":"神話傳說中仙樹所結的果實。"},{"f":"比喻難得、美味的水果。"},{"f":"飛昇成仙的結局。"}]}],"仙桃":[{"b":"ㄒㄧㄢ ㄊㄠˊ","p":"xiān táo","d":[{"f":"一種桃樹的果實。"},{"f":"泛指桃樹。"}]}],"仙樂":[{"b":"ㄒㄧㄢ ㄩㄝˋ","p":"xiān yuè","d":[{"f":"仙界的音樂。比喻境界高而優美的音樂。"}]}],"仙樹":[{"b":"ㄒㄧㄢ ㄕㄨˋ","p":"xiān shù","d":[{"f":"神話傳說中可解旅人飢渴的神樹。"}]}],"仙機":[{"b":"ㄒㄧㄢ ㄐㄧ","p":"xiān jī","d":[{"f":"神仙所透露的預言、暗示。"}]}],"仙氣":[{"b":"ㄒㄧㄢ ㄑㄧˋ","p":"xiān qì","d":[{"f":"靈秀脫俗的氣質。","e":["如：「他走起路來輕飄飄的，帶著一股仙氣。」"]}]}],"仙洞":[{"b":"ㄒㄧㄢ ㄉㄨㄥˋ","p":"xiān dòng","d":[{"f":"仙人居住的山洞。"}]}],"仙海":[{"b":"ㄒㄧㄢ ㄏㄞˇ","p":"xiān hǎi","d":[{"f":"青海湖的別名。參見「青海湖」條。"}]}],"仙源":[{"b":"ㄒㄧㄢ ㄩㄢˊ","p":"xiān yuán","d":[{"f":"神仙居住的地方。"},{"f":"晉朝陶淵明描寫的理想境界桃花源。"}]}],"仙班":[{"b":"ㄒㄧㄢ ㄅㄢ","p":"xiān bān","d":[{"f":"天上仙人的行列。"},{"f":"朝班。"}]}],"仙界":[{"b":"ㄒㄧㄢ ㄐㄧㄝˋ","p":"xiān jiè","d":[{"f":"神仙生活的世界。"}]}],"仙真":[{"b":"ㄒㄧㄢ ㄓㄣ","p":"xiān zhēn","d":[{"f":"神仙、仙人。"}]}],"仙童":[{"b":"ㄒㄧㄢ ㄊㄨㄥˊ","p":"xiān tóng","d":[{"f":"服侍仙人的童子。"}]}],"仙童仙女":[{"b":"ㄒㄧㄢ ㄊㄨㄥˊ ㄒㄧㄢ ㄋㄩˇ","p":"xiān tóng xiān nǚ","d":[{"f":"舊時有喪事的人家，多在靈前左右放置男女紙人，以代表僕婢，殯葬後則火化，稱為「仙童仙女」。"}]}],"仙筆":[{"b":"ㄒㄧㄢ ㄅㄧˇ","p":"xiān bǐ","d":[{"f":"清逸超絕的文筆。"},{"f":"奇異神妙的筆或文字。"},{"f":"仙人的筆跡。"}]}],"仙籍":[{"b":"ㄒㄧㄢ ㄐㄧˊ","p":"xiān jí","d":[{"f":"登錄仙人姓名的簿冊。"},{"f":"古時科舉及第者或朝廷侍臣的名籍。"}]}],"仙經":[{"b":"ㄒㄧㄢ ㄐㄧㄥ","p":"xiān jīng","d":[{"f":"道教經典的通稱。"}]}],"仙茅":[{"b":"ㄒㄧㄢ ㄇㄠˊ","p":"xiān máo","d":[{"f":"植物名。石蒜科仙茅屬。多年生草本，葉似茅，莖高四五寸，開黃花，形如梔子，不結實，根有節，色黃多涎，可入藥。原產於西域，今四川、浙江、雲南、廣東等地皆有。梵語為河輪勒陀。"}]}],"仙草":[{"b":"ㄒㄧㄢ ㄘㄠˇ","p":"xiān cǎo","d":[{"f":"神話傳說中具有特殊效力的綠草。"},{"f":"植物名。脣形科仙草屬，一年生草本。長在田畦或河堤旁，形似莧菜。莖方形而帶褐色。葉對生，卵形，鋸齒緣，有茸毛。短總狀花序，花冠二脣形，淡紅色。莖葉熬汁後加入少量碳酸鈉，再調合甘藷粉，冷卻後凝結為黑色似果凍之軟凝膠，為夏季清涼食品。"}]}],"仙草蜜":[{"b":"ㄒㄧㄢ ㄘㄠˇ ㄇㄧˋ","p":"xiān cǎo mì","d":[{"f":"用仙草及水、糖等製成的清涼飲料。","e":["如：「夏天時喝一碗仙草蜜，清涼又消暑。」"]}]}],"仙蒂瑞拉":[{"b":"ㄒㄧㄢ ㄉㄧˋ ㄖㄨㄟˋ ㄌㄚ","p":"xiān dì ruì lā","d":[{"f":"法國童話小說中的女主角。參見「灰姑娘」條。"}]}],"仙藥":[{"b":"ㄒㄧㄢ ㄧㄠˋ","p":"xiān yào","d":[{"f":"神話傳說中仙人所製的神藥仙丹，吃了可以長生不老。"}]}],"仙術":[{"b":"ㄒㄧㄢ ㄕㄨˋ","p":"xiān shù","d":[{"f":"仙人神奇變化的法術。","e":["如：「點石成金是傳說中的仙術。」"]}]}],"仙貝":[{"b":"ㄒㄧㄢ ㄅㄟˋ","p":"xiān bèi","d":[{"f":"一種由蓬萊米製成的小食。外敷以糖，甜脆可口。"}]}],"仙逝":[{"b":"ㄒㄧㄢ ㄕˋ","p":"xiān shì","d":[{"f":"成仙升天。多用以指人死亡。","e":["如：「他不抽菸、不喝酒，一直活到八十幾歲才仙逝。」"],"s":"歸天,去世,仙遊"}]}],"仙遊":[{"b":"ㄒㄧㄢ ㄧㄡˊ","p":"xiān yóu","d":[{"f":"外出求仙訪道。","s":"歸天,去世,仙逝,逝世,死亡,亡故"},{"f":"稱人死亡。"},{"f":"縣名。位於福建省東部，木蘭溪北岸。"}]}],"仙郎":[{"b":"ㄒㄧㄢ ㄌㄤˊ","p":"xiān láng","d":[{"f":"面貌年輕的仙人。比喻俊美的青年。宋．張先〈醉桃源．仙郎何日是來期〉詞：「仙郎何日是來期？無心雲勝伊。」《