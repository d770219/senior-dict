{"䬳":[{"b":"","p":"","d":[{"f":"「粄」的異體字。"}]}],"乓":[{"b":"ㄆㄤ","p":"pāng","d":[{"f":"參見「乒乓」條。"}]}],"匃":[{"b":"","p":"","d":[{"f":"「丐」的異體字。"}]}],"屣":[{"b":"ㄒㄧˇ","p":"xǐ","d":[{"f":"鞋子。","t":"名","e":["如：「敝屣」。"]},{"f":"拖著鞋走路。","t":"動"},{"f":"放下、拋棄。","t":"動"}]}],"屣履":[{"b":"ㄒㄧˇ ㄌㄩˇ","p":"xǐ lǚ","d":[{"f":"鞋子還來不及穿好就舉步行路。形容匆忙的樣子。《後漢書．卷四九．王符傳》：「衣不及帶，屣履出迎。」晉．左思〈嬌女〉詩：「動為鑪鉦屈，屣履任之適。」也作「蹝履」、「躧履」。"}]}],"屣履造門":[{"b":"ㄒㄧˇ ㄌㄩˇ ㄗㄠˋ ㄇㄣˊ","p":"xǐ lǚ zào mén","d":[{"f":"鞋子還來不及穿好就登門拜訪。形容急於晉見或會見某人。"}]}],"巳":[{"b":"ㄙˋ","p":"sì","d":[{"f":"地支的第六位。","t":"名"},{"f":"時辰名。約當早晨九點到十一點。","t":"名"}]}],"巳時":[{"b":"ㄙˋ ㄕˊ","p":"sì shí","d":[{"f":"上午九點到十一點的時間。"}]}],"徃":[{"b":"","p":"","d":[{"f":"「往」的異體字。"}]}],"愓":[{"b":"ㄕㄤ","p":"shāng","d":[{"f":"參見「愓愓」條。"}]}],"愓愓":[{"b":"ㄕㄤ ㄕㄤ","p":"shāng shāng","d":[{"f":"走路身直而步快的樣子。"}]}],"搳":[{"b":"ㄏㄨㄚˊ","p":"huá","d":[{"f":"划拳。","t":"動","e":["如：「搳拳」。"]}]},{"b":"ㄒㄧㄚˊ","p":"xiá","d":[{"f":"搔。","t":"動"}]}],"搳拳":[{"b":"ㄏㄨㄚˊ ㄑㄩㄢˊ","p":"huá quán","d":[{"f":"猜拳，以手出數目決定勝負，飲酒時常以此助興。"}]}],"搳脫":[{"b":"ㄏㄨㄚˊ ㄊㄨㄛ","p":"huá tuō","d":[{"f":"吳語。指丟掉。"}]}],"旃":[{"b":"ㄓㄢ","p":"zhān","d":[{"f":"曲柄的旗子。","t":"名"},{"f":"泛指旗子、旌旗。","t":"名"},{"f":"毛織品。","t":"名"},{"f":"之焉二字的合讀。","t":"助"}]}],"旃檀":[{"b":"ㄓㄢ ㄊㄢˊ","p":"zhān tán","d":[{"f":"檀香。梵語Candana的音譯。唐．段成式《酉陽雜俎．卷一八．木篇》：「木五香，根旃檀，節沉香，花雞舌，葉藿，膠薰陸。」也作「栴檀」。"}]}],"旃毛":[{"b":"ㄓㄢ ㄇㄠˊ","p":"zhān máo","d":[{"f":"氈毛。"}]}],"旃裘":[{"b":"ㄓㄢ ㄑㄧㄡˊ","p":"zhān qiú","d":[{"f":"北方民族所穿的氈毛衣服。後用以代指北方民族。"}]}],"旃車":[{"b":"ㄓㄢ ㄔㄜ","p":"zhān chē","d":[{"f":"氈車。"}]}],"杓":[{"b":"ㄅㄧㄠ","p":"biāo","d":[{"f":"勺子的柄。","t":"名"},{"f":"北斗七星的柄，指第五到第七顆星。","t":"名"},{"f":"拉開。","t":"動"},{"f":"擊。","t":"動"}]},{"b":"ㄕㄠˊ","p":"sháo","d":[{"f":"取水、舀東西的器具。","t":"名"}]}],"杓倈":[{"b":"ㄕㄠˊ ㄌㄞˊ","p":"sháo lái","d":[{"f":"貪色的傻瓜。"}]}],"棣":[{"b":"ㄉㄧˋ","p":"dì","d":[{"f":"植物名。薔薇科李屬，「郁李」、「棠棣」、「常棣」之古稱。參見「郁李」條。","t":"名"},{"f":"年紀比自己小的男子。通「弟」。如「賢弟」也作「賢棣」。","t":"名"},{"f":"姓。如漢代有棣立。","t":"名"}]},{"b":"ㄊㄧˋ","p":"tì","d":[{"f":"通、達。","t":"副"}]}],"棣棣":[{"b":"ㄉㄧˋ ㄉㄧˋ","p":"dì dì","d":[{"f":"富盛而熟習的樣子。《詩經．邶風．柏舟》：「威儀棣棣，不可選也。」唐．李華〈弔古戰場文〉：「飲至策勛，和樂且閑，穆穆棣棣，君臣之間。」也作「逮逮」。"}]}],"棣華":[{"b":"ㄉㄧˋ ㄏㄨㄚ","p":"dì huā","d":[{"f":"比喻兄弟和睦相親，一若常棣繁茂，花朵豔麗。"},{"f":"比喻兄弟。"}]}],"棣鄂":[{"b":"ㄉㄧˋ ㄜˋ","p":"dì è","d":[{"f":"常棣花鄂之繁茂。語本《詩經．小雅．常棣》：「常棣之花，鄂不韡韡，凡今之人，莫如兄弟。」比喻兄弟相友愛。"},{"f":"比喻兄弟。","e":["如：「棣鄂聯輝」。"]}]}],"氃":[{"b":"ㄊㄨㄥˊ","p":"tóng","d":[{"f":"參見「氋氃」、「氃氋」等條。"}]}],"氃氋":[{"b":"ㄊㄨㄥˊ ㄇㄥˊ","p":"tóng méng","d":[{"f":"毛散亂的樣子。南朝宋．劉義慶《世說新語．排調》：「昔羊叔子有鶴善舞，嘗向客稱之。客試使驅來，氃氋而不肯舞。」也作「氋氃」。"}]}],"涓":[{"b":"ㄐㄩㄢ","p":"juān","d":[{"f":"細流。","t":"名"},{"f":"姓。如漢代有涓勛。","t":"名"},{"f":"細緩的、細微的。","t":"形","e":["如：「涓流」、「涓塵」。"]},{"f":"清潔的。參見「涓人」、「涓潔」等條。","t":"形"},{"f":"選擇。","t":"動"}]}],"涓人":[{"b":"ㄐㄩㄢ ㄖㄣˊ","p":"juān rén","d":[{"f":"古代掌管宮中清潔灑掃事宜的人。"}]}],"涓吉":[{"b":"ㄐㄩㄢ ㄐㄧˊ","p":"juān jí","d":[{"f":"涓，選擇。涓吉指擇取吉祥的日子。元．陶宗儀《南村輟耕錄．卷一〇．官倉入粟》：「今官府收斂秋糧之際，比先涓吉啟倉。」《聊齋志異．卷一一．陳雲棲》：「夫人亦喜，涓吉為之成禮。」也作「蠲吉」。"}]}],"涓埃":[{"b":"ㄐㄩㄢ ㄞ","p":"juān āi","d":[{"f":"細流輕塵。比喻微末、微小。"}]}],"涓流":[{"b":"ㄐㄩㄢ ㄌㄧㄡˊ","p":"juān liú","d":[{"f":"細小的水流。《隋書．卷四八．楊素傳》：「雖涓流赴海，誠心屢竭，輕塵集岳，功力蓋微。」後常比喻微小的事物。"}]}],"涓涓":[{"b":"ㄐㄩㄢ ㄐㄩㄢ","p":"juān juān","d":[{"f":"細水慢流的樣子。","a":"浩浩"},{"f":"形容眼淚、血液等不斷流出。"},{"f":"小水流。"},{"f":"形容清白、清新。"}]}],"涓滴":[{"b":"ㄐㄩㄢ ㄉㄧ","p":"juān dī","d":[{"f":"一滴一滴的流。"},{"f":"水滴。"},{"f":"比喻微少或極少的財物、利益。"}]}],"涓滴歸公":[{"b":"ㄐㄩㄢ ㄉㄧ ㄍㄨㄟ ㄍㄨㄥ","p":"juān dī guī gōng","d":[{"f":"涓滴，水滴，比喻微小或極少的東西。涓滴歸公指即使是極少量的財物，也要上繳給公家。《清史稿．卷二〇．文宗本紀》：「然必涓滴歸公，撙節動用，始得實濟。」形容秉公理財，不占公家便宜。《官場現形記》第三三回：「真正涓滴歸公，一絲一毫不敢亂用。」","a":"大飽私囊"}]}],"涓潔":[{"b":"ㄐㄩㄢ ㄐㄧㄝˊ","p":"juān jié","d":[{"f":"清潔。"}]}],"漣":[{"b":"ㄌㄧㄢˊ","p":"lián","d":[{"f":"水面的小波紋。","t":"名","e":["如：「漣漪」。"]},{"f":"參見「漣漣」條。","t":"形"}]}],"漣洏":[{"b":"ㄌㄧㄢˊ ㄦˊ","p":"lián ér","d":[{"f":"涕淚交流的樣子。"}]}],"漣洳":[{"b":"ㄌㄧㄢˊ ㄖㄨˋ","p":"lián rù","d":[{"f":"哭泣流淚的樣子。"}]}],"漣漣":[{"b":"ㄌㄧㄢˊ ㄌㄧㄢˊ","p":"lián lián","d":[{"f":"哭泣流淚的樣子。"}]}],"漣漪":[{"b":"ㄌㄧㄢˊ ㄧ","p":"lián yī","d":[{"f":"水面上細微的波紋。"}]}],"炳":[{"b":"ㄅㄧㄥˇ","p":"bǐng","d":[{"f":"顯著、光明。","t":"形","e":["如：「功業彪炳」。"]},{"f":"明白。","t":"副"},{"f":"持拿、執握。","t":"動"}]}],"炳如日星":[{"b":"ㄅㄧㄥˇ ㄖㄨˊ ㄖˋ ㄒㄧㄥ","p":"bǐng rú rì xīng","d":[{"f":"光耀如同日月星辰。形容非常盛大。宋．陸九淵〈貴溪重脩縣學記〉：「二帝三皇之書，先聖先師之訓，炳如日星。」也作「炳若日星」。"}]}],"炳曜":[{"b":"ㄅㄧㄥˇ ㄧㄠˋ","p":"bǐng yào","d":[{"f":"文采晶亮如明星。"}]}],"炳炳烺烺":[{"b":"ㄅㄧㄥˇ ㄅㄧㄥˇ ㄌㄤˇ ㄌㄤˇ","p":"bǐng bǐng lǎng lǎng","d":[{"f":"文采耀目的樣子。後用來指文章的辭藻聲韻。唐．柳宗元〈答韋中立論師道書〉：「是故不苟為炳炳烺烺，務采色夸聲音而以為能也。」也作「炳炳麟麟」。"}]}],"炳炳鑿鑿":[{"b":"ㄅㄧㄥˇ ㄅㄧㄥˇ ㄗㄨㄛˋ ㄗㄨㄛˋ","p":"bǐng bǐng zuò zuò","d":[{"f":"形容言語明確有據。"}]}],"炳炳麟麟":[{"b":"ㄅㄧㄥˇ ㄅㄧㄥˇ ㄌㄧㄣˊ ㄌㄧㄣˊ","p":"bǐng bǐng lín lín","d":[{"f":"光明耀目的樣子。《文選．揚雄．劇秦美新》：「帝典闕者已補，王綱弛者已張，炳炳麟麟，豈不懿哉！」也作「炳炳烺烺」。"}]}],"炳然":[{"b":"ㄅㄧㄥˇ ㄖㄢˊ","p":"bǐng rán","d":[{"f":"清楚、顯然可見的樣子。"}]}],"炳煥":[{"b":"ㄅㄧㄥˇ ㄏㄨㄢˋ","p":"bǐng huàn","d":[{"f":"光彩耀眼。"}]}],"炳燭":[{"b":"ㄅㄧㄥˇ ㄓㄨˊ","p":"bǐng zhú","d":[{"f":"燃燭照明。引喻日夜不輟，好學不倦。漢．劉向《說苑．卷三．建本》：「晉平公問於師曠曰：『吾年七十，欲學恐已暮矣。』師曠曰：『何不炳燭乎？』」也作「秉燭」。"}]}],"炳燭之明":[{"b":"ㄅㄧㄥˇ ㄓㄨˊ ㄓ ㄇㄧㄥˊ","p":"bǐng zhú zhī míng","d":[{"f":"微弱的光明。後比喻人老而好學。"}]}],"炳燭夜遊":[{"b":"ㄅㄧㄥˇ ㄓㄨˊ ㄧㄝˋ ㄧㄡˊ","p":"bǐng zhú yè yóu","d":[{"f":"因惋惜光陰易逝，故持燭夜裡遊玩。比喻及時行樂。三國．魏．曹丕〈與吳質書〉：「古人思炳燭夜遊，良有以也。」也作「秉燭夜遊」。"}]}],"炳若日星":[{"b":"ㄅㄧㄥˇ ㄖㄨㄛˋ ㄖˋ ㄒㄧㄥ","p":"bǐng ruò rì xīng","d":[{"f":"光耀如同日月星辰。形容非常盛大。宋．周煇《清波別志．卷上》：「仁皇一朝人才之盛，如文正公、文忠公、師魯，皆第一流人，名書國史，炳若日星，初不假於稱贊。」也作「炳如日星」。"}]}],"炳著":[{"b":"ㄅㄧㄥˇ ㄓㄨˋ","p":"bǐng zhù","d":[{"f":"彪炳卓著。","e":["如：「將軍一生馳騁沙場，功業炳著。」"]}]}],"炳蔚":[{"b":"ㄅㄧㄥˇ ㄨㄟˋ","p":"bǐng wèi","d":[{"f":"文采鮮明華美。"}]}],"炳賁":[{"b":"ㄅㄧㄥˇ ㄅㄧˋ","p":"bǐng bì","d":[{"f":"形容文章辭藻華麗耀目。"}]}],"炳靈寺":[{"b":"ㄅㄧㄥˇ ㄌㄧㄥˊ ㄙˋ","p":"bǐng líng sì","d":[{"f":"位於甘肅省永靖縣，是著名的石窟寺院。開鑿於西秦建弘元年，經北魏、北周至明，有洞窟三十四個，佛龕一百四十九個。洞窟格式與龍門、雲岡相似，佛龕風格採複缽式塔形，為此地石窟的特徵之一。"}]}],"珓":[{"b":"ㄐㄧㄠˋ","p":"jiào","d":[{"f":"拜神祭祖時占卜吉凶的器具。","t":"名","e":["如：「杯珓」、「聖珓」。"]}]}],"珓杯":[{"b":"ㄐㄧㄠˋ ㄅㄟ","p":"jiào bēi","d":[{"f":"以蚌殼或竹、木片做成的占卜用具，通常為一對。元．無名氏《替殺妻》第三折：「人間私語，天聞若雷。行道數十里地，見座神廟，我且問珓杯咱。」也作「杯珓」。"}]}],"盳":[{"b":"ㄇㄤˊ","p":"máng","d":[{"f":"","t":"名"}]}],"紳":[{"b":"ㄕㄣ","p":"shēn","d":[{"f":"古代官員束在腰間的大帶子。","t":"名"},{"f":"退職的官僚或地方上有名望的人。","t":"名","e":["如：「官紳」、「鄉紳」、「土豪劣紳」。"]},{"f":"約束。","t":"動"}]}],"紳商":[{"b":"ㄕㄣ ㄕㄤ","p":"shēn shāng","d":[{"f":"紳士與商人。","e":["如：「展覽會場中紳商雲集，氣氛熱絡。」"]}]}],"紳士":[{"b":"ㄕㄣ ㄕˋ","p":"shēn shì","d":[{"f":"退職居家，在地方上有聲望的人。","s":"名流"}]}],"紳士協定":[{"b":"ㄕㄣ ㄕˋ ㄒㄧㄝˊ ㄉㄧㄥˋ","p":"shēn shì xié dìng","d":[{"f":"不經書面共同簽字，只以信義為重，而不用法定手續的口頭協定。"}]}],"紳耆":[{"b":"ㄕㄣ ㄑㄧˊ","p":"shēn qí","d":[{"f":"地方上的紳士和年老有德望的人。"}]}],"紳董":[{"b":"ㄕㄣ ㄉㄨㄥˇ","p":"shēn dǒng","d":[{"f":"地方上有身分地位的人。"}]}],"紳衿":[{"b":"ㄕㄣ ㄐㄧㄣ","p":"shēn jīn","d":[{"f":"地方上退休的官員和士子。泛稱地方上有聲望的人。"}]}],"臣":[{"b":"ㄔㄣˊ","p":"chén","d":[{"f":"俘虜、奴隸。","t":"名"},{"f":"君王時代的官吏。","t":"名"},{"f":"古人對君、父或一般人的自謙之詞。","t":"名"},{"f":"姓。如漢代有臣綜。","t":"名"},{"f":"二一四部首之一。","t":"名"},{"f":"服從。","t":"動","e":["如：「臣服」。"]},{"f":"統率、使之服從而為臣。","t":"動"}]}],"臣一主二":[{"b":"ㄔㄣˊ ㄧ ㄓㄨˇ ㄦˋ","p":"chén yī zhǔ èr","d":[{"f":"人臣有自由擇主的權力。"}]}],"臣僚":[{"b":"ㄔㄣˊ ㄌㄧㄠˊ","p":"chén liáo","d":[{"f":"君主時代的官吏。"}]}],"臣妾":[{"b":"ㄔㄣˊ ㄑㄧㄝˋ","p":"chén qiè","d":[{"f":"稱服賤役的男女。"}]}],"臣子":[{"b":"ㄔㄣˊ ㄗˇ","p":"chén zǐ","d":[{"f":"舊時入仕者對國君的自稱。"}]}],"臣工":[{"b":"ㄔㄣˊ ㄍㄨㄥ","p":"chén gōng","d":[{"f":"群臣百官。"},{"f":"《詩經．周頌》的篇名。共一章。根據〈詩序〉：「臣工，諸侯助祭遣於廟也。」或以為春日祈穀時所歌之詩。本章二句為：「嗟嗟臣工，敬爾在公。」"}]}],"臣心如水":[{"b":"ㄔㄣˊ ㄒㄧㄣ ㄖㄨˊ ㄕㄨㄟˇ","p":"chén xīn rú shuǐ","d":[{"f":"形容心地廉潔清白。"}]}],"臣服":[{"b":"ㄔㄣˊ ㄈㄨˊ","p":"chén fú","d":[{"f":"奉人為君，自己稱臣。《三國志．卷四二．蜀書．譙周傳》：「自古以來，無寄他國為天子者也，今若入吳，固當臣服。」也作「臣事」。"},{"f":"服輸。","e":["如：「職棒年度總冠軍賽，雄獅發威，巨象臣服。」"]}]}],"臣民":[{"b":"ㄔㄣˊ ㄇㄧㄣˊ","p":"chén mín","d":[{"f":"君主國家的官吏與人民。"}]}],"臣門如市":[{"b":"ㄔㄣˊ ㄇㄣˊ ㄖㄨˊ ㄕˋ","p":"chén mén rú shì","d":[{"f":"形容門下鑽營請託的人很多，有如市場一樣熱鬧。"}]}],"荳":[{"b":"ㄉㄡˋ","p":"dòu","d":[{"f":"雙子葉植物的一科。種類甚多，實皆結莢。","t":"名"}]}],"荳芽菜":[{"b":"ㄉㄡˋ ㄧㄚˊ ㄘㄞˋ","p":"dòu yá cài","d":[{"f":"「豆芽菜」、「豆芽」的別名。參見「豆芽」條。"},{"f":"（歇後語）有甚綑兒。豆芽菜很不容易整理出條理來，所以通常是橫七豎八的包起來，而不是順枝順條的捆起來。形容沒有正當條理的行為。"}]}],"荳蔻":[{"b":"ㄉㄡˋ ㄎㄡˋ","p":"dòu kòu","d":[{"f":"植物名。薑科豆蔻屬。「豆蔻」之別稱。參見「豆蔻」條。"},{"f":"比喻十三、四歲的年輕美少女。也作「豆蔻」。"}]}],"荳蔻年華":[{"b":"ㄉㄡˋ ㄎㄡˋ ㄋㄧㄢˊ ㄏㄨㄚˊ","p":"dòu kòu nián huá","d":[{"f":"荳蔻開花的時間。比喻女子十三、四歲的年紀。如：「正值荳蔻年華的她，總是充滿活力朝氣。」也作「豆蔻年華」。"}]}],"蚓":[{"b":"ㄧㄣˇ","p":"yǐn","d":[{"f":"參見「蚯蚓」條。"}]}],"蚓廉":[{"b":"ㄧㄣˇ ㄌㄧㄢˊ","p":"yǐn lián","d":[{"f":"蚯蚓只吃土和水，別無所求，沒有心機見識。故以蚓廉比喻人謹守小節而不通達。"}]}],"蠣":[{"b":"ㄌㄧˋ","p":"lì","d":[{"f":"參見「牡蠣」條。"}]}],"蠣塘":[{"b":"ㄌㄧˋ ㄊㄤˊ","p":"lì táng","d":[{"f":"養殖牡蠣的海塘。"}]}],"蠣房":[{"b":"ㄌㄧˋ ㄈㄤˊ","p":"lì fáng","d":[{"f":"牡蠣的殼。"}]}],"蠣粉":[{"b":"ㄌㄧˋ ㄈㄣˇ","p":"lì fěn","d":[{"f":"牡蠣殼所燒成的灰。可以用來塗壁，或牡蠣殼經火鍛赤後，研磨成的粉，可作藥用。見明．李時珍《本草綱目．卷四六．介部．牡蠣》。"}]}],"蠣鷸":[{"b":"ㄌㄧˋ ㄩˋ","p":"lì yù","d":[{"f":"動物名。一種濱鳥。鷸目蠣鷸科。見於溫帶至熱帶地區。體型粗短，嘴長而扁，楔形，橙紅色。翼長而尖，羽色由黑、白花至全黑，唯腹部呈白色。腿為緋紅色。群棲於海濱，主要以軟體動物如牡蠣、蛤、貽貝等為食。"}]}],"蠣黃":[{"b":"ㄌㄧˋ ㄏㄨㄤˊ","p":"lì huáng","d":[{"f":"牡蠣的肉。"}]}],"賓":[{"b":"ㄅㄧㄣ","p":"bīn","d":[{"f":"客人。與「主」相對。","t":"名","e":["如：「來賓」、「貴賓」、「喧賓奪主」、「賓至如歸」。"]},{"f":"姓。如春秋時齊國有賓須無。","t":"名"},{"f":"以禮對待。","t":"動"},{"f":"歸順、服從。","t":"動"}]},{"b":"ㄅㄧㄣˋ","p":"bìn","d":[{"f":"擯棄。","t":"動"}]}],"賓主":[{"b":"ㄅㄧㄣ ㄓㄨˇ","p":"bīn zhǔ","d":[{"f":"賓客與主人。"}]}],"賓主盡歡":[{"b":"ㄅㄧㄣ ㄓㄨˇ ㄐㄧㄣˋ ㄏㄨㄢ","p":"bīn zhǔ jìn huān","d":[{"f":"主、客間相聚融洽，都能盡興、歡愉。"}]}],"賓主禮":[{"b":"ㄅㄧㄣ ㄓㄨˇ ㄌㄧˇ","p":"bīn zhǔ lǐ","d":[{"f":"賓客、主人間寒暄的禮數。"}]}],"賓之初筵":[{"b":"ㄅㄧㄣ ㄓ ㄔㄨ ㄧㄢˊ","p":"bīn zhī chū yán","d":[{"f":"《詩經．小雅》的篇名。共五章。"}]}],"賓享":[{"b":"ㄅㄧㄣ ㄒㄧㄤˇ","p":"bīn xiǎng","d":[{"f":"接待。"}]}],"賓位":[{"b":"ㄅㄧㄣ ㄨㄟˋ","p":"bīn wèi","d":[{"f":"客位。"},{"f":"文句中賓詞所處的位置。"}]}],"賓友":[{"b":"ㄅㄧㄣ ㄧㄡˇ","p":"bīn yǒu","d":[{"f":"充當賓客及朋友，以達相互來往、習道問藝的目的。"}]}],"賓器":[{"b":"ㄅㄧㄣ ㄑㄧˋ","p":"bīn qì","d":[{"f":"祭祀時盛放牲品的器具和樂器。"}]}],"賓士":[{"b":"ㄅㄧㄣ ㄕˋ","p":"bīn shì","d":[{"f":"賓客。"},{"f":"接待士人。"},{"f":"德國製的汽車品牌名。為德語benz的音譯，西元一八八五年推出第一部，後經多年的技術改進，成為今日世界名車之一。也譯作「朋馳」。"}]}],"賓夕法尼亞州":[{"b":"ㄅㄧㄣ ㄒㄧˋ ㄈㄚˇ ㄋㄧˊ ㄧㄚˋ ㄓㄡ","p":"bīn xì fǎ ní yà zhōu","d":[{"f":"州名。位於美國東部，面積十一萬七千四百十二平方公里，有煤、鐵等礦產，工業很盛，農產品有穀、麥、菸草等。"}]}],"賓天":[{"b":"ㄅㄧㄣ ㄊㄧㄢ","p":"bīn tiān","d":[{"f":"飛昇至天，而成為上帝之賓。借指帝王去世。"},{"f":"泛指尊者去世。"}]}],"賓宇":[{"b":"ㄅㄧㄣ ㄩˇ","p":"bīn yǔ","d":[{"f":"賓客所居住的地方。"}]}],"賓客":[{"b":"ㄅㄧㄣ ㄎㄜˋ","p":"bīn kè","d":[{"f":"泛稱客人。","s":"客人","a":"主人"},{"f":"別國來的使者。"},{"f":"古代豪門所養的食客。"}]}],"賓客填門":[{"b":"ㄅㄧㄣ ㄎㄜˋ ㄊㄧㄢˊ ㄇㄣˊ","p":"bīn kè tián mén","d":[{"f":"形容客人很多。","s":"賓客如雲","a":"門可羅雀"}]}],"賓客如雲":[{"b":"ㄅㄧㄣ ㄎㄜˋ ㄖㄨˊ ㄩㄣˊ","p":"bīn kè rú yún","d":[{"f":"形容客人很多。","s":"賓客填門","a":"門可羅雀"}]}],"賓客盈庭":[{"b":"ㄅㄧㄣ ㄎㄜˋ ㄧㄥˊ ㄊㄧㄥˊ","p":"bīn kè yíng tíng","d":[{"f":"形容客人很多。","e":["如：「李奶奶八十大壽的那天，想必賓客盈庭，熱鬧非凡。」"],"s":"三千珠履"}]}],"賓客盈門":[{"b":"ㄅㄧㄣ ㄎㄜˋ ㄧㄥˊ ㄇㄣˊ","p":"bīn kè yíng mén","d":[{"f":"形容客人很多。","s":"賓朋滿座,高朋滿座"}]}],"賓實":[{"b":"ㄅㄧㄣ ㄕˊ","p":"bīn shí","d":[{"f":"名稱和實際。"}]}],"賓師":[{"b":"ㄅㄧㄣ ㄕ","p":"bīn shī","d":[{"f":"不居官職而地位尊貴的人。"},{"f":"動物名。一種鳥。"}]}],"賓待":[{"b":"ㄅㄧㄣ ㄉㄞˋ","p":"bīn dài","d":[{"f":"以客禮相待。"}]}],"賓從":[{"b":"ㄅㄧㄣ ㄘㄨㄥˊ","p":"bīn cóng","d":[{"f":"﻿歸順、服從。"}]}],"賓旅":[{"b":"ㄅㄧㄣ ㄌㄩˇ","p":"bīn lǚ","d":[{"f":"旅客。"}]}],"賓朋":[{"b":"ㄅㄧㄣ ㄆㄥˊ","p":"bīn péng","d":[{"f":"賓客好友。"}]}],"賓朋滿座":[{"b":"ㄅㄧㄣ ㄆㄥˊ ㄇㄢˇ ㄗㄨㄛˋ","p":"bīn péng mǎn zuò","d":[{"f":"賓客盈門。形容來客甚多。","e":["如：「這飯店一開張，馬上賓朋滿座。」"],"s":"賓朋盈門,賓客盈門,高朋滿座"}]}],"賓服":[{"b":"ㄅㄧㄣ ㄈㄨˊ","p":"bīn fú","d":[{"f":"古代諸侯入貢朝見天子。引申為歸順臣服。"},{"f":"佩服。","e":["如：「他以敏捷身手，榮獲拳擊冠軍，觀眾對他賓服之至。」"]}]}],"賓東":[{"b":"ㄅㄧㄣ ㄉㄨㄥ","p":"bīn dōng","d":[{"f":"古代主人的坐位在東，客人的坐位在西，因此稱賓主關係為「賓東」。"},{"f":"賓客之東。"}]}],"賓果":[{"b":"ㄅㄧㄣ ㄍㄨㄛˇ","p":"bīn guǒ","d":[{"f":"一種美式遊戲。為英語bingo的音譯。由羅特（lotto）轉化而來，遊戲規則為從袋中取出有號碼的牌子，放在有相當號碼的盤上，以先能排成一列或特定圖形者為優勝。"}]}],"賓次":[{"b":"ㄅㄧㄣ ㄘˋ","p":"bīn cì","d":[{"f":"接待賓客的地方。"},{"f":"文句中賓語所處的位置。"}]}],"賓漢":[{"b":"ㄅㄧㄣ ㄏㄢˋ","p":"bīn hàn","d":[{"f":"書名。美國華萊士(Lew Wallace）所著小說，西元一八八〇年出版。故事取材於聖經，描寫一位名叫賓漢（Judah Ben Hur）的猶太貴族，傳言有意謀害羅馬駐巴勒斯坦總督，以致被捕下獄，在船上受苦役多年。後成為羅馬軍官，在戰車競賽中擊敗惡友梅薩樂(Messala）。"}]}],"賓白":[{"b":"ㄅㄧㄣ ㄅㄞˊ","p":"bīn bái","d":[{"f":"賓，兩人對語。白，一人自語。賓白指戲曲中人物的內心獨白和對話。有韻白、口白兩種，韻白接近官話，有明顯的旋律和節奏變化，字音較為拖長；口白較接近各地方日常語言，但又比口語誇張。"}]}],"賓禮":[{"b":"ㄅㄧㄣ ㄌㄧˇ","p":"bīn lǐ","d":[{"f":"古代五禮之一。為國際間的一種禮節。"},{"f":"以賓客之禮相待。"}]}],"賓至如歸":[{"b":"ㄅㄧㄣ ㄓˋ ㄖㄨˊ ㄍㄨㄟ","p":"bīn zhì rú guī","d":[{"f":"客人來到這裡就好像回到自己的家裡。語出《左傳．襄公三十一年》：「賓至如歸，無寧菑患，不畏寇盜，而亦不患燥濕。」後形容招待親切，使客人如同回到家裡一樣舒適。如：「每次到他家，都有賓至如歸的感覺。」《東周列國志》第七八回：「四方之客，一入魯境，皆有常供，不至缺乏，賓至如歸。」"}]}],"賓興":[{"b":"ㄅㄧㄣ ㄒㄧㄥ","p":"bīn xīng","d":[{"f":"周代從鄉小學選出賢能的人，以上賓之禮升於國學。"},{"f":"科舉時代，士子將參加鄉試時，地方官設宴款待，稱為「賓興」。"}]}],"賓萌":[{"b":"ㄅㄧㄣ ㄇㄥˊ","p":"bīn méng","d":[{"f":"戰國時往來諸侯國之間的遊士。也作「賓孟」。"},{"f":"由他處遷至此地居住的人。"}]}],"賓詞":[{"b":"ㄅㄧㄣ ㄘˊ","p":"bīn cí","d":[{"f":"句法中承受主語的動作者，有直接和間接兩種。"}]}],"賓語":[{"b":"ㄅㄧㄣ ㄩˇ","p":"bīn yǔ","d":[{"f":"句法中承受主語的動作者，有直接和間接二種。如「他給我一本書」其中「書」為直接賓語，「我」為間接賓語。"}]}],"賓貢":[{"b":"ㄅㄧㄣ ㄍㄨㄥˋ","p":"bīn gòng","d":[{"f":"古代鄉舉，地方官員設宴款待應舉的學子，稱為「賓貢」。"},{"f":"稱他國的貢士。"},{"f":"臣服。"}]}],"賓賓":[{"b":"ㄅㄧㄣ ㄅㄧㄣ","p":"bīn bīn","d":[{"f":"恭敬的樣子。"}]}],"賓郎":[{"b":"ㄅㄧㄣ ㄌㄤˊ","p":"bīn láng","d":[{"f":"檳榔的別名。參見「檳榔」條。"},{"f":"牛鼻上套的圈子。"}]}],"賓鐵":[{"b":"ㄅㄧㄣ ㄊㄧㄝˇ","p":"bīn tiě","d":[{"f":"精煉且堅硬的鐵。《宋史．卷四九〇．外國列傳六．高昌》：「又有礪石，剖之得賓鐵，謂之喫鐵石。」也作「鑌鐵」。"},{"f":"遼的稱號。"}]}],"賓館":[{"b":"ㄅㄧㄣ ㄍㄨㄢˇ","p":"bīn guǎn","d":[{"f":"接待賓客住宿或休息的館舍。"}]}],"賓鴻":[{"b":"ㄅㄧㄣ ㄏㄨㄥˊ","p":"bīn hóng","d":[{"f":"鴻鳥。"}]}],"蹣":[{"b":"ㄆㄢˊ","p":"pán","d":[{"f":"參見「蹣跚」條。"}]},{"b":"ㄇㄢˊ","p":"mán","d":[{"f":"踰越。","t":"動","e":["如：「蹣山渡水」。"]}]}],"蹣跚":[{"b":"ㄆㄢˊ ㄕㄢ","p":"pán shān","d":[{"f":"形容步伐不穩，歪歪斜斜的樣子。《幼學瓊林．卷二．身體類》：「足跛曰『蹣跚』。」也作「盤跚」。","a":"矯健"},{"f":"旋行的樣子。"}]}],"蹣跼":[{"b":"ㄆㄢˊ ㄐㄩˊ","p":"pán jú","d":[{"f":"形容步伐不穩，歪歪斜斜的樣子。"}]}],"醃":[{"b":"ㄧㄢ","p":"yān","d":[{"f":"用鹽、糖、酒等調味料浸漬食物。","t":"動","e":["如：「醃肉」。"]}]}],"醃漬":[{"b":"ㄧㄢ ㄗˋ","p":"yān zì","d":[{"f":"將食物加鹽、糖、醬或各種佐料加以浸泡的調理方法。","e":["如：「這些蜜餞的醃漬過程不夠完善，所以顧客吃了會拉肚子。」"]}]}],"醃肉":[{"b":"ㄧㄢ ㄖㄡˋ","p":"yān ròu","d":[{"f":"鹽漬或燻製的肉。","e":["如：「春節氣氛漸濃，臘肉店的醃肉也傳來陣陣的肉香。」"]}]}],"醃臘":[{"b":"ㄧㄢ ㄌㄚˋ","p":"yān là","d":[{"f":"一種食品加工法。將肉品以醬汁鹽液浸漬或塗抹調味料後以火燻烤，避免腐敗。"}]}],"醃菜":[{"b":"ㄧㄢ ㄘㄞˋ","p":"yān cài","d":[{"f":"泛稱用鹽或各種香料浸泡脫去水分的蔬菜。","e":["如：「老店號新產品，他們的醃菜口感不凡，吃來舌齒生津。」"]}]}],"醃製":[{"b":"ㄧㄢ ㄓˋ","p":"yān zhì","d":[{"f":"以醃漬方法所製成。","e":["如：「媽媽醃製的醬瓜非常好吃。」"]}]}],"醃魚":[{"b":"ㄧㄢ ㄩˊ","p":"yān yú","d":[{"f":"泛稱用鹽醃製的魚類食品。"}]}],"韃":[{"b":"ㄉㄚˊ","p":"dá","d":[{"f":"參見「韃靼」、「韃子」等條。"}]}],"韃虜":[{"b":"ㄉㄚˊ ㄌㄨˇ","p":"dá lǔ","d":[{"f":"金人。後泛指外來民族。宋．羅大經《鶴林玉露．甲編．卷四．春秋書國滅》:「近時韃虜入蔡，殘金之主守緖，乃能聚薪自焚，義不受辱，庶幾於江、黃。」《醒世恆言．卷三．賣油郎獨占花魁》：「擔渴擔飢擔勞苦，此行誰是家鄉；叫天叫地叫祖宗，惟願不逢韃虜。」"}]}],"韃靼":[{"b":"ㄉㄚˊ ㄉㄚˊ","p":"dá dá","d":[{"f":"唐末蒙古種族之一。是契丹的西北族，沙陀的別種，散居在中國西北、蒙古、中亞、獨立國協東部等地。元亡後，其宗族走漠北，於清時歸附。"}]}],"韃靼海峽":[{"b":"ㄉㄚˊ ㄉㄚˊ ㄏㄞˇ ㄒㄧㄚˊ","p":"dá dá hǎi xiá","d":[{"f":"海峽名。在亞洲東北部，介於亞洲大陸和庫頁島之間，寬度從七公里至三百四十二公里，全長約六百三十二公里。南連日本海，北經庫頁灣（薩哈林灣）通鄂霍次克海。黑龍江出口即在韃靼海峽北端。"}]}],"髣":[{"b":"ㄈㄤˇ","p":"fǎng","d":[{"f":"參見「髣髴」條。"}]}],"髣髴":[{"b":"ㄈㄤˇ ㄈㄨˊ","p":"fǎng fú","d":[{"f":"似乎、好像、近似。晉．陶淵明〈桃花源記〉：「山有小口，髣髴若有光。」宋．蘇軾〈臨江仙．夜飲東坡醒復醉〉詞：「夜飲東坡醒復醉，歸來髣髴三更。」也作「仿佛」、「彷彿」。","s":"類似,好像"}]}],"鸃":[{"b":"ㄧˊ","p":"yí","d":[{"f":"參見「鵔鸃」條。"}]}],"𨉣":[{"b":"ㄏㄚ","p":"hā","d":[{"f":"彎腰。","t":"動","e":["如：「點頭𨉣腰」。"]}]}],"𨉣腰":[{"b":"ㄏㄚ ㄧㄠ","p":"hā yāo","d":[{"f":"彎腰。也作「哈腰」。"},{"f":"舊時一種輕簡之禮，稍微彎腰，略如鞠躬，以表示禮貌。也作「哈腰」。"}]}],"󰨳":[{"b":"","p":"","d":[{"f":"「厄」的異體字。"}]}]}