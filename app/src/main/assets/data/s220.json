{"傌":[{"b":"ㄇㄚˇ","p":"mǎ","d":[{"f":"象棋遊戲中，紅色棋子「馬」作「傌」，以示區別於黑子的「馬」。","t":"名"}]},{"b":"ㄇㄚˋ","p":"mà","d":[{"f":"漢代刑罰之一。","t":"名"}]}],"刜":[{"b":"ㄈㄨˊ","p":"fú","d":[{"f":"用刀砍擊。","t":"動"}]}],"唼":[{"b":"ㄑㄧㄝˋ","p":"qiè","d":[{"f":"參見「唼佞」條。"}]},{"b":"ㄕㄚˋ","p":"shà","d":[{"f":"蟲咬東西。","t":"動","e":["如：「這棵死樹根螞蟻唼了。」"]},{"f":"魚、鳥在水中覓食。參見「唼喋」條。","t":"動"},{"f":"除掉沒有用的東西。","t":"動","e":["如：「用篩子唼細土。」、「吃飲時將沙唼出。」"]},{"f":"小孔洩氣。參見「唼氣」條。","t":"動"}]},{"b":"ㄗㄚ","p":"zā","d":[{"f":"食。","t":"動"}]}],"唼佞":[{"b":"ㄑㄧㄝˋ ㄋㄧㄥˋ","p":"qiè nìng","d":[{"f":"誹謗的言論。"}]}],"唼唼":[{"b":"ㄕㄚˋ ㄕㄚˋ","p":"shà shà","d":[{"f":"擬聲詞。形容吃東西的聲音。"}]}],"唼喋":[{"b":"ㄕㄚˋ ㄓㄚˊ","p":"shà zhá","d":[{"f":"擬聲詞。形容水鳥或魚類吃食的聲音。《文選．司馬相如．上林賦》：「唼喋菁藻，咀嚼菱藕。」也作「啑喋」。"}]}],"唼氣":[{"b":"ㄕㄚˋ ㄑㄧˋ","p":"shà qì","d":[{"f":"器物因有小孔而洩氣。多指汽車、摩托車等的輪胎而言。"}]}],"唼眼":[{"b":"ㄕㄚˋ ㄧㄢˇ","p":"shà yǎn","d":[{"f":"器物上的小洞兒。"}]}],"唼血":[{"b":"ㄕㄚˋ ㄒㄩㄝˋ","p":"shà xuè","d":[{"f":"古時盟誓時，以牲血塗口表示守信。"},{"f":"殺人血流漫地。多指戰爭時而言。"}]}],"囌":[{"b":"ㄙㄨ","p":"sū","d":[{"f":"參見「嚕囌」條。"}]}],"姬":[{"b":"ㄐㄧ","p":"jī","d":[{"f":"古代對婦女的美稱。","t":"名","e":["如：「美姬」、「虞姬」、「戚姬」。"]},{"f":"古代對妾的通稱。","t":"名","e":["如：「侍姬」、「寵姬」。"]},{"f":"舊稱從事歌舞表演的女子。","t":"名","e":["如：「歌舞姬」。"]},{"f":"姓。如漢代有姬嘉。","t":"名"}]}],"姬侍":[{"b":"ㄐㄧ ㄕˋ","p":"jī shì","d":[{"f":"侍妾。《北齊書．卷一四．上洛王思宗傳》：「便縱酒肆情，廣納姬侍。」《新唐書．卷二二三．奸臣傳下．盧杞傳》：「初尚父郭子儀病甚，百官造省，不屏姬侍。」也作「姬人」、「姬媵」。"}]}],"姬妾":[{"b":"ㄐㄧ ㄑㄧㄝˋ","p":"jī qiè","d":[{"f":"女妾、妾侍。"}]}],"姬姜":[{"b":"ㄐㄧ ㄐㄧㄤ","p":"jī jiāng","d":[{"f":"春秋時代，周王室姓姬，齊國姓姜，二國常通婚，故用以稱貴族婦女。"},{"f":"泛指美人。"}]}],"姬漢":[{"b":"ㄐㄧ ㄏㄢˋ","p":"jī hàn","d":[{"f":"姬，因周天子姓姬，故稱周代為「姬」。姬漢指周、漢兩代。南朝梁．蕭統〈文選序〉：「自姬漢以來，眇焉悠邈，時更七代。」後泛指漢族。《文選．丘遲．與陳伯之書》：「姬漢舊邦，無取雜種。」"}]}],"姬鼠":[{"b":"ㄐㄧ ㄕㄨˇ","p":"jī shǔ","d":[{"f":"動物名。嚙齒目鼠科姬鼠屬，產於亞、歐洲等溫帶地區。體小，尾長，呈灰色、褐色、或紅褐色。生活於田野或森林間，以植物的莖、葉、根為食，常為害作物。"}]}],"孼":[{"b":"","p":"","d":[{"f":"「孽」的異體字。"}]}],"府":[{"b":"ㄈㄨˇ","p":"fǔ","d":[{"f":"儲藏文書或財物的地方。","t":"名"},{"f":"官署，官員辦公的地方。","t":"名","e":["如：「官府」、「首府」、「總統府」。"]},{"f":"古代介於省、縣間的地方行政機構。","t":"名","e":["如：「開封府」、「徐州府」。"]},{"f":"達官顯貴的住所。","t":"名","e":["如：「王府」。"]},{"f":"尊稱別人的居處。","t":"名","e":["如：「尊府」、「貴府」、「造府請教」。"]},{"f":"泛指人、物聚集的地方。","t":"名"},{"f":"姓。如漢代有府悝。","t":"名"}]}],"府上":[{"b":"ㄈㄨˇ ㄕㄤˋ","p":"fǔ shàng","d":[{"f":"尊稱別人的家宅。","s":"貴寓,尊府"}]}],"府丞":[{"b":"ㄈㄨˇ ㄔㄥˊ","p":"fǔ chéng","d":[{"f":"職官名：(1)太守的屬官。《後漢書．卷三一．羊續傳》：「續為南陽太守。……府丞嘗獻其生魚，續受而懸於庭；丞後又進之，續乃出前所懸者以杜其意。」(2)清代宗人府設置的官員，掌本府漢文典籍。《清史稿．卷一一四．職官志一》：「宗人府，……府丞掌校漢文冊籍。」"}]}],"府主":[{"b":"ㄈㄨˇ ㄓㄨˇ","p":"fǔ zhǔ","d":[{"f":"掌府政的官。"},{"f":"幕職人員對其長官的稱呼。"}]}],"府佐":[{"b":"ㄈㄨˇ ㄗㄨㄛˇ","p":"fǔ zuǒ","d":[{"f":"幫助知府辦事的官吏。"}]}],"府兵":[{"b":"ㄈㄨˇ ㄅㄧㄥ","p":"fǔ bīng","d":[{"f":"古代一種兵制。始於西魏，北周、隋唐沿用。北周府兵是兵民分籍，由軍人自相督率，隸屬軍府管轄，唐代則改為軍民合一，軍納入戶籍，隸屬州縣。府兵選自兵區家富而體健子弟，年二十當兵，年六十退役。不擔任其他徭役，須自備糧食衣裝。平時得農耕、教戰，戰時出征，尚須入京宿衛。"}]}],"府君":[{"b":"ㄈㄨˇ ㄐㄩㄣ","p":"fǔ jūn","d":[{"f":"漢代太守的尊稱。"},{"f":"子孫對已故者的敬稱。"},{"f":"對尊者長者的尊稱。"}]}],"府城":[{"b":"ㄈㄨˇ ㄔㄥˊ","p":"fǔ chéng","d":[{"f":"較縣高一級的州、郡府治的所在地。"}]}],"府報":[{"b":"ㄈㄨˇ ㄅㄠˋ","p":"fǔ bào","d":[{"f":"尊稱別人家的書信。"}]}],"府學":[{"b":"ㄈㄨˇ ㄒㄩㄝˊ","p":"fǔ xué","d":[{"f":"古代府州縣皆設學，直屬於府者為府學。"}]}],"府宅":[{"b":"ㄈㄨˇ ㄓㄜˋ","p":"fǔ zhè","d":[{"f":"府第宅院。指富貴人家。"}]}],"府尊":[{"b":"ㄈㄨˇ ㄗㄨㄣ","p":"fǔ zūn","d":[{"f":"舊時人民對知府的尊稱。"}]}],"府小吏":[{"b":"ㄈㄨˇ ㄒㄧㄠˇ ㄌㄧˋ","p":"fǔ xiǎo lì","d":[{"f":"太守府中的小吏。"}]}],"府尹":[{"b":"ㄈㄨˇ ㄧㄣˇ","p":"fǔ yǐn","d":[{"f":"職官名。始於漢代於京畿置的京兆尹，掌地方行政。唐代西都、東都、北都亦各置府尹，明、清襲之。後泛指太守。"}]}],"府帑":[{"b":"ㄈㄨˇ ㄊㄤˇ","p":"fǔ tǎng","d":[{"f":"國庫、庫金。"}]}],"府幹":[{"b":"ㄈㄨˇ ㄍㄢˋ","p":"fǔ gàn","d":[{"f":"府中差役。"}]}],"府庫":[{"b":"ㄈㄨˇ ㄎㄨˋ","p":"fǔ kù","d":[{"f":"國家儲藏財物的處所。"}]}],"府快":[{"b":"ㄈㄨˇ ㄎㄨㄞˋ","p":"fǔ kuài","d":[{"f":"捕班衙役。"}]}],"府會":[{"b":"ㄈㄨˇ ㄏㄨㄟˋ","p":"fǔ huì","d":[{"f":"政府與議會。","e":["如：「新任市長特別關注府會關係的和諧。」"]}]}],"府治":[{"b":"ㄈㄨˇ ㄓˋ","p":"fǔ zhì","d":[{"f":"一府最高行政官署的所在地。"}]}],"府第":[{"b":"ㄈㄨˇ ㄉㄧˋ","p":"fǔ dì","d":[{"f":"貴族官吏或大地主的住宅。"}]}],"府綢":[{"b":"ㄈㄨˇ ㄔㄡˊ","p":"fǔ chóu","d":[{"f":"一種絲織品。柞蠶絲所織的綢，質地細密平滑，有光澤，而耐用，產於山東歷城、蓬萊等縣。"}]}],"府衙":[{"b":"ㄈㄨˇ ㄧㄚˊ","p":"fǔ yá","d":[{"f":"府城行政機關的所在地。"}]}],"府邸":[{"b":"ㄈㄨˇ ㄉㄧˇ","p":"fǔ dǐ","d":[{"f":"王侯府第。"}]}],"怬":[{"b":"ㄙˋ","p":"sì","d":[{"f":"欣喜。","t":"動"},{"f":"休息。","t":"動"}]}],"捌":[{"b":"ㄅ