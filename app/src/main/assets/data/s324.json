{"佤":[{"b":"ㄨㄚˇ","p":"wǎ","d":[{"f":"參見「佤族」條。"}]}],"佤族":[{"b":"ㄨㄚˇ ㄗㄨˊ","p":"wǎ zú","d":[{"f":"中國少數民族之一。主要分布在雲南省西南山區中。語言屬南亞語系孟高棉語族的佤德昂語支，有拉丁字母形式的文字推廣。信仰以崇拜自然為主。家庭組織為一夫一妻制，行自由戀愛，稱為「串姑娘」。傳統族習中有獵人頭祭。舊稱為「哈喇」、「佧喇」、「佧佤」。"}]}],"佤語":[{"b":"ㄨㄚˇ ㄩˇ","p":"wǎ yǔ","d":[{"f":"佤人使用的語言。屬南亞語系孟高棉語族。分布在雲南和緬甸。基本語序為主語、謂語、賓語。人稱代名詞有單數、雙數和多數的區分。大部分的語詞由單音節的語根構成。"}]}],"劄":[{"b":"ㄓㄚˊ","p":"zhá","d":[{"f":"書信。","t":"名","e":["如：「信劄」。"]},{"f":"公文。","t":"名","e":["如：「劄子」。"]},{"f":"筆記。如清朝趙翼有《廿二史劄記》。","t":"名"}]}],"劄付":[{"b":"ㄓㄚˊ ㄈㄨˋ","p":"zhá fù","d":[{"f":"官府下行的文書。《儒林外史》第四〇回：「奉旨：『著往新任』，蕭雲仙領了劄付出京，走東路來南京。」也作「札付」。"}]}],"劄子":[{"b":"ㄓㄚˊ ˙ㄗ","p":"zhá zi","d":[{"f":"官府中的往來文書。宋．歐陽修《歸田錄》卷二：「唐人奏事，非表非狀者，謂之牓子，亦謂之錄子，今謂之劄子。」也作「札子」。"}]}],"劄記":[{"b":"ㄓㄚˊ ㄐㄧˋ","p":"zhá jì","d":[{"f":"讀書時摘記下來的要點或心得。如清．錢大昕有《潛丘劄記》，趙翼有《二十二史劄記》。也作「札記」。"}]}],"吔":[{"b":"˙ㄧㄝ","p":"ye","d":[{"f":"表示感嘆、驚訝等語氣。","t":"歎","e":["如：「吔！你這麼做，真叫人吃驚！」"]}]}],"喤":[{"b":"ㄏㄨㄤˊ","p":"huáng","d":[{"f":"參見「喤喤」條。"}]}],"喤喤":[{"b":"ㄏㄨㄤˊ ㄏㄨㄤˊ","p":"huáng huáng","d":[{"f":"擬聲詞：(1)形容小孩的啼哭聲。《詩經．小雅．斯干》：「乃生男子，載寢之床，載衣之裳，載弄之璋，其泣喤喤。」(2)形容聲音洪亮而和諧。《詩經．周頌．執競》：「鐘鼓喤喤，磬筦將將。」"}]}],"壄":[{"b":"","p":"","d":[{"f":"「野」的異體字。"}]}],"寤":[{"b":"ㄨˋ","p":"wù","d":[{"f":"睡醒。","t":"動"},{"f":"覺悟、醒悟。","t":"動"}]}],"寤夢":[{"b":"ㄨˋ ㄇㄥˋ","p":"wù mèng","d":[{"f":"白晝有所見而夜有所夢。"},{"f":"睡夢之中，半夢半醒之間。"}]}],"寤寐":[{"b":"ㄨˋ ㄇㄟˋ","p":"wù mèi","d":[{"f":"寤，睡醒。寐，就寢。「寤寐」，醒時睡時，表示時時刻刻。"}]}],"寤寐以求":[{"b":"ㄨˋ ㄇㄟˋ ㄧˇ ㄑㄧㄡˊ","p":"wù mèi yǐ qiú","d":[{"f":"形容願望強烈、迫切，隨時都想得到。","e":["如：「經過多年努力，他終於娶得寤寐以求的佳人。」"]}]}],"寤懷":[{"b":"ㄨˋ ㄏㄨㄞˊ","p":"wù huái","d":[{"f":"顧念懷思。《楚辭．屈原．九歌．河伯》：「日將暮兮悵忘歸，惟極浦兮寤懷。」也作「顧懷」。"}]}],"寤生":[{"b":"ㄨˋ ㄕㄥ","p":"wù shēng","d":[{"f":"難產，生產時胎兒腳部先出來。"}]}],"弄":[{"b":"ㄋㄨㄥˋ","p":"nòng","d":[{"f":"把玩、玩賞。","t":"動"},{"f":"遊戲、耍弄。","t":"動"},{"f":"做、從事。","t":"動"},{"f":"處理、探察、追究。","t":"動","e":["如：「這件事一定要弄清楚才行！」"]},{"f":"尋求、取得。","t":"動"},{"f":"搖動、攪動。","t":"動","e":["如：「這消息把大家弄得人心惶惶。」"]},{"f":"與人淫亂、姦汙。","t":"動"},{"f":"演奏樂器。","t":"動","e":["如：「弄笛」、「弄簫」。"]},{"f":"妝飾、修飾。","t":"動"},{"f":"樂曲。","t":"名","e":["如：「江南弄」、「梅花三弄」。"]},{"f":"計算樂曲或演奏次數的單位。","t":"量"}]},{"b":"ㄌㄨㄥˋ","p":"lòng","d":[{"f":"小巷。","t":"名","e":["如：「巷弄」。"]}]}],"弄丸":[{"b":"ㄋㄨㄥˋ ㄨㄢˊ","p":"nòng wán","d":[{"f":"一種民俗雜技。表演者把幾個球拋上空中，再用手接住，弄出各種花樣。"}]}],"弄乖":[{"b":"ㄋㄨㄥˋ ㄍㄨㄞ","p":"nòng guāi","d":[{"f":"使詭計、耍花招。"}]}],"弄乾坤":[{"b":"ㄋㄨㄥˋ ㄑㄧㄢˊ ㄎㄨㄣ","p":"nòng qián kūn","d":[{"f":"耍花樣、搞把戲。"}]}],"弄了個魚頭來拆":[{"b":"ㄋㄨㄥˋ ˙ㄌㄜ ˙ㄍㄜ ㄩˊ ㄊㄡˊ ㄌㄞˊ ㄔㄞ","p":"nòng le ge yú tóu lái chāi","d":[{"f":"（諺語）比喻自找麻煩。"}]}],"弄來弄去":[{"b":"ㄋㄨㄥˋ ㄌㄞˊ ㄋㄨㄥˋ ㄑㄩˋ","p":"nòng lái nòng qù","d":[{"f":"指進行事情的多方嚐試。"},{"f":"亂弄、折騰。","e":["如：「這隻蝴蝶被他們弄來弄去，早已奄奄一息。」"]}]}],"弄倒":[{"b":"ㄋㄨㄥˋ ㄉㄠˇ","p":"nòng dǎo","d":[{"f":"使東西傾倒。","e":["如：「她不小心將大家好不容易堆好的積木弄倒了。」"]}]}],"弄假成真":[{"b":"ㄋㄨㄥˋ ㄐㄧㄚˇ ㄔㄥˊ ㄓㄣ","p":"nòng jiǎ chéng zhēn","d":[{"f":"本是刻意假裝的，想不到結果卻變成真的事。"}]}],"弄優":[{"b":"ㄋㄨㄥˋ ㄧㄡ","p":"nòng yōu","d":[{"f":"俳優、伶人。"}]}],"弄兵潢池":[{"b":"ㄋㄨㄥˋ ㄅㄧㄥ ㄏㄨㄤˊ ㄔˊ","p":"nòng bīng huáng chí","d":[{"f":"潢池，積水的池子。弄兵潢池語本《漢書．卷八九．循吏傳．龔遂傳》：「海瀕遐遠，不霑聖化，其民困於飢寒而吏不恤，故使陛下赤子盜弄陛下之兵於潢池中耳。」喻人不自量力而興兵作亂，有輕視的意味。也作「潢池弄兵」。"}]}],"弄刀":[{"b":"ㄋㄨㄥˋ ㄉㄠ","p":"nòng dāo","d":[{"f":"耍弄刀子。","e":["如：「這孩子拜師學武藝，整日裡舞槍弄刀，努力練習。」"]},{"f":"一種民俗雜藝。表演時，令人取刀刺己腹，以示刀槍不入。"}]}],"弄剌子兒":[{"b":"ㄋㄨㄥˋ ㄌㄚˋ ㄗˇㄦ ","p":"nòng là zǐr ","d":[{"f":"使詭計、耍花招。"}]}],"弄口":[{"b":"ㄋㄨㄥˋ ㄎㄡˇ","p":"nòng kǒu","d":[{"f":"賣弄口舌、搬弄是非。"}]}],"弄口鳴舌":[{"b":"ㄋㄨㄥˋ ㄎㄡˇ ㄇㄧㄥˊ ㄕㄜˊ","p":"nòng kǒu míng shé","d":[{"f":"巧言辯飾。南朝梁．任昉〈奏彈范縝〉：「曲學謏聞，未知去代、弄口鳴舌，只足飾非。」也作「弄口」。"}]}],"弄喧":[{"b":"ㄋㄨㄥˋ ㄒㄩㄢ","p":"nòng xuān","d":[{"f":"玩把戲、弄玄虛。《西遊記》第三五回：「我等切莫揭蓋，只怕他也會弄喧走了。」也作「弄諠」。"}]}],"弄喧搗鬼":[{"b":"ㄋㄨㄥˋ ㄒㄩㄢ ㄉㄠˇ ㄍㄨㄟˇ","p":"nòng xuān dǎo guǐ","d":[{"f":"使詭計、弄玄虛。"}]}],"弄嘴":[{"b":"ㄋㄨㄥˋ ㄗㄨㄟˇ","p":"nòng zuǐ","d":[{"f":"耍嘴皮子、多嘴。"},{"f":"信口胡言、搬弄是非。"},{"f":"鬥嘴、拌嘴。"}]}],"弄嘴弄舌":[{"b":"ㄋㄨㄥˋ ㄗㄨㄟˇ ㄋㄨㄥˋ ㄕㄜˊ","p":"nòng zuǐ nòng shé","d":[{"f":"賣弄口舌。"}]}],"弄堂":[{"b":"ㄋㄨㄥˋ ㄊㄤˊ","p":"nòng táng","d":[{"f":"小巷子。《文明小史》第一七回：「有個弄堂口站著多少女人，那個東洋回來的先生要我同進去玩玩，我不敢去。」也作「弄唐」。","s":"衚衕,小巷"}]}],"弄壞":[{"b":"ㄋㄨㄥˋ ㄏㄨㄞˋ","p":"nòng huài","d":[{"f":"搞砸了，處理不當。","e":["如：「他不小心弄壞了模型。」"],"a":"弄好"}]}],"弄好":[{"b":"ㄋㄨㄥˋ ㄏㄠˇ","p":"nòng hǎo","d":[{"f":"處理妥當。","a":"弄壞"}]}],"弄小":[{"b":"ㄋㄨㄥˋ ㄒㄧㄠˇ","p":"nòng xiǎo","d":[{"f":"納妾。"}]}],"弄小性兒":[{"b":"ㄋㄨㄥˋ ㄒㄧㄠˇ ㄒㄧㄥˋㄦ","p":"nòng xiǎo xìngr ","d":[{"f":"使性子、耍脾氣。"}]}],"弄局":[{"b":"ㄋㄨㄥˋ ㄐㄩˊ","p":"nòng jú","d":[{"f":"開設賭局。"}]}],"弄岔":[{"b":"ㄋㄨㄥˋ ㄔㄚˋ","p":"nòng chà","d":[{"f":"誤解他人的意思。","e":["如：「我這麼做，全都是為你好，你可別弄岔了。」"]}]}],"弄左性":[{"b":"ㄋㄨㄥˋ ㄗㄨㄛˇ ㄒㄧㄥˋ","p":"nòng zuǒ xìng","d":[{"f":"使性子，發起拗脾氣來。"}]}],"弄巧反拙":[{"b":"ㄋㄨㄥˋ ㄑㄧㄠˇ ㄈㄢˇ ㄓㄨㄛˊ","p":"nòng qiǎo fǎn zhuó","d":[{"f":"本想取巧，卻反而敗事。有枉費心機的意思。《里語徵實．卷下．弄巧反拙》引《傳燈錄》：「諺云：『墨魚吐墨，弄巧反拙。』蓋墨魚性巧，每聚遊輒吐墨自覆，人即跡墨水捕之。」也作「弄巧成拙」。"}]}],"弄巧成拙":[{"b":"ㄋㄨㄥˋ ㄑㄧㄠˇ ㄔㄥˊ ㄓㄨㄛˊ","p":"nòng qiǎo chéng zhuó","d":[{"f":"本想取巧，卻反而敗事。有枉費心機的意思。《五燈會元．卷一六．淨名法因禪師》：「祖師妙訣，別無可說。直饒釘嘴鐵舌，未免弄巧成拙。」《封神演義》第五六回：「孩兒係深閨幼女，此事俱是父親失言，弄巧成拙。」也作「弄巧反拙」。"}]}],"弄影":[{"b":"ㄋㄨㄥˋ ㄧㄥˇ","p":"nòng yǐng","d":[{"f":"人或物體在光下晃動，而使影子搖曳不定。"}]}],"弄性":[{"b":"ㄋㄨㄥˋ ㄒㄧㄥˋ","p":"nòng xìng","d":[{"f":"使性子、鬧彆扭。"}]}],"弄性尚氣":[{"b":"ㄋㄨㄥˋ ㄒㄧㄥˋ ㄕㄤˋ ㄑㄧˋ","p":"nòng xìng shàng qì","d":[{"f":"好使性子、愛耍脾氣。"}]}],"弄手腳":[{"b":"ㄋㄨㄥˋ ㄕㄡˇ ㄐㄧㄠˇ","p":"nòng shǒu jiǎo","d":[{"f":"動手腳，暗中安排或暗中使計害人。"}]}],"弄擰了":[{"b":"ㄋㄨㄥˋ ㄋㄧㄥˇ ˙ㄌㄜ","p":"nòng nǐng le","d":[{"f":"弄錯、弄混。"},{"f":"弄僵、弄糟。"}]}],"弄文":[{"b":"ㄋㄨㄥˋ ㄨㄣˊ","p":"nòng wén","d":[{"f":"追求文采。"}]}],"弄文輕武":[{"b":"ㄋㄨㄥˋ ㄨㄣˊ ㄑㄧㄥ ㄨˇ","p":"nòng wén qīng wǔ","d":[{"f":"注重文事而輕視武事。"}]}],"弄斧班門":[{"b":"ㄋㄨㄥˋ ㄈㄨˇ ㄅㄢ ㄇㄣˊ","p":"nòng fǔ bān mén","d":[{"f":"班，魯班，古代巧匠。「弄斧班門」比喻在行家面前賣弄本領，不自量力。明．高濂《玉簪記》第一六齣：「小生略記一二，弄斧班門，休笑，休笑。」《儒林外史》第二八回：「先生大名，如雷灌耳。小弟獻醜，真是弄斧班門。」也作「班門弄斧」、「般門弄斧」。"}]}],"弄月":[{"b":"ㄋㄨㄥˋ ㄩㄝˋ","p":"nòng yuè","d":[{"f":"賞月。","s":"賞月"}]}],"弄月嘲風":[{"b":"ㄋㄨㄥˋ ㄩㄝˋ ㄔㄠˊ ㄈㄥ","p":"nòng yuè cháo fēng","d":[{"f":"玩賞、吟詠風與月，或指談論一些有關風花雪月、無關痛癢的事。《孤本元明雜劇．神仙會．第二折》：「深謝四位伶官，逢場作戲，果然是錦心繡口，弄月嘲風。」也作「弄月摶風」。"}]}],"弄月摶風":[{"b":"ㄋㄨㄥˋ ㄩㄝˋ ㄊㄨㄢˊ ㄈㄥ","p":"nòng yuè tuán fēng","d":[{"f":"玩賞、嘲詠風與月。明．無名氏《東籬賞菊》第二折：「疏柳柴門帶月敲，喜秋清樂意逍遙，常則是弄月摶風，快活到老。」也作「弄月嘲風」。"}]}],"弄柳拈花":[{"b":"ㄋㄨㄥˋ ㄌㄧㄡˇ ㄋㄧㄢˊ ㄏㄨㄚ","p":"nòng liǔ nián huā","d":[{"f":"比喻勾搭他人，到處留情。"}]}],"弄權":[{"b":"ㄋㄨㄥˋ ㄑㄩㄢˊ","p":"nòng quán","d":[{"f":"憑藉職位，濫用職權力。"}]}],"弄死":[{"b":"ㄋㄨㄥˋ ㄙˇ","p":"nòng sǐ","d":[{"f":"害死、殺死。"},{"f":"自尋死路。"}]}],"弄水":[{"b":"ㄋㄨㄥˋ ㄕㄨㄟˇ","p":"nòng shuǐ","d":[{"f":"戲水、游泳。"}]}],"弄法":[{"b":"ㄋㄨㄥˋ ㄈㄚˇ","p":"nòng fǎ","d":[{"f":"舞弊，玩弄法律。"}]}],"弄潮":[{"b":"ㄋㄨㄥˋ ㄔㄠˊ","p":"nòng cháo","d":[{"f":"游泳、戲水。宋．吳自牧《夢粱錄．卷四．觀潮》：「杭人有一等無賴不惜性命之徒，以大綵旗或小清涼繖兒，各繫繡色緞子滿竿，伺潮出海門，百十為群，執旗泅水上，以迓子胥弄潮之戲。」也作「弄濤」。"}]}],"弄潮兒":[{"b":"ㄋㄨㄥˋ ㄔㄠˊ ㄦˊ","p":"nòng cháo ér","d":[{"f":"駕船的人或在潮中戲水的人。"}]}],"弄濤":[{"b":"ㄋㄨㄥˋ ㄊㄠˊ","p":"nòng táo","d":[{"f":"游泳、戲水。宋．王應麟《通鑒地理通釋．卷五．十道山川考．大川浙江》：「每年八月十八日，數百里士女共觀舟人漁人泝濤觸浪，稱為弄濤。」也作「弄潮」。"}]}],"弄狗相咬":[{"b":"ㄋㄨㄥˋ ㄍㄡˇ ㄒㄧㄤ ㄧㄠˇ","p":"nòng gǒu xiāng yǎo","d":[{"f":"唆使兩隻狗互咬來。比喻唆使兩人中的一方故意製造問題，挑起兩人的爭端。","e":["如：「他這叫做『弄狗相咬』，製造糾紛。」"],"s":"挑撥是非"}]}],"弄獐":[{"b":"ㄋㄨㄥˋ ㄓㄤ","p":"nòng zhāng","d":[{"f":"賀人生男。為弄璋的筆誤。《舊唐書．卷一〇六．列傳．李林甫》：「太常少卿姜度，林甫舅子，度妻誕子，林甫手書慶之曰：『聞有弄獐之慶。』客視之掩口。」後用以嘲笑他人寫別字或沒有知識。宋．蘇軾〈賀陳述古弟章生子〉詩：「甚欲去為湯餅客，唯愁錯寫弄獐書。」"}]}],"弄獐宰相":[{"b":"ㄋㄨㄥˋ ㄓㄤ ㄗㄞˇ ㄒㄧㄤˋ","p":"nòng zhāng zǎi xiàng","d":[{"f":"指李林甫。唐玄宗宰相李林甫誤將「弄璋」寫成「弄獐」，故稱。見《舊唐書．卷一〇六．列傳．李林甫》。後用以稱沒有文化的權貴。"}]}],"弄璋":[{"b":"ㄋㄨㄥˋ ㄓㄤ","p":"nòng zhāng","d":[{"f":"璋，玉器。古時拿玉給男孩玩，期望將來有如玉一般的品德。語本《詩經．小雅．斯干》：「乃生男子，載寢之床，載衣之裳，載弄之璋。」後指生男孩為弄璋。唐．白居易〈崔侍御以孩子三日示其所生詩見示因以二絕和之〉詩：「弄璋詩句多才思，愁殺無兒老鄧攸。」","s":"夢熊","a":"弄瓦"}]}],"弄璋之喜":[{"b":"ㄋㄨㄥˋ ㄓㄤ ㄓ ㄒㄧˇ","p":"nòng zhāng zhī xǐ","d":[{"f":"恭喜人生男孩的賀詞。明．陳汝元《金蓮記》第二齣：「室人王氏，琴瑟聲和，更駕才于絰騝，新有弄璋之喜，允符種玉之祥。」《金瓶梅》第三一回：「今日是你西門老爹加官進祿，又是好的日子，又是弄璋之喜，宜該唱這套。」也作「弄璋之慶」。","a":"弄瓦之喜"}]}],"弄璋之慶":[{"b":"ㄋㄨㄥˋ ㄓㄤ ㄓ ㄑㄧㄥˋ","p":"nòng zhāng zhī qìng","d":[{"f":"恭喜人生男孩的賀詞。明．趙弼〈木綿庵記〉：「喜公有弄璋之慶，萬事足矣。」也作「弄璋之喜」。"}]}],"弄瓦":[{"b":"ㄋㄨㄥˋ ㄨㄚˇ","p":"nòng wǎ","d":[{"f":"瓦，古時紡織時用的陶製紡塼。古時拿這種陶製紡塼給小女孩玩，期望將來能勝任女紅。語本《詩經．小雅．斯干》：「乃生女子，載寢之地，載衣之裼，載弄之瓦。」後凡生女兒，稱為「弄瓦」。《幼學瓊林．卷二．老壽幼誕類》：「生男曰弄璋，生女曰弄瓦。」","a":"弄璋"}]}],"弄瓦之喜":[{"b":"ㄋㄨㄥˋ ㄨㄚˇ ㄓ ㄒㄧˇ","p":"nòng wǎ zhī xǐ","d":[{"f":"恭賀人生女兒的賀辭。","e":["如：「新居落成，又是弄瓦之喜，真是雙喜臨門！」"],"a":"弄璋之喜"}]}],"弄甏":[{"b":"ㄋㄨㄥˋ ㄆㄥˋ","p":"nòng pèng","d":[{"f":"一種民俗雜技。即耍壜子。耍弄時，用手抓起磁壜，在空中轉動，使盤旋於腰腹或兩腋兩股之間。"}]}],"弄白相":[{"b":"ㄋㄨㄥˋ ㄅㄞˊ ㄒㄧㄤˋ","p":"nòng bái xiàng","d":[{"f":"吳語。指嬉鬧、開玩笑。"}]}],"弄盞傳杯":[{"b":"ㄋㄨㄥˋ ㄓㄢˇ ㄔㄨㄢˊ ㄅㄟ","p":"nòng zhǎn chuán bēi","d":[{"f":"傳弄酒杯。比喻擺設筵席飲酒歡娛。"}]}],"弄破":[{"b":"ㄋㄨㄥˋ ㄆㄛˋ","p":"nòng pò","d":[{"f":"將物品毀壞。","e":["如：「他一不小心把掛在牆上的畫弄破了。」"]},{"f":"撕破臉、說穿了。"}]}],"弄神弄鬼":[{"b":"ㄋㄨㄥˋ ㄕㄣˊ ㄋㄨㄥˋ ㄍㄨㄟˇ","p":"nòng shén nòng guǐ","d":[{"f":"使詭計、耍花招。"}]}],"弄空頭":[{"b":"ㄋㄨㄥˋ ㄎㄨㄥ ˙ㄊㄡ","p":"nòng kōng tou","d":[{"f":"搞花樣、耍手段。《醒世恆言．卷八．喬太守亂點鴛鴦譜》：「你把老娘當做什麼樣人，敢來弄空頭，壞我的女兒。」也作「弄虛頭」。"}]}],"弄窩子":[{"b":"ㄋㄨㄥˋ ㄨㄛ ˙ㄗ","p":"nòng wō zi","d":[{"f":"窩子是清朝兩淮鹽商專利運鹽的憑照，自己不經營時，可以轉賣或出租。「弄窩子」指承購或承租別人的窩子來經營。"}]}],"弄筆":[{"b":"ㄋㄨㄥˋ ㄅㄧˇ","p":"nòng bǐ","d":[{"f":"舞弄文筆。"},{"f":"執筆寫字、為文、作畫。"}]}],"弄筆墨":[{"b":"ㄋㄨㄥˋ ㄅㄧˇ ㄇㄛˋ","p":"nòng bǐ mò","d":[{"f":"寫字或寫文章。"}]}],"弄筆端":[{"b":"ㄋㄨㄥˋ ㄅㄧˇ ㄉㄨㄢ","p":"nòng bǐ duān","d":[{"f":"搖筆桿賣弄文筆。"}]}],"弄粉調朱":[{"b":"ㄋㄨㄥˋ ㄈㄣˇ ㄊㄧㄠˊ ㄓㄨ","p":"nòng fěn tiáo zhū","d":[{"f":"抹粉塗脂。指修飾容顏。"}]}],"弄精神":[{"b":"ㄋㄨㄥˋ ㄐㄧㄥ ㄕㄣˊ","p":"nòng jīng shén","d":[{"f":"傷腦筋、費精神。"}]}],"弄精細":[{"b":"ㄋㄨㄥˋ ㄐㄧㄥ ㄒㄧˋ","p":"nòng jīng xì","d":[{"f":"拿手、在行。"},{"f":"眼光短淺。"}]}],"弄精魂":[{"b":"ㄋㄨㄥˋ ㄐㄧㄥ ㄏㄨㄣˊ","p":"nòng jīng hún","d":[{"f":"耗費精神心思。"}]}],"弄翰":[{"b":"ㄋㄨㄥˋ ㄏㄢˋ","p":"nòng hàn","d":[{"f":"操筆寫字或繪畫。"}]}],"弄聳":[{"b":"ㄋㄨㄥˋ ㄙㄨㄥˇ","p":"nòng sǒng","d":[{"f":"興風作浪，挑動是非，以從中得利。"}]}],"弄腔調":[{"b":"ㄋㄨㄥˋ ㄑㄧㄤ ㄉㄧㄠˋ","p":"nòng qiāng diào","d":[{"f":"裝腔作勢，耍花腔。"}]}],"弄臣":[{"b":"ㄋㄨㄥˋ ㄔㄣˊ","p":"nòng chén","d":[{"f":"皇上親近狎玩之臣。"}]}],"弄虛作假":[{"b":"ㄋㄨㄥˋ ㄒㄩ ㄗㄨㄛˋ ㄐㄧㄚˇ","p":"nòng xū zuò jiǎ","d":[{"f":"耍花招，以虛偽面目或虛假事物行騙。","e":["如：「別在行家面前弄虛作假，徒遭人訕笑而已。」"]}]}],"弄虛頭":[{"b":"ㄋㄨㄥˋ ㄒㄩ ˙ㄊㄡ","p":"nòng xū tou","d":[{"f":"搞花樣、耍手段。《西遊記》第三二回：「好大聖，你看他弄個虛頭，把眼揉了一揉，揉出些淚來。」也作「弄空頭」。"}]}],"弄車鼓":[{"b":"ㄋㄨㄥˋ ㄔㄜ ㄍㄨˇ","p":"nòng chē gǔ","d":[{"f":"一種臺灣民間的歌舞小戲。表演方式是由丑、旦又歌又舞，相互對答，作即興的演出。通常在民間的迎神賽會或其他節日時，做出陣遊行或野臺表演。","e":["如：「對外國人而言，迎神賽會的弄車鼓極為新鮮有趣。」"]}]}],"弄送":[{"b":"ㄋㄨㄥˋ ㄙㄨㄥˋ","p":"nòng sòng","d":[{"f":"作弄、陷害。"}]}],"弄錢":[{"b":"ㄋㄨㄥˋ ㄑㄧㄢˊ","p":"nòng qián","d":[{"f":"找門路攢錢。"}]}],"弄錯":[{"b":"ㄋㄨㄥˋ ㄘㄨㄛˋ","p":"nòng cuò","d":[{"f":"搞錯了。"}]}],"弄險":[{"b":"ㄋㄨㄥˋ ㄒㄧㄢˇ","p":"nòng xiǎn","d":[{"f":"輕易冒險。"}]}],"弄風兒":[{"b":"ㄋㄨㄥˋ ㄈㄥㄦ","p":"nòng fēngr ","d":[{"f":"搞把戲騙人。"}]}],"弄飯":[{"b":"ㄋㄨㄥˋ ㄈㄢˋ","p":"nòng fàn","d":[{"f":"煮飯，準備飯食。"}]}],"弄髒":[{"b":"ㄋㄨㄥˋ ㄗㄤ","p":"nòng zāng","d":[{"f":"使不乾淨。","e":["如：「他一不小心把衣服給弄髒了。」"],"a":"潔淨,洗淨"}]}],"弄鬆":[{"b":"ㄋㄨㄥˋ ㄙㄨㄥ","p":"nòng sōng","d":[{"f":"使原本緊的鬆開。","e":["如：「他使勁把繩子弄鬆，逃了出來。」"]},{"f":"作弄、陷害。"}]}],"弄鬼":[{"b":"ㄋㄨㄥˋ ㄍㄨㄟˇ","p":"nòng guǐ","d":[{"f":"搗鬼，耍花樣。"}]}],"弄鬼妝么":[{"b":"ㄋㄨㄥˋ ㄍㄨㄟˇ ㄓㄨㄤ ㄧㄠ","p":"nòng guǐ zhuāng yāo","d":[{"f":"裝腔作勢，故弄玄虛。"}]}],"弄鬼弔猴":[{"b":"ㄋㄨㄥˋ ㄍㄨㄟˇ ㄉㄧㄠˋ ㄏㄡˊ","p":"nòng guǐ diào hóu","d":[{"f":"存心搗蛋，耍花招、搞花樣。《紅樓夢》第四六回：「又怕那些牙子家出來的，不乾不淨，也不知道毛病兒，買了來家，三日兩日，又弄鬼弔猴的。」也作「弄鬼掉猴」。"}]}],"弄鬼搏沙":[{"b":"ㄋㄨㄥˋ ㄍㄨㄟˇ ㄅㄛˊ ㄕㄚ","p":"nòng guǐ bó shā","d":[{"f":"把力氣耗費在虛無飄渺的鬼怪和瑣碎繁多的細沙上。比喻徒費心力。"}]}],"悔":[{"b":"ㄏㄨㄟˇ","p":"huǐ","d":[{"f":"事後追恨。","t":"動","e":["如：「悔恨」、「悔不當初」。"]},{"f":"改過。","t":"動","e":["如：「悔過」、「悔改」。"]}]}],"悔不當初":[{"b":"ㄏㄨㄟˇ ㄅㄨˋ ㄉㄤ ㄔㄨ","p":"huǐ bù dāng chū","d":[{"f":"事與願違而悔恨最初的計畫或作為不當。"}]}],"悔之不及":[{"b":"ㄏㄨㄟˇ ㄓ ㄅㄨˋ ㄐㄧˊ","p":"huǐ zhī bù jí","d":[{"f":"後悔已來不及了。元．無名氏《三出小沛》第一折：「某想當日，都是三兄弟失了徐州，悔之不及。」《四遊記．南遊記．第一一回》：「華光悔之不及，悶悶不悅不提。」也作「悔之無及」。"}]}],"悔之亡及":[{"b":"ㄏㄨㄟˇ ㄓ ㄨˊ ㄐㄧˊ","p":"huǐ zhī wú jí","d":[{"f":"後悔已來不及了。《漢書．卷四九．鼂錯傳》：「夫以人之死爭勝，跌而不振，則悔之亡及也。」也作「悔之無及」。"}]}],"悔之何及":[{"b":"ㄏㄨㄟˇ ㄓ ㄏㄜˊ ㄐㄧˊ","p":"huǐ zhī hé jí","d":[{"f":"後悔已來不及了。《東周列國志》第八四回：「蚋蟻蜂蠆，猶能害人，況君相乎？主公不備，異日悔之何及！」也作「悔之無及」。"}]}],"悔之無及":[{"b":"ㄏㄨㄟˇ ㄓ ㄨˊ ㄐㄧˊ","p":"huǐ zhī wú jí","d":[{"f":"後悔已來不及了。《史記．卷六六．伍子胥傳》：「願王釋齊而先越，若不然，後將悔之無及。」《儒林外史》第四六回：「至今想來，究竟還是意氣用事，並不曾報效得朝廷，倒惹得同官心中不快活。卻也悔之無及！」也作「悔之不及」、「悔之莫及」、「悔之何及」、「悔之亡及」。"}]}],"悔之莫及":[{"b":"ㄏㄨㄟˇ ㄓ ㄇㄛˋ ㄐㄧˊ","p":"huǐ zhī mò jí","d":[{"f":"後悔已來不及了。如：「今日不聽我勸，他日將悔之莫及。」也作「悔之無及」。"}]}],"悔婚":[{"b":"ㄏㄨㄟˇ ㄏㄨㄣ","p":"huǐ hūn","d":[{"f":"訂婚後一方反悔而背棄婚約。","e":["如：「婚期都已敲定，你怎能因為小小爭執而悔婚？」"]}]}],"悔尤":[{"b":"ㄏㄨㄟˇ ㄧㄡˊ","p":"huǐ yóu","d":[{"f":"過失、悔恨。"}]}],"悔心":[{"b":"ㄏㄨㄟˇ ㄒㄧㄣ","p":"huǐ xīn","d":[{"f":"改過的心。"}]}],"悔怨":[{"b":"ㄏㄨㄟˇ ㄩㄢˋ","p":"huǐ yuàn","d":[{"f":"因後悔而心生怨恨。","s":"悔恨,懊悔"}]}],"悔恨":[{"b":"ㄏㄨㄟˇ ㄏㄣˋ","p":"huǐ hèn","d":[{"f":"反悔怨恨。","s":"後悔,悔怨,懊悔,怨恨"}]}],"悔悟":[{"b":"ㄏㄨㄟˇ ㄨˋ","p":"huǐ wù","d":[{"f":"追悔前非，覺悟改過。","s":"悔過"}]}],"悔意":[{"b":"ㄏㄨㄟˇ ㄧˋ","p":"huǐ yì","d":[{"f":"後悔的意念。","e":["如：「即使判刑確定，那幫歹徒仍毫無悔意。」"]}]}],"悔愧":[{"b":"ㄏㄨㄟˇ ㄎㄨㄟˋ","p":"huǐ kuì","d":[{"f":"因做錯事而感到後悔慚愧。","e":["如：「他悔愧得無地自容。」"]}]}],"悔改":[{"b":"ㄏㄨㄟˇ ㄍㄞˇ","p":"huǐ gǎi","d":[{"f":"承認過錯，並加以改正。","s":"改過,悛改"}]}],"悔棋":[{"b":"ㄏㄨㄟˇ ㄑㄧˊ","p":"huǐ qí","d":[{"f":"棋子落定後，覺得不妥，收回重下。","e":["如：「他棋品不好，時常悔棋。」"]}]}],"悔毒之歎":[{"b":"ㄏㄨㄟˇ ㄉㄨˊ ㄓ ㄊㄢˋ","p":"huǐ dú zhī tàn","d":[{"f":"極言反悔莫及。"}]}],"悔氣":[{"b":"ㄏㄨㄟˇ ㄑㄧˋ","p":"huǐ qì","d":[{"f":"遇事不順心、倒楣。元．關漢卿《竇娥冤》第二折：「可不悔氣！剛剛討藥的人，就是救那婆子的。」《初刻拍案驚奇》卷二六：「只是足下自己悔氣到了，撞進此房，急急自裁，休得怨我！」也作「晦氣」。"}]}],"悔禍":[{"b":"ㄏㄨㄟˇ ㄏㄨㄛˋ","p":"huǐ huò","d":[{"f":"因追悔而除去所加的災禍，多指天而言。"},{"f":"追悔所造成的禍害。"}]}],"悔罪自新":[{"b":"ㄏㄨㄟˇ ㄗㄨㄟˋ ㄗˋ ㄒㄧㄣ","p":"huǐ zuì zì xīn","d":[{"f":"悔改過失，重新做人。《東周列國志》第四二回：「陳穆公亦有使命至晉，代衛鄭致悔罪自新之意。」也作「悔過自新」。"}]}],"悔艾":[{"b":"ㄏㄨㄟˇ ㄞˋ","p":"huǐ ài","d":[{"f":"改過自新。"}]}],"悔親":[{"b":"ㄏㄨㄟˇ ㄑㄧㄣ","p":"huǐ qīn","d":[{"f":"反悔而廢棄婚約。"}]}],"悔讀南華":[{"b":"ㄏㄨㄟˇ ㄉㄨˊ ㄋㄢˊ ㄏㄨㄚˊ","p":"huǐ dú nán huá","d":[{"f":"唐代溫庭筠因譏諷令狐綯不識《南華經》，因此而觸犯令狐綯，卒不能登第。典出《唐詩紀事．卷五四．溫庭筠》。後比喻學問高深而不容於人或遭人忌妒。"}]}],"悔賴":[{"b":"ㄏㄨㄟˇ ㄌㄞˋ","p":"huǐ lài","d":[{"f":"反悔抵賴。"}]}],"悔過":[{"b":"ㄏㄨㄟˇ ㄍㄨㄛˋ","p":"huǐ guò","d":[{"f":"悔改過失。","s":"悔悟"}]}],"悔過書":[{"b":"ㄏㄨㄟˇ ㄍㄨㄛˋ ㄕㄨ","p":"huǐ guò shū","d":[{"f":"記載悔改過失的文字，以表示改過的誠意。"}]}],"悔過自懺":[{"b":"ㄏㄨㄟˇ ㄍㄨㄛˋ ㄗˋ ㄔㄢˋ","p":"huǐ guò zì chàn","d":[{"f":"後悔自己所犯的過失，並且感到自責、慚愧。宋．張邦基《墨莊漫錄》卷一〇：「欲以足加菩薩面，忽梁間有聲如雷，寬震悸而墜，損其左手。僧教寬悔過自懺，後歲餘，方如舊。」也作「悔過自責」。"}]}],"悔過自新":[{"b":"ㄏㄨㄟˇ ㄍㄨㄛˋ ㄗˋ ㄒㄧㄣ","p":"huǐ guò zì xīn","d":[{"f":"悔改過失，重新做人。《新唐書．卷一一二．馮元常傳》：「元常喻以恩信，約悔過自新，賊相率脫甲面縛。」也作「悔罪自新」。"}]}],"悔過自責":[{"b":"ㄏㄨㄟˇ ㄍㄨㄛˋ ㄗˋ ㄗㄜˊ","p":"huǐ guò zì zé","d":[{"f":"後悔自己所犯的過失，並且感到自責、慚愧。《漢書．卷二七．五行志下之下》：「後得反國，不悔過自責，復會諸侯伐鄭，與楚戰于泓，軍敗身傷，為諸侯笑。」也作「悔過自懺」。"}]}],"戤":[{"b":"ㄍㄞˋ","p":"gài","d":[{"f":"典押物品借貸錢財。","t":"動"},{"f":"冒牌圖利。參見「影戤」條。","t":"動"},{"f":"倚靠。","t":"動"}]}],"戤典":[{"b":"ㄍㄞˋ ㄉㄧㄢˇ","p":"gài diǎn","d":[{"f":"抵押、典當。"}]}],"戤牌":[{"b":"ㄍㄞˋ ㄆㄞˊ","p":"gài pái","d":[{"f":"商人盜用別人的商標品牌。","e":["如：「戤牌是違反商標法的行為。」"]}]}],"戤米囤餓殺了":[{"b":"ㄍㄞˋ ㄇㄧˇ ㄉㄨㄣˋ ㄜˋ ㄕㄚ ˙ㄌㄜ","p":"gài mǐ dùn è shā le","d":[{"f":"（諺語）戤，倚靠。米囤，米簍子。