ㄟˋ ㄨㄛˋ","p":"zuì wò","d":[{"f":"醉酒後倒臥。"}]}],"醉舞狂歌":[{"b":"ㄗㄨㄟˋ ㄨˇ ㄎㄨㄤˊ ㄍㄜ","p":"zuì wǔ kuáng gē","d":[{"f":"沉迷於酒食歌舞之中。"}]}],"醉蟹":[{"b":"ㄗㄨㄟˋ ㄒㄧㄝˋ","p":"zuì xiè","d":[{"f":"被酒浸漬過的螃蟹。"}]}],"醉貌咕咚":[{"b":"ㄗㄨㄟˋ ˙ㄇㄠ ㄍㄨ ㄉㄨㄥ","p":"zuì mao gū dōng","d":[{"f":"酩酊大醉的樣子。","e":["如：「他喝得醉貌咕咚，連走路都走不穩。」"]}]}],"醉貓兒":[{"b":"ㄗㄨㄟˋ ㄇㄠㄦ","p":"zuì māor ","d":[{"f":"譏稱因酒醉而舉止失常的人。","e":["如：「他已喝的醉貓兒似的，還在那裡猛灌老酒。」"]}]}],"醉鄉":[{"b":"ㄗㄨㄟˋ ㄒㄧㄤ","p":"zuì xiāng","d":[{"f":"酒醉後精神所進入的昏沉、迷糊境界。"}]}],"醉酒":[{"b":"ㄗㄨㄟˋ ㄐㄧㄡˇ","p":"zuì jiǔ","d":[{"f":"喝酒過度，精神體力不濟。","e":["如：「他已醉酒了，別讓他自己開車。」"],"a":"解酒"}]}],"醉酒飽德":[{"b":"ㄗㄨㄟˋ ㄐㄧㄡˇ ㄅㄠˇ ㄉㄜˊ","p":"zuì jiǔ bǎo dé","d":[{"f":"語本《詩經．大雅．既醉》：「既醉以酒，既飽以德。」意指既喝足了酒，又飽受恩德。為客人於宴後向主人道謝的話。"}]}],"醉醺醺":[{"b":"ㄗㄨㄟˋ ㄒㄩㄣ ㄒㄩㄣ","p":"zuì xūn xūn","d":[{"f":"酒醉的樣子。唐．岑參〈送羽林長孫將軍赴歙州〉詩：「青門酒樓上，欲別醉醺醺。」《紅樓夢》第二六回：「襲人正記掛著他去見賈政，不知是禍是福，只見寶玉醉醺醺的回來，問其緣故，寶玉一一向他說了。」也作「醉薰薰」、「醉熏熏」。"}]}],"醉雷公":[{"b":"ㄗㄨㄟˋ ㄌㄟˊ ㄍㄨㄥ","p":"zuì léi gōng","d":[{"f":"（歇後語）胡劈。劈諧音「批」。諷刺喜歡胡亂批評事物的人。","e":["如：「一提起政治，他又在那兒醉雷公──胡劈了。」"]}]}],"醉鬼":[{"b":"ㄗㄨㄟˋ ㄍㄨㄟˇ","p":"zuì guǐ","d":[{"f":"譏稱酒醉的人。","e":["如：「那個醉鬼倒臥在路旁。」"]}]}],"錙":[{"b":"ㄗ","p":"zī","d":[{"f":"量詞。古代計算重量的單位。六銖為一錙，二十四銖為一兩。","t":"名"}]}],"錙毫":[{"b":"ㄗ ㄏㄠˊ","p":"zī háo","d":[{"f":"比喻細微。"}]}],"錙銖":[{"b":"ㄗ ㄓㄨ","p":"zī zhū","d":[{"f":"錙與銖都是極小的計算單位，用以比喻極細微。"}]}],"錙銖必較":[{"b":"ㄗ ㄓㄨ ㄅㄧˋ ㄐㄧㄠˋ","p":"zī zhū bì jiào","d":[{"f":"斤斤計較。《二刻拍案驚奇》卷三一：「就是族中支派，不論親疏，但與他財利交關，錙銖必較，一些面情也沒有的。」也作「銖銖校量」、「錙銖較量」。","a":"慷慨解囊"}]}],"錙銖較量":[{"b":"ㄗ ㄓㄨ ㄐㄧㄠˋ ㄌㄧㄤˋ","p":"zī zhū jiào liàng","d":[{"f":"斤斤計較。《鏡花緣》第一一回：「些須銀色小事，何必錙銖較量？」《文明小史》第一二回：「生來手筆又大，從不會錙銖較量的，又念自己的位分大了，無處可以借貸，盤算數日，一籌莫展。」也作「銖銖校量」、「錙銖必較」。"}]}],"韉":[{"b":"ㄐㄧㄢ","p":"jiān","d":[{"f":"馬鞍下的墊褥。","t":"名"}]}],"饙":[{"b":"ㄈㄣ","p":"fēn","d":[{"f":"蒸飯，米煮半熟後以箕漉出再蒸熟。","t":"動"}]}],"饙餾":[{"b":"ㄈㄣ ㄌㄧㄡˋ","p":"fēn liù","d":[{"f":"蒸飯使其熟。"}]}],"髩":[{"b":"","p":"","d":[{"f":"「鬢」的異體字。"}]}]}