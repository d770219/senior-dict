{"㕙":[{"b":"ㄐㄩㄣˋ","p":"jùn","d":[{"f":"狡兔，或泛指兔子。","t":"名"}]}],"乙":[{"b":"ㄧˇ","p":"yǐ","d":[{"f":"天干的第二位。","t":"名"},{"f":"姓。如明代有乙瑄。","t":"名"},{"f":"二一四部首之一。","t":"名"},{"f":"人或地的代稱。","t":"代","e":["如：「某乙」、「乙地」。"]},{"f":"次序或等級屬於第二的。","t":"形","e":["如：「乙等」、「乙級」、「乙班」。"]}]}],"乙炔":[{"b":"ㄧˇ ㄑㄩㄝ","p":"yǐ quē","d":[{"f":"一種電石和水作用而產生的可燃氣體。無色無氣味。可用來焊接和照明。"}]}],"乙烯":[{"b":"ㄧˇ ㄒㄧ","p":"yǐ xī","d":[{"f":"分子式CH2=CH2，由石油裂解而成的氣體。無色，略有甜香味，可促進水果的熟成。乙烯是石化工業重要的基本原料，可衍生製造塑膠產品及人造纖維等；金工方面可焊接及切割金屬。"}]}],"乙烷":[{"b":"ㄧˇ ㄨㄢˊ","p":"yǐ wán","d":[{"f":"分子式C2H6，一種無色無臭的氣體。存在於石油與天然氣中，主要用於製造乙烯或當燃料用。"}]}],"乙種國庫券":[{"b":"ㄧˇ ㄓㄨㄥˇ ㄍㄨㄛˊ ㄎㄨˋ ㄑㄩㄢˋ","p":"yǐ zhǒng guó kù quàn","d":[{"f":"由中央銀行發行的國庫券。係以貼現方式發行，購買者以低於面額的價格公開標購，到期可取回面額的本金。"}]}],"乙種國民兵役":[{"b":"ㄧˇ ㄓㄨㄥˇ ㄍㄨㄛˊ ㄇㄧㄣˊ ㄅㄧㄥ ㄧˋ","p":"yǐ zhǒng guó mín bīng yì","d":[{"f":"凡經徵兵檢查，區分為甲、乙等體位之男子，應服常備兵現役，或補充兵現役，其超額者即服甲種國民兵役，再超額者，或經徵兵檢查其體位為丙等者，均服乙種國民兵役。"}]}],"乙等特考":[{"b":"ㄧˇ ㄉㄥˇ ㄊㄜˋ ㄎㄠˇ","p":"yǐ děng tè kǎo","d":[{"f":"報考資格、任用職等與高考相同的特考。"}]}],"乙覽":[{"b":"ㄧˇ ㄌㄢˇ","p":"yǐ lǎn","d":[{"f":"乙，指乙夜，二更時候，約為晚上十點。乙覽謂於乙夜觀看文書。語本唐．蘇鶚《杜陽雜編．卷中》：「文宗皇帝尚賢樂善，罕有倫比。…謂左右曰：『若不甲夜視事，乙夜觀書，何以為人君耶！』」後以乙覽指皇帝閱讀文書。宋．劉克莊〈書事〉詩二首之一：「學徒誰是單傳者，史藳曾經乙覽無？」"}]}],"乙酸":[{"b":"ㄧˇ ㄙㄨㄢ","p":"yǐ suān","d":[{"f":"醋酸的學名。是一種有刺激性氣味的無色液體，具酸味，食醋中約含百分之五的乙酸，可由酒在空氣中發酵而得。參見「醋酸」條。"}]}],"乙醇":[{"b":"ㄧˇ ㄔㄨㄣˊ","p":"yǐ chún","d":[{"f":"酒精的學名。一種有機化合物。可用發酵方法，亦可用石油工業的副產品乙烯，加硫酸和水反應取得。其用途廣泛，可用來燃燒、消毒等。"}]}],"乙醚":[{"b":"ㄧˇ ㄇㄧˊ","p":"yǐ mí","d":[{"f":"分子式(C2H5)2O，一種常用的揮發性有機溶劑。無色、易燃，遇火會燃燒爆炸。可作為麻醉劑。"}]}],"乙醯水楊酸":[{"b":"ㄧˇ ㄒㄧ ㄕㄨㄟˇ ㄧㄤˊ ㄙㄨㄢ","p":"yǐ xī shuǐ yáng suān","d":[{"f":"阿司匹靈的學名。參見「阿司匹靈」條。"}]}],"嘩":[{"b":"","p":"","d":[{"f":"「譁」的異體字。"}]},{"b":"ㄏㄨㄚ","p":"huā","d":[{"f":"參見「嘩喇喇」條。"}]}],"嘩啦":[{"b":"ㄏㄨㄚ ㄌㄚ","p":"huā lā","d":[{"f":"擬聲詞。(1)形容東西流下的聲音。(2)形容倒塌的聲音。","e":["如：「只聽嘩啦一聲，牆倒了。」"]}]}],"嘩啦啦":[{"b":"ㄏㄨㄚ ㄌㄚ ㄌㄚ","p":"huā lā lā","d":[{"f":"擬聲詞。形容東西倒塌散落的聲音。如：「雨嘩啦啦的下個不停，真煩人！」也作「嘩喇喇」。"}]}],"嘩喇喇":[{"b":"ㄏㄨㄚ ㄌㄚ ㄌㄚ","p":"huā lā lā","d":[{"f":"擬聲詞。形容東西倒塌散落的聲音。也作「嘩啦啦」。"},{"f":"比喻團體的瓦解或事業的失敗。"}]}],"奉":[{"b":"ㄈㄥˋ","p":"fèng","d":[{"f":"拱捧。","t":"動"