ng","d":[{"f":"馬韁繩。","t":"名"}]}],"餵":[{"b":"ㄨㄟˋ","p":"wèi","d":[{"f":"將食物送進人的嘴裡。","t":"動","e":["如：「餵奶」、「餵飯」。"]},{"f":"拿食物給動物吃。","t":"動","e":["如：「餵雞」、「餵豬」。"]}]}],"餵食":[{"b":"ㄨㄟˋ ㄕˊ","p":"wèi shí","d":[{"f":"拿食物給人或動物吃。如：「幼兒應以牛奶或稀飯餵食比較合適。」「到動物園千萬別隨便餵食動物。」"}]}],"餵養":[{"b":"ㄨㄟˋ ㄧㄤˇ","p":"wèi yǎng","d":[{"f":"餵養牲畜。","e":["如：「他家裡餵養著一隻大狼狗。」"],"s":"豢養,飼養"}]}],"鷥":[{"b":"ㄙ","p":"sī","d":[{"f":"參見「鷺鷥」條。"}]}],"齵":[{"b":"ㄡˊ","p":"óu","d":[{"f":"(一)之又音。"}]},{"b":"ㄩˊ","p":"yú","d":[{"f":"牙齒不正。","t":"形"},{"f":"參差不齊的樣子。","t":"形"}]}],"齵差":[{"b":"ㄩˊ ㄘ","p":"yú cī","d":[{"f":"參差不齊。"}]}]}