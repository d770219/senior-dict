:"隨嫁的臣僕。"}]}],"居":[{"b":"ㄐㄧ","p":"jī","d":[{"f":"用於句末，表示疑問的語氣。","t":"助"}]},{"b":"ㄐㄩ","p":"jū","d":[{"f":"住。《論語．學而》：「居無求安」。","t":"動"},{"f":"坐下。","t":"動"},{"f":"存積、儲存。","t":"動","e":["如：「奇貨可居」。"]},{"f":"處、位於。","t":"動"},{"f":"占有。","t":"動"},{"f":"存有、懷著。","t":"動","e":["如：「居心叵測」。"]},{"f":"住所。","t":"名","e":["如：「故居」、「新居」、「遷居」。"]},{"f":"住宅、茶樓、飯館等場所的稱號用字。","t":"名","e":["如：「為善長樂居」、「明湖居」、「德林居」。"]},{"f":"姓。如明代有居節。","t":"名"}]}],"居下訕上":[{"b":"ㄐㄩ ㄒㄧㄚˋ ㄕㄢˋ ㄕㄤˋ","p":"jū xià shàn shàng","d":[{"f":"屬下背地裡譏笑長官。"}]}],"居不重席":[{"b":"ㄐㄩ ㄅㄨˋ ㄔㄨㄥˊ ㄒㄧˊ","p":"jū bù chóng xí","d":[{"f":"坐臥處不鋪設兩重墊子。比喻生活非常的節約。《左傳．哀公元年》：「昔闔廬食不二味，居不重席，室不崇壇。」也作「居不重茵」。"}]}],"居不重茵":[{"b":"ㄐㄩ ㄅㄨˋ ㄔㄨㄥˊ ㄧㄣ","p":"jū bù chóng yīn","d":[{"f":"坐臥處不鋪設兩重墊子。比喻生活非常的儉約。晉．陳元達〈諫起䳨儀樓〉：「故身衣大布，居不重茵。」也作「居不重席」。"}]}],"居中":[{"b":"ㄐㄩ ㄓㄨㄥ","p":"jū zhōng","d":[{"f":"處於兩者之間。","e":["如：「這件爭端，經過他居中調停，雙方已握手言和了。」"]},{"f":"不偏不倚。"}]}],"居中調停":[{"b":"ㄐㄩ ㄓㄨㄥ ㄊㄧㄠˊ ㄊㄧㄥˊ","p":"jū zhōng tiáo tíng","d":[{"f":"法律上指居於兩者之間而調解其糾紛。"}]}],"居之不疑":[{"b":"ㄐㄩ ㄓ ㄅㄨˋ ㄧˊ","p":"jū zhī bù yí","d":[{"f":"認為自己所處的環境、地位是理所當然，沒有疑慮。"}]}],"居人":[{"b":"ㄐㄩ ㄖㄣˊ","p":"jū rén","d":[{"f":"留居的人。"},{"f":"居民。"}]}],"居仁由義":[{"b":"ㄐㄩ ㄖㄣˊ ㄧㄡˊ ㄧˋ","p":"jū rén yóu yì","d":[{"f":"內懷仁愛之心，行事遵循義理。"}]}],"居今稽古":[{"b":"ㄐㄩ ㄐㄧㄣ ㄐㄧ ㄍㄨˇ","p":"jū jīn jī gǔ","d":[{"f":"處於今世而與古人之意相符合。"}]}],"居住":[{"b":"ㄐㄩ ㄓㄨˋ","p":"jū zhù","d":[{"f":"住。","s":"棲身","a":"出奔"}]}],"居住密度":[{"b":"ㄐㄩ ㄓㄨˋ ㄇㄧˋ ㄉㄨˋ","p":"jū zhù mì dù","d":[{"f":"居住地區單位土地面積的實際居住人口數、住宅戶數或居室數。"}]}],"居住環境":[{"b":"ㄐㄩ ㄓㄨˋ ㄏㄨㄢˊ ㄐㄧㄥˋ","p":"jū zhù huán jìng","d":[{"f":"住家周圍的各種居住條件。如噪音、衛生、安全、視野等。","e":["如：「那裡的居住環境不錯，我們可以考慮搬過去。」"]}]}],"居住自由":[{"b":"ㄐㄩ ㄓㄨˋ ㄗˋ ㄧㄡˊ","p":"jū zhù zì yóu","d":[{"f":"依據《憲法》規定，人民有選擇其居住處所，營私人生活不受干預之自由。"}]}],"居停":[{"b":"ㄐㄩ ㄊㄧㄥˊ","p":"jū tíng","d":[{"f":"寄居、歇腳之處。"},{"f":"寄寓之所的主人。"}]}],"居停主人":[{"b":"ㄐㄩ ㄊㄧㄥˊ ㄓㄨˇ ㄖㄣˊ","p":"jū tíng zhǔ rén","d":[{"f":"寄寓之所的主人。"}]}],"居其大半":[{"b":"ㄐㄩ ㄑㄧˊ ㄉㄚˋ ㄅㄢˋ","p":"jū qí dà bàn","d":[{"f":"占總數的二分之一以上。形容數目眾多。"}]}],"居功":[{"b":"ㄐㄩ ㄍㄨㄥ","p":"jū gōng","d":[{"f":"自以為有功勞。"}]}],"居功自傲":[{"b":"ㄐㄩ ㄍㄨㄥ ㄗˋ ㄠˋ","p":"jū gōng zì ào","d":[{"f":"憑藉著自己的功勞而驕傲自滿。","e":["如：「一個謙和自守的人，絕不居功自傲。」"],"a":"功成不居"}]}],"居功自恃":[{"b":"ㄐㄩ ㄍㄨㄥ ㄗˋ ㄕˋ","p":"jū gōng zì shì","d":[{"f":"憑藉著自己的功勞而自大自滿。","e":["如：「組長總是默默奉獻，從不居功自恃，因此深獲好評。」"]}]}],"居喪":[{"b":"ㄐㄩ ㄙㄤ","p":"jū sāng","d":[{"f":"因喪守制。"}]}],"居址":[{"b":"ㄐㄩ ㄓˇ","p":"jū zhǐ","d":[{"f":"住址。","e":["如：「居址不定」。"]}]}],"居士":[{"b":"ㄐㄩ ㄕˋ","p":"jū shì","d":[{"f":"稱隱居的人。"},{"f":"佛教稱在家佛教徒。"}]}],"居士屩":[{"b":"ㄐㄩ ㄕˋ ㄐㄩㄝˊ","p":"jū shì jué","d":[{"f":"唐隱士朱桃椎隱居山林，每織芒屩十雙置於路中，用來和居民交換米茶過日，人稱「居士屩」。典出《新唐書．卷一九六．隱逸傳．朱桃椎傳〉。後用來稱隱士所穿的草鞋。"}]}],"居多":[{"b":"ㄐㄩ ㄉㄨㄛ","p":"jū duō","d":[{"f":"占多數。","e":["如：「舞蹈系同學向來以女生居多。」"]}]}],"居大不易":[{"b":"ㄐㄩ ㄉㄚˋ ㄅㄨˋ ㄧˋ","p":"jū dà bù yì","d":[{"f":"比喻居住在大城市生活不容易。參見「長安居大不易」條。"}]}],"居奇":[{"b":"ㄐㄩ ㄑㄧˊ","p":"jū qí","d":[{"f":"商人為圖厚利，故意囤積貨物，等價錢抬高時再賣。","e":["如：「囤積居奇」。"]}]}],"居孀":[{"b":"ㄐㄩ ㄕㄨㄤ","p":"jū shuāng","d":[{"f":"守寡。"}]}],"居安思危":[{"b":"ㄐㄩ ㄢ ㄙ ㄨㄟˊ","p":"jū ān sī wéi","d":[{"f":"處於安樂之境，要想到可能出現的危險、困難。《左傳．襄公十一年》：「居安思危，思則有備，有備無患。」《明史．卷一九二．鄭本公傳》：「陛下居安思危，當遠群小，節燕遊，以防一朝之患。」也作「居安慮危」、「處安思危」。"}]}],"居安慮危":[{"b":"ㄐㄩ ㄢ ㄌㄩˋ ㄨㄟˊ","p":"jū ān lǜ wéi","d":[{"f":"處安樂之境，要想到可能出現的危險、困難。《宋書．卷七九．文五王傳．竟陵王誕傳》：「然居安慮危，不可不懼。」也作「居安思危」、「處安思危」。"}]}],"居安資深":[{"b":"ㄐㄩ ㄢ ㄗ ㄕㄣ","p":"jū ān zī shēn","d":[{"f":"學道有所得，則可自處安穩，且可利用無窮。"}]}],"居官":[{"b":"ㄐㄩ ㄍㄨㄢ","p":"jū guān","d":[{"f":"當官、任官。"}]}],"居室":[{"b":"ㄐㄩ ㄕˋ","p":"jū shì","d":[{"f":"居住的房屋。"},{"f":"同屋居住。"},{"f":"囚禁罪人的處所。"}]}],"居家":[{"b":"ㄐㄩ ㄐㄧㄚ","p":"jū jiā","d":[{"f":"住在家裡。","a":"出門,外出"},{"f":"家居生活。"},{"f":"住家、民房。"}]}],"居居":[{"b":"ㄐㄩ ㄐㄩ","p":"jū jū","d":[{"f":"懷惡不相親附的樣子。"},{"f":"安靜的樣子。"}]}],"居常":[{"b":"ㄐㄩ ㄔㄤˊ","p":"jū cháng","d":[{"f":"平常、日常。"}]}],"居庸關":[{"b":"ㄐㄩ ㄩㄥ ㄍㄨㄢ","p":"jū yōng guān","d":[{"f":"位於河北省昌平縣西北的關口。為長城的要隘，有平綏鐵路經過。"}]}],"居延海":[{"b":"ㄐㄩ ㄧㄢˊ ㄏㄞˇ","p":"jū yán hǎi","d":[{"f":"湖泊名。位寧夏額濟納旗東北境。因中間淤塞，分為東西兩泊，二者相距達三十五公里。"}]}],"居心":[{"b":"ㄐㄩ ㄒㄧㄣ","p":"jū xīn","d":[{"f":"存心、處心。","s":"宅心,存心"}]}],"居心不良":[{"b":"ㄐㄩ ㄒㄧㄣ ㄅㄨˋ ㄌㄧㄤˊ","p":"jū xīn bù liáng","d":[{"f":"心懷不軌，意圖不善。","e":["如：「那流氓落得今天如此慘境，都是平時居心不良的惡果。」"],"a":"宅心仁厚"}]}],"居心叵測":[{"b":"ㄐㄩ ㄒㄧㄣ ㄆㄛˇ ㄘㄜˋ","p":"jū xīn pǒ cè","d":[{"f":"心存險詐，難以預測。清．薛福成〈代李伯相三答朝鮮國相李裕元書〉：「近察日本，行事乖謬，居心叵測。」也作「心懷叵測」。","s":"圖謀不詭"}]}],"居心無愧":[{"b":"ㄐㄩ ㄒㄧㄣ ㄨˊ ㄎㄨㄟˋ","p":"jū xīn wú kuì","d":[{"f":"心中沒有什麼好慚愧的事。","e":["如：「做任何事情，必須居心無愧才行。」"]}]}],"居息":[{"b":"ㄐㄩ ㄒㄧˊ","p":"jū xí","d":[{"f":"居家休閒。"}]}],"居憂":[{"b":"ㄐㄩ ㄧㄡ","p":"jū yōu","d":[{"f":"居父母之喪。"}]}],"居所":[{"b":"ㄐㄩ ㄙㄨㄛˇ","p":"jū suǒ","d":[{"f":"指暫時寄居某地，沒有久住的意思，與住所有別。","s":"住處"}]}],"居攝":[{"b":"ㄐㄩ ㄕㄜˋ","p":"jū shè","d":[{"f":"臣下暫時攝行天子職權。"},{"f":"漢孺子嬰的年號（西元6）。"}]}],"居易":[{"b":"ㄐㄩ ㄧˋ","p":"jū yì","d":[{"f":"居平正坦蕩之境，不矯情行險以立名。"}]}],"居業":[{"b":"ㄐㄩ ㄧㄝˋ","p":"jū yè","d":[{"f":"積聚的家業、產業。"}]}],"居次":[{"b":"ㄐㄩ ㄘˋ","p":"jū cì","d":[{"f":"匈奴公主的稱號。"},{"f":"處於第二。","e":["如：「每學期的學業成績，總是他居首，我居次。」"]}]}],"居止":[{"b":"ㄐㄩ ㄓˇ","p":"jū zhǐ","d":[{"f":"居住。"},{"f":"行動。"}]}],"居正":[{"b":"ㄐㄩ ㄓㄥˋ","p":"jū zhèng","d":[{"f":"循常道以處事。"}]}],"居民":[{"b":"ㄐㄩ ㄇㄧㄣˊ","p":"jū mín","d":[{"f":"泛指居住在一定區域內的人民。","s":"住戶"}]}],"居民樓":[{"b":"ㄐㄩ ㄇㄧㄣˊ ㄌㄡˊ","p":"jū mín lóu","d":[{"f":"北平方言。稱國民住宅。"}]}],"居無定所":[{"b":"ㄐㄩ ㄨˊ ㄉㄧㄥˋ ㄙㄨㄛˇ","p":"jū wú dìng suǒ","d":[{"f":"沒有固定的住處。","e":["如：「他一向居無定所，你很難找得到他的。」"]}]}],"居無求安":[{"b":"ㄐㄩ ㄨˊ ㄑㄧㄡˊ ㄢ","p":"jū wú qiú ān","d":[{"f":"居住不求安適。"}]}],"居然":[{"b":"ㄐㄩ ㄖㄢˊ","p":"jū rán","d":[{"f":"竟然。"},{"f":"安然。"},{"f":"顯然、自然。"}]}],"居留":[{"b":"ㄐㄩ ㄌㄧㄡˊ","p":"jū liú","d":[{"f":"居住停留。","e":["如：「居留權」。"]}]}],"居留權":[{"b":"ㄐㄩ ㄌㄧㄡˊ ㄑㄩㄢˊ","p":"jū liú quán","d":[{"f":"政府依據本國法律的規定，給與非本國人在本國居留的權利。"}]}],"居留證":[{"b":"ㄐㄩ ㄌㄧㄡˊ ㄓㄥˋ","p":"jū liú zhèng","d":[{"f":"由本國政府發給外籍人士，准其在本國居留的證明文件。可分為臨時居留證、長期居留證、永久居留證三種。"}]}],"居積":[{"b":"ㄐㄩ ㄐㄧ","p":"jū jī","d":[{"f":"囤積財物。"}]}],"居第":[{"b":"ㄐㄩ ㄉㄧˋ","p":"jū dì","d":[{"f":"居住的宅第。"}]}],"居處":[{"b":"ㄐㄩ ㄔㄨˋ","p":"jū chù","d":[{"f":"居住的地方。","e":["如：「我的居處就在附近，有空可以過來找我。」"],"s":"住宅"}]}],"居諸":[{"b":"ㄐㄩ ㄓㄨ","p":"jū zhū","d":[{"f":"語本《詩經．邶風．柏舟》：「日居月諸，胡迭而微。」借指光陰。"}]}],"居貞":[{"b":"ㄐㄩ ㄓㄣ","p":"jū zhēn","d":[{"f":"遵循正道。"}]}],"居貧":[{"b":"ㄐㄩ ㄆㄧㄣˊ","p":"jū pín","d":[{"f":"家貧。"}]}],"居賣":[{"b":"ㄐㄩ ㄇㄞˋ","p":"jū mài","d":[{"f":"坐賣的商賈，對行貨商而言。"}]}],"居里":[{"b":"ㄐㄩ ㄌㄧˇ","p":"jū lǐ","d":[{"f":"人名。（Pierre Curie，西元1859～1906）法國物理學家。與其兄共同發現晶體的壓電現象。又發現鐵磁性在某溫度（今稱居里溫度）以上消失。後與夫人共同發現釙及鐳，二人與貝克勒合得西元一九〇三年諾貝爾物理學獎。也譯作「居禮」。"},{"f":"量詞。物理學上計算放射性強度的單位。為英語curie的音譯。一定量放射性物質中每秒有三點七個原子發生衰變，稱為「一居里」。相當於一公克鐳的放射性強度。符號為Ci。"}]}],"居里夫人":[{"b":"ㄐㄩ ㄌㄧˇ ㄈㄨ ㄖㄣˊ","p":"jū lǐ fū rén","d":[{"f":"人名。（西元1867～1934）生於波蘭的法國物理學及化學家。自西元一八九三年起，致力放射性現象研究，成就非凡，精神偉大。一九〇三年與其夫及貝克勒共獲諾貝爾物理學獎，一九一一年又獨得諾貝爾化學獎，逝世於法國。也譯作「居禮夫人」。"}]}],"居間":[{"b":"ㄐㄩ ㄐㄧㄢ","p":"jū jiān","d":[{"f":"從中調解。"},{"f":"做中間人、介紹人的意思。"},{"f":"法律上指立於相對人之間，為訂立某種契約之見證，或為商業買賣之介紹者。"}]}],"居首":[{"b":"ㄐㄩ ㄕㄡˇ","p":"jū shǒu","d":[{"f":"占第一位。"}]}],"居高":[{"b":"ㄐㄩ ㄍㄠ","p":"jū gāo","d":[{"f":"位居高處。"}]}],"居高不下":[{"b":"ㄐㄩ ㄍㄠ ㄅㄨˋ ㄒㄧㄚˋ","p":"jū gāo bù xià","d":[{"f":"處於高位而不下滑。如：「由於颱風來襲，蔬果價格一直居高不下。」「這位民意代表勤跑基層，積極服務民眾，所以民調滿意度一直居高不下。」"}]}],"居高思危":[{"b":"ㄐㄩ ㄍㄠ ㄙ ㄨㄟˊ","p":"jū gāo sī wéi","d":[{"f":"處於高位時，應考慮到未來可能遭遇的危難。","e":["如：「人要居高思危，不要得意忘形。」"]}]}],"居高臨下":[{"b":"ㄐㄩ ㄍㄠ ㄌㄧㄣˊ ㄒㄧㄚˋ","p":"jū gāo lín xià","d":[{"f":"處於有利的地位，可控制一切。","s":"高高在上,高屋建瓴"}]}],"彥":[{"b":"ㄧㄢˋ","p":"yàn","d":[{"f":"才德出眾的人。","t":"名","e":["如：「俊彥」、「碩彥」。"]}]}],"彥倫鶴怨":[{"b":"ㄧㄢˋ ㄌㄨㄣˊ ㄏㄜˋ ㄩㄢˋ","p":"yàn lún hè yuàn","d":[{"f":"周顒，字彥倫，南朝齊人。初隱居於鍾山，後出仕為縣令。孔稚珪過鍾山草堂，作〈北山移文〉，其辭有曰：「蕙帳空兮夜鶴怨，山人去兮曉猿驚。」譏諷周顒隱居不終，中途改志。見唐．李瀚《蒙求集註．卷下．彥倫鶴怨》徐子光注引《南史》。"}]}],"彥國吐屑":[{"b":"ㄧㄢˋ ㄍㄨㄛˊ ㄊㄨˇ ㄒㄧㄝˋ","p":"yàn guó tǔ xiè","d":[{"f":"晉代胡毋輔之，字彥國。生性不拘小節，時出妙語。友人王澄曾與人書曰：「彥國吐佳言如鋸木屑，霏霏不絕，誠為後進領袖也。」見《晉書．卷四九．胡毋輔之傳》。"}]}],"彥士":[{"b":"ㄧㄢˋ ㄕˋ","p":"yàn shì","d":[{"f":"才學優美的賢士。"}]}],"彥琮":[{"b":"ㄧㄢˋ ㄘㄨㄥˊ","p":"yàn cóng","d":[{"f":"人名。（西元557～610）姓李，出家名道江，為北朝高僧。齊末入晉陽講仁王經於宣德殿，齊亡，周武帝召為通道觀學士，時武帝毀滅佛教，乃更名為「彥琮」。隋初圓寂。譯經凡二十三部，一百餘卷。"}]}],"惵":[{"b":"ㄉㄧㄝˊ","p":"dié","d":[{"f":"懼怕、恐懼的樣子。","t":"副"}]}],"搕":[{"b":"ㄎㄜ","p":"kē","d":[{"f":"取。","t":"動"},{"f":"敲擊、打擊。","t":"動"}]}],"搕打":[{"b":"ㄎㄜ ㄉㄚˇ","p":"kē dǎ","d":[{"f":"敲打。如：「他不斷的搕打門窗，以喚起她的注意。」也作「搕撻」。"}]}],"斥":[{"b":"ㄔˋ","p":"chì","d":[{"f":"排除拒絕、摒棄不用。","t":"動","e":["如：「排斥」、「同性相斥」。"]},{"f":"責罵。","t":"動","e":["如：「申斥」、「痛斥」、「呵斥」。"]},{"f":"遍布。","t":"動","e":["如：「外國貨充斥市場。」"]},{"f":"偵察、探測。","t":"動"},{"f":"動用，出。","t":"動","e":["如：「斥資」。"]}]}],"斥候":[{"b":"ㄔˋ ㄏㄡˋ","p":"chì hòu","d":[{"f":"偵察敵情的哨兵。《史記．卷一〇九．李將軍傳》：「及出擊胡，而廣行無部伍行陳，就善水草屯，舍止，人人自便，不擊刀斗以自衛，莫府省約文書籍事，然亦遠斥候，未嘗遇害。」《漢書．卷五四．蘇建傳》：「武與副中郎將張勝及假吏常惠等，募士斥候百餘人俱。」也作「斥堠」。","s":"尖兵,哨兵"}]}],"斥力":[{"b":"ㄔˋ ㄌㄧˋ","p":"chì lì","d":[{"f":"物體間互相排斥的力量，如同性磁極或同性電荷之間的作用力，即稱為「斥力」。","a":"引力"}]}],"斥喝":[{"b":"ㄔˋ ㄏㄜˋ","p":"chì hè","d":[{"f":"大聲喝阻、威嚇或責罵。","e":["如：「他作賊心虛，聽到後面有人斥喝，嚇得拔腿就跑。」"]}]}],"斥土":[{"b":"ㄔˋ ㄊㄨˇ","p":"chì tǔ","d":[{"f":"開拓土地。清．王夫之《宋論．卷一〇．高宗》：「不然，則建武之初，斥土未廣，何所得粟以飼此眾邪？」也作「斥地」。"}]}],"斥地":[{"b":"ㄔˋ ㄉㄧˋ","p":"chì dì","d":[{"f":"開拓土地。《漢書．卷七三．韋賢傳》：「四垂無事，斥地遠境，起十餘郡。」《新唐書．卷一三三．王忠嗣傳》：「自朔方至雲中袤數千里，據要險築城堡，斥地甚遠。」也作「斥土」。"}]}],"斥埴":[{"b":"ㄔˋ ㄓˊ","p":"chì zhí","d":[{"f":"鹹質的黏土。"}]}],"斥堠":[{"b":"ㄔˋ ㄏㄡˋ","p":"chì hòu","d":[{"f":"瞭望敵情的碉堡。"},{"f":"偵察敵情的哨兵。《舊唐書．卷一八．宣宗本紀》：「甌脫頓空於內地，斥堠全據於新封，莫大之休，指期而就。」《五代史平話．唐史．卷上》：「德威急忙趕至南宮，將劉鄩軍下斥堠的拿來，斷卻手臂而縱之去。」也作「斥候」。"}]}],"斥大":[{"b":"ㄔˋ ㄉㄚˋ","p":"chì dà","d":[{"f":"開拓。"}]}],"斥斥":[{"b":"ㄔˋ ㄔˋ","p":"chì chì","d":[{"f":"廣大的樣子。"}]}],"斥罵":[{"b":"ㄔˋ ㄇㄚˋ","p":"chì mà","d":[{"f":"大聲責罵。如：「他闖了大禍，被人斥罵了一頓。」也作「斥責」。"}]}],"斥罷":[{"b":"ㄔˋ ㄅㄚˋ","p":"chì bà","d":[{"f":"罷免職務。"}]}],"斥責":[{"b":"ㄔˋ ㄗㄜˊ","p":"chì zé","d":[{"f":"指責、責罵。如：「他因粗心犯錯，被斥責了一頓。」也作「斥罵」。","s":"呵叱,呵斥,譴責,指責,責備,責罵,責問","a":"表揚,撫慰,讚許"}]}],"斥資":[{"b":"ㄔˋ ㄗ","p":"chì zī","d":[{"f":"出錢。","e":["如：「市政府決定斥資兩千萬改建老舊的圖書館。」"]}]}],"斥賣":[{"b":"ㄔˋ ㄇㄞˋ","p":"chì mài","d":[{"f":"拍賣、出賣。"}]}],"斥退":[{"b":"ㄔˋ ㄊㄨㄟˋ","p":"chì tuì","d":[{"f":"革退、免職。","s":"革退"},{"f":"喝令退出。"}]}],"斥逐":[{"b":"ㄔˋ ㄓㄨˊ","p":"chì zhú","d":[{"f":"驅逐。","s":"驅逐","a":"覊縻"}]}],"斥革":[{"b":"ㄔˋ ㄍㄜˊ","p":"chì gé","d":[{"f":"罷退、革除。","s":"革退"}]}],"斥騎":[{"b":"ㄔˋ ㄐㄧˋ","p":"chì jì","d":[{"f":"偵探敵人的騎兵。"}]}],"斥鷃":[{"b":"ㄔˋ ㄧㄢˋ","p":"chì yàn","d":[{"f":"動物名。一種鳥，頭小尾禿，額、頭側、頦及喉部羽毛呈淡紅色。"}]}],"斥鹵":[{"b":"ㄔˋ ㄌㄨˇ","p":"chì lǔ","d":[{"f":"無法耕種的鹹鹼地。"}]}],"朵":[{"b":"ㄉㄨㄛˇ","p":"duǒ","d":[{"f":"植物的花或苞。","t":"名","e":["如：「花朵」。"]},{"f":"量詞。計算花或雲彩等團狀物的單位。","t":"名","e":["如：「一朵花」、「幾朵白雲」、「浪花一朵朵」。"]},{"f":"參見「朵頤」條。","t":"動"}]}],"朵朵蓮花":[{"b":"ㄉㄨㄛˇ ㄉㄨㄛˇ ㄌㄧㄢˊ ㄏㄨㄚ","p":"duǒ duǒ lián huā","d":[{"f":"形容女子走路清雅美妙的姿態。參見「潘妃金蓮」條。"}]}],"朵殿":[{"b":"ㄉㄨㄛˇ ㄉㄧㄢˋ","p":"duǒ diàn","d":[{"f":"殿之東西側堂，稱為「朵殿」。"}]}],"朵雲":[{"b":"ㄉㄨㄛˇ ㄩㄣˊ","p":"duǒ yún","d":[{"f":"比喻他人的來信。","s":"大札,華翰"}]}],"朵頤":[{"b":"ㄉㄨㄛˇ ㄧˊ","p":"duǒ yí","d":[{"f":"朵，動；頤，下巴。「朵頤」指動著腮頰，嚼食或欲食的樣子。","e":["如：「大快朵頤」。"]}]}],"朵頤大嚼":[{"b":"ㄉㄨㄛˇ ㄧˊ ㄉㄚˋ ㄐㄧㄠˊ","p":"duǒ yí dà jiáo","d":[{"f":"咬動腮頰，大口咀嚼。","e":["如：「看他朵頤大嚼的樣子，想必餓了許久。」"]}]}],"橕":[{"b":"ㄔㄥ","p":"chēng","d":[{"f":"支撐、卡住。","t":"動"},{"f":"斜柱。","t":"名","e":["如：「屋橕」、「隄橕」。"]}]}],"漅":[{"b":"ㄔㄠˊ","p":"cháo","d":[{"f":"湖泊名。即巢湖。位大陸地區安徽省巢縣西南，東南注入長江。","t":"名"}]}],"炕":[{"b":"ㄎㄤˋ","p":"kàng","d":[{"f":"大陸北方地區各地用磚或泥坯在屋裡砌成的臥榻。下有孔道，與煙囪相通，可生火取暖。","t":"名"},{"f":"烤、烘乾。如：「炕餅」、「炕肉」。《詩經．小雅．瓠葉》「有兔斯首，燔之炙之」句下．漢．毛亨．傳：「炕火曰炙。」唐．孔穎達．正義：「炕，舉也。謂以物貫之而舉於火上以炙之。」","t":"動"}]}],"炕房":[{"b":"ㄎㄤˋ ㄈㄤˊ","p":"kàng fáng","d":[{"f":"陳設炕具的房間。"}]}],"炕暴":[{"b":"ㄎㄤˋ ㄅㄠˋ","p":"kàng bào","d":[{"f":"性情躁烈橫暴。"}]}],"炕桌兒":[{"b":"ㄎㄤˋ ㄓㄨㄛㄦ","p":"kàng zhuōr ","d":[{"f":"置於火炕上的小桌。"}]}],"炕洞":[{"b":"ㄎㄤˋ ㄉㄨㄥˋ","p":"kàng dòng","d":[{"f":"火炕下面的方形洞道，用來推入火爐而取暖。"}]}],"炕爐子":[{"b":"ㄎㄤˋ ㄌㄨˊ ˙ㄗ","p":"kàng lú zi","d":[{"f":"矮小的火爐，下腳裝有四輪，火生著後可由炕洞推入，炕上即能得暖。"}]}],"炕琴桌兒":[{"b":"ㄎㄤˋ ㄑㄧㄣˊ ㄓㄨㄛㄦ","p":"kàng qín zhuōr ","d":[{"f":"置於火炕上的狹長、短足的條桌。"}]}],"炕陽":[{"b":"ㄎㄤˋ ㄧㄤˊ","p":"kàng yáng","d":[{"f":"枯涸。比喻對於臣下百姓毫無恩澤。"},{"f":"張皇自大的樣子。"}]}],"炕面磚":[{"b":"ㄎㄤˋ ㄇㄧㄢˋ ㄓㄨㄢ","p":"kàng miàn zhuān","d":[{"f":"用來敷砌火炕上面的正方形磚。"}]}],"硥":[{"b":"ㄇㄤˇ","p":"mǎng","d":[{"f":"石塊高大的樣子。","t":"形"}]}],"箅":[{"b":"ㄅㄧˋ","p":"bì","d":[{"f":"平而有孔隙的竹器，墊在鍋底，以便蒸食物之用。","t":"名"}]}],"箅子":[{"b":"ㄅㄧˋ ˙ㄗ","p":"bì zi","d":[{"f":"原指平面而有空隙的竹器，今泛稱一般有空隙及用以隔物間隔作用的器物。如蒸食物用的「竹箅子」、下水道的「鐵箅子」。"}]}],"紕":[{"b":"ㄆㄧ","p":"pī","d":[{"f":"織布時，經緯線沒織好的地方。引申為錯誤。","t":"名","e":["如：「紕繆」、「紕漏」。"]},{"f":"布帛等織品線或接縫處脫散。","t":"形","e":["如：「線紕了」。"]}]},{"b":"ㄆㄧˊ","p":"pí","d":[{"f":"衣冠的緣飾。","t":"名"},{"f":"在衣冠或旗幟邊緣繡上花邊。","t":"動"}]}],"紕漏":[{"b":"ㄆㄧ ㄌㄡˋ","p":"pī lòu","d":[{"f":"疏漏謬誤。今多指辦事出差錯，或貪汙舞弊等情事被舉發。如：「那件工程又出紕漏。」也作「皮漏」。","s":"漏洞"}]}],"紕繆":[{"b":"ㄆㄧ ㄇㄧㄡˋ","p":"pī miù","d":[{"f":"錯誤。"}]}],"耵":[{"b":"ㄉㄧㄥˇ","p":"dǐng","d":[{"f":"參見「耵聹」條。"}]},{"b":"ㄊㄧㄥ","p":"tīng","d":[{"f":"(一)之又音。"}]}],"耵聹":[{"b":"ㄉㄧㄥˇ ㄋㄧㄥˊ","p":"dǐng níng","d":[{"f":"為外耳道耵聹腺所分泌的淡黃色黏稠液體或蠟狀物質，和外耳道皮膚剝落上皮混合後的產物。"}]},{"b":"ㄊㄧㄥ ㄋㄧㄥˊ","p":"tīng níng","d":[{"f":"耵聹腺的分泌物。"}]}],"耵聹腺":[{"b":"ㄊㄧㄥ ㄋㄧㄥˊ ㄒㄧㄢˋ","p":"tīng níng xiàn","d":[{"f":"聽覺器官重要的外皮腺。位於外聽道後部，開口於外聽道。能分泌黃色脂肪物，防止灰塵、小蟲侵入耳內。"}]}],"臅":[{"b":"ㄔㄨˋ","p":"chù","d":[{"f":"胸腔中的脂油。","t":"名"}]}],"虵":[{"b":"","p":"","d":[{"f":"「蛇」的異體字。"}]}],"蠅":[{"b":"ㄧㄥˊ","p":"yíng","d":[{"f":"昆蟲綱雙翅目蠅科的通稱。體長約六、七公釐，密生短毛，灰黑色，頭上有複眼甚大，口器伸為管狀，適於舐食。生長繁殖極快，能傳染霍亂、傷寒、結核、痢疾等的病原菌。常見的有家蠅、綠蠅、肉蠅等。","t":"名"}]}],"蠅利蝸名":[{"b":"ㄧㄥˊ ㄌㄧˋ ㄍㄨㄚ ㄇㄧㄥˊ","p":"yíng lì guā míng","d":[{"f":"比喻微不足道的名利。明．汪廷訥《獅吼記》第四齣：「蠅利蝸名鎮日奔，生惡趣，惹客塵，膠膠擾擾只貪嗔。」也作「蝸名蠅利」、「蝸利蠅名」、「蠅名蝸利」。"}]}],"蠅名蝸利":[{"b":"ㄧㄥˊ ㄇㄧㄥˊ ㄍㄨㄚ ㄌㄧˋ","p":"yíng míng guā lì","d":[{"f":"比喻微不足道的名利。明．陳汝元《金蓮記》第四齣：「縱白鳳琱章多美技，論世態浮雲可比。看這些蠅名蝸利，心腸熱憑誰淘洗。」也作「蠅利蝸名」。"}]}],"蠅子":[{"b":"ㄧㄥˊ ˙ㄗ","p":"yíng zi","d":[{"f":"蒼蠅的別名。參見「蒼蠅」條。"}]}],"蠅帚子":[{"b":"ㄧㄥˊ ㄓㄡˇ ˙ㄗ","p":"yíng zhǒu zi","d":[{"f":"驅趕蚊蠅的用具。"}]}],"蠅拂":[{"b":"ㄧㄥˊ ㄈㄨˊ","p":"yíng fú","d":[{"f":"驅蠅的器具。"}]}],"蠅止":[{"b":"ㄧㄥˊ ㄓˇ","p":"yíng zhǐ","d":[{"f":"蒼蠅停留的地方，使白的變黑的。比喻佞人顛倒黑白，變亂善惡。"}]}],"蠅營":[{"b":"ㄧㄥˊ ㄧㄥˊ","p":"yíng yíng","d":[{"f":"如蒼蠅般到處鑽營。比喻為鑽營小利而勞碌不休。"}]}],"蠅營狗苟":[{"b":"ㄧㄥˊ ㄧㄥˊ ㄍㄡˇ ㄍㄡˇ","p":"yíng yíng gǒu gǒu","d":[{"f":"如蒼蠅般的到處鑽營，如狗般卑劣苟且。比喻四處鑽營，只為謀利；不顧廉恥，但求偷生的生活態度。唐．韓愈〈送窮文〉：「蠅營狗苟，驅去復還。」也作「狗苟蠅營」。"}]}],"蠅甩子":[{"b":"ㄧㄥˊ ㄕㄨㄞˇ ˙ㄗ","p":"yíng shuǎi zi","d":[{"f":"一種驅逐蠅、蟲的器具。"}]}],"蠅糞點玉":[{"b":"ㄧㄥˊ ㄈㄣˋ ㄉㄧㄢˇ ㄩˋ","p":"yíng fèn diǎn yù","d":[{"f":"蒼蠅的糞玷汙美玉。語本唐．陳子昂〈宴胡楚真禁所〉詩：「青蠅一相點，白璧遂成冤。」比喻奸邪害善。宋．陸佃《埤雅．卷一〇．釋蟲．蠅》：「青蠅糞尤能敗物，雖玉猶不免，所謂蠅糞點玉是也。」"}]}],"蠅級":[{"b":"ㄧㄥˊ ㄐㄧˊ","p":"yíng jí","d":[{"f":"拳擊比賽體重四十八至五十一公斤、舉重比賽重量在五十二公斤以下的級別。"}]}],"蠅虎":[{"b":"ㄧㄥˊ ㄏㄨˇ","p":"yíng hǔ","d":[{"f":"動物名。一種蜘蛛。節肢動物門蛛形綱真蜘蛛目。大三四分，白色或灰色，善跳躍，不結網，徘徊牆間，以尾端之絲黏附於壁，伺蠅而捕之。"}]}],"蠅蛆病":[{"b":"ㄧㄥˊ ㄑㄩ ㄅㄧㄥˋ","p":"yíng qū bìng","d":[{"f":"一種牛羊的疾病。蒼蠅在牛羊傷口上排卵，孵化後螺旋狀幼蟲繼續在傷口內寄生生長，破壞組織，引起壞疽的病症。"}]}],"蠅頭":[{"b":"ㄧㄥˊ ㄊㄡˊ","p":"yíng tóu","d":[{"f":"比喻微細。"}]}],"蠅頭