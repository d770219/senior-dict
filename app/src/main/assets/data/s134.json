{"亦":[{"b":"ㄧˋ","p":"yì","d":[{"f":"相當於「也」、「也是」。","t":"副","e":["如：「人云亦云」。"]},{"f":"相當於「又」。","t":"副"},{"f":"只是、不過。","t":"副"},{"f":"已經。","t":"副"},{"f":"雖然。","t":"連"},{"f":"位於句首或句中，無義。","t":"助"},{"f":"姓。如明代有亦孔昭。","t":"名"}]}],"亦步亦趨":[{"b":"ㄧˋ ㄅㄨˋ ㄧˋ ㄑㄩ","p":"yì bù yì qū","d":[{"f":"本指學生跟隨老師的腳步。語本《莊子．田子方》：「夫子步亦步，夫子趨亦趨，夫子馳亦馳。」用以形容事事仿傚或追隨別人。如：「我們若老是跟在先進國家的後面亦步亦趨，永遠不會有自己的成就。」也作「一步一趨」。","s":"馬首是瞻,密切追隨,極力模倣","a":"別出心裁"}]}],"亦然":[{"b":"ㄧˋ ㄖㄢˊ","p":"yì rán","d":[{"f":"也是如此。","e":["如：「要了解一個人必須知道他的過去，要了解一個國家亦然。」"]}]}],"准":[{"b":"ㄓㄨㄣˇ","p":"zhǔn","d":[{"f":"允許。","t":"動","e":["如：「准許」、「上課不准遲到。」"]},{"f":"確定。","t":"動","e":["如：「准於某日上任。」"]},{"f":"依據。","t":"動","e":["如：「准某部公函。」"]},{"f":"比照。","t":"動","e":["如：「准前例科罪。」"]},{"f":"折算、相抵。","t":"動"},{"f":"類比的、將來的。","t":"形","e":["如：「准尉」。"]}]}],"准予":[{"b":"ㄓㄨㄣˇ ㄩˇ","p":"zhǔn yǔ","d":[{"f":"公文上用以表示許可的意思。","e":["如：「准予備查」。"]}]}],"准伏":[{"b":"ㄓㄨㄣˇ ㄈㄨˊ","p":"zhǔn fú","d":[{"f":"畫押。在文書或契約中簽上表示負責、認可的文字。"}]}],"准信":[{"b":"ㄓㄨㄣˇ ㄒㄧㄣˋ","p":"zhǔn xìn","d":[{"f":"信任、相信。"}]}],"准假":[{"b":"ㄓㄨㄣˇ ㄐㄧㄚˋ","p":"zhǔn jià","d":[{"f":"准許請假。","e":["如：「准假外出」。"],"s":"給假,予假"}]}],"准奏":[{"b":"ㄓㄨㄣˇ ㄗㄡˋ","p":"zhǔn zòu","d":[{"f":"古代稱皇帝答應官員的建議或要求為「准奏」。"}]}],"准定":[{"b":"ㄓㄨㄣˇ ㄉㄧㄥˋ","p":"zhǔn dìng","d":[{"f":"肯定、一定。"},{"f":"擬訂、準備好。《清平山堂話本．刎頸鴛鴦會》：「倆個相見暗喜，准定目下成事。」也作「准便」。"}]}],"准將":[{"b":"ㄓㄨㄣˇ ㄐㄧㄤˋ","p":"zhǔn jiàng","d":[{"f":"一種軍階。居少將之下，上校之上。"}]}],"准尉":[{"b":"ㄓㄨㄣˇ ㄨㄟˋ","p":"zhǔn wèi","d":[{"f":"軍隊中的官職位階，居少尉之下，上士之上。"}]}],"准式":[{"b":"ㄓㄨㄣˇ ㄕˋ","p":"zhǔn shì","d":[{"f":"標準、法則。南朝梁．蕭統〈文選序〉：「若夫姬公之籍，孔父之書，與日月俱懸，鬼神爭奧，孝敬之准式，人倫之師友。」也作「準式」、「準則」。"},{"f":"依照標準法式。"}]}],"准折":[{"b":"ㄓㄨㄣˇ ㄓㄜˊ","p":"zhǔn zhé","d":[{"f":"折算、抵償。《水滸傳》第四四回：「三人酒至半酣，計算了酒錢，石秀將這擔柴也都准折了。」《紅樓夢》第六五回：「趁如今我不拿他們取樂作踐准折，到那時，白落個臭名，後悔不及。」也作「准贖」、「准算」、「準折」。"}]}],"准擬":[{"b":"ㄓㄨㄣˇ ㄋㄧˇ","p":"zhǔn nǐ","d":[{"f":"打算、準備。"},{"f":"排定、擬訂。"}]}],"准此":[{"b":"ㄓㄨㄣˇ ㄘˇ","p":"zhǔn cǐ","d":[{"f":"用於公文引敘平行機關來文之後。"}]}],"准算":[{"b":"ㄓㄨㄣˇ ㄙㄨㄢˋ","p":"zhǔn suàn","d":[{"f":"抵價、折算。《警世通言．卷三一．趙春兒重旺曹家莊》：「既寫之後，這產業就不許你賣與他人。及至准算與他，他又要減你的價錢。」也作「准折」。"}]}],"准考證":[{"b":"ㄓㄨㄣˇ ㄎㄠˇ ㄓㄥˋ","p":"zhǔn kǎo zhèng","d":[{"f":"由主辦單位核發，准許考生進場考試的證明文件。"}]}],"准許":[{"b":"ㄓㄨㄣˇ ㄒㄩˇ","p":"zhǔn xǔ","d":[{"f":"許可。","e":["如：「准許請假」。"],"s":"批准,答應,允許","a":"不許"}]}],"哦":[{"b":"ㄛˊ","p":"ó","d":[{"f":"表示領悟的語氣。常配合語境，單獨成句。如：「哦！您就是孫先生。」「哦！我明白了。」","t":"歎"}]},{"b":"ㄜˊ","p":"é","d":[{"f":"吟唱、吟詠。","t":"動","e":["如：「吟哦」。"]}]}],"哦呀":[{"b":"ㄛˊ ㄧㄚ","p":"ó yā","d":[{"f":"表讚嘆或驚訝之詞。","e":["如：「哦呀！又打贏一場球！」"]}]}],"哦呵":[{"b":"ㄛˊ ㄏㄜ","p":"ó hē","d":[{"f":"讚嘆或驚訝之詞。","e":["如：「哦呵！來了這麼多的人。」"]}]}],"哦喲":[{"b":"ㄛˊ ㄧㄠ","p":"ó yāo","d":[{"f":"驚嘆詞。","e":["如：「哦喲！就這麼些而已？」"]}]}],"哦詩":[{"b":"ㄜˊ ㄕ","p":"é shī","d":[{"f":"吟詩。"}]}],"噶":[{"b":"ㄍㄚˊ","p":"gá","d":[{"f":"譯音用字。為藏文譯音所常用。","t":"名","e":["如：「噶當派」、「噶廈」。"]}]},{"b":"ㄍㄜˊ","p":"gé","d":[{"f":"譯音用字。為藏文譯音所常用。","t":"名","e":["如：「噶大克」、「噶倫」。"]}]}],"噶個點兒":[{"b":"ㄍㄚˊ ˙ㄍㄜ ㄉㄧㄢˇㄦ ","p":"gá ge diǎnr ","d":[{"f":"指打賭。","e":["如：「你不相信今天會下雨？咱們不妨來噶個點兒。」"]}]}],"噶倫":[{"b":"ㄍㄜˊ ㄌㄨㄣˊ","p":"gé lún","d":[{"f":"西藏地方政府的內閣或閣員。噶倫係由一喇嘛、一俗官、二軍事長官所組成。"}]}],"噶大克":[{"b":"ㄍㄜˊ ㄉㄚˋ ㄎㄜˋ","p":"gé dà kè","d":[{"f":"城市名。西藏阿里的首府，位於印度河支流象泉河東岸，南通印度、尼泊爾，北通新疆和闐，西通伊朗、阿富汗，東達西藏中部、東部，為西陲交通要地，清光緒三十二年中英新訂藏印條約開為商埠。"}]}],"噶廈":[{"b":"ㄍㄚˊ ㄒㄧㄚˋ","p":"gá xià","d":[{"f":"西藏最高的行政機關，噶布倫議事的所在地。"}]}],"噶當派":[{"b":"ㄍㄚˊ ㄉㄤ ㄆㄞˋ","p":"gá dāng pài","d":[{"f":"西藏佛教主要宗派之一。藏語bka'gdams pa 的音譯。噶當，意為一切佛語都是對僧徒修習的指導。淵源於十一世紀阿底峽尊者，由其高足仲敦巴確立西藏的傳承。後分成教典、教授、教誡三派。對西藏佛教各宗影響頗大。至十五世紀初，宗喀巴吸收其教義，創立格魯派，亦稱新噶當派，噶當派和格魯派遂合而為一。"}]}],"噶舉派":[{"b":"ㄍㄚˊ ㄐㄩˇ ㄆㄞˋ","p":"gá jǔ pài","d":[{"f":"西藏佛教主要宗派之一。藏語bKa' brgyud pa的音譯。噶舉，意為口傳。由於此派特別著重密法的修習，而這些密法又全靠師長口授，故稱為「噶舉派」。又本派的祖瑪爾巴、密勒日巴等在修法時都穿白布裙，所以也稱為「白教」。十一世紀時，由瑪爾巴創立，傳與密勒日巴等，密勒日巴又傳法給岡波巴，由岡波巴門下弟子建立六個支派，大多以其寺院取名，教義差別不大，主要是月稱派的中觀見，強調瑜伽苦修，以證得大手印為圓滿。是西藏現存的主要佛教支派之一。"}]}],"堆":[{"b":"ㄉㄨㄟ","p":"duī","d":[{"f":"積聚成小山的東西。","t":"名","e":["如：「土堆」、「瓦礫堆」、「柴火堆」。"]},{"f":"量詞。計算堆積物、成群人的單位。","t":"名","e":["如：「一堆土」、「兩堆人」。"]},{"f":"地名用字。如屏東縣的六堆，大陸地區四川省奉節縣東瞿塘峽口的灩澦堆。","t":"名"},{"f":"積聚。","t":"動","e":["如：「堆恨成仇」。"]},{"f":"用手或工具把東西聚積起來。","t":"動","e":["如：「把白菜堆在院子裡。」、「把書堆在桌子上。」"]}]}],"堆下笑":[{"b":"ㄉㄨㄟ ㄒㄧㄚˋ ㄒㄧㄠˋ","p":"duī xià xiào","d":[{"f":"滿臉笑容。"}]}],"堆垛":[{"b":"ㄉㄨㄟ ㄉㄨㄛˋ","p":"duī duò","d":[{"f":"堆積、堆砌。"},{"f":"堆砌文字。"}]}],"堆堆":[{"b":"ㄉㄨㄟ ㄉㄨㄟ","p":"duī duī","d":[{"f":"眾多的樣子。"},{"f":"形容久坐不動。"}]}],"堆子":[{"b":"ㄉㄨㄟ ˙ㄗ","p":"duī zi","d":[{"f":"清八旗兵於北平駐屯之所。"}]}],"堆山塞海":[{"b":"ㄉㄨㄟ ㄕㄢ ㄙㄜˋ ㄏㄞˇ","p":"duī shān sè hǎi","d":[{"f":"堆聚成山，填塞大海。比喻很多。"}]}],"堆棧":[{"b":"ㄉㄨㄟ ㄓㄢˋ","p":"duī zhàn","d":[{"f":"積存貨物的倉庫。如：「今年大豐收，堆棧裡存放著滿滿的米糧。」「檢察官帶人搜了這家公司的堆棧，搬走幾箱證物。」","s":"貨倉,棧房,倉庫"}]}],"堆滿":[{"b":"ㄉㄨㄟ ㄇㄢˇ","p":"duī mǎn","d":[{"f":"堆積、布滿。"}]}],"堆疊":[{"b":"ㄉㄨㄟ ㄉㄧㄝˊ","p":"duī dié","d":[{"f":"一層一層的堆積起來。","e":["如：「他桌上堆疊著很多書。」"]}]}],"堆疊式智慧型乙太網路集線器":[{"b":"ㄉㄨㄟ ㄉㄧㄝˊ ㄕˋ ㄓˋ ㄏㄨㄟˋ ㄒㄧㄥˊ ㄧˇ ㄊㄞˋ ㄨㄤˇ ㄌㄨˋ ㄐㄧˊ ㄒㄧㄢˋ ㄑㄧˋ","p":"duī dié shì zhì huì xíng yǐ tài wǎng lù jí xiàn qì","d":[{"f":"一種可堆疊起來的區域網路連接線集線設備。"}]}],"堆砌":[{"b":"ㄉㄨㄟ ㄑㄧˋ","p":"duī qì","d":[{"f":"層疊累積。","e":["如：「那公園裡一列嶙峋的假山，人工堆砌得可真精巧！」"]},{"f":"形容文章中堆積大量華麗而無內容的詞藻。"}]}],"堆積":[{"b":"ㄉㄨㄟ ㄐㄧ","p":"duī jī","d":[{"f":"聚積堆高。","s":"積聚,聚積"}]}],"堆積如山":[{"b":"ㄉㄨㄟ ㄐㄧ ㄖㄨˊ ㄕㄢ","p":"duī jī rú shān","d":[{"f":"東西堆積得像一座山。形容很多。宋．孟元老《東京夢華錄．卷一．外諸司》：「每遇冬月諸鄉納粟稈草，牛車闐塞道路，車尾相啣，數千萬量不絕，場內堆積如山。」《喻世明言．卷二四．晏平仲二桃殺三士》：「臣國中人呵氣如雲，沸汗如雨，行者摩肩，立者並跡，金銀珠玉，堆積如山，安得人物稀少耶？」也作「堆集如山」。"}]}],"堆積平原":[{"b":"ㄉㄨㄟ ㄐㄧ ㄆㄧㄥˊ ㄩㄢˊ","p":"duī jī píng yuán","d":[{"f":"沖積平原及淺海底堆積地形，由泥、砂礫堆積而隆起的海岸平原。"}]}],"堆紅":[{"b":"ㄉㄨㄟ ㄏㄨㄥˊ","p":"duī hóng","d":[{"f":"漆器上所堆成的朱色花紋。"}]}],"堆置":[{"b":"ㄉㄨㄟ ㄓˋ","p":"duī zhì","d":[{"f":"堆積放置。","e":["如：「這批貨堆置這麼久了，還是賣不出去。」、「書房中堆置許多還未整理的論文資料。」"]}]}],"堆肥":[{"b":"ㄉㄨㄟ ㄈㄟˊ","p":"duī féi","d":[{"f":"以植物殘渣與加工後渣粕、廢棄菇類栽培介質、禽畜糞尿等原料，經過翻堆、醱酵腐熟、調配成分、堆置風乾等程序所製成之肥料。"}]}],"堆花":[{"b":"ㄉㄨㄟ ㄏㄨㄚ","p":"duī huā","d":[{"f":"裝飾品上凸起的花紋。"}]}],"堆花燒酒":[{"b":"ㄉㄨㄟ ㄏㄨㄚ ㄕㄠ ㄐㄧㄡˇ","p":"duī huā shāo jiǔ","d":[{"f":"醇酒。"}]}],"堆豗":[{"b":"ㄉㄨㄟ ㄏㄨㄟ","p":"duī huī","d":[{"f":"困頓，無精打彩。"}]}],"堆貨":[{"b":"ㄉㄨㄟ ㄏㄨㄛˋ","p":"duī huò","d":[{"f":"堆疊貨物。","e":["如：「樓梯間不可堆貨及放置雜物擋道。」"]}]}],"堆貯":[{"b":"ㄉㄨㄟ ㄓㄨˇ","p":"duī zhǔ","d":[{"f":"堆積貯藏。"}]}],"堆金":[{"b":"ㄉㄨㄟ ㄐㄧㄣ","p":"duī jīn","d":[{"f":"堆積黃金或錢幣。"},{"f":"比喻陽光燦爛如黃金耀眼。"}]}],"堆金積玉":[{"b":"ㄉㄨㄟ ㄐㄧㄣ ㄐㄧ ㄩˋ","p":"duī jīn jī yù","d