 rǔ","d":[{"f":"一種為改善乳房發育不良、下垂、畸形等現象，使乳房豐滿美觀的整型手術。"}]}],"隆冬":[{"b":"ㄌㄨㄥˊ ㄉㄨㄥ","p":"lóng dōng","d":[{"f":"嚴冬。","s":"窮冬","a":"炎暑,盛暑,盛夏,炎夏"}]}],"隆刑峻法":[{"b":"ㄌㄨㄥˊ ㄒㄧㄥˊ ㄐㄩㄣˋ ㄈㄚˇ","p":"lóng xíng jùn fǎ","d":[{"f":"刑法繁苛而嚴厲。"}]}],"隆古賤今":[{"b":"ㄌㄨㄥˊ ㄍㄨˇ ㄐㄧㄢˋ ㄐㄧㄣ","p":"lóng gǔ jiàn jīn","d":[{"f":"推崇古代，輕賤現今。","e":["如：「食古不化的人，最易犯隆古賤今的毛病。」"]}]}],"隆名":[{"b":"ㄌㄨㄥˊ ㄇㄧㄥˊ","p":"lóng míng","d":[{"f":"盛名、崇高的聲望。"}]}],"隆寒":[{"b":"ㄌㄨㄥˊ ㄏㄢˊ","p":"lóng hán","d":[{"f":"嚴寒。"}]}],"隆崇":[{"b":"ㄌㄨㄥˊ ㄔㄨㄥˊ","p":"lóng chóng","d":[{"f":"高的樣子。"}]}],"隆德":[{"b":"ㄌㄨㄥˊ ㄉㄜˊ","p":"lóng dé","d":[{"f":"崇高的品德。","e":["如：「隆德高行」。"]}]}],"隆恩":[{"b":"ㄌㄨㄥˊ ㄣ","p":"lóng ēn","d":[{"f":"厚恩。"}]}],"隆恩曠典":[{"b":"ㄌㄨㄥˊ ㄣ ㄎㄨㄤˋ ㄉㄧㄢˇ","p":"lóng ēn kuàng diǎn","d":[{"f":"千載難逢的宏恩厚澤。"}]}],"隆恩盛德":[{"b":"ㄌㄨㄥˊ ㄣ ㄕㄥˋ ㄉㄜˊ","p":"lóng ēn shèng dé","d":[{"f":"恩德深厚。"}]}],"隆情":[{"b":"ㄌㄨㄥˊ ㄑㄧㄥˊ","p":"lóng qíng","d":[{"f":"深厚的情感。","e":["如：「隆情高誼」。"]}]}],"隆愛":[{"b":"ㄌㄨㄥˊ ㄞˋ","p":"lóng ài","d":[{"f":"厚愛、深愛。"}]}],"隆昌":[{"b":"ㄌㄨㄥˊ ㄔㄤ","p":"lóng chāng","d":[{"f":"興隆昌盛。","e":["如：「今天公司能夠隆昌興盛、揚名海外，全賴各位同仁的努力。」"]}]}],"隆暑":[{"b":"ㄌㄨㄥˊ ㄕㄨˇ","p":"lóng shǔ","d":[{"f":"盛暑。"}]}],"隆替":[{"b":"ㄌㄨㄥˊ ㄊㄧˋ","p":"lóng tì","d":[{"f":"興衰。","s":"興替,興衰,盛衰"}]}],"隆極":[{"b":"ㄌㄨㄥˊ ㄐㄧˊ","p":"lóng jí","d":[{"f":"至高的地位。"}]}],"隆正":[{"b":"ㄌㄨㄥˊ ㄓㄥˋ","p":"lóng zhèng","d":[{"f":"最高的準則。"}]}],"隆汙":[{"b":"ㄌㄨㄥˊ ㄨ","p":"lóng wū","d":[{"f":"比喻世道盛衰或政治興替。語本《禮記．檀弓上》：「道隆則從而隆，道汙則從而汙。」也作「隆窳」。"}]}],"隆河":[{"b":"ㄌㄨㄥˊ ㄏㄜˊ","p":"lóng hé","d":[{"f":"河川名。在法國東南部，發源於瑞士境內的阿爾卑斯山，向西南流至里昂後，南流注入地中海的里昂灣，全長約八百一十公里。為法國重要的商業水道，沿岸風景優美。"}]}],"隆河谷地":[{"b":"ㄌㄨㄥˊ ㄏㄜˊ ㄍㄨˇ ㄉㄧˋ","p":"lóng hé gǔ dì","d":[{"f":"由隆河沖積而成的肥沃谷地。盛產水果及蠶絲，為法國人口稠密、物產豐富的精華區之一。"}]}],"隆渥":[{"b":"ㄌㄨㄥˊ ㄨㄛˋ","p":"lóng wò","d":[{"f":"隆厚。"}]}],"隆準":[{"b":"ㄌㄨㄥˊ ㄓㄨㄣˇ","p":"lóng zhǔn","d":[{"f":"高鼻。"}]}],"隆盛":[{"b":"ㄌㄨㄥˊ ㄕㄥˋ","p":"lóng shèng","d":[{"f":"興隆繁盛。","s":"興旺,昌隆"}]}],"隆穹":[{"b":"ㄌㄨㄥˊ ㄑㄩㄥ","p":"lóng qiōng","d":[{"f":"高大而中間隆起的樣子。"},{"f":"車篷。"}]}],"隆窯":[{"b":"ㄌㄨㄥˊ ㄧㄠˊ","p":"lóng yáo","d":[{"f":"明隆慶年間官窯所焙製的陶器。"}]}],"隆窳":[{"b":"ㄌㄨㄥˊ ㄩˇ","p":"lóng yǔ","d":[{"f":"興隆衰敗。《三國志．卷四二．蜀書．郤正傳》：「道有隆窳，物有興廢。」也作「隆汙」。"}]}],"隆美爾":[{"b":"ㄌㄨㄥˊ ㄇㄟˇ ㄦˇ","p":"lóng měi ěr","d":[{"f":"人名。（西元1891～1944）德國軍人。第二次世界大戰期間，率兵出征多次，曾指揮德國的非洲兵團遠征北非，因智勇雙全，驍勇善戰，被稱為「非洲之狐」。西元一九四四年因涉及行刺希特勒案件，被逼服毒身亡。"}]}],"隆興":[{"b":"ㄌㄨㄥˊ ㄒㄧㄥ","p":"lóng xīng","d":[{"f":"昌隆興盛。"},{"f":"宋孝宗的年號（西元1163～1164）。"}]}],"隆貴":[{"b":"ㄌㄨㄥˊ ㄍㄨㄟˋ","p":"lóng guì","d":[{"f":"尊貴。"}]}],"隆起":[{"b":"ㄌㄨㄥˊ ㄑㄧˇ","p":"lóng qǐ","d":[{"f":"高起、突起。","a":"陷落,凹下"}]}],"隆運":[{"b":"ㄌㄨㄥˊ ㄩㄣˋ","p":"lóng yùn","d":[{"f":"好運。","e":["如：「他目前正值隆運當頭，凡事得心應手。」"]}]}],"隆重":[{"b":"ㄌㄨㄥˊ ㄓㄨㄥˋ","p":"lóng zhòng","d":[{"f":"盛大而鄭重。","s":"鄭重","a":"簡慢,草率,輕率"},{"f":"地位尊貴。"}]}],"隆隆":[{"b":"ㄌㄨㄥˊ ㄌㄨㄥˊ","p":"lóng lóng","d":[{"f":"擬聲詞。形容很大的聲音。常指雷聲而言。"},{"f":"勢盛的樣子。"}]}],"隆顏":[{"b":"ㄌㄨㄥˊ ㄧㄢˊ","p":"lóng yán","d":[{"f":"天子的容顏。"}]}],"隆鼻":[{"b":"ㄌㄨㄥˊ ㄅㄧˊ","p":"lóng bí","d":[{"f":"高鼻。"},{"f":"一種將鼻梁增高，以改善先天或後天所引起的鼻梁扁平或彎曲現象的外科手術。"}]}],"頖":[{"b":"ㄆㄢˋ","p":"pàn","d":[{"f":"參見「頖宮」條。"}]}],"頖宮":[{"b":"ㄆㄢˋ ㄍㄨㄥ","p":"pàn gōng","d":[{"f":"周代諸侯的學宮。"}]}]}