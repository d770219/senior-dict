{"且":[{"b":"ㄐㄩ","p":"jū","d":[{"f":"農曆六月。","t":"名"},{"f":"用於句末，近似於表示感嘆的「啊」。","t":"助"}]},{"b":"ㄑㄧㄝˇ","p":"qiě","d":[{"f":"暫時。","t":"副","e":["如：「你且坐著」。"]},{"f":"將、將要。","t":"副","e":["如：「旦暮且下」。"]},{"f":"只。","t":"副"},{"f":"又、並。","t":"連","e":["如：「老榕樹既高且大。」"]},{"f":"況、何況。","t":"連"},{"f":"尚、還。","t":"連","e":["如：「尚且」、「然且不可」。"]},{"f":"抑、或者。","t":"連"},{"f":"表示同時做兩件事情。","t":"連","e":["如：「且歌且舞」、「且戰且走」。"]}]}],"且住":[{"b":"ㄑㄧㄝˇ ㄓㄨˋ","p":"qiě zhù","d":[{"f":"暫且停住、等一下。"}]}],"且則":[{"b":"ㄑㄧㄝˇ ㄗㄜˊ","p":"qiě zé","d":[{"f":"姑且、暫且。","s":"且自,暫且"}]}],"且夫":[{"b":"ㄑㄧㄝˇ ㄈㄨˊ","p":"qiě fú","d":[{"f":"承接連詞，表示更進一層。"}]}],"且如":[{"b":"ㄑㄧㄝˇ ㄖㄨˊ","p":"qiě rú","d":[{"f":"假設語氣。假如、如果。"},{"f":"例如、就好像。"}]}],"且慢":[{"b":"ㄑㄧㄝˇ ㄇㄢˋ","p":"qiě màn","d":[{"f":"暫且停住，別急。"}]}],"且戰且走":[{"b":"ㄑㄧㄝˇ ㄓㄢˋ ㄑㄧㄝˇ ㄗㄡˇ","p":"qiě zhàn qiě zǒu","d":[{"f":"邊打邊退。指在敗退時尚且一邊抵抗追擊的敵兵。"}]}],"且是":[{"b":"ㄑㄧㄝˇ ㄕˋ","p":"qiě shì","d":[{"f":"倒是、只是、卻是，為轉折語氣詞。"},{"f":"而且。"}]}],"且月":[{"b":"ㄐㄩ ㄩㄝˋ","p":"jū yuè","d":[{"f":"陰曆六月。"}]}],"且歌且舞":[{"b":"ㄑㄧㄝˇ ㄍㄜ ㄑㄧㄝˇ ㄨˇ","p":"qiě gē qiě wǔ","d":[{"f":"一邊唱歌，一邊跳舞。","e":["如：「就讓我們且歌且舞，歡度中秋佳節吧！」"]}]}],"且聽下回分解":[{"b":"ㄑㄧㄝˇ ㄊㄧㄥ ㄒㄧㄚˋ ㄏㄨㄟˊ ㄈㄣ ㄐㄧㄝˇ","p":"qiě tīng xià huí fēn jiě","d":[{"f":"本是說書人的用語，表示故事尚未完結，請聽眾下次繼續再聽。章回小說中保留此種習慣用語，常在一回末尾使用這句話表示情節還沒結束，請讀者繼續閱讀下一個章節段落。"}]}],"且自":[{"b":"ㄑㄧㄝˇ ㄗˋ","p":"qiě zì","d":[{"f":"姑且。","s":"且則,暫且"}]}],"且行且談":[{"b":"ㄑㄧㄝˇ ㄒㄧㄥˊ ㄑㄧㄝˇ ㄊㄢˊ","p":"qiě xíng qiě tán","d":[{"f":"一邊走路，一邊交談。"}]}],"且要":[{"b":"ㄑㄧㄝˇ ㄧㄠˋ","p":"qiě yào","d":[{"f":"只要、就要。"}]}],"且見":[{"b":"ㄑㄧㄝˇ ㄐㄧㄢˋ","p":"qiě jiàn","d":[{"f":"只看到。","e":["如：「颱風過後，且見行道樹倒了一地。」"]}]}],"且說":[{"b":"ㄑㄧㄝˇ ㄕㄨㄛ","p":"qiě shuō","d":[{"f":"姑且先說。古時說書人結束一個情節，另起一個段落時常用的語詞。章回小說中沿用以發端承接。"}]}],"且道":[{"b":"ㄑㄧㄝˇ ㄉㄠˋ","p":"qiě dào","d":[{"f":"試想、試問、試看。"}]}],"儴":[{"b":"ㄖㄤˊ","p":"ráng","d":[{"f":"依循、沿襲。","t":"動"}]}],"呔":[{"b":"˙ㄊㄞ","p":"tai","d":[{"f":"促使對方注意的吆喝聲。","t":"歎"}]}],"嗤":[{"b":"ㄔ","p":"chī","d":[{"f":"譏笑。","t":"動","e":["如：「嗤之以鼻」。"]},{"f":"形容笑的聲音。","t":"擬","e":["如：「嗤嗤的笑」。"]},{"f":"形容撕紙的聲音。","t":"擬"}]}],"嗤之以鼻":[{"b":"ㄔ ㄓ ㄧˇ ㄅㄧˊ","p":"chī zhī yǐ bí","d":[{"f":"從鼻子裡發出冷笑。表示不屑、鄙視。","e":["如：「他每每大言不慚，惹得眾人對他嗤之以鼻。」"],"a":"拍案叫絕"}]}],"嗤嗤":[{"b":"ㄔ ㄔ","p":"chī chī","d":[{"f":"擬聲詞。形容笑聲或擦撞聲。"},{"f":"敦厚老實的樣子。唐．劉禹錫〈送李策秀才還湖南因寄幕中親故兼簡衡州呂八郎中〉詩：「一揮出滎陽，惠彼嗤嗤氓。」也作「蚩蚩」。"},{"f":"喧擾紛亂的樣子。唐．陳子昂〈感遇〉詩三八首之二〇：「玄天幽且默，群議曷嗤嗤。」也作「蚩蚩」。"}]}],"嗤笑":[{"b":"ㄔ ㄒㄧㄠˋ","p":"chī xiào","d":[{"f":"譏笑、嘲笑。《隋書．卷七三．循吏傳．梁彥光傳》：「豪猾者聞彥光自請而來，莫不嗤笑。」《三國演義》第一八回：「意欲棄布他往，卻又不忍；又恐被人嗤笑。乃終日悶悶不樂。」也作「蚩笑」。","s":"譏笑,恥笑,嘲諷,嘲笑"}]}],"嗤詆":[{"b":"ㄔ ㄉㄧˇ","p":"chī dǐ","d":[{"f":"譏笑、詆毀。"}]}],"嗤鄙":[{"b":"ㄔ ㄅㄧˇ","p":"chī bǐ","d":[{"f":"輕視、不屑。"}]}],"嗤騾子氣":[{"b":"ㄔ ㄌㄨㄛˊ ˙ㄗ ㄑㄧˋ","p":"chī luó zi qì","d":[{"f":"比喻生活貧窮困頓，無以為生。"}]}],"嗤點":[{"b":"ㄔ ㄉㄧㄢˇ","p":"chī diǎn","d":[{"f":"嘲笑指摘。"}]}],"媔":[{"b":"ㄇㄧㄢˇ","p":"miǎn","d":[{"f":"嫉妒。","t":"動"}]},{"b":"ㄇㄧㄢˊ","p":"mián","d":[{"f":"眼睛美麗的樣子。","t":"形"}]}],"尤":[{"b":"ㄧㄡˊ","p":"yóu","d":[{"f":"怨恨、責怪。","t":"動"},{"f":"親近、喜愛。","t":"動"},{"f":"更加、格外。","t":"副"},{"f":"特異。","t":"名"},{"f":"過失。","t":"名"},{"f":"姓。如宋代有尤鶴。","t":"名"}]}],"尤人":[{"b":"ㄧㄡˊ ㄖㄣˊ","p":"yóu rén","d":[{"f":"埋怨他人。","e":["如：「怨天尤人」。"],"s":"怨人"}]}],"尤侗":[{"b":"ㄧㄡˊ ㄊㄨㄥˊ","p":"yóu tóng","d":[{"f":"人名。（西元1618～1704）字同人，更字展成，號悔菴，晚號艮齋，又號西堂老人，清長洲（今江蘇省吳縣）人。康熙間召試鴻博，授檢討，歷官侍講。工古文詩詞，喜為遊戲之筆。詩效溫、李，晚學白居易，詞華富贍，號稱才子。著有《西堂雜俎》、《艮齋雜記》、《鶴栖堂文集》及《鈞天樂》等雜劇。"}]}],"尤其":[{"b":"ㄧㄡˊ ㄑㄧˊ","p":"yóu qí","d":[{"f":"格外、更加。","s":"特別,更加"}]}],"尤列":[{"b":"ㄧㄡˊ ㄌㄧㄝˋ","p":"yóu liè","d":[{"f":"人名。（西元1865～1936）字令季，別字少紈，清廣東順德人。清末，籍隸洪門，在香港識國父，共致力革命，時以二人與楊鶴齡、陳少白，並稱四大寇。第一次起義失敗，同志四散，別組中和堂以維黨務。嗣東渡日本，常往來於南洋。民國十年，曾任總統府顧問。"}]}],"尤悔":[{"b":"ㄧㄡˊ ㄏㄨㄟˇ","p":"yóu huǐ","d":[{"f":"怨恨、懊悔。"}]}],"尤態":[{"b":"ㄧㄡˊ ㄊㄞˋ","p":"yóu tài","d":[{"f":"優美出眾的儀態。"}]}],"尤有甚者":[{"b":"ㄧㄡˊ ㄧㄡˇ ㄕㄣˋ ㄓㄜˇ","p":"yóu yǒu shèn zhě","d":[{"f":"更過分的情況。","e":["如：「這個人本就可惡，尤有甚者，竟把各方捐款占為己有。」"]}]}],"尤殢":[{"b":"ㄧㄡˊ ㄊㄧˋ","p":"yóu tì","d":[{"f":"撒賴、耍賴、糾纏不已。"}]}],"尤物":[{"b":"ㄧㄡˊ ㄨˋ","p":"yóu wù","d":[{"f":"絕色美女。《左傳．昭公二十八年》：「夫有尤物，足以移人。苟非德義，則必有禍。」宋．柳永〈少年遊．世間尤物意中人〉詞：「世間尤物意中人。輕細好腰身。香幃睡起，發妝酒釃，紅臉杏花春。」清．孔尚任《桃花扇》第七齣：「世兄有福，消此尤物。」今或指誘人的美女，略含貶義。","s":"美人"},{"f":"最好的物品。"}]}],"尤甚":[{"b":"ㄧㄡˊ ㄕㄣˋ","p":"yóu shèn","d":[{"f":"更加。用以表示程度更大、更嚴重。"}]}],"尤異":[{"b":"ㄧㄡˊ ㄧˋ","p":"yóu yì","d":[{"f":"特別優異。","e":["如：「他成績不錯，數學尤異。」"]}]}],"尤至":[{"b":"ㄧㄡˊ ㄓˋ","p":"yóu zhì","d":[{"f":"更加周到、完善。"}]}],"尤袤":[{"b":"ㄧㄡˊ ㄇㄠˋ","p":"yóu mào","d":[{"f":"人名。（西元1127～1194）字延之，宋常州無錫人。少穎異，入太學，以詞賦冠多士，紹興十八年擢進士，累官國史侍講，後除禮部尚書。嘗取孫綽遂初賦以自號，光宗曾書匾賜之，年七十而卒，諡文簡。著有《遂初小稿》等，為南宋四大家之一。"}]}],"尤詬":[{"b":"ㄧㄡˊ ㄍㄡˋ","p":"yóu gòu","d":[{"f":"恥辱。"}]}],"尤違":[{"b":"ㄧㄡˊ ㄨㄟˊ","p":"yóu wéi","d":[{"f":"過錯違失。"}]}],"尤里比底斯":[{"b":"ㄧㄡˊ ㄌㄧˇ ㄅㄧˇ ㄉㄧˇ ㄙ","p":"yóu lǐ bǐ dǐ sī","d":[{"f":"人名。（西元前480～前406）古希臘悲劇作家，浪漫戲曲之父。始習繪畫，又習哲學及修辭學，後傾心戲劇。著有劇本九十二種，今存《海倫娜》、《美狄亞》等十八種。也譯作「幼里庇得」、「幼里披底斯」。"}]}],"尤里西斯":[{"b":"ㄧㄡˊ ㄌㄧˇ ㄒㄧ ㄙ","p":"yóu lǐ xī sī","d":[{"f":"書名。愛爾蘭小說家詹姆士．喬艾斯的小說名著，西元一九二二年在巴黎出版。作者運用不同的文體和技巧，描述一九〇四年六月十六日自晨至深夜、發生在都柏林的零星故事。時間空間極其有限，而含義無窮，為近代意識流小說代表作。近有金隄中譯本。"}]}],"尤雲殢雨":[{"b":"ㄧㄡˊ ㄩㄣˊ ㄊㄧˋ ㄩˇ","p":"yóu yún tì yǔ","d":[{"f":"尤、殢，親暱、纏綿；雲、雨，男女歡愛的隱語。「尤雲殢雨」形容男女歡愛纏綿親暱。宋．杜安世〈剔銀燈．好事爭如不遇〉詞：「尤雲殢雨，正繾綣朝朝暮暮。」元．王實甫《西廂記．第三本．第三折》：「強風情措大，晴乾了尤雲殢雨心，悔過了竊玉偷香膽。」也作「殢雨尤雲」、「殢雲尤雨」。"}]}],"嶴":[{"b":"ㄠˋ","p":"ào","d":[{"f":"地名用字。浙江等沿海省分的島嶼，多用嶴作名字。","t":"名","e":["如：「懸嶴」、「薛嶴」、「章嶴」。"]}]}],"彄":[{"b":"ㄎㄡ","p":"kōu","d":[{"f":"弓弩兩端繫弦的部分。","t":"名"},{"f":"環類的東西。","t":"名"}]}],"彄環":[{"b":"ㄎㄡ ㄏㄨㄢˊ","p":"kōu huán","d":[{"f":"指環。"}]}],"惔":[{"b":"ㄊㄢˊ","p":"tán","d":[{"f":"灼燒。","t":"動"}]}],"扤":[{"b":"ㄨˋ","p":"wù","d":[{"f":"動、搖。","t":"動"}]}],"援":[{"b":"ㄩㄢˊ","p":"yuán","d":[{"f":"拉、牽引。","t":"動"},{"f":"引進。","t":"動"},{"f":"引用。","t":"動","e":["如：「援驗」。"]},{"f":"持、拿。","t":"動"},{"f":"救助。","t":"動","e":["如：「援救」、「支援」。"]}]}],"援交":[{"b":"ㄩㄢˊ ㄐㄧㄠ","p":"yuán jiāo","d":[{"f":"即援助交際。參見「援助交際」條。"}]}],"援例":[{"b":"ㄩㄢˊ ㄌㄧˋ","p":"yuán lì","d":[{"f":"引用或比照過去的例子。","e":["如：「援例辦理」。"]}]}],"援兵":[{"b":"ㄩㄢˊ ㄅㄧㄥ","p":"yuán bīng","d":[{"f":"救援的部隊。"}]}],"援助":[{"b":"ㄩㄢˊ ㄓㄨˋ","p":"yuán zhù","d":[{"f":"援救幫助。","s":"幫助,扶助,接濟,支援,援救,援手"}]}],"援助交際":[{"b":"ㄩㄢˊ ㄓㄨˋ ㄐㄧㄠ ㄐㄧˋ","p":"yuán zhù jiāo jì","d":[{"f":"一種不正當的性交易模式。通常由需要金錢的未成年人，以性為條件，向成年人尋求援助。最早流行於日本，後來也影響至國內。"}]}],"援古證今":[{"b":"ㄩㄢˊ ㄍㄨˇ ㄓㄥˋ ㄐㄧㄣ","p":"yuán gǔ zhèng jīn","d":[{"f":"引用古義以證明今事。"}]}],"援外":[{"b":"ㄩㄢˊ ㄨㄞˋ","p":"yuán wài","d":[{"f":"勾結外力。"},{"f":"援助外國。","e":["如：「為善盡國際責任及義務，我國向來積極從事援外活動。」"]}]}],"援引":[{"b":"ㄩㄢˊ ㄧㄣˇ","p":"yuán yǐn","d":[{"f":"引證、舉例。"},{"f":"引薦、提拔。"}]}],"援手":[{"b":"ㄩㄢˊ ㄕㄡˇ","p":"yuán shǒu","d":[{"f":"助人一臂之力使其解脫困境。語本《孟子．離婁上》：「天下溺，援之以道；嫂溺，援之以手。」後用以泛指救助。《二刻拍案驚奇》卷七：「公卿宣淫，誤人兒女。不遇援手，焉復其所？」清．紀昀《閱微草堂筆記．卷三．灤陽消夏錄三》：「父陷冤獄，得公一語可活。公肯援手，當不惜此身。」","s":"援助"}]}],"援據":[{"b":"ㄩㄢˊ ㄐㄩˋ","p":"yuán jù","d":[{"f":"援引依據。"}]}],"援救":[{"b":"ㄩㄢˊ ㄐㄧㄡˋ","p":"yuán jiù","d":[{"f":"救助、援助。","s":"救濟,救助,搶救,拯救,營救,援助"}]}],"援溺振渴":[{"b":"ㄩㄢˊ ㄋㄧˋ ㄓㄣˋ ㄎㄜˇ","p":"yuán nì zhèn kě","d":[{"f":"溺，落水者。振，救助。援溺振渴指救助落水者和乾渴者。比喻援救受難的人。"}]}],"援照":[{"b":"ㄩㄢˊ ㄓㄠˋ","p":"yuán zhào","d":[{"f":"援引依照現成的例子。"}]}],"援用":[{"b":"ㄩㄢˊ ㄩㄥˋ","p":"yuán yòng","d":[{"f":"引用。","e":["如：「援用成例」、「援用法規」。"]}]}],"援筆":[{"b":"ㄩㄢˊ ㄅㄧˇ","p":"yuán bǐ","d":[{"f":"執筆寫字。","s":"執筆"}]}],"援筆成章":[{"b":"ㄩㄢˊ ㄅㄧˇ ㄔㄥˊ ㄓㄤ","p":"yuán bǐ chéng zhāng","d":[{"f":"拿起筆來立刻寫成文章。形容才思敏捷。唐．蔣防《霍小玉傳》：「生素多才思，援筆成章，引諭山河，指誠日月，句句懇切，聞之動人。」也作「援筆立成」。"}]}],"援筆立就":[{"b":"ㄩㄢˊ ㄅㄧˇ ㄌㄧˋ ㄐㄧㄡˋ","p":"yuán bǐ lì jiù","d":[{"f":"拿起筆來很快就完成。《三國演義》第二二回：「（陳琳）當下領命草檄，援筆立就。」也作「援筆而就」。"}]}],"援筆立成":[{"b":"ㄩㄢˊ ㄅㄧˇ ㄌㄧˋ ㄔㄥˊ","p":"yuán bǐ lì chéng","d":[{"f":"拿起筆來立刻寫成文章。形容才思敏捷。宋．羅大經《鶴林玉露》卷一六：「李太白一斗百篇，援筆立成；杜子美改罷長吟，一字不苟。」宋．魏慶之《詩人玉屑．卷三．句法．有三種句》：「命屬題意，如有神助，歸於自然之句；命題立意，援筆立成，歸於容易之句。」也作「援筆成章」。"}]}],"援筆而就":[{"b":"ㄩㄢˊ ㄅㄧˇ ㄦˊ ㄐㄧㄡˋ","p":"yuán bǐ ér jiù","d":[{"f":"拿起筆來很快就完成。清．李漁《意中緣．第二齣．名逋》：「我想求詩求字的，還容易打發，唯有索畫一事，最難應酬。須要逐筆圖寫出來，不是可以倚馬而成，援筆而就的。」也作「援筆立就」。"}]}],"援軍":[{"b":"ㄩㄢˊ ㄐㄩㄣ","p":"yuán jūn","d":[{"f":"增援的軍隊。","e":["如：「正當危急之際，忽傳援軍已至，我方士氣大振。」"],"s":"救兵"}]}],"援鱉失龜":[{"b":"ㄩㄢˊ ㄅㄧㄝ ㄕ ㄍㄨㄟ","p":"yuán biē shī guī","d":[{"f":"為求得到鱉卻反而喪失了靈龜。語本《淮南子．說山》：「殺戎馬而求狐狸，援兩鱉而失靈龜，斷右臂而爭一毛，折鏌邪而爭錐刀。用智如此，豈足高乎？」後用以比喻得不償失，求小利而失大利。如：「你這樣的決定無異是援鱉失龜，絕對得不到好處的。」"}]}],"斄":[{"b":"ㄌㄧˊ","p":"lí","d":[{"f":"硬而捲曲的毛。","t":"名"}]}],"朔":[{"b":"ㄕㄨㄛˋ","p":"shuò","d":[{"f":"農曆每月初一日。","t":"名"},{"f":"開始、最初。","t":"名"},{"f":"北方。","t":"名"},{"f":"北方的。","t":"形"}]}],"朔吹":[{"b":"ㄕㄨㄛˋ ㄔㄨㄟˋ","p":"shuò chuì","d":[{"f":"北風。"}]}],"朔政":[{"b":"ㄕㄨㄛˋ ㄓㄥˋ","p":"shuò zhèng","d":[{"f":"古時天子頒布的政令，諸侯受而行之。"}]}],"朔方":[{"b":"ㄕㄨㄛˋ ㄈㄤ","p":"shuò fāng","d":[{"f":"北方。"},{"f":"郡名。漢武帝驅逐匈奴，收復河南時所設。"}]}],"朔日":[{"b":"ㄕㄨㄛˋ ㄖˋ","p":"shuò rì","d":[{"f":"陰曆每月初一日。","a":"晦日,望日"}]}],"朔月":[{"b":"ㄕㄨㄛˋ ㄩㄝˋ","p":"shuò yuè","d":[{"f":"月球和太陽的黃經相等時的月相。此時月亮在地球與太陽之間，其暗面正與地球相對，地球上看不見月光。","a":"望月,滿月"}]}],"朔望":[{"b":"ㄕㄨㄛˋ ㄨㄤˋ","p":"shuò wàng","d":[{"f":"朔日和望日，陰曆初一與十五。"},{"f":"朝謁之禮。"}]}],"朔望月":[{"b":"ㄕㄨㄛˋ ㄨㄤˋ ㄩㄝˋ","p":"shuò wàng yuè","d":[{"f":"連續二次合朔或滿月所隔的時間。其週期不定，平均為二十九點五三日。故陰曆一月之日數或為二十九日，或為三十日。"}]}],"朔氣":[{"b":"ㄕㄨㄛˋ ㄑㄧˋ","p":"shuò qì","d":[{"f":"節氣。"},{"f":"北方的寒氣。"}]}],"朔漠":[{"b":"ㄕㄨㄛˋ ㄇㄛˋ","p":"shuò mò","d":[{"f":"北方沙漠之地。"}]}],"朔雪":[{"b":"ㄕㄨㄛˋ ㄒㄩㄝˇ","p":"shuò xuě","d":[{"f":"北方的雪。"}]}],"朔雲":[{"b":"ㄕㄨㄛˋ ㄩㄣˊ","p":"shuò yún","d":[{"f":"北方的雲氣。"},{"f":"朔方、雲中二郡的合稱。"}]}],"朔風":[{"b":"ㄕㄨㄛˋ ㄈㄥ","p":"shuò fēng","d":[{"f":"北方吹來的寒風。","s":"北風","a":"薰風"}]}],"朔黨":[{"b":"ㄕㄨㄛˋ ㄉㄤˇ","p":"shuò dǎng","d":[{"f":"宋哲宗時，朝臣所分三黨之一，以劉摯等為首。"}]}],"樴":[{"b":"ㄓˊ","p":"zhí","d":[{"f":"樁子。","t":"名"}]}],"毄":[{"b":"ㄐㄧˊ","p":"jí","d":[{"f":"互相擊中。","t":"動"},{"f":"拂拭。","t":"動"}]}],"甤":[{"b":"","p":"","d":[{"f":"「蕤」的異體字。"}]}],"皴":[{"b":"ㄘㄨㄣ","p":"cūn","d":[{"f":"皮膚皸裂。","t":"動"},{"f":"皺縮。","t":"動"},{"f":"皮膚上聚積的泥垢或脫落的表皮。","t":"名","e":["如：「一脖子皴」、「一身子皴」。"]},{"f":"一種國畫表現紋理的畫法。參見「皴法」條。","t":"名"}]}],"皴法":[{"b":"ㄘㄨㄣ ㄈㄚˇ","p":"cūn fǎ","d":[{"f":"國畫山水樹石中，表現凹凸陰陽之感及線條、紋理、形態等的筆法。如披麻皴、荷葉皴、褶帶皴、解索皴、捲雲皴等。"}]}],"皴節":[{"b":"ㄘㄨㄣ ㄐㄧㄝˊ","p":"cūn jié","d":[{"f":"皺褶與結節。"}]}],"皴裂":[{"b":"ㄘㄨㄣ ㄌㄧㄝˋ","p":"cūn liè","d":[{"f":"裂開、龜裂。","e":["如：「皮膚皴裂」。"]}]}],"皴輪骨":[{"b":"ㄘㄨㄣ ㄌㄨㄣˊ ㄍㄨˇ","p":"cūn lún gǔ","d":[{"f":"有輪形皺紋且高的顴骨。"}]}],"秔":[{"b":"","p":"","d":[{"f":"「粳」的異體字。"}]}],"筤":[{"b":"ㄌㄤˊ","p":"láng","d":[{"f":"車後用竹子編成的篷蓋。","t":"名"},{"f":"初生的嫩竹。參見「蒼筤」條。","t":"名"}]}],"糴":[{"b":"ㄉㄧˊ","p":"dí","d":[{"f":"買入穀物。與「糶」相對。","t":"動"},{"f":"姓。如春秋時晉國有糴筏。","t":"名"}]}],"糴入":[{"b":"ㄉㄧˊ ㄖㄨˋ","p":"dí rù","d":[{"f":"買入穀糧。","a":"糶出"}]}],"糴米":[{"b":"ㄉㄧˊ ㄇㄧˇ","p":"dí mǐ","d":[{"f":"買入米糧。"}]}],"糴糶":[{"b":"ㄉㄧˊ ㄊㄧㄠˋ","p":"dí tiào","d":[{"f":"米糧、稻穀的買賣進出。"}]}],"耔":[{"b":"ㄗˇ","p":"zǐ","d":[{"f":"培土，將土堆在苗根旁邊。","t":"動"},{"f":"植物的種子。","t":"名"}]}],"茴":[{"b":"ㄏㄨㄟˊ","p":"huí","d":[{"f":"參見「茴香」條。"}]}],"茴香":[{"b":"ㄏㄨㄟˊ ㄒㄧㄤ","p":"huí xiāng","d":[{"f":"植物名。繖形科茴香屬，多年生草本，具強烈芳香。莖直立，圓柱形，葉三至四回羽狀全裂，末端裂片細絲狀。複繖形花序，繖輻八至三十枝，花小，黃色，卵形。果卵狀扁橢圓形，可充蔬食，亦用做香料。從果實提煉出的油為茴香油，可供作藥用。"}]}],"蓄":[{"b":"ㄒㄩˋ","p":"xù","d":[{"f":"儲藏、儲存。","t":"動","e":["如：「蓄水池」、「儲蓄」。"]},{"f":"蘊藏、不表露。","t":"動","e":["如：「含蓄」、「蓄意」。"]},{"f":"留著。","t":"動","e":["如：「蓄髮」、「爺爺蓄了一臉的絡腮鬍。」"]},{"f":"等待。","t":"動"}]}],"蓄勢待發":[{"b":"ㄒㄩˋ ㄕˋ ㄉㄞˋ ㄈㄚ","p":"xù shì dài fā","d":[{"f":"貯備隨時可以展現的實力，待機而發。","e":["如：「運動會即將來臨，同學們個個摩拳擦掌，蓄勢待發。」"]}]}],"蓄志":[{"b":"ㄒㄩˋ ㄓˋ","p":"xù zhì","d":[{"f":"蘊藏志願，待機即發。","e":["如：「他接手父親瀕臨倒閉的公司，蓄志再次振興家業。」"],"s":"蓄意,存心"}]}],"蓄念":[{"b":"ㄒㄩˋ ㄋㄧㄢˋ","p":"xù niàn","d":[{"f":"蘊積已久的意念。《文選．班固．西都賦》：「願賓攄懷舊之蓄念，發思古之幽情。」也作「蓄意」。"}]}],"蓄恨":[{"b":"ㄒㄩˋ ㄏㄣˋ","p":"xù hèn","d":[{"f":"積蓄已久的怨恨。","e":["如：「他因為蓄恨難洩，所以失手傷人。」"]}]}],"蓄意":[{"b":"ㄒㄩˋ ㄧˋ","p":"xù yì","d":[{"f":"蘊積已久的意念。唐．開元宮人〈袍中〉詩：「蓄意添多線，含情更著綿。」也作「蓄念」。","s":"蓄謀,蓄志,存心"}]}],"蓄書":[{"b":"ㄒㄩˋ ㄕㄨ","p":"xù shū","d":[{"f":"藏書。"}]}],"蓄水":[{"b":"ㄒㄩˋ ㄕㄨㄟˇ","p":"xù shuǐ","d":[{"f":"將水儲存起來。","e":["如：「梅雨季節，水庫充分發揮蓄水功能，今年人們不用擔心會缺水了。」"]}]}],"蓄水池":[{"b":"ㄒㄩˋ ㄕㄨㄟˇ ㄔˊ","p":"xù shuǐ chí","d":[{"f":"儲存用水的人工池。"}]}],"蓄洪":[{"b":"ㄒㄩˋ ㄏㄨㄥˊ","p":"xù hóng","d":[{"f":"為了防止洪水成災，把超過河道所能排泄的洪水儲存在一定的地區，稱為「蓄洪」。"}]}],"蓄火":[{"b":"ㄒㄩˋ ㄏㄨㄛˇ","p":"xù huǒ","d":[{"f":"留存火種，以備引燃之用。"}]}],"蓄疑":[{"b":"ㄒㄩˋ ㄧˊ","p":"xù yí","d":[{"f":"蓄積疑慮。"}]}],"蓄積":[{"b":"ㄒㄩˋ ㄐㄧ","p":"xù jī","d":[{"f":"儲蓄累積。","s":"積儲,儲蓄","a":"虛耗"},{"f":"所儲存的糧食物資。"}]}],"蓄精蓄銳":[{"b":"ㄒㄩˋ ㄐㄧㄥ ㄒㄩˋ ㄖㄨㄟˋ","p":"xù jīng xù ruì","d":[{"f":"蓄養精神，儲備氣力。"}]}],"蓄縮":[{"b":"ㄒㄩˋ ㄙㄨㄛ","p":"xù suō","d":[{"f":"收縮。"},{"f":"作事懈怠而不振作。"}]}],"蓄艾":[{"b":"ㄒㄩˋ ㄞˋ","p":"xù ài","d":[{"f":"比喻儲材備用。"}]}],"蓄謀":[{"b":"ㄒㄩˋ ㄇㄡˊ","p":"xù móu","d":[{"f":"精心謀畫而未明露。","e":["如：「他為了侵占公款，處心積慮，蓄謀已久。」"],"s":"蓄意,存心"}]}],"蓄足":[{"b":"ㄒㄩˋ ㄗㄨˊ","p":"xù zú","d":[{"f":"儲蓄充足。","e":["如：「今年風調雨順，水稻豐收，故穀倉蓄足。」"]}]}],"蓄銳":[{"b":"ㄒㄩˋ ㄖㄨㄟˋ","p":"xù ruì","d":[{"f":"蓄養銳氣。"}]}],"蓄銳養威":[{"b":"ㄒㄩˋ ㄖㄨㄟˋ ㄧㄤˇ ㄨㄟ","p":"xù ruì yǎng wēi","d":[{"f":"積蓄銳氣，保養威力。《周書．卷三一．韋孝寬傳》：「今若更存遵養，且復相時，臣謂宜還崇鄰好，申其盟約，安人和眾，通商惠工，蓄銳養威，觀釁而動。」也作「養銳蓄威」、「養威蓄銳」。"}]}],"蓄電":[{"b":"ㄒㄩˋ ㄉㄧㄢˋ","p":"xù diàn","d":[{"f":"儲備電能。"}]}],"蓄電池":[{"b":"ㄒㄩˋ ㄉㄧㄢˋ ㄔˊ","p":"xù diàn chí","d":[{"f":"一種具有兩電極及電解質，可將電能轉為化學能儲存起來的裝置，如鉛蓄電池。用電時，經化學變化放出電能後，可沿著與放電方向相反的電流，使之充電而再度使用，與一般電池原理不同，為供應直流電的重要裝置，用途甚廣。"}]}],"蓄養":[{"b":"ㄒㄩˋ ㄧㄤˇ","p":"xù yǎng","d":[{"f":"飼養。"},{"f":"蓄積培養。","e":["如：「蓄養國力是保障國家安全的不二法門。」"]}]}],"蓄髮":[{"b":"ㄒㄩˋ ㄈㄚˇ","p":"xù fǎ","d":[{"f":"留髮。"}]}],"虔":[{"b":"ㄑㄧㄢˊ","p":"qián","d":[{"f":"恭敬有誠意的。","t":"形","e":["如：「虔誠」、「虔敬」。"]},{"f":"殺害。","t":"動"},{"f":"強取、掠奪。","t":"動"}]}],"虔劉":[{"b":"ㄑㄧㄢˊ ㄌㄧㄡˊ","p":"qián liú","d":[{"f":"殺害。"}]}],"虔婆勢":[{"b":"ㄑㄧㄢˊ ㄆㄛˊ ㄕˋ","p":"qián pó shì","d":[{"f":"做作、虛情假意，故作兇狠的樣子。"}]}],"虔心":[{"b":"ㄑㄧㄢˊ ㄒㄧㄣ","p":"qián xīn","d":[{"f":"恭敬有誠心。《西遊記》第四回：「三兄弟各辦虔心，牽著白馬，馬上馱著行李，找大路一直前進。」《初刻拍案驚奇》卷六：「先喫兩日素，足見大娘虔心。」也作「虔誠」。"}]}],"虔恪":[{"b":"ㄑㄧㄢˊ ㄎㄜˋ","p":"qián kè","d":[{"f":"恭敬。"}]}],"虔敬":[{"b":"ㄑㄧㄢˊ ㄐㄧㄥˋ","p":"qián jìng","d":[{"f":"虔誠恭敬。","e":["如：「母親早晚都以虔敬的心，燒香拜佛，求神庇佑在外的子孫。」"],"s":"虔誠"}]}],"虔虔":[{"b":"ㄑㄧㄢˊ ㄑㄧㄢˊ","p":"qián qián","d":[{"f":"恭敬的樣子。"}]}],"虔誠":[{"b":"ㄑㄧㄢˊ ㄔㄥˊ","p":"qián chéng","d":[{"f":"恭敬有誠心。北周．庾信〈周祀五帝歌〉一二首之五：「朱絃絳鼓罄虔誠，萬物含養各長生。」《初刻拍案驚奇》卷五：「民間各處，立起個虎媒之祠，若是有婚姻求合的，虔誠祈禱，無有不應。」也作「虔心」。","s":"虔敬"}]}],"襴":[{"b":"ㄌㄢˊ","p":"lán","d":[{"f":"舊時上衣和下裳相連的衣服。","t":"名"}]}],"襴衣":[{"b":"ㄌㄢˊ ㄧ","p":"lán yī","d":[{"f":"和尚所穿的長袍。"}]}],"襴衫":[{"b":"ㄌㄢˊ ㄕㄢ","p":"lán shān","d":[{"f":"古代讀書人的家常服飾。《宋史．卷一五三．輿服志五》：「襴衫，以白細布為之，圓領大袖下施橫襴為裳，腰間有辟積。進士及國子生、州縣生服之。」《土風錄．卷三．襴衫》：「按綱目集覽，馬周以三代布深衣，因於其下著衫及裙，名曰襴衫。以為上士之服。……或云當為藍衫。」也作「藍衫」。"}]}],"襴裙":[{"b":"ㄌㄢˊ ㄑㄩㄣˊ","p":"lán qún","d":[{"f":"覆蓋在女性胸腹的小衣。唐時稱為「抹胸」，宋、明時稱為「袜胸」，清時稱為「肚兜」。"}]}],"謄":[{"b":"ㄊㄥˊ","p":"téng","d":[{"f":"複寫、抄寫。","t":"動","e":["如：「謄稿」、「謄清」、「謄寫」。"]}]}],"謄寫":[{"b":"ㄊㄥˊ ㄒㄧㄝˇ","p":"téng xiě","d":[{"f":"謄清抄寫。","s":"謄錄,抄寫,鈔寫,繕寫"}]}],"謄寫鋼版":[{"b":"ㄊㄥˊ ㄒㄧㄝˇ ㄍㄤ ㄅㄢˇ","p":"téng xiě gāng bǎn","d":[{"f":"一種簡便的印刷器材。其紋如網，多鑲於木板上，使用時，將蠟紙置於版上以鋼製筆把蠟質刮去，再將蠟紙置於機器上，上覆以薄絹，以膠棍塗油墨印刷於白紙上。"}]}],"謄本":[{"b":"ㄊㄥˊ ㄅㄣˇ","p":"téng běn","d":[{"f":"文件的抄本或副本。","e":["如：「戶籍謄本」。"]}]}],"謄清":[{"b":"ㄊㄥˊ ㄑㄧㄥ","p":"téng qīng","d":[{"f":"照草稿用正楷抄寫清楚。"}]}],"謄真":[{"b":"ㄊㄥˊ ㄓㄣ","p":"téng zhēn","d":[{"f":"以正楷謄寫清楚。"}]}],"謄錄":[{"b":"ㄊㄥˊ ㄌㄨˋ","p":"téng lù","d":[{"f":"謄寫抄錄。","e":["如：「謄錄文稿」。"],"s":"謄寫,抄寫,鈔繕"}]}],"謄錄所":[{"b":"ㄊㄥˊ ㄌㄨˋ ㄙㄨㄛˇ","p":"téng lù suǒ","d":[{"f":"古時考試，為避免閱卷者認出應試者的筆跡，而將試卷重新謄寫的機構。"}]}],"謄黃":[{"b":"ㄊㄥˊ ㄏㄨㄤˊ","p":"téng huáng","d":[{"f":"舊時天子下詔書，由禮部或各省督撫用黃紙謄寫頒行所屬州縣，稱為「謄黃」。"}]}],"貔":[{"b":"ㄆㄧˊ","p":"pí","d":[{"f":"一種猛獸。似虎，毛灰白色。","t":"名"}]}],"貔子":[{"b":"ㄆㄧˊ ˙ㄗ","p":"pí zi","d":[{"f":"鼬鼠的別名。參見「鼬鼠」條。"}]}],"貔子窩港":[{"b":"ㄆㄧˊ ㄗˇ ㄨㄛ ㄍㄤˇ","p":"pí zǐ wō gǎng","d":[{"f":"地名。位於遼東半島南岸，大連灣之東，當清水河入海的海口；港口東南向，前有島嶼羅列，形勢扼要。清光緒中日甲午戰爭時，日兵由此登岸以襲擊旅順。"}]}],"貔虎":[{"b":"ㄆㄧˊ ㄏㄨˇ","p":"pí hǔ","d":[{"f":"貔與虎都是猛獸。比喻勇猛的將士。"}]}],"貔貅":[{"b":"ㄆㄧˊ ㄒㄧㄡ","p":"pí xiū","d":[{"f":"動物名。哺乳綱食肉目豹屬。一種猛獸。"},{"f":"比喻勇猛的將士。"}]}],"踤":[{"b":"ㄗㄨˊ","p":"zú","d":[{"f":"觸擊、衝撞。","t":"動"}]}],"辴":[{"b":"ㄓㄣˇ","p":"zhěn","d":[{"f":"笑的樣子。","t":"副"}]}],"鑤":[{"b":"","p":"","d":[{"f":"「鉋」的異體字。"}]}],"鞄":[{"b":"ㄅㄠ","p":"bāo","d":[{"f":"軟皮做成的小箱子。","t":"名","e":["如：「提鞄」。"]}]},{"b":"ㄆㄠˊ","p":"páo","d":[{"f":"使皮革柔軟的工匠。","t":"名"}]}],"餔":[{"b":"ㄅㄨ","p":"bū","d":[{"f":"傍晚進食，猶吃晚餐。","t":"動"},{"f":"吃。","t":"動"},{"f":"申時。指下午三點到五點。或泛指黃昏時分。","t":"名"}]},{"b":"ㄅㄨˋ","p":"bù","d":[{"f":"給予食物、餵食。","t":"動"},{"f":"參見「餔子」條。","t":"名"}]}],"餔啜":[{"b":"ㄅㄨ ㄔㄨㄛˋ","p":"bū chuò","d":[{"f":"吃喝。《孟子．離婁上》：「子之從於子敖來，徒餔啜也。我不意子學古之道，而以餔啜也。」漢．趙岐．注：「學而不行其道，徒食飲而已。」《初刻拍案驚奇》卷八：「小可不是餔啜之徒，感仁兄一飯。」也作「餔歠」。"}]}],"餔子":[{"b":"ㄅㄨˋ ˙ㄗ","p":"bù zi","d":[{"f":"嬰兒吃的糊狀食物。"}]}],"餔時":[{"b":"ㄅㄨ ㄕˊ","p":"bū shí","d":[{"f":"申時。下午三點到五點。《淮南子．天文》：「至于悲谷，是謂餔時。」《史記．卷九．呂太后本紀》：「日餔時，遂擊產。」也作「晡時」。"}]}],"餔歠":[{"b":"ㄅㄨ ㄔㄨㄛˋ","p":"bū chuò","d":[{"f":"吃喝。漢．揚雄〈反離騷〉：「溷漁父之餔歠兮，絜沐浴之振衣。」也作「餔啜」。"}]}],"餔糟啜醨":[{"b":"ㄅㄨ ㄗㄠ ㄔㄨㄛˋ ㄌㄧˊ","p":"bū zāo chuò lí","d":[{"f":"比喻隨波逐流、與世浮沉的態度。參見「餔糟歠醨」條。"}]}],"餔糟歠醨":[{"b":"ㄅㄨ ㄗㄠ ㄔㄨㄛˋ ㄌㄧˊ","p":"bū zāo chuò lí","d":[{"f":"糟，釀酒的殘渣。醨，薄酒。「餔糟歠醨」指吃酒渣，喝薄酒。語本《文選．卷三三．騷．屈原．漁父》：「眾人皆醉，何不餔其糟而歠其醨？」後借以喻隨波逐流，與世浮沉的生活態度。也作「餔糟啜醨」。"}]}],"餔菜":[{"b":"ㄅㄨˋ ㄘㄞˋ","p":"bù cài","d":[{"f":"在筵席上替客人夾菜稱為「餔菜」。也作「布菜」、「佈菜」。"}]}],"鰴":[{"b":"ㄏㄨㄟ","p":"huī","d":[{"f":"魚強而有力，異於群輩的樣子。","t":"形"}]}],"鷄":[{"b":"","p":"","d":[{"f":"「雞」的異體字。"}]}],"齔":[{"b":"ㄔㄣˋ","p":"chèn","d":[{"f":"自乳齒脫換為成人的牙齒。","t":"動"},{"f":"年幼的人。","t":"名"},{"f":"幼小。","t":"形"}]}],"󶾄":[{"b":"","p":"","d":[{"f":"「黃」的異體字。"}]}]}