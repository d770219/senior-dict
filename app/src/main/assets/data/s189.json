b":"ㄆㄧˇ","p":"pǐ","d":[{"f":"人名用字。如春秋時吳國有伯嚭。","t":"名"}]}],"嚭嚭地":[{"b":"ㄆㄧˇ ㄆㄧˇ ˙ㄉㄜ","p":"pǐ pǐ de","d":[{"f":"心跳的樣子。"}]}],"堽":[{"b":"ㄍㄤ","p":"gāng","d":[{"f":"山脊、山嶺。","t":"名"},{"f":"參見「堽頭」條。","t":"名"}]}],"堽頭":[{"b":"ㄍㄤ ㄊㄡˊ","p":"gāng tóu","d":[{"f":"水手的頭目。","e":["如：「在船上要先和堽頭建立好關係，才好安撫水手。」"]}]}],"姍":[{"b":"ㄒㄧㄢ","p":"xiān","d":[{"f":"(一)之又音。"}]},{"b":"ㄕㄢ","p":"shān","d":[{"f":"誹謗、詆毀。","t":"動"},{"f":"參見「姍姍」條。","t":"形"}]}],"姍姍":[{"b":"ㄕㄢ ㄕㄢ","p":"shān shān","d":[{"f":"形容姿態輕盈緩慢，從容優雅。多用於女子。"},{"f":"形容氣度高雅，飄逸灑脫。"}]}],"姍姍來遲":[{"b":"ㄕㄢ ㄕㄢ ㄌㄞˊ ㄔˊ","p":"shān shān lái chí","d":[{"f":"形容女子遲步緩來的樣子。語本《漢書．卷九七．外戚傳上．孝武李夫人》：「上思念李夫人不已，方士齊人少翁言能致其神。乃夜張燈燭，設帷帳，陳酒肉，而令上居他帳，遙望好女如李夫人之貌，還幄坐而步。又不得就視，上愈益相思悲感，為作詩曰：『是邪？非邪？立而望之，偏何姍姍其來遲！』」清．屈大均〈汪虞部以咂嘛酒惠奠崋姜賦謝〉詩：「先生憫念黃泉下，蘆酒今朝奠一斝，馨香更用返魂燒。清冷如將甘露灑，恍惚既醉朱顏酡。姍姍來遲可奈何。」清．楊懋建《帝城花樣．小薌傳》：「小蘭如芙蓉女兒，明秀無匹，姍姍來遲，媚不可言。」後也用以形容人不依時赴會，害人苦等。如：「他總是姍姍來遲，害得大家老等他一人。」"}]}],"姍笑":[{"b":"ㄕㄢ ㄒㄧㄠˋ","p":"shān xiào","d":[{"f":"譏笑、嘲笑。"}]}],"孝":[{"b":"ㄒㄧㄠˋ","p":"xiào","d":[{"f":"盡心奉養父母。","t":"動","e":["如：「孝順」、「孝敬」。"]},{"f":"有孝心的。","t":"形","e":["如：「孝子」、「孝女」。"]},{"f":"善事父母的道理、方法。","t":"名","e":["如：「忠孝傳家」。"]},{"f":"居喪的禮儀。","t":"名","e":["如：「守孝」。"]},{"f":"居喪時所穿的素服。","t":"名","e":["如：「戴孝」、「穿孝」。"]},{"f":"姓。如宋代有孝發。","t":"名"}]}],"孝事":[{"b":"ㄒㄧㄠˋ ㄕˋ","p":"xiào shì","d":[{"f":"表示辦理喪事的標誌。"}]}],"孝先便腹":[{"b":"ㄒㄧㄠˋ ㄒㄧㄢ ㄆㄧㄢˊ ㄈㄨˋ","p":"xiào xiān pián fù","d":[{"f":"漢邊韶字孝先，白晝假寐，弟子則譏嘲他腹大便便，懶讀書。典出《後漢書．卷八〇．文苑傳上．邊韶傳》。後用以形容貪睡而腹大的樣子。"}]}],"孝友":[{"b":"ㄒㄧㄠˋ ㄧㄡˇ","p":"xiào yǒu","d":[{"f":"孝順父母，友愛兄弟。"}]}],"孝堂":[{"b":"ㄒㄧㄠˋ ㄊㄤˊ","p":"xiào táng","d":[{"f":"喪家停放靈柩的廳堂。"}]}],"孝女":[{"b":"ㄒㄧㄠˋ ㄋㄩˇ","p":"xiào nǚ","d":[{"f":"有孝行的女子。"},{"f":"居父母之喪的女子自稱。"}]}],"孝子":[{"b":"ㄒㄧㄠˋ ㄗˇ","p":"xiào zǐ","d":[{"f":"事親至孝的人。","e":["如：「孝子慈孫」、「忠臣孝子」。"],"a":"逆子"},{"f":"居親喪的人。"},{"f":"臨祭時對父母的自稱。"},{"f":"流行語。孝順孩子，戲稱對孩子非常疼愛。","e":["如：「他是個標準的孝子，一下班就迫不及待地衝回家抱小孩。」"]}]}],"孝子慈孫":[{"b":"ㄒㄧㄠˋ ㄗˇ ㄘˊ ㄙㄨㄣ","p":"xiào zǐ cí sūn","d":[{"f":"能克盡孝道奉養父母的子孫。《孟子．離婁上》：「暴其民甚，則身弒國亡；不甚，則身危國削。名之曰幽厲，雖孝子慈孫，百世不能改也。」宋．羅大經《鶴林玉露》卷六：「古人之所謂卜其宅兆者，乃孝子慈孫之心，謹重親之遺體，使其他日不為城邑道路溝渠耳。」也作「