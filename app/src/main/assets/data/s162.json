{"仂":[{"b":"ㄌㄜˋ","p":"lè","d":[{"f":"零餘的數目。","t":"名"}]}],"仂語":[{"b":"ㄌㄜˋ ㄩˇ","p":"lè yǔ","d":[{"f":"文法學名詞之一。指文法上不成句的詞組。如「雄偉的建築」、「春夏秋冬」等。"}]}],"凢":[{"b":"","p":"","d":[{"f":"「凡」的異體字。"}]}],"卲":[{"b":"ㄕㄠˋ","p":"shào","d":[{"f":"高尚、美好。","t":"形","e":["如：「年高德卲」。"]}]}],"妲":[{"b":"ㄉㄚˊ","p":"dá","d":[{"f":"參見「妲己」條。"}]}],"妲己":[{"b":"ㄉㄚˊ ㄐㄧˇ","p":"dá jǐ","d":[{"f":"人名。姓己，字妲，生卒年不詳，商代有蘇氏之女。紂王之妃，得紂王寵愛，助紂為虐，周武王滅紂被殺。"}]}],"峒":[{"b":"ㄉㄨㄥˋ","p":"dòng","d":[{"f":"早期大陸地區海南島黎族政治組織的名稱。各峒以山嶺、河流為界，有固定的地域。","t":"名","e":["如：「峒長」。"]},{"f":"地名用字：(1)苗、傜、僮、侗等民族的聚居區域。分布在大陸地區廣西、貴州等部分山區。如「苗峒」、「黃峒」。(2)山洞。","t":"名","e":["如：「峒中」、「吉峒坪」。"]}]},{"b":"ㄊㄨㄥˊ","p":"tóng","d":[{"f":"參見「崆峒山」條。"}]}],"幢":[{"b":"ㄓㄨㄤˋ","p":"zhuàng","d":[{"f":"后妃舟車上形狀像車蓋的帷幔。","t":"名"}]},{"b":"ㄔㄨㄤˊ","p":"chuáng","d":[{"f":"旌旗一類的東西。","t":"名","e":["如：「旌幢」、「幡幢」。"]},{"f":"量詞。計算房屋的單位。","t":"名","e":["如：「一幢房子」。"]}]}],"幢幡":[{"b":"ㄔㄨㄤˊ ㄈㄢ","p":"chuáng fān","d":[{"f":"佛教道場用來裝飾的長形旗幟。"}]}],"幢幢":[{"b":"ㄔㄨㄤˊ ㄔㄨㄤˊ","p":"chuáng chuáng","d":[{"f":"形容羽飾繁多。"},{"f":"晃動，搖曳不定。"}]}],"幢節":[{"b":"ㄔㄨㄤˊ ㄐㄧㄝˊ","p":"chuáng jié","d":[{"f":"傳達命令的符信等物。"},{"f":"旗幟儀仗。"}]}],"幢蓋":[{"b":"ㄔㄨㄤˊ ㄍㄞˋ","p":"chuáng gài","d":[{"f":"旌旗和曲柄的蓬蓋。古為將軍刺史的儀仗。"}]}],"幢隊":[{"b":"ㄔㄨㄤˊ ㄉㄨㄟˋ","p":"chuáng duì","d":[{"f":"軍隊中掌旗作先導的隊伍。"}]}],"幢麾":[{"b":"ㄔㄨㄤˊ ㄏㄨㄟ","p":"chuáng huī","d":[{"f":"儀仗旗幟等物。"}]}],"忲":[{"b":"","p":"","d":[{"f":"「忕」的異體字。"}]}],"憂":[{"b":"ㄧㄡ","p":"yōu","d":[{"f":"發愁、擔心。","t":"動","e":["如：「杞人憂天」。"]},{"f":"愁悶不快樂。","t":"形","e":["如：「憂傷」、「憂心忡忡」、「憂心如焚」。"]},{"f":"煩惱的事。","t":"名","e":["如：「分憂解勞」、「高枕無憂」、「內憂外患」、「無憂無慮」。"]},{"f":"父母的喪事。","t":"名","e":["如：「丁憂」。"]},{"f":"疾病。","t":"名"}]}],"憂傷":[{"b":"ㄧㄡ ㄕㄤ","p":"yōu shāng","d":[{"f":"憂愁悲傷。","s":"難過,惆悵,憂鬱","a":"歡樂"}]}],"憂公如家":[{"b":"ㄧㄡ ㄍㄨㄥ ㄖㄨˊ ㄐㄧㄚ","p":"yōu gōng rú jiā","d":[{"f":"憂慮公事，就如懸念家事一般。"}]}],"憂公忘私":[{"b":"ㄧㄡ ㄍㄨㄥ ㄨㄤˋ ㄙ","p":"yōu gōng wàng sī","d":[{"f":"一心憂勞國事，不顧及私利。《魏書．卷七五．尒朱兆等傳．史臣曰》：「若使布德行義，憂公忘私，脣齒相依，同心協力，則磐石之固，未可圖也。」宋．司馬光〈遠謀〉：「上自公卿，下及斗食，自非憂公忘私之人，大抵多懷苟且之計。」也作「憂公無私」。"}]}],"憂公無私":[{"b":"ㄧㄡ ㄍㄨㄥ ㄨˊ ㄙ","p":"yōu gōng wú sī","d":[{"f":"一心憂勞國事，毫不顧及私利。三國魏．桓範《世要論．臣不易》：「陳之於主，行之於身，志於忠上濟事，憂公無私。」也作「憂公忘私」。"}]}],"憂勞":[{"b":"ㄧㄡ ㄌㄠˊ","p":"yōu láo","d":[{"f":"憂愁勞苦。"}]}],"憂喜交集":[{"b":"ㄧㄡ ㄒㄧˇ ㄐㄧㄠ ㄐㄧˊ","p":"yōu xǐ jiāo jí","d":[{"f":"憂愁和喜悅的情緒交織錯雜。"}]}],"憂喜參半":[{"b":"ㄧㄡ ㄒㄧˇ ㄘㄢ ㄅㄢˋ","p":"yōu xǐ cān bàn","d":[{"f":"憂愁和喜悅的心情各占一半。","e":["如：「他得知兒子發生車禍，幸而經急救後已無大礙，不禁憂喜參半。」"]}]}],"憂國":[{"b":"ㄧㄡ ㄍㄨㄛˊ","p":"yōu guó","d":[{"f":"憂慮國事。"}]}],"憂國哀民":[{"b":"ㄧㄡ ㄍㄨㄛˊ ㄞ ㄇㄧㄣˊ","p":"yōu guó āi mín","d":[{"f":"憂慮國事，哀憐百姓。漢．王符《潛夫論．救邊》：「會坐朝堂，則無憂國哀民懇惻之誠，苟轉相顧望，莫肯違止。」也作「憂國恤民」。"}]}],"憂國如家":[{"b":"ㄧㄡ ㄍㄨㄛˊ ㄖㄨˊ ㄐㄧㄚ","p":"yōu guó rú jiā","d":[{"f":"憂慮國事，就如惦念家事一般。"}]}],"憂國忘家":[{"b":"ㄧㄡ ㄍㄨㄛˊ ㄨㄤˋ ㄐㄧㄚ","p":"yōu guó wàng jiā","d":[{"f":"一心憂慮國事，把家庭私事置諸度外。"}]}],"憂國忘私":[{"b":"ㄧㄡ ㄍㄨㄛˊ ㄨㄤˋ ㄙ","p":"yōu guó wàng sī","d":[{"f":"憂慮國事，將個人私務棄置一旁。"}]}],"憂國忘身":[{"b":"ㄧㄡ ㄍㄨㄛˊ ㄨㄤˋ ㄕㄣ","p":"yōu guó wàng shēn","d":[{"f":"憂勞國事，不顧自身安危得失。"}]}],"憂國恤民":[{"b":"ㄧㄡ ㄍㄨㄛˊ ㄒㄩˋ ㄇㄧㄣˊ","p":"yōu guó xù mín","d":[{"f":"憂慮國事，憐恤百姓。漢．徐幹《中論．卷下．譴交》：「文書委於官曹，繫囚積於囹圄，而不遑省也。詳察其為也，非欲憂國恤民，謀道講德也。」也作「憂國哀民」。"}]}],"憂國愛民":[{"b":"ㄧㄡ ㄍㄨㄛˊ ㄞˋ ㄇㄧㄣˊ","p":"yōu guó ài mín","d":[{"f":"憂慮國事，關愛人民。"}]}],"憂國憂時":[{"b":"ㄧㄡ ㄍㄨㄛˊ ㄧㄡ ㄕˊ","p":"yōu guó yōu shí","d":[{"f":"憂慮國事及時局。","e":["如：「一位偉大的政治家應具有憂國憂時的胸懷。」"]}]}],"憂國憂民":[{"b":"ㄧㄡ ㄍㄨㄛˊ ㄧㄡ ㄇㄧㄣˊ","p":"yōu guó yōu mín","d":[{"f":"憂慮國家大計和人民疾苦。宋．范仲淹〈謝轉禮部侍郎表〉：「進則盡憂國憂民之誠，退則處樂天樂道之分。」也作「憂民憂國」。","s":"傷時感事"}]}],"憂尋":[{"b":"ㄧㄡ ㄒㄩㄣˊ","p":"yōu xún","d":[{"f":"深憂。"}]}],"憂形於色":[{"b":"ㄧㄡ ㄒㄧㄥˊ ㄩˊ ㄙㄜˋ","p":"yōu xíng yú sè","d":[{"f":"憂慮表現於神色上。"}]}],"憂心":[{"b":"ㄧㄡ ㄒㄧㄣ","p":"yōu xīn","d":[{"f":"憂愁的心緒。"},{"f":"憂慮擔心。"}]}],"憂心如惔":[{"b":"ㄧㄡ ㄒㄧㄣ ㄖㄨˊ ㄊㄢˊ","p":"yōu xīn rú tán","d":[{"f":"惔，火燒。憂心如惔比喻非常憂慮焦急。《詩經．小雅．節南山》：「憂心如惔，不敢戲談。」也作「憂心如焚」。"}]}],"憂心如擣":[{"b":"ㄧㄡ ㄒㄧㄣ ㄖㄨˊ ㄉㄠˇ","p":"yōu xīn rú dǎo","d":[{"f":"語本《詩經．小雅．小弁》：「我心憂傷，惄焉如擣。」比喻心中焦慮難安。","s":"憂心忡忡"}]}],"憂心如焚":[{"b":"ㄧㄡ ㄒㄧㄣ ㄖㄨˊ ㄈㄣˊ","p":"yōu xīn rú fén","d":[{"f":"內心憂慮有如火在焚燒。比喻非常焦慮不安。三國魏．曹植〈釋愁文〉：「予以愁慘，行吟路邊，形容枯悴，憂心如焚。」《三國演義》第八〇回：「憂心如焚，命不久矣。」也作「憂心如惔」。","s":"內心不安,憂心忡忡","a":"無憂無慮"}]}],"憂心如薰":[{"b":"ㄧㄡ ㄒㄧㄣ ㄖㄨˊ ㄒㄩㄣ","p":"yōu xīn rú xūn","d":[{"f":"憂愁得如同被火薰烤一般。比喻非常憂慮痛苦。"}]}],"憂心如酲":[{"b":"ㄧㄡ ㄒㄧㄣ ㄖㄨˊ ㄔㄥˊ","p":"yōu xīn rú chéng","d":[{"f":"酲，酒醉後神志不清的樣子。憂心如酲比喻心情十分愁悶抑鬱。《詩經．小雅．節南山》：「憂心如酲，誰秉國成？」《文選．曹植．應詔詩》：「仰瞻城閾，俯惟闕庭，長懷永慕，憂心如酲。」也作「憂心如醉」、「憂心若醉」。"}]}],"憂心如醉":[{"b":"ㄧㄡ ㄒㄧㄣ ㄖㄨˊ ㄗㄨㄟˋ","p":"yōu xīn rú zuì","d":[{"f":"心中憂悶，如同醉酒後般難過。比喻非常憂愁鬱悶。《詩經．秦風．晨風》：「未見君子，憂心如醉。」也作「憂心如酲」、「憂心若醉」。"}]}],"憂心忡忡":[{"b":"ㄧㄡ ㄒㄧㄣ ㄔㄨㄥ ㄔㄨㄥ","p":"yōu xīn chōng chōng","d":[{"f":"憂愁不安的樣子。","s":"憂心如擣,憂心如焚","a":"喜氣洋洋"}]}],"憂心悄悄":[{"b":"ㄧㄡ ㄒㄧㄣ ㄑㄧㄠˇ ㄑㄧㄠˇ","p":"yōu xīn qiǎo qiǎo","d":[{"f":"憂慮不安的樣子。"}]}],"憂心若醉":[{"b":"ㄧㄡ ㄒㄧㄣ ㄖㄨㄛˋ ㄗㄨㄟˋ","p":"yōu xīn ruò zuì","d":[{"f":"心中憂悶，如同醉酒後般難過。比喻非常憂愁鬱悶。也作「憂心如酲」、「憂心如醉」。"}]}],"憂思":[{"b":"ㄧㄡ ㄙ","p":"yōu sī","d":[{"f":"憂慮。"},{"f":"憂愁的情緒。"}]}],"憂悒":[{"b":"ㄧㄡ ㄧˋ","p":"yōu yì","d":[{"f":"愁悶不安。《晉書．卷七四．列傳．桓彝》：「彝嘗去職，至廣陵尋親舊，還遇風，停浦中，累日憂悒。」也作「憂鬱」。"}]}],"憂患":[{"b":"ㄧㄡ ㄏㄨㄢˋ","p":"yōu huàn","d":[{"f":"憂愁患難。"}]}],"憂患意識":[{"b":"ㄧㄡ ㄏㄨㄢˋ ㄧˋ ㄕˋ","p":"yōu huàn yì shì","d":[{"f":"處於安定中仍不忘思慮急難處境的危機感。","e":["如：「唯有對自己的國家前途懷有憂患意識，才能避免民族走向衰敗的命運。」"]}]}],"憂悶":[{"b":"ㄧㄡ ㄇㄣˋ","p":"yōu mèn","d":[{"f":"憂愁煩悶。","s":"憂愁","a":"舒暢"}]}],"憂惙":[{"b":"ㄧㄡ ㄔㄨㄛˋ","p":"yōu chuò","d":[{"f":"憂愁悲傷。"}]}],"憂惱":[{"b":"ㄧㄡ ㄋㄠˇ","p":"yōu nǎo","d":[{"f":"憂愁煩惱。"}]}],"憂愁":[{"b":"ㄧㄡ ㄔㄡˊ","p":"yōu chóu","d":[{"f":"擔憂發愁。","s":"苦惱,哀愁,憂悶,憂慮,憂鬱","a":"高興,歡樂,歡欣,喜悅,欣喜,痛快"}]}],"憂愁夫人":[{"b":"ㄧㄡ ㄔㄡˊ ㄈㄨ ㄖㄣˊ","p":"yōu chóu fū rén","d":[{"f":"書名。德國蘇德曼所作的小說。敘述一女子苦心積慮，欲維持家庭，但終歸失敗，後忽然覺悟，乃與其愛人結合。描寫深刻入微，耐人尋味。"}]}],"憂慮":[{"b":"ㄧㄡ ㄌㄩˋ","p":"yōu lǜ","d":[{"f":"憂愁擔心。","s":"擔心,擔憂,憂愁,憂鬱","a":"安心,放心,舒暢"}]}],"憂憤":[{"b":"ㄧㄡ ㄈㄣˋ","p":"yōu fèn","d":[{"f":"心中愁悶不平。"}]}],"憂憶":[{"b":"ㄧㄡ ㄧˋ","p":"yōu yì","d":[{"f":"憂慮、擔心。"}]}],"憂懼":[{"b":"ㄧㄡ ㄐㄩˋ","p":"yōu jù","d":[{"f":"憂愁恐懼。","s":"恐憂"}]}],"憂戚":[{"b":"ㄧㄡ ㄑㄧ","p":"yōu qī","d":[{"f":"憂愁哀傷。"}]}],"憂民":[{"b":"ㄧㄡ ㄇㄧㄣˊ","p":"yōu mín","d":[{"f":"為民憂思。"}]}],"憂民憂國":[{"b":"ㄧㄡ ㄇㄧㄣˊ ㄧㄡ ㄍㄨㄛˊ","p":"yōu mín yōu guó","d":[{"f":"憂慮國家大計和民生疾苦。明．王世貞《鳴鳳記》第二七齣：「鏡中華髮為誰班，憂民憂國減容光。」也作「憂國憂民」。"}]}],"憂深思遠":[{"b":"ㄧㄡ ㄕㄣ ㄙ ㄩㄢˇ","p":"yōu shēn sī yuǎn","d":[{"f":"凡事想得深，思慮得遠。"}]}],"憂煎":[{"b":"ㄧㄡ ㄐㄧㄢ","p":"yōu jiān","d":[{"f":"受憂慮煎熬。比喻非常憂愁。"}]}],"憂煩":[{"b":"ㄧㄡ ㄈㄢˊ","p":"yōu fán","d":[{"f":"憂愁煩惱。"}]}],"憂疑":[{"b":"ㄧㄡ ㄧˊ","p":"yōu yí","d":[{"f":"疑慮。"}]}],"憂能傷人":[{"b":"ㄧㄡ ㄋㄥˊ ㄕㄤ ㄖㄣˊ","p":"yōu néng shāng rén","d":[{"f":"憂愁煩悶會損害人的健康。"}]}],"憂色":[{"b":"ㄧㄡ ㄙㄜˋ","p":"yōu sè","d":[{"f":"憂愁的神色。"}]}],"憂葵":[{"b":"ㄧㄡ ㄎㄨㄟˊ","p":"yōu kuí","d":[{"f":"比喻女子擔憂國事。參見「魯女憂葵」條。"}]}],"憂虞":[{"b":"ㄧㄡ ㄩˊ","p":"yōu yú","d":[{"f":"憂愁。"}]}],"憂道不憂貧":[{"b":"ㄧㄡ ㄉㄠˋ ㄅㄨˋ ㄧㄡ ㄆㄧㄣˊ","p":"yōu dào bù yōu pín","d":[{"f":"憂心大道不能行之天下，而不以個人的貧困為憂。"}]}],"憂闕":[{"b":"ㄧㄡ ㄑㄩㄝ","p":"yōu quē","d":[{"f":"前任官吏因丁憂返鄉所遺留的空缺。"}]}],"憂鬱":[{"b":"ㄧㄡ ㄩˋ","p":"yōu yù","d":[{"f":"憂傷悒鬱。《管子．內業》：「思索生知，慢易生憂，暴傲生怨，憂鬱生疾，疾困乃死。」《紅樓夢》第三回：「只因寶玉情性乖僻，每每規諫，寶玉不聽，心中著實憂鬱。」也作「憂悒」。","s":"憂悶,憂慮,憂傷,憂愁","a":"爽朗,開朗,愉快,暢快"}]}],"憂鬱症":[{"b":"ㄧㄡ ㄩˋ ㄓㄥˋ","p":"yōu yù zhèng","d":[{"f":"因環境壓力或個人心理因素等原因所造成的心理疾病。表現症狀多為情緒低落、悲觀、抑鬱，嚴重者甚至陷入絕望、自責、思想錯亂的情況，生理上也出現食慾不振，或暴飲暴食、頭痛、心悸、嗜睡或早睡、兩眼無神、嘴角下陷等徵狀。依形成原因可分為反應型憂鬱症及內因型憂鬱症。"}]}],"撢":[{"b":"ㄉㄢˇ","p":"dǎn","d":[{"f":"用撢子或其他東西輕拍，拂去塵土。","t":"動","e":["如：「撢一撢灰塵。」"]}]},{"b":"ㄊㄢˋ","p":"tàn","d":[{"f":"探索。通「探」。《說文解字．手部》：「撢，探也。」《周禮．夏官．撢人》「掌誦王志道，國之政事」句下唐．賈公彥．疏：「撢取王之此志，又道國之政事。」","t":"動"}]}],"撢子":[{"b":"ㄉㄢˇ ˙ㄗ","p":"dǎn zi","d":[{"f":"用雞毛或布條做成，用於拂掃灰塵的工具。","e":["如：「雞毛撢子」。"]}]}],"汲":[{"b":"ㄐㄧˊ","p":"jí","d":[{"f":"自井中取水。","t":"動","e":["如：「汲水」、「汲引」。"]},{"f":"姓。如漢代有汲黯。","t":"名"}]}],"汲井":[{"b":"ㄐㄧˊ ㄐㄧㄥˇ","p":"jí jǐng","d":[{"f":"汲取井水。"}]}],"汲冢古文":[{"b":"ㄐㄧˊ ㄓㄨㄥˇ ㄍㄨˇ ㄨㄣˊ","p":"jí zhǒng gǔ wén","d":[{"f":"汲冢出土的古籍或其上的文字。晉武帝太康二年，汲郡人不準盜發魏襄王墓，所得數十車竹書，皆先秦科斗文，共計七十五篇，稱為「汲冢古文」。見《晉書．卷三九．荀勖傳及卷五十一．束晳傳》。"}]}],"汲取":[{"b":"ㄐㄧˊ ㄑㄩˇ","p":"jí qǔ","d":[{"f":"本為取水之意。後引申為吸取、吸收。如：「當百花盛開時，小蜜蜂辛勤地工作，以汲取花蜜。」「許多偉大作家、藝術家，都曾自希臘神話中汲取創作靈感。」","s":"吸收"}]}],"汲古":[{"b":"ㄐㄧˊ ㄍㄨˇ","p":"jí gǔ","d":[{"f":"鑽研古籍以獲取知識。如汲水於井，故稱為「汲古」。"}]}],"汲古閣":[{"b":"ㄐㄧˊ ㄍㄨˇ ㄍㄜˊ","p":"jí gǔ gé","d":[{"f":"明末常熟人毛晉藏書的閣名。毛晉喜藏書，積八萬四千餘冊，多宋、元善本。又喜刻書，所刻諸書通稱為「汲古閣本」。"}]}],"汲引":[{"b":"ㄐㄧˊ ㄧㄣˇ","p":"jí yǐn","d":[{"f":"引進提拔人才。","s":"提拔"}]}],"汲水":[{"b":"ㄐㄧˊ ㄕㄨㄟˇ","p":"jí shuǐ","d":[{"f":"從井裡取水。亦泛指打水。","s":"打水,吊水,取水"}]}],"汲水機":[{"b":"ㄐㄧˊ ㄕㄨㄟˇ ㄐㄧ","p":"jí shuǐ jī","d":[{"f":"將低處的水送至高處的一種機械。"}]}],"汲汲":[{"b":"ㄐㄧˊ ㄐㄧˊ","p":"jí jí","d":[{"f":"形容努力求取、不休息的樣子。"},{"f":"虛偽奸詐的樣子。"},{"f":"憂惶不安的樣子。"},{"f":"恭敬謹慎，不敢怠忽。"}]}],"汲汲營營":[{"b":"ㄐㄧˊ ㄐㄧˊ ㄧㄥˊ ㄧㄥˊ","p":"jí jí yíng yíng","d":[{"f":"汲汲，勤求不休止的樣子；營營，追逐求取。「汲汲營營」本指匆匆往來的樣子。後多形容人急切求取名利的樣子。","e":["如：「他為了名利，每天汲汲營營，哪還能顧得了這些小事。」"]}]}],"汲汲皇皇":[{"b":"ㄐㄧˊ ㄐㄧˊ ㄏㄨㄤˊ ㄏㄨㄤˊ","p":"jí jí huáng huáng","d":[{"f":"形容心情急切，舉止匆忙的樣子。"}]}],"汲深綆短":[{"b":"ㄐㄧˊ ㄕㄣ ㄍㄥˇ ㄉㄨㄢˇ","p":"jí shēn gěng duǎn","d":[{"f":"比喻才能不足，無法勝任。參見「綆短汲深」條。","e":["如：「一個人如果把目標定得太高，超出自己的能力，那麼雖然想努力的做好它，恐怕汲深綆短，力有未逮。」"],"s":"心餘力絀"}]}],"汲直":[{"b":"ㄐㄧˊ ㄓˊ","p":"jí zhí","d":[{"f":"原指汲黯性情剛直，敢於漢武帝面前諫諍。見《漢書．卷五〇．汲黯傳》。後世稱諍臣為「汲直」。"}]}],"汲綆":[{"b":"ㄐㄧˊ ㄍㄥˇ","p":"jí gěng","d":[{"f":"汲水的繩子。"}]}],"汲道":[{"b":"ㄐㄧˊ ㄉㄠˋ","p":"jí dào","d":[{"f":"引水的通道。"}]}],"汲酒":[{"b":"ㄐㄧˊ ㄐㄧㄡˇ","p":"jí jiǔ","d":[{"f":"取酒。","e":["如：「汲酒澆愁」、「這種麥芽威士忌是直接從酒桶汲酒裝瓶，風味香醇。」"]}]}],"汲黯":[{"b":"ㄐㄧˊ ㄢˋ","p":"jí àn","d":[{"f":"人名。字長孺，漢濮陽人，生卒年不詳。性剛直，守節死義，直言極諫，至為武帝所敬憚，世稱「汲直」。"}]}],"澒":[{"b":"ㄏㄨㄥˋ","p":"hòng","d":[{"f":"水銀。","t":"名"},{"f":"水深廣的樣子。","t":"形"}]}],"澒洞":[{"b":"ㄏㄨㄥˋ ㄊㄨㄥˊ","p":"hòng tóng","d":[{"f":"迷濛無間，瀰漫無際的樣子。"}]}],"澒溶":[{"b":"ㄏㄨㄥˋ ㄖㄨㄥˊ","p":"hòng róng","d":[{"f":"水深廣的樣子。"},{"f":"渾融、混沌。"}]}],"澒濛":[{"b":"ㄏㄨㄥˋ ㄇㄥˊ","p":"hòng méng","d":[{"f":"宇宙形成前的混沌之氣。"}]}],"痒":[{"b":"","p":"","d":[{"f":"「癢」的異體字。"}]},{"b":"ㄧㄤˊ","p":"yáng","d":[{"f":"身體器官或皮膚黏膜發生潰爛或生瘡的症狀。","t":"名"},{"f":"憂慮成疾。","t":"動"}]}],"睢":[{"b":"ㄙㄨㄟ","p":"suī","d":[{"f":"參見「睢睢」條。","t":"形"},{"f":"河川名。參見「睢河」條。","t":"名"},{"f":"姓。如春秋時齊國有睢休相。","t":"名"}]}],"睢河":[{"b":"ㄙㄨㄟ ㄏㄜˊ","p":"suī hé","d":[{"f":"河川名。源出河南省虞城縣，東南流經江蘇、安徽北部，流入洪澤湖。今多堙塞。"}]}],"睢盱":[{"b":"ㄙㄨㄟ ㄒㄩ","p":"suī xū","d":[{"f":"喜悅的樣子。"},{"f":"質樸。"},{"f":"仰目而視。"}]}],"睢睢":[{"b":"ㄙㄨㄟ ㄙㄨㄟ","p":"suī suī","d":[{"f":"仰目而視的樣子。"}]}],"睢睢盱盱":[{"b":"ㄙㄨㄟ ㄙㄨㄟ ㄒㄩ ㄒㄩ","p":"suī suī xū xū","d":[{"f":"傲慢、橫暴。"},{"f":"恭敬聽視。"},{"f":"渾厚純樸。"}]}],"睢維":[{"b":"ㄙㄨㄟ ㄨㄟˊ","p":"suī wéi","d":[{"f":"眼睛張開的樣子。"}]}],"睢陽":[{"b":"ㄙㄨㄟ ㄧㄤˊ","p":"suī yáng","d":[{"f":"地名。故城在今河南省商邱縣境。唐張巡、許遠曾死守此，以抗安祿山，屏蔽江淮。"}]}],"磲":[{"b":"ㄑㄩˊ","p":"qú","d":[{"f":"參見「硨磲」條。"}]}],"綢":[{"b":"ㄔㄡˊ","p":"chóu","d":[{"f":"絲織品的通稱。","t":"名","e":["如：「綢緞」、「杭綢」、「府綢」。"]},{"f":"束縛、纏紮。","t":"動"}]}],"綢子":[{"b":"ㄔㄡˊ ˙ㄗ","p":"chóu zi","d":[{"f":"輕薄柔軟的絲織品。"}]}],"綢帷":[{"b":"ㄗ ㄨㄟˊ","p":"zī wéi","d":[{"f":"形容林木繁茂。"}]}],"綢直":[{"b":"ㄔㄡˊ ㄓˊ","p":"chóu zhí","d":[{"f":"比喻性情細密而操行正直。"}]}],"綢紋紙":[{"b":"ㄔㄡˊ ㄨㄣˊ ㄓˇ","p":"chóu wén zhǐ","d":[{"f":"一種沖印、放大照片時用的紙。其紋理細密，宛若綢子，故稱為「綢紋紙」。"}]}],"綢緞":[{"b":"ㄔㄡˊ ㄉㄨㄢˋ","p":"chóu duàn","d":[{"f":"綢與緞。泛指絲織品。"}]}],"綢繆":[{"b":"ㄔㄡˊ ㄇㄡˊ","p":"chóu móu","d":[{"f":"親密、纏綿。"},{"f":"纏縛。引申為修補，使之堅固。"},{"f":"花朵稠密的樣子。"}]}],"胂":[{"b":"ㄕㄣ","p":"shēn","d":[{"f":"夾脊肉。","t":"名"}]}],"菢":[{"b":"ㄅㄠˋ","p":"bào","d":[{"f":"禽鳥孵卵。","t":"動"}]}],"蜂":[{"b":"ㄈㄥ","p":"fēng","d":[{"f":"昆蟲綱膜翅目蜂類的泛稱。共含六科，約一萬二千多種。體長約一至三公分，會飛，多有毒刺，能蜇人，常群居一起。較常見的有蜜蜂、黃蜂等。","t":"名"}]}],"蜂出":[{"b":"ㄈㄥ ㄔㄨ","p":"fēng chū","d":[{"f":"像蜂群飛出。比喻多而雜亂。"}]}],"蜂午並起":[{"b":"ㄈㄥ ㄨˇ ㄅㄧㄥˋ ㄑㄧˇ","p":"fēng wǔ bìng qǐ","d":[{"f":"形容雜沓而出。"}]}],"蜂屯蟻聚":[{"b":"ㄈㄥ ㄊㄨㄣˊ ㄧˇ ㄐㄩˋ","p":"fēng tún yǐ jù","d":[{"f":"形容如同蜂蟻聚集般紛紜雜亂。宋．秦觀《進策．盜賊下》：「臣聞盜賊之起，小則蜂屯蟻聚，虜掠閭里，大則擅名號、攻城邑、取庫兵、釋死罪、殺掠吏民。」《孽海花》第三回：「這裡雯青直到日落西山，才把那些蜂屯蟻聚的親朋支使出了門。」也作「蟻聚蜂屯」。"}]}],"蜂巢":[{"b":"ㄈㄥ ㄔㄠˊ","p":"fēng cháo","d":[{"f":"蜜蜂所造的巢。"}]}],"蜂巢式行動電話系統":[{"b":"ㄈㄥ ㄔㄠˊ ㄕˋ ㄒㄧㄥˊ ㄉㄨㄥˋ ㄉㄧㄢˋ ㄏㄨㄚˋ ㄒㄧˋ ㄊㄨㄥˇ","p":"fēng cháo shì xíng dòng diàn huà xì tǒng","d":[{"f":"一種可隨意增加通訊容量的小區域行動電話系統。將整個通訊地區劃分為數個如細胞格（蜂巢）的區域，藉區域內的基地臺互相通訊。當一個細胞格容量不夠時，可再劃分為數個細胞格，如此，便可不斷增加空中通訊的容量，使通訊服務更便捷。通常七個細胞格成為一個蜂巢。"}]}],"蜂巢胃":[{"b":"ㄈㄥ ㄔㄠˊ ㄨㄟˋ","p":"fēng cháo wèi","d":[{"f":"反芻類動物的胃常分四囊，其第二囊內壁構造襞皺如蜂巢，故稱為「蜂巢胃」。"}]}],"蜂房":[{"b":"ㄈㄥ ㄈㄤˊ","p":"fēng fáng","d":[{"f":"蜂巢。"}]}],"蜂房不容鵠卵":[{"b":"ㄈㄥ ㄈㄤˊ ㄅㄨˋ ㄖㄨㄥˊ ㄏㄨˊ ㄌㄨㄢˇ","p":"fēng fáng bù róng hú luǎn","d":[{"f":"比喻小形不足以包大體。"}]}],"蜂擁":[{"b":"ㄈㄥ ㄩㄥˇ","p":"fēng yǒng","d":[{"f":"比喻人多而擁擠。","e":["如：「蜂擁而來」。"],"s":"蜂湧,簇擁"}]}],"蜂擁而上":[{"b":"ㄈㄥ ㄩㄥˇ ㄦˊ ㄕㄤˋ","p":"fēng yǒng ér shàng","d":[{"f":"比喻如蜂般簇擁上來。"}]}],"蜂擁而至":[{"b":"ㄈㄥ ㄩㄥˇ ㄦˊ ㄓˋ","p":"fēng yǒng ér zhì","d":[{"f":"比喻如蜂般擁進來。","s":"汹湧而來"}]}],"蜂湧":[{"b":"ㄈㄥ ㄩㄥˇ","p":"fēng yǒng","d":[{"f":"如蜂群集。"}]}],"蜂湧而出":[{"b":"ㄈㄥ ㄩㄥˇ ㄦˊ ㄔㄨ","p":"fēng yǒng ér chū","d":[{"f":"蜜蜂自蜂巢傾洩出來，形容在很短時間內，許多人同時出來。","e":["如：「火車陸續到站，只見人群便蜂湧而出，使火車站顯得擁擠不堪。」"]}]}],"蜂準":[{"b":"ㄈㄥ ㄓㄨㄣˇ","p":"fēng zhǔn","d":[{"f":"高高隆起的鼻梁。"}]}],"蜂炮":[{"b":"ㄈㄥ ㄆㄠˋ","p":"fēng pào","d":[{"f":"將數萬枝五顏六色的火燄沖天炮，一排排的綁在木架上，高度各有不同，外形很像蜂巢的炮陣。點燃時，沖天炮帶著火燄向四方奔竄飛舞，就像是群蜂出巢。如臺南市鹽水區元宵夜蜂炮便十分有名。"}]}],"蜂王":[{"b":"ㄈㄥ ㄨㄤˊ","p":"fēng wáng","d":[{"f":"蜜蜂為群居昆蟲，每一蜂群中，只有一隻身體最大而能產卵的雌蜂，眾蜂附從之。為整個蜂窩的領導者。參見「女王蜂」條。"}]}],"蜂王乳":[{"b":"ㄈㄥ ㄨㄤˊ ㄖㄨˇ","p":"fēng wáng rǔ","d":[{"f":"女王蜂專屬攝取的食物。為工蜂採集花粉，經過花蜜糖漬，再加上工蜂嘴裡的分泌物轉化而成。呈白色糊狀或乳油狀，味酸。","e":["如：「蜂王乳是滋補保健聖品，營養豐富，特別具有美容養顏的功效。」"]}]}],"蜂目豺聲":[{"b":"ㄈㄥ ㄇㄨˋ ㄔㄞˊ ㄕㄥ","p":"fēng mù chái shēng","d":[{"f":"形容人極為凶悍。"}]}],"蜂窩":[{"b":"ㄈㄥ ㄨㄛ","p":"fēng wō","d":[{"f":"蜂巢。"}]}],"蜂窩兒":[{"b":"ㄈㄥ ㄨㄛㄦ","p":"fēng wōr ","d":[{"f":"物品多孔似蜂窩形狀。","e":["如：「發麵所蒸食品，多有蜂窩兒。」"]}]}],"蜂糖":[{"b":"ㄈㄥ ㄊㄤˊ","p":"fēng táng","d":[{"f":"蜜蜂採取花中甘液所釀成濃稠的蜜汁。"}]}],"蜂聚":[{"b":"ㄈㄥ ㄐㄩˋ","p":"fēng jù","d":[{"f":"像蜂一樣的聚集。形容人數眾多。","e":["如：「像潮水般湧來的群眾，蜂聚在舞臺前，想要一睹巨星的光采。」"]}]}],"蜂腰":[{"b":"ㄈㄥ ㄧㄠ","p":"fēng yāo","d":[{"f":"比喻細腰。"},{"f":"梁沈約所倡作詩八病之一，即五言詩第二字與第五字同聲。"}]}],"蜂腰削背":[{"b":"ㄈㄥ ㄧㄠ ㄒㄩㄝˋ ㄅㄟˋ","p":"fēng yāo xuè bèi","d":[{"f":"形容身材瘦弱細腰。"}]}],"蜂膠":[{"b":"ㄈㄥ ㄐㄧㄠ","p":"fēng jiāo","d":[{"f":"為一種保健產品，係蜜蜂採集植物的汁液、花粉或花蜜，混合其口腔唾液及分泌的蜜臘，所形成的膠狀物。含有類黃酮及多酚類等成分。據研究，可以減緩喉嚨發炎、增強免疫力及抑制細菌生長。"}]}],"蜂蒙":[{"b":"ㄈㄥ ㄇㄥˊ","p":"fēng méng","d":[{"f":"古代著名的射手。參見「逢蒙」條。"}]}],"蜂蜜":[{"b":"ㄈㄥ ㄇㄧˋ","p":"fēng mì","d":[{"f":"蜜蜂採取花中甘液所釀成濃稠的蜜汁，可供食用和入藥。"}]}],"蜂蠆入懷，解衣去趕":[{"b":"ㄈㄥ ㄔㄞˋ ㄖㄨˋ ㄏㄨㄞˊ ， ㄐㄧㄝˇ ㄧ ㄑㄩˋ ㄍㄢˇ","p":"fēng chài rù huái ， jiě yī qù gǎn","d":[{"f":"（諺語）比喻壞事現形，無法隱瞞。"}]}],"蜂蠆有毒":[{"b":"ㄈㄥ ㄔㄞˋ ㄧㄡˇ ㄉㄨˊ","p":"fēng chài yǒu dú","d":[{"f":"蜂蠆，蠍子一類的毒蟲。蜂蠆有毒比喻微小的東西也能害人。"}]}],"蜂蠟":[{"b":"ㄈㄥ ㄌㄚˋ","p":"fēng là","d":[{"f":"係由蜂巢純化得到的黃色蠟質，也稱為「黃蠟」。黃蠟經脫色加工，即成白蠟。可當作硬化劑，供製蠟燭、製藥或其他工業用途。"}]}],"蜂衙":[{"b":"ㄈㄥ ㄧㄚˊ","p":"fēng yá","d":[{"f":"群蜂早晚定時的聚集，如下屬參謁長官於衙中，故稱為「蜂衙」。"},{"f":"蜂房。"}]}],"蜂起":[{"b":"ㄈㄥ ㄑㄧˇ","p":"fēng qǐ","d":[{"f":"形容像蜜蜂成群而起。"}]}],"蜂門":[{"b":"ㄈㄥ ㄇㄣˊ","p":"fēng mén","d":[{"f":"古代著名的射手。參見「逢蒙」條。"}]}],"蜂鳥":[{"b":"ㄈㄥ ㄋㄧㄠˇ","p":"fēng niǎo","d":[{"f":"動物名。鳥綱雨燕目。產在西半球，為最小的鳥類。羽毛細，嘴為管狀，便於吸收花蜜。"}]}],"蜂鳴器":[{"b":"ㄈㄥ ㄇㄧㄥˊ ㄑㄧˋ","p":"fēng míng qì","d":[{"f":"為一種電子音響裝置，可發出類似蜂鳴的聲音，廣泛應用於報警器、電鈴、電話機、定時器等電器中作為發聲元件。"}]}],"蜂黃":[{"b":"ㄈㄥ ㄏㄨㄤˊ","p":"fēng huáng","d":[{"f":"古代婦女塗額的黃色妝飾。也稱花黃。"}]}],"袒":[{"b":"ㄊㄢˇ","p":"tǎn","d":[{"f":"裸露。","t":"動","e":["如：「袒腹」、「袒胸」。"]},{"f":"偏護。","t":"動","e":["如：「偏袒」、「袒護」。"]},{"f":"表露、表白。","t":"動","e":["如：「袒懷」、「袒露心事」。"]}]}],"袒免":[{"b":"ㄊㄢˇ ㄨㄣˋ","p":"tǎn wèn","d":[{"f":"袒露左臂、脫帽束髮、以布纏頭，是古代喪服中最輕的服制。《儀禮．喪服》：「朋友皆在他邦，袒免，歸則已。」也作「袒絻」。"}]}],"袒縛":[{"b":"ㄊㄢˇ ㄈㄨˊ","p":"tǎn fú","d":[{"f":"袒露身體，反綁手臂。表示降服順從。"}]}],"袒胸":[{"b":"ㄊㄢˇ ㄒㄩㄥ","p":"tǎn xiōng","d":[{"f":"露出胸部。","e":["如：「每到夏天他就袒胸露背，一點也不雅觀。」"]}]}],"袒胸露背":[{"b":"ㄊㄢˇ ㄒㄩㄥ ㄌㄨˋ ㄅㄟˋ","p":"tǎn xiōng lù bèi","d":[{"f":"裸露上身。","e":["如：「天氣酷熱，很多小朋友袒胸露背在游泳池裡玩水消暑。」"]}]}],"袒膊":[{"b":"ㄊㄢˇ ㄅㄛˊ","p":"tǎn bó","d":[{"f":"露出肩臂。"}]}],"袒臂":[{"b":"ㄊㄢˇ ㄅㄧˋ","p":"tǎn bì","d":[{"f":"露出手臂。"}]}],"袒衣":[{"b":"ㄊㄢˇ ㄧ","p":"tǎn yī","d":[{"f":"著衣而未扣好紐扣以至有裸露的地方。"}]}],"袒裼":[{"b":"ㄊㄢˇ ㄒㄧˊ","p":"tǎn xí","d":[{"f":"脫去外衣，露出裡衣。"}]}],"袒裼裸裎":[{"b":"ㄊㄢˇ ㄒㄧˊ ㄌㄨㄛˇ ㄔㄥˊ","p":"tǎn xí luǒ chéng","d":[{"f":"赤身露體。","s":"赤身露體"}]}],"袒護":[{"b":"ㄊㄢˇ ㄏㄨˋ","p":"tǎn hù","d":[{"f":"偏袒庇護。","e":["如：「父母教養兒女，不可過分袒護。」"],"s":"包庇,庇護,偏護,回護,掩護"}]}],"袒露":[{"b":"ㄊㄢˇ ㄌㄨˋ","p":"tǎn lù","d":[{"f":"裸露。"}]}],"訢":[{"b":"ㄒㄧ","p":"xī","d":[{"f":"感應、融合。","t":"動"}]},{"b":"ㄒㄧㄣ","p":"xīn","d":[{"f":"喜樂。","t":"副"},{"f":"姓。如漢代有訢梵。","t":"名"}]}],"訢合":[{"b":"ㄒㄧ ㄏㄜˊ","p":"xī hé","d":[{"f":"感通。"}]}],"訢戴":[{"b":"ㄒㄧㄣ ㄉㄞˋ","p":"xīn dài","d":[{"f":"心悅誠服的擁戴。"}]}],"訢然":[{"b":"ㄒㄧㄣ ㄖㄢˊ","p":"xīn rán","d":[{"f":"喜樂的樣子。"}]}],"訢訢":[{"b":"ㄒㄧㄣ ㄒㄧㄣ","p":"xīn xīn","d":[{"f":"喜樂的樣子。"}]}],"軒":[{"b":"ㄒㄩㄢ","p":"xuān","d":[{"f":"古代一種有篷、有屏蔽的車子，多為貴族所乘。","t":"名"},{"f":"車子的通稱。","t":"名"},{"f":"車前高起的部分。","t":"名"},{"f":"廳堂前後高起的屋簷。","t":"名","e":["如：「翻軒」。"]},{"f":"窗子。","t":"名"},{"f":"長廊。","t":"名"},{"f":"小房間。","t":"名"},{"f":"姓。如漢代有軒如。","t":"名"},{"f":"高飛。","t":"動"},{"f":"高。","t":"形","e":["如：「氣宇軒昂」。"]}]}],"軒冕":[{"b":"ㄒㄩㄢ ㄇㄧㄢˇ","p":"xuān miǎn","d":[{"f":"古代卿大夫的車服。古制大夫以上的官員才可以乘軒服冕。後借指官位爵祿或顯貴的人。"}]}],"軒城":[{"b":"ㄒㄩㄢ ㄔㄥˊ","p":"xuān chéng","d":[{"f":"古代天子有四面城牆，諸侯則缺其南面，稱為「軒城」。表示隨時受過的意思。"}]}],"軒宇":[{"b":"ㄒㄩㄢ ㄩˇ","p":"xuān yǔ","d":[{"f":"形容恢宏不凡的氣質。","e":["如：「氣質軒宇」。"]}]}],"軒掖":[{"b":"ㄒㄩㄢ ㄧㄝˋ","p":"xuān yè","d":[{"f":"宮禁。"}]}],"軒敞":[{"b":"ㄒㄩㄢ ㄔㄤˇ","p":"xuān chǎng","d":[{"f":"高大寬敞。","a":"狹窄"},{"f":"開朗明亮。也作「軒朗」。"}]}],"軒昂":[{"b":"ㄒㄩㄢ ㄤˊ","p":"xuān áng","d":[{"f":"高舉的樣子。","a":"平凡"},{"f":"意態不凡的樣子。"}]}],"軒昂氣宇":[{"b":"ㄒㄩㄢ ㄤˊ ㄑㄧˋ ㄩˇ","p":"xuān áng qì yǔ","d":[{"f":"形容人的儀表精神飽滿，氣度不凡。《孤本元明雜劇．漁樵閑話．第三折》：「一個個前撮後擁，看見他呵，是好個軒昂氣宇。」也作「氣宇軒昂」、「器宇軒昂」。"}]}],"軒昂自若":[{"b":"ㄒㄩㄢ ㄤˊ ㄗˋ ㄖㄨㄛˋ","p":"xuān áng zì ruò","d":[{"f":"形容人精神飽滿，神態自然。","e":["如：「他軒昂自若地站在臺上，一點也不怯場。」"]}]}],"軒朗":[{"b":"ㄒㄩㄢ ㄌㄤˇ","p":"xuān lǎng","d":[{"f":"開朗明亮。宋．歐陽玄〈辟雍賦〉：「若乃道閫邃嚴，義闥軒朗，澄源止而不泥。」也作「軒敞」。"}]}],"軒檻":[{"b":"ㄒㄩㄢ ㄐㄧㄢˋ","p":"xuān jiàn","d":[{"f":"廳堂上長廊的欄干。"}]}],"軒渠":[{"b":"ㄒㄩㄢ ㄑㄩˊ","p":"xuān qú","d":[{"f":"歡笑的樣子。"}]}],"軒然":[{"b":"ㄒㄩㄢ ㄖㄢˊ","p":"xuān rán","d":[{"f":"高舉的樣子。"},{"f":"歡笑的樣子。"}]}],"軒然大波":[{"b":"ㄒㄩㄢ ㄖㄢˊ ㄉㄚˋ ㄅㄛ","p":"xuān rán dà bō","d":[{"f":"高湧而盛大的波濤。"},{"f":"比喻大的糾紛或風潮。","e":["如：「這個消息經報端披露後，在輿論界掀起軒然大波。」"]}]}],"軒眉":[{"b":"ㄒㄩㄢ ㄇㄟˊ","p":"xuān méi","d":[{"f":"揚眉。","a":"侘傺"}]}],"軒秀":[{"b":"ㄒㄩㄢ ㄒㄧㄡˋ","p":"xuān xiù","d":[{"f":"傑出。"}]}],"軒翥":[{"b":"ㄒㄩㄢ ㄓㄨˋ","p":"xuān zhù","d":[{"f":"飛舉的樣子。"}]}],"軒舉":[{"b":"ㄒㄩㄢ ㄐㄩˇ","p":"xuān jǔ","d":[{"f":"爽朗的樣子。"}]}],"軒裳":[{"b":"ㄒㄩㄢ ㄔㄤˊ","p":"xuān cháng","d":[{"f":"古代卿大夫以上的車服。"},{"f":"顯貴的人。"}]}],"軒豁":[{"b":"ㄒㄩㄢ ㄏㄨㄛˋ","p":"xuān huò","d":[{"f":"開朗。"},{"f":"形容聲勢浩大。"}]}],"軒車":[{"b":"ㄒㄩㄢ ㄔㄜ","p":"xuān chē","d":[{"f":"大夫以上所乘有帷幕的馬車。"},{"f":"攻城的車子。"}]}],"軒軒":[{"b":"ㄒㄩㄢ ㄒㄩㄢ","p":"xuān xuān","d":[{"f":"自得。"},{"f":"舞動。"},{"f":"光彩煥發。"}]}],"軒軒甚得":[{"b":"ㄒㄩㄢ ㄒㄩㄢ ㄕㄣˋ ㄉㄜˊ","p":"xuān xuān shèn dé","d":[{"f":"得意自如。"}]}],"軒輊":[{"b":"ㄒㄩㄢ ㄓˋ","p":"xuān zhì","d":[{"f":"古代大夫以上乘坐的車前頂高的部分為軒，而車頂前低後高的部分為輊。一說車子行進時，前端高起叫軒，後端高起叫輊。多用於比喻高低、輕重、優劣的差異。","e":["如：「不分軒輊」。"]}]}],"軒輖":[{"b":"ㄒㄩ